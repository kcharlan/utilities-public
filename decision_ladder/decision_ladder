// decision-math:begin
(function () {
const finite = v => typeof v === 'number' && Number.isFinite(v);
function withinCaps(row, caps) { return finite(row.price) && finite(row.latency) && row.price <= caps.cost && row.latency <= caps.latency; }
function capReasons(row, caps) {
  const reasons = [];
  if (!finite(row.price)) reasons.push('no price'); else if (row.price > caps.cost) reasons.push('price above the cap');
  if (!finite(row.latency)) reasons.push('no latency'); else if (row.latency > caps.latency) reasons.push('latency above the cap');
  return reasons;
}
function prepare(rows, opts) {
  return rows.filter(r => r.ranked && finite(r.capability) && (opts.board === 'all' || r.board === opts.board)).map(r => ({...r,
    label:r.name, score:opts.mode === 'whole' ? ladderCore.wholePoints(r.capability) : r.capability,
    cost:finite(r[opts.axis]) ? r[opts.axis] : null, inCaps:withinCaps(r,opts.caps)}));
}
function tiers(rows) {
  const compareNullable = (a,b) => a == null ? (b == null ? 0 : 1) : b == null ? -1 : a-b;
  const list = rows.slice().sort((a,b) => b.score-a.score || compareNullable(a.price,b.price) || compareNullable(a.latency,b.latency) || ladderCore.compareText(a.label,b.label));
  let tier = 0, previous, size = 0;
  list.forEach((r,i) => { if (i === 0 || r.score !== previous) { tier++; previous=r.score; size=list.filter(x => x.score === r.score).length; } list[i]={...r,tier,tierSize:size}; });
  return list;
}
function boardFrontier(rows) { return ladderCore.paretoRows(rows.filter(r => r.inCaps)); }
function priceText(v) { return finite(v) ? v.toFixed(v < .01 ? 4 : v < 1 ? 3 : 2) : ''; }
function latencyText(v) { return finite(v) ? (v < 1 ? Math.round(v*1000)+' ms' : v.toFixed(2)+' s') : ''; }
function scoreText(v) { return finite(v) ? v.toFixed(1) : ''; }
function capText(v,axis) { return axis==='price' ? '$'+priceText(v) : latencyText(v); }
function label(kind,token) {
  const labels={price:{tariff:'published tariff',listed:'listed price',estimate:'estimate',estimated:'estimate',mixed:'part estimate',unpriced:'no price'},latency:{'api-end-to-end':'measured end to end','measured-loopback':'loopback, adjusted','demo-endpoint-x2':'demo endpoint, adjusted'}};
  return Object.hasOwn(labels,kind) && Object.hasOwn(labels[kind],token) ? labels[kind][token] : (token == null ? '' : String(token).replace(/-/g,' '));
}
function whenText(iso) { const date=new Date(iso); return Number.isNaN(date.getTime()) ? iso : date.toISOString().slice(0,16).replace('T',' ')+' UTC'; }
function findings(rows, caps, mode, axis='price') {
  const inside=rows.filter(r=>r.inCaps), ranked=tiers(inside), front=boardFrontier(rows).filter(r=>r.status==='frontier');
  const out=[`${inside.length} ranked systems are inside the caps; ${front.length} are on the frontier.`];
  if (ranked.length) { const top=ranked.filter(r=>r.tier===1); out.push(`The top tier scores ${mode === 'whole' ? top[0].score : top[0].score.toFixed(1)}: ${top.map(r=>r.label).join(', ')}.`); }
  const steps=front.filter(r=>r.up && r.up.perPoint !== null).map(r=>({from:r.label, ...r.up})).sort((a,b)=>a.perPoint-b.perPoint);
  if (steps.length) {
    const unit=axis==='latency'?'seconds per point':'dollars per 1,000 decisions per point';
    const describe=s=>`${s.from} to ${s.to.label} (${Number(s.perPoint.toPrecision(4))} ${unit})`;
    const [low, high]=axis==='latency'?['shortest','longest']:['cheapest','most expensive'];
    out.push(`The ${low} frontier step per point is ${describe(steps[0])}; the ${high} is ${describe(steps[steps.length-1])}.`);
  }
  return out;
}
function searchRows(rows, query) { const q=query.toLowerCase(); return rows.filter(r=>r.name.toLowerCase().includes(q)); }
function changesToShow(changes, mode) {
  if (!changes || changes.method) return [];
  const fields=['listing','capability_rank','composite_rank'];
  const formattedChange=(pair,format)=>pair && format(pair[0])!==format(pair[1]);
  return (changes.changed || []).filter(r=>fields.some(k=>r[k] && r[k][0]!==r[k][1]) ||
    formattedChange(r.price,priceText) || formattedChange(r.latency,latencyText) ||
    (r.capability && r.capability.map(v=>finite(v)?(mode==='whole'?ladderCore.wholePoints(v):v.toFixed(1)):v).some((v,i,a)=>v!==a[0])));
}
function visibleHistory(history, mode) {
  return history.find(c=>c.revision || c.method || c.caps || c.added.length || c.removed.length || changesToShow(c,mode).length) || null;
}
const api={withinCaps,capReasons,prepare,tiers,boardFrontier,priceText,latencyText,scoreText,capText,label,whenText,findings,searchRows,changesToShow,visibleHistory};
if (typeof module !== 'undefined') module.exports=api; else window.decisionMath=api;
}());
// decision-math:end
"""
