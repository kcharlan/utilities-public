# frontend-vendor:end
HTML_TEMPLATE = HTML_TEMPLATE.replace("<!-- frontend-vendor -->", FRONTEND_VENDOR_HTML)


def render_page(payload):
    assets = {"PAGE_CSS": PAGE_CSS, "DECISION_MATH_JS": DECISION_MATH_JS, "APP_JS": APP_JS}
    for name, text in assets.items():
        if "</script" in text.lower():
            raise ValueError(f"{name} contains a closing script tag")
    parts = {"{{CSS}}": PAGE_CSS, "{{SCRIPTS}}": f"<script>{DECISION_MATH_JS}</script><script>{APP_JS}</script>",
             "{{PAYLOAD}}": json.dumps(payload, separators=(",", ":")).replace("<", "\\u003c")}
    out, rest = [], HTML_TEMPLATE
    for marker in sorted(parts, key=HTML_TEMPLATE.index):
        before, found, rest = rest.partition(marker)
        if not found:
            raise ValueError(f"page template is missing {marker}")
        out += [before, parts[marker]]
    out.append(rest)
    return "".join(out).encode("utf-8")


def build_page(home, output):
    paths = load_snapshots(home)
    if not paths:
        raise StoreError("no snapshot to build from")
    snapshot = read_snapshot(paths[0])
    payload = build_payload(snapshot, None, load_config())
    payload["change_history"] = []
    for path in paths[1:]:
        try:
            payload["change_history"].append(diff_rows(read_snapshot(path), snapshot))
        except StoreError as error:
            _complain(f"{error}; skipping it for the list of changes")
    payload["changes"] = next((diff for diff in payload["change_history"] if _shows_a_change(diff)), None)
    payload["built_at"] = datetime.now(timezone.utc).isoformat()
    atomic_write_bytes(output, render_page(payload))


def testing_mode_enabled() -> bool:
    return os.environ.get("UTILITIES_TESTING", "").lower() not in {"", "0", "false", "no"}


def build_parser():
    parser = argparse.ArgumentParser(prog="decision_ladder", description="Explore JevBench system measurements.",
                                     epilog="Runtime home: ~/.decision_ladder/ (override with DECISION_LADDER_HOME).")
    parser.add_argument("command", nargs="?", choices=("refresh", "build"))
    parser.add_argument("--no-refresh", action="store_true")
    parser.add_argument("--no-open", action="store_true")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--version", action="version", version=f"Decision Ladder {VERSION}")
    return parser


def _complain(message):
    print(f"Decision Ladder: {message}", file=sys.stderr)


def main(argv=None, *, now=None, fetch=fetch_feed, open_page=webbrowser.open):
    args = build_parser().parse_args(argv)
    now = now or datetime.now(timezone.utc)
    try:
        config = load_config()
        home = runtime_home()
        paths = load_snapshots(home)
        newest = read_snapshot(paths[0]) if paths else None
    except (ValueError, OSError, StoreError) as error:
        _complain(str(error))
        return 1
    should_fetch = not (args.command == "build" or args.no_refresh) and (
        args.command == "refresh" or newest is None or
        _utc(now) - _utc(datetime.fromisoformat(newest["last_checked"])) > timedelta(hours=config["max_age_hours"]))
    if should_fetch:
        try:
            result = fetch()
            save_snapshot(home, result, now)
            systems = result["feed"]["systems"]
            print(f"Fetched {len(systems)} systems ({sum(row['ranked'] for row in systems)} ranked), revision {result['feed']['revision']}.")
        except (FetchError, StoreError, OSError) as error:
            _complain(f"{error}; building from the existing snapshot" if newest is not None else str(error))
            if newest is None:
                return 1
    elif newest is None:
        _complain("no snapshot yet; run decision_ladder refresh to fetch one")
        return 1
    output = args.output.expanduser() if args.output else home / "decision_ladder.html"
    try:
        build_page(home, output)
    except (OSError, StoreError, ValueError) as error:
        _complain(f"cannot build the page: {error}")
        return 1
    print(output)
    if not args.no_open and not testing_mode_enabled():
        try:
            open_page(output.resolve().as_uri())
        except Exception:
            _complain("could not open a browser; open the page manually")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
