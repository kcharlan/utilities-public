def runtime_home() -> Path:
    override = os.environ.get("DECISION_LADDER_HOME")
    return Path(override).expanduser() if override else Path.home() / ".decision_ladder"


def ensure_runtime_home(path: Path) -> Path:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Publish a complete same-directory private file, preserving the old file on failure."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


def load_config():
    path = ensure_runtime_home(runtime_home()) / "config.json"
    if not path.exists():
        atomic_write_bytes(path, (json.dumps(DEFAULT_CONFIG, indent=2) + "\n").encode())
        return dict(DEFAULT_CONFIG)
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError(f"{path} is not valid JSON: {error}") from error
    if not isinstance(loaded, dict):
        raise ValueError(f"{path} must contain a JSON object")
    config = {**DEFAULT_CONFIG, **loaded}
    age = config["max_age_hours"]
    if isinstance(age, bool) or not isinstance(age, (int, float)) or not 0 < age <= MAX_AGE_LIMIT:
        raise ValueError(f"{path}: max_age_hours must be a positive number of at most {MAX_AGE_LIMIT}")
    return config


def split_name(name):
    if name.endswith(")") and " (" in name:
        short, detail = name.split(" (", 1)
        return {"short": short, "detail": detail[:-1]}
    return {"short": name, "detail": ""}


def classify(feed):
    rows = []
    for system in feed["systems"]:
        axes = system.get("axes") or {}
        cap = system["capability"]
        price = system.get("price") or {}
        latency = system.get("latency") or {}
        draw = system.get("draw") or {}
        basis = latency.get("latency_basis")
        adjusted = latency.get("p50_s_adjusted")
        rows.append({
            "key": system["key"], "name": system["name"], **split_name(system["name"]),
            "board": system["board"], "listing": system.get("listing"), "ranked": system["ranked"],
            "not_ranked_because": system.get("not_ranked_because"), "source_url": system.get("source_url"),
            "intelligence": axes.get("intelligence"), "calibration": axes.get("calibration"),
            "speed": axes.get("speed"), "cost_axis": axes.get("cost"),
            "capability": cap.get("score"), "capability_rank": cap.get("rank"),
            "composite": system.get("composite_score"), "composite_rank": system.get("rank"),
            "eligible": cap["eligible"], "within_caps": cap["within_caps"], "cap_reasons": cap.get("reasons"),
            "price": price.get("usd_per_1000_decisions"), "price_kind": price.get("kind"),
            "price_published": price.get("kind") in ("tariff", "listed"), "price_basis": price.get("basis"),
            "latency": adjusted if adjusted is not None else latency.get("p50_s_measured"),
            "latency_measured": latency.get("p50_s_measured"), "latency_p95": latency.get("p95_s_adjusted"),
            "latency_basis": basis, "latency_assumed": basis != "api-end-to-end",
            "latency_adjustment": latency.get("adjustment"), "measured_on": draw.get("measured_on"),
            "method_status": system.get("method_status"),
        })
    return rows


class FetchError(Exception):
    pass


def _is_number(value) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _is_finite_number(value) -> bool:
    return _is_number(value) and math.isfinite(value)


def _valid_feed_number(value):
    try:
        return _is_finite_number(value)
    except OverflowError:
        return False


def validate_feed(feed):
    if not isinstance(feed, dict):
        raise FetchError("feed is not an object")
    if feed.get("schema_version") != SUPPORTED_SCHEMA:
        raise FetchError(f"feed schema {feed.get('schema_version')} is not supported by this version")
    if not isinstance(feed.get("revision"), str) or not feed["revision"].strip():
        raise FetchError("feed revision must be a non-empty string")
    method = feed.get("method")
    if not isinstance(method, dict) or not isinstance(method.get("label"), str) or not method["label"].strip():
        raise FetchError("feed method.label must be a non-empty string")
    policy = feed.get("capability_policy")
    if not isinstance(policy, dict):
        raise FetchError("feed capability_policy must be an object")
    for field in ("cost_cap_usd_per_1000", "median_latency_cap_s"):
        if not _valid_feed_number(policy.get(field)) or policy[field] <= 0:
            raise FetchError(f"feed {field} must be a positive finite number")
    for obj, field in ((method, "decision_limit_s"), (policy, "factor")):
        if obj.get(field) is not None and not _valid_feed_number(obj[field]):
            raise FetchError(f"feed {field} must be finite or null")
    systems = feed.get("systems")
    if not isinstance(systems, list) or not systems:
        raise FetchError("feed systems must be a non-empty list")
    seen = set()
    for row in systems:
        if not isinstance(row, dict):
            raise FetchError("feed system must be an object")
        key = row.get("key")
        if not isinstance(key, str) or not key.strip() or key in seen:
            raise FetchError(f"system {key!r}: key must be non-empty and unique")
        seen.add(key)
        if not isinstance(row.get("name"), str) or not row["name"].strip():
            raise FetchError(f"system {key}: name must be a non-empty string")
        if not isinstance(row.get("board"), str) or not isinstance(row.get("ranked"), bool):
            raise FetchError(f"system {key}: invalid board or ranked")
        cap = row.get("capability")
        if not isinstance(cap, dict) or any(not isinstance(cap.get(f), bool) for f in ("within_caps", "eligible")):
            raise FetchError(f"system {key}: invalid capability")
        for field in ("price", "latency", "axes", "draw"):
            if row.get(field) is not None and not isinstance(row[field], dict):
                raise FetchError(f"system {key}: {field} must be an object or null")
        for obj, fields in ((row, ("composite_score", "rank")), (cap, ("score", "rank")),
                            (row.get("axes") or {}, ("intelligence", "calibration", "speed", "cost")),
                            (row.get("price") or {}, ("usd_per_1000_decisions",)),
                            (row.get("latency") or {}, ("p50_s_measured", "p50_s_adjusted", "p95_s_adjusted"))):
            if not isinstance(obj, dict):
                raise FetchError(f"system {key}: invalid numeric fields")
            for field in fields:
                value = obj.get(field)
                if value is not None and not _valid_feed_number(value):
                    raise FetchError(f"system {key}: {field} must be finite or null")


def fetch_feed(open_url=urllib.request.urlopen):
    request = urllib.request.Request(FEED_URL, headers={"Accept": "application/json", "User-Agent": f"decision-ladder/{VERSION}"})
    try:
        with open_url(request, timeout=30) as response:
            body = response.read(MAX_BYTES + 1)
            headers = response.headers
    except urllib.error.HTTPError as error:
        raise FetchError(f"Benchmark Heaven returned HTTP {error.code}") from None
    except urllib.error.URLError as error:
        raise FetchError(f"Could not reach Benchmark Heaven: {' '.join(str(error.reason).splitlines())}") from None
    except http.client.HTTPException as error:
        raise FetchError(f"Benchmark Heaven response was incomplete or malformed ({type(error).__name__})") from None
    except (OSError, TimeoutError) as error:
        raise FetchError(f"Could not reach Benchmark Heaven: {' '.join(str(error).splitlines())}") from None
    if len(body) > MAX_BYTES:
        raise FetchError("Benchmark Heaven response is too large")
    digest = hashlib.sha256(body).hexdigest()
    checksum = headers.get("X-Content-SHA256")
    if checksum is not None and checksum != digest:
        raise FetchError("Benchmark Heaven response does not match its checksum")
    try:
        feed = json.loads(body)
    except ValueError:
        raise FetchError("Benchmark Heaven response is not valid JSON") from None
    validate_feed(feed)
    return {"feed": feed, "sha256": digest}

KEEP = 60
SCHEMA = 1
SNAPSHOT_DIR = "snapshots"
SNAPSHOT_SUFFIX = ".json.gz"


class StoreError(Exception):
    """A snapshot could not be read."""


def _utc(moment: datetime) -> datetime:
    """An aware UTC datetime; a naive one is taken to be UTC already."""
    if moment.tzinfo is None:
        return moment.replace(tzinfo=timezone.utc)
    return moment.astimezone(timezone.utc)


def _write_snapshot(path, data):
    atomic_write_bytes(path, gzip.compress(json.dumps(data).encode("utf-8")))


def load_snapshots(home):
    return sorted((home / SNAPSHOT_DIR).glob("*" + SNAPSHOT_SUFFIX), key=lambda p: p.name, reverse=True)


def read_snapshot(path):
    try:
        with gzip.open(path, "rb") as stream:
            data = json.loads(stream.read().decode("utf-8"))
    except (OSError, EOFError, ValueError, zlib.error) as error:
        raise StoreError(f"cannot read {path}: {error or type(error).__name__}") from None
    if not isinstance(data, dict) or data.get("schema") != SCHEMA or not isinstance(data.get("feed"), dict):
        raise StoreError(f"cannot read {path}: not a version {SCHEMA} snapshot")
    try:
        validate_feed(data["feed"])
    except FetchError as error:
        raise StoreError(f"cannot read {path}: {error}") from None
    for field in ("fetched_at", "last_checked"):
        try:
            datetime.fromisoformat(data[field])
        except (KeyError, TypeError, ValueError):
            raise StoreError(f"cannot read {path}: bad {field}") from None
    return data


def save_snapshot(home, result, now):
    moment = _utc(now).replace(microsecond=0)
    ensure_runtime_home(home / SNAPSHOT_DIR)
    existing = load_snapshots(home)
    if existing:
        newest = read_snapshot(existing[0])
        if newest["feed"] == result["feed"]:
            newest["last_checked"] = moment.isoformat()
            _write_snapshot(existing[0], newest)
            return existing[0]
    stem = moment.strftime("%Y%m%dT%H%M%SZ")
    path = home / SNAPSHOT_DIR / (stem + SNAPSHOT_SUFFIX)
    siblings = [p.name.removesuffix(SNAPSHOT_SUFFIX) for p in existing
                if p.name.startswith(stem + "_") and p.name.endswith(SNAPSHOT_SUFFIX)]
    sequences = [int(name[len(stem) + 1:]) for name in siblings if name[len(stem) + 1:].isdigit()]
    if path.exists() or sequences:
        path = home / SNAPSHOT_DIR / (f"{stem}_{max(sequences, default=0) + 1:012d}" + SNAPSHOT_SUFFIX)
    _write_snapshot(path, {"schema": SCHEMA, "fetched_at": moment.isoformat(),
                           "last_checked": moment.isoformat(), "sha256": result["sha256"], "feed": result["feed"]})
    for old in load_snapshots(home)[KEEP:]:
        old.unlink()
    return path


def diff_rows(old, new):
    if old is None:
        return None
    before = {r["key"]: r for r in classify(old["feed"])}
    after = {r["key"]: r for r in classify(new["feed"])}
    fields = ("capability", "composite", "price", "latency", "listing", "capability_rank", "composite_rank")
    changed = []
    for key, row in after.items():
        prior = before.get(key)
        if prior and any(prior[f] != row[f] for f in fields):
            changed.append({"key": key, "name": row["name"], **{f: [prior[f], row[f]] for f in fields}})
    a, b = old["feed"], new["feed"]
    def pair(x, y):
        return None if x == y else [x, y]
    return {"from": old["fetched_at"], "to": new["fetched_at"],
            "revision": pair(a["revision"], b["revision"]), "method": pair(a["method"], b["method"]),
            "caps": pair(a["capability_policy"], b["capability_policy"]),
            "added": [r["name"] for k, r in after.items() if k not in before],
            "removed": [r["name"] for k, r in before.items() if k not in after], "changed": changed}


def _shows_a_change(diff):
    return bool(diff["revision"] or diff["method"] or diff["caps"] or diff["added"] or diff["removed"] or diff["changed"])


def _last_real_change(older, snapshot):
    for path in older:
        try:
            candidate = read_snapshot(path)
        except StoreError as error:
            _complain(f"{error}; skipping it for the list of changes")
            continue
        if _shows_a_change(diff_rows(candidate, snapshot)):
            return candidate
    return None


def build_payload(snapshot, previous, config):
    feed = snapshot["feed"]
    policy = feed["capability_policy"]
    return {"schema": 1, "app": {"name": "Decision Ladder", "version": VERSION},
            "fetched_at": snapshot["fetched_at"], "last_checked": snapshot["last_checked"],
            "max_age_hours": config["max_age_hours"], "revision": feed["revision"], "method": feed["method"],
            "caps": {"cost": policy["cost_cap_usd_per_1000"], "latency": policy["median_latency_cap_s"],
                     "reference_key": policy.get("reference_key"), "factor": policy.get("factor")},
            "rows": classify(feed), "changes": diff_rows(previous, snapshot)}


