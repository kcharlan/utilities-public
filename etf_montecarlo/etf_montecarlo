"""Estimate annual dividend income from a private portfolio configuration."""

from __future__ import annotations

import argparse
import csv
import json
import math
import os
import re
import stat
import sys
import tempfile
import unicodedata
from collections import Counter
from dataclasses import dataclass
from datetime import date, datetime
from pathlib import Path
from statistics import median
from typing import Any, Iterable, Sequence

import numpy as np


SCHEMA_VERSION = 1
SOURCE_DIR = Path(__file__).resolve().parent
PLACEHOLDER_SYMBOLS = frozenset({"SYNTH1", "SYNTH2"})
MAX_HOLDINGS = 100
MAX_SHARES = 1e12
MAX_HISTORY_YEARS = 100
MAX_TRIALS = 1_000_000
MAX_SEED = (1 << 32) - 1
MAX_SIMULATION_CELLS = 50_000_000
SIMULATION_BATCH_SIZE = 10_000
SYMBOL_PATTERN = re.compile(r"[A-Z0-9.^=-]{1,32}")
FORMULA_PREFIXES = frozenset("=+-@")
SOURCE_SCAN_EXCLUSIONS = frozenset({".venv", ".pytest_cache", "__pycache__"})
# macOS exposes these root-owned aliases while their canonical directories live
# under /private. Only these exact, verified targets bypass the symlink guard.
TRUSTED_SYSTEM_PATH_ALIASES = {
    Path("/etc"): Path("/private/etc"),
    Path("/tmp"): Path("/private/tmp"),
    Path("/var"): Path("/private/var"),
}
PERCENTILES = (("P5", 5), ("P25", 25), ("P50", 50), ("P75", 75), ("P95", 95))
INCOMPLETE_SKELETON: dict[str, Any] = {
    "schema_version": SCHEMA_VERSION,
    "holdings": [],
    "history": {"years": 0},
    "simulation": {"trials": 0, "seed": None},
    "output": {"results_csv": ""},
}

# Test-only observation point. It contains error text, never config values.
LAST_ERROR_FOR_TESTS = ""


class ConfigurationError(ValueError):
    """Raised when local configuration is missing, incomplete, or unsafe."""

    def __init__(self, problems: Iterable[str]):
        self.problems = tuple(problems)
        super().__init__("; ".join(self.problems))


class MarketDataError(RuntimeError):
    """Raised when dividend history is unavailable or invalid."""


class UnsafePathError(RuntimeError):
    """Raised when a private path cannot be handled without following a link."""


@dataclass(frozen=True)
class Holding:
    symbol: str
    shares: float


@dataclass(frozen=True)
class Settings:
    holdings: tuple[Holding, ...]
    history_years: int
    trials: int
    seed: int | None
    results_csv: Path | None


@dataclass(frozen=True)
class DividendPayment:
    payment_date: date
    amount: float


@dataclass(frozen=True)
class DividendHistory:
    symbol: str
    payments: tuple[DividendPayment, ...]


@dataclass(frozen=True)
class HoldingSimulation:
    holding: Holding
    payments_per_year: int
    per_share_samples: np.ndarray
    scaled_samples: np.ndarray


@dataclass(frozen=True)
class SummaryRow:
    scope: str
    symbol: str
    payments_per_year: int | None
    percentile: str
    annual_income_per_share: float | None
    annual_income_scaled: float


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Bootstrap historical dividend payments to estimate annual dividend "
            "income for a privately configured portfolio."
        )
    )
    parser.add_argument(
        "--config",
        type=Path,
        help=(
            "Private JSON config path. Defaults to $ETF_MONTECARLO_HOME/config.json "
            "or ~/.etf_montecarlo/config.json."
        ),
    )
    parser.add_argument(
        "--overwrite",
        action="store_true",
        help="Atomically replace an existing results CSV.",
    )
    return parser.parse_args(argv)


def runtime_home() -> Path:
    override = os.environ.get("ETF_MONTECARLO_HOME")
    return Path(override).expanduser() if override else Path.home() / ".etf_montecarlo"


def resolve_config_path(explicit_path: Path | None) -> Path:
    path = explicit_path.expanduser() if explicit_path else runtime_home() / "config.json"
    return path if path.is_absolute() else Path.cwd() / path


def _absolute_path(path: Path) -> Path:
    expanded = path.expanduser()
    return expanded if expanded.is_absolute() else Path.cwd() / expanded


def _casefolded_real_parts(path: Path) -> tuple[str, ...]:
    resolved = Path(os.path.realpath(_absolute_path(path)))
    return tuple(part.casefold() for part in resolved.parts)


def paths_alias(first: Path, second: Path) -> bool:
    """Compare path spellings conservatively, then use inode identity when possible."""
    if _casefolded_real_parts(first) == _casefolded_real_parts(second):
        return True
    try:
        return os.path.samefile(first, second)
    except OSError:
        return False


def path_is_within(path: Path, directory: Path) -> bool:
    path_parts = _casefolded_real_parts(path)
    directory_parts = _casefolded_real_parts(directory)
    return (
        len(path_parts) >= len(directory_parts)
        and path_parts[: len(directory_parts)] == directory_parts
    )


def path_aliases_source_tree(path: Path, directory: Path) -> bool:
    """Reject containment and existing hard-link aliases to public source entries."""
    if path_is_within(path, directory):
        return True
    try:
        candidate = path.stat()
        source_root = directory.stat()
    except OSError:
        return False
    identity = (candidate.st_dev, candidate.st_ino)
    if identity == (source_root.st_dev, source_root.st_ino):
        return True
    for root, directory_names, file_names in os.walk(directory, followlinks=False):
        directory_names[:] = [
            name for name in directory_names if name not in SOURCE_SCAN_EXCLUSIONS
        ]
        for name in (*directory_names, *file_names):
            try:
                metadata = (Path(root) / name).stat(follow_symlinks=False)
            except OSError:
                continue
            if identity == (metadata.st_dev, metadata.st_ino):
                return True
    return False


def reject_symbolic_link_components(path: Path, *, label: str) -> None:
    """Reject an existing symbolic link anywhere in an absolute path."""
    absolute = _absolute_path(path)
    parts = absolute.parts
    if not parts:
        return
    current = Path(parts[0])
    for part in parts[1:]:
        current /= part
        try:
            metadata = current.lstat()
        except FileNotFoundError:
            return
        if stat.S_ISLNK(metadata.st_mode):
            trusted_target = TRUSTED_SYSTEM_PATH_ALIASES.get(current)
            if trusted_target is not None:
                resolved = Path(os.path.realpath(current))
                if resolved == trusted_target:
                    continue
            raise UnsafePathError(
                f"{label} path must not contain a symbolic link: {current}"
            )


def fsync_directory(path: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def secure_private_directory(path: Path) -> None:
    """Create or harden a private directory without accepting symlink components."""
    reject_symbolic_link_components(path, label="private directory")
    try:
        details = path.lstat()
    except FileNotFoundError:
        path.mkdir(parents=True, mode=0o700)
        reject_symbolic_link_components(path, label="private directory")
        details = path.lstat()
    if stat.S_ISLNK(details.st_mode):
        raise UnsafePathError(f"private directory must not be a symbolic link: {path}")
    if not stat.S_ISDIR(details.st_mode):
        raise UnsafePathError(f"private directory path is not a directory: {path}")

    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if (opened.st_dev, opened.st_ino) != (details.st_dev, details.st_ino):
            raise UnsafePathError(f"private directory changed while it was opened: {path}")
        os.fchmod(descriptor, 0o700)
    finally:
        os.close(descriptor)


def inspect_regular_file(path: Path, *, label: str) -> os.stat_result | None:
    try:
        details = path.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(details.st_mode):
        raise UnsafePathError(f"{label} must not be a symbolic link: {path}")
    if not stat.S_ISREG(details.st_mode):
        raise UnsafePathError(f"{label} must be a regular file: {path}")
    return details


def write_incomplete_skeleton(path: Path) -> bool:
    """Atomically create a private incomplete config; never replace one."""
    if inspect_regular_file(path, label="config") is not None:
        return False

    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
        suffix=".tmp",
        text=True,
    )
    temporary_path = Path(temporary_name)
    linked = False
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            os.fchmod(handle.fileno(), 0o600)
            json.dump(INCOMPLETE_SKELETON, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temporary_path, path)
            linked = True
        except FileExistsError:
            inspect_regular_file(path, label="config")
            return False
        fsync_directory(path.parent)
        return True
    except Exception:
        if linked:
            path.unlink(missing_ok=True)
        raise
    finally:
        temporary_path.unlink(missing_ok=True)


def read_private_json(path: Path) -> Any:
    expected = inspect_regular_file(path, label="config")
    if expected is None:
        raise ConfigurationError([f"config does not exist: {path}"])

    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise UnsafePathError(f"cannot safely open config: {path}: {exc}") from exc
    try:
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode):
            raise UnsafePathError(f"config must be a regular file: {path}")
        if (opened.st_dev, opened.st_ino) != (expected.st_dev, expected.st_ino):
            raise UnsafePathError(f"config changed while it was opened: {path}")
        os.fchmod(descriptor, 0o600)
        try:
            with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
                descriptor = -1
                return json.load(handle)
        except json.JSONDecodeError as exc:
            raise ConfigurationError(
                [f"config is not valid JSON at line {exc.lineno}, column {exc.colno}"]
            ) from exc
        except UnicodeDecodeError as exc:
            raise ConfigurationError(["config must be valid UTF-8 text"]) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def object_field(parent: dict[str, Any], name: str, problems: list[str]) -> dict[str, Any]:
    value = parent.get(name)
    if not isinstance(value, dict):
        problems.append(f"{name} must be an object")
        return {}
    return value


def report_unexpected_fields(
    value: dict[str, Any], allowed: set[str], field: str, problems: list[str]
) -> None:
    for name in sorted(set(value) - allowed):
        problems.append(f"{field}.{name} is not supported")


def positive_integer(value: Any, field: str, maximum: int, problems: list[str]) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        problems.append(f"{field} must be a whole number")
        return 0
    if value <= 0:
        problems.append(f"{field} must be greater than zero")
    elif value > maximum:
        problems.append(f"{field} must be {maximum} or less")
    return value


def finite_positive_number(value: Any, field: str, problems: list[str]) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        problems.append(f"{field} must be a finite number")
        return 0.0
    try:
        number = float(value)
    except (OverflowError, TypeError, ValueError):
        problems.append(f"{field} must be a finite number")
        return 0.0
    if not math.isfinite(number):
        problems.append(f"{field} must be a finite number")
    elif number <= 0:
        problems.append(f"{field} must be greater than zero")
    elif number > MAX_SHARES:
        problems.append(f"{field} exceeds the safety limit")
    return number


def validate_config(payload: Any, config_path: Path) -> Settings:
    problems: list[str] = []
    if not isinstance(payload, dict):
        raise ConfigurationError(["config root must be an object"])

    report_unexpected_fields(
        payload,
        {"_notice", "schema_version", "holdings", "history", "simulation", "output"},
        "config",
        problems,
    )
    if (
        type(payload.get("schema_version")) is not int
        or payload.get("schema_version") != SCHEMA_VERSION
    ):
        problems.append(f"schema_version must be {SCHEMA_VERSION}")

    raw_holdings = payload.get("holdings")
    if not isinstance(raw_holdings, list) or not raw_holdings:
        problems.append("holdings must contain at least one configured holding")
        raw_holdings = []
    elif len(raw_holdings) > MAX_HOLDINGS:
        problems.append(f"holdings must contain {MAX_HOLDINGS} entries or fewer")

    holdings: list[Holding] = []
    seen_symbols: set[str] = set()
    for index, raw_holding in enumerate(raw_holdings):
        field = f"holdings[{index}]"
        if not isinstance(raw_holding, dict):
            problems.append(f"{field} must be an object")
            continue
        report_unexpected_fields(raw_holding, {"symbol", "shares"}, field, problems)
        raw_symbol = raw_holding.get("symbol")
        symbol = raw_symbol.strip().upper() if isinstance(raw_symbol, str) else ""
        if not symbol:
            problems.append(f"{field}.symbol is required")
        elif symbol[0] in FORMULA_PREFIXES:
            problems.append(
                f"{field}.symbol must not begin with a spreadsheet formula character"
            )
        elif not SYMBOL_PATTERN.fullmatch(symbol):
            problems.append(f"{field}.symbol contains unsupported characters")
        elif symbol in seen_symbols:
            problems.append(f"{field}.symbol is a duplicate symbol")
        if symbol:
            seen_symbols.add(symbol)

        shares = finite_positive_number(raw_holding.get("shares"), f"{field}.shares", problems)
        if symbol in PLACEHOLDER_SYMBOLS:
            problems.append(f"{field}: replace placeholder symbol {symbol} in the private config")
        if (
            symbol
            and SYMBOL_PATTERN.fullmatch(symbol)
            and symbol[0] not in FORMULA_PREFIXES
            and symbol not in PLACEHOLDER_SYMBOLS
            and math.isfinite(shares)
            and 0 < shares <= MAX_SHARES
        ):
            holdings.append(Holding(symbol=symbol, shares=shares))

    history = object_field(payload, "history", problems)
    report_unexpected_fields(history, {"years"}, "history", problems)
    history_years = positive_integer(
        history.get("years"), "history.years", MAX_HISTORY_YEARS, problems
    )

    simulation = object_field(payload, "simulation", problems)
    report_unexpected_fields(simulation, {"trials", "seed"}, "simulation", problems)
    trials = positive_integer(
        simulation.get("trials"), "simulation.trials", MAX_TRIALS, problems
    )
    raw_seed = simulation.get("seed")
    seed: int | None
    if raw_seed is None:
        seed = None
    elif isinstance(raw_seed, bool) or not isinstance(raw_seed, int):
        problems.append("simulation.seed must be null or a whole number")
        seed = None
    elif not 0 <= raw_seed <= MAX_SEED:
        problems.append(f"simulation.seed must be between 0 and {MAX_SEED}")
        seed = None
    else:
        seed = raw_seed

    if trials > 0 and len(raw_holdings) * trials > MAX_SIMULATION_CELLS:
        problems.append("holdings and simulation.trials request too much simulation work")

    output = object_field(payload, "output", problems)
    report_unexpected_fields(output, {"results_csv"}, "output", problems)
    raw_results = output.get("results_csv")
    results_csv: Path | None
    if not isinstance(raw_results, str):
        problems.append("output.results_csv must be a path string or empty string")
        results_csv = None
    elif not raw_results.strip():
        results_csv = None
    elif any(unicodedata.category(character) == "Cc" for character in raw_results):
        problems.append("output.results_csv must not contain control characters")
        results_csv = None
    else:
        configured = Path(raw_results).expanduser()
        results_csv = configured if configured.is_absolute() else config_path.parent / configured
        if paths_alias(results_csv, config_path):
            problems.append("output.results_csv must not overwrite the private config")
        if path_aliases_source_tree(results_csv, SOURCE_DIR):
            problems.append("output.results_csv must live outside the public source directory")

    if problems:
        raise ConfigurationError(problems)
    return Settings(
        holdings=tuple(holdings),
        history_years=history_years,
        trials=trials,
        seed=seed,
        results_csv=results_csv,
    )


def current_date() -> date:
    return date.today()


def _coerce_payment_date(value: Any) -> date:
    if hasattr(value, "to_pydatetime"):
        value = value.to_pydatetime()
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    raise MarketDataError("finance provider returned an unsupported dividend date")


def fetch_dividend_history(symbol: str) -> DividendHistory:
    """Fetch the provider boundary used by the simulation and mocked by tests."""
    try:
        import yfinance as yf

        series = yf.Ticker(symbol).dividends
    except Exception as exc:
        raise MarketDataError(f"could not fetch dividend history for {symbol}: {exc}") from exc

    if series is None:
        return DividendHistory(symbol=symbol, payments=())
    try:
        items = series.items()
    except AttributeError as exc:
        raise MarketDataError(f"finance provider returned invalid dividend history for {symbol}") from exc

    payments: list[DividendPayment] = []
    for raw_date, raw_amount in items:
        try:
            amount = float(raw_amount)
        except (OverflowError, TypeError, ValueError) as exc:
            raise MarketDataError(f"finance provider returned an invalid dividend for {symbol}") from exc
        if not math.isfinite(amount) or amount <= 0:
            raise MarketDataError(f"finance provider returned a non-positive dividend for {symbol}")
        payments.append(DividendPayment(_coerce_payment_date(raw_date), amount))
    payments.sort(key=lambda payment: payment.payment_date)
    return DividendHistory(symbol=symbol, payments=tuple(payments))


def _calendar_years_before(value: date, years: int) -> date:
    try:
        return value.replace(year=value.year - years)
    except ValueError:
        # February 29 has no counterpart in a non-leap target year.
        return value.replace(year=value.year - years, day=28)


def trailing_payments(
    payments: Sequence[DividendPayment], *, years: int, as_of: date
) -> tuple[DividendPayment, ...]:
    cutoff = _calendar_years_before(as_of, years)
    return tuple(
        payment for payment in payments if cutoff <= payment.payment_date <= as_of
    )


def typical_payments_per_year(payments: Sequence[DividendPayment]) -> int:
    if not payments:
        raise MarketDataError("cannot infer payment frequency without dividend payments")
    annual_counts = Counter(payment.payment_date.year for payment in payments)
    inferred = int(round(median(annual_counts.values())))
    if inferred <= 0:
        raise MarketDataError("could not infer a positive dividend payment frequency")
    return inferred


def bootstrap_annual_income(
    amounts: np.ndarray,
    *,
    payments_per_year: int,
    trials: int,
    rng: np.random.Generator,
) -> np.ndarray:
    values = np.asarray(amounts, dtype=float)
    if values.ndim != 1 or values.size == 0:
        raise MarketDataError("dividend bootstrap requires at least one payment")
    if not np.isfinite(values).all() or (values <= 0).any():
        raise MarketDataError("dividend bootstrap received invalid payment amounts")
    if payments_per_year <= 0 or trials <= 0:
        raise MarketDataError("dividend bootstrap requires positive frequency and trials")
    if trials * payments_per_year > MAX_SIMULATION_CELLS:
        raise MarketDataError("dividend payment frequency and trials request too much work")

    samples = np.empty(trials, dtype=float)
    for start in range(0, trials, SIMULATION_BATCH_SIZE):
        stop = min(start + SIMULATION_BATCH_SIZE, trials)
        indices = rng.integers(0, values.size, size=(stop - start, payments_per_year))
        samples[start:stop] = values[indices].sum(axis=1)
    if not np.isfinite(samples).all():
        raise MarketDataError("simulated dividend income exceeded numeric limits")
    return samples


def income_percentiles(samples: np.ndarray) -> dict[str, float]:
    values = np.asarray(samples, dtype=float)
    if values.ndim != 1 or values.size == 0 or not np.isfinite(values).all():
        raise MarketDataError("cannot summarize an empty or invalid simulation")
    calculated = np.percentile(values, [value for _, value in PERCENTILES])
    return {
        label: float(result)
        for (label, _), result in zip(PERCENTILES, calculated, strict=True)
    }


def simulate(settings: Settings, *, as_of: date) -> tuple[list[HoldingSimulation], np.ndarray]:
    rng = np.random.default_rng(settings.seed)
    simulations: list[HoldingSimulation] = []
    portfolio_samples = np.zeros(settings.trials, dtype=float)
    for holding in settings.holdings:
        history = fetch_dividend_history(holding.symbol)
        if history.symbol != holding.symbol:
            raise MarketDataError(
                f"finance provider returned dividend history for the wrong symbol: {holding.symbol}"
            )
        payments = trailing_payments(
            history.payments, years=settings.history_years, as_of=as_of
        )
        if not payments:
            raise MarketDataError(
                f"no dividend payments found for {holding.symbol} in the trailing "
                f"{settings.history_years} years"
            )
        payments_per_year = typical_payments_per_year(payments)
        per_share = bootstrap_annual_income(
            np.asarray([payment.amount for payment in payments], dtype=float),
            payments_per_year=payments_per_year,
            trials=settings.trials,
            rng=rng,
        )
        scaled = per_share * holding.shares
        if not np.isfinite(scaled).all():
            raise MarketDataError(f"simulated dividend income exceeded limits for {holding.symbol}")
        portfolio_samples += scaled
        simulations.append(
            HoldingSimulation(
                holding=holding,
                payments_per_year=payments_per_year,
                per_share_samples=per_share,
                scaled_samples=scaled,
            )
        )
    return simulations, portfolio_samples


def build_summary_rows(
    simulations: Sequence[HoldingSimulation], portfolio_samples: np.ndarray
) -> list[SummaryRow]:
    rows: list[SummaryRow] = []
    for simulation in simulations:
        per_share = income_percentiles(simulation.per_share_samples)
        scaled = income_percentiles(simulation.scaled_samples)
        for label, _ in PERCENTILES:
            rows.append(
                SummaryRow(
                    scope="holding",
                    symbol=simulation.holding.symbol,
                    payments_per_year=simulation.payments_per_year,
                    percentile=label,
                    annual_income_per_share=per_share[label],
                    annual_income_scaled=scaled[label],
                )
            )
    portfolio = income_percentiles(portfolio_samples)
    for label, _ in PERCENTILES:
        rows.append(
            SummaryRow(
                scope="portfolio",
                symbol="PORTFOLIO",
                payments_per_year=None,
                percentile=label,
                annual_income_per_share=None,
                annual_income_scaled=portfolio[label],
            )
        )
    return rows


def preflight_results_path(path: Path, *, overwrite: bool) -> None:
    reject_symbolic_link_components(path, label="results CSV")
    if path_aliases_source_tree(path, SOURCE_DIR):
        raise UnsafePathError(f"results CSV must live outside the public source directory: {path}")
    existing = inspect_regular_file(path, label="results CSV")
    if existing is not None and not overwrite:
        raise UnsafePathError(f"results CSV already exists; use --overwrite to replace it: {path}")


def _format_number(value: float | None) -> str:
    return "" if value is None else format(value, ".12g")


def install_results_no_replace(source: Path, target: Path) -> None:
    """Atomically install a staged result only while the target name is unclaimed."""
    os.link(source, target, follow_symlinks=False)


def write_results_csv(path: Path, rows: Sequence[SummaryRow], *, overwrite: bool) -> None:
    secure_private_directory(path.parent)
    preflight_results_path(path, overwrite=overwrite)
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
        suffix=".tmp",
        text=True,
    )
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
            os.fchmod(handle.fileno(), 0o600)
            writer = csv.DictWriter(
                handle,
                fieldnames=(
                    "scope",
                    "symbol",
                    "payments_per_year",
                    "percentile",
                    "annual_income_per_share",
                    "annual_income_scaled",
                ),
            )
            writer.writeheader()
            for row in rows:
                writer.writerow(
                    {
                        "scope": row.scope,
                        "symbol": row.symbol,
                        "payments_per_year": (
                            "" if row.payments_per_year is None else row.payments_per_year
                        ),
                        "percentile": row.percentile,
                        "annual_income_per_share": _format_number(
                            row.annual_income_per_share
                        ),
                        "annual_income_scaled": _format_number(row.annual_income_scaled),
                    }
                )
            handle.flush()
            os.fsync(handle.fileno())
        # Recheck for diagnostics, then let the no-replace link enforce exclusivity.
        preflight_results_path(path, overwrite=overwrite)
        if overwrite:
            os.replace(temporary_path, path)
        else:
            install_results_no_replace(temporary_path, path)
        fsync_directory(path.parent)
    finally:
        temporary_path.unlink(missing_ok=True)


def print_summary(rows: Sequence[SummaryRow]) -> None:
    print("Annual dividend income Monte Carlo")
    current_symbol: str | None = None
    for row in rows:
        if row.symbol != current_symbol:
            current_symbol = row.symbol
            if row.scope == "portfolio":
                print("\nPortfolio aggregate")
            else:
                print(f"\n{row.symbol} ({row.payments_per_year} payments/year)")
        if row.scope == "portfolio":
            print(f"  {row.percentile}: scaled={_format_number(row.annual_income_scaled)}")
        else:
            print(
                f"  {row.percentile}: per-share={_format_number(row.annual_income_per_share)} "
                f"scaled={_format_number(row.annual_income_scaled)}"
            )


def _record_error(message: str) -> None:
    global LAST_ERROR_FOR_TESTS
    LAST_ERROR_FOR_TESTS = message


def main(argv: list[str] | None = None) -> int:
    global LAST_ERROR_FOR_TESTS
    LAST_ERROR_FOR_TESTS = ""
    args = parse_args(argv)
    config_path = resolve_config_path(args.config)

    if path_aliases_source_tree(config_path, SOURCE_DIR):
        message = f"private config must live outside the public source directory: {config_path}"
        _record_error(message)
        print(f"CONFIGURATION ERROR: {message}", file=sys.stderr)
        return 2

    try:
        secure_private_directory(config_path.parent)
        existing = inspect_regular_file(config_path, label="config")
        if existing is None:
            write_incomplete_skeleton(config_path)
            message = (
                f"CONFIGURATION REQUIRED: edit the private skeleton at {config_path}; "
                "replace every blank or zero value, then run again. No finance service was contacted."
            )
            _record_error(message)
            print(message, file=sys.stderr)
            return 2
        payload = read_private_json(config_path)
        settings = validate_config(payload, config_path)
    except ConfigurationError as exc:
        message = "\n".join(exc.problems)
        _record_error(message)
        print("CONFIGURATION ERROR:", file=sys.stderr)
        for problem in exc.problems:
            print(f"  - {problem}", file=sys.stderr)
        return 2
    except (OSError, UnsafePathError) as exc:
        message = str(exc)
        _record_error(message)
        print(f"RUNTIME ERROR: {message}", file=sys.stderr)
        return 1

    try:
        if settings.results_csv is not None:
            preflight_results_path(settings.results_csv, overwrite=args.overwrite)
        simulations, portfolio_samples = simulate(settings, as_of=current_date())
        rows = build_summary_rows(simulations, portfolio_samples)
        print_summary(rows)
        if settings.results_csv is not None:
            write_results_csv(settings.results_csv, rows, overwrite=args.overwrite)
            print(f"\nResults written atomically to {settings.results_csv}")
        return 0
    except (MarketDataError, OSError, UnsafePathError) as exc:
        message = str(exc)
        _record_error(message)
        print(f"RUNTIME ERROR: {message}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
