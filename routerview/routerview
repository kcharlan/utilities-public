# === ASYNC DB HELPERS ===
async def get_db() -> aiosqlite.Connection:
    database_path = Path(_db_path)
    prepare_private_file(database_path, "SQLite database")
    db = await aiosqlite.connect(_db_path)
    db.row_factory = aiosqlite.Row
    await db.execute("PRAGMA journal_mode=WAL")
    await db.execute("PRAGMA busy_timeout=5000")
    await db.execute("PRAGMA synchronous=NORMAL")
    await db.execute("PRAGMA cache_size=-8000")
    secure_sqlite_files(database_path)
    return db


async def db_dependency():
    db = await get_db()
    try:
        yield db
    finally:
        await db.close()


async def log_ingestion(db, source: str, inserted: int, skipped: int,
                        error: str = None, metadata: dict = None):
    now = datetime.now(timezone.utc).isoformat()
    await db.execute(
        """INSERT INTO ingestion_log
           (source, started_at, completed_at, records_inserted, records_skipped, error_message, metadata)
           VALUES (?, ?, ?, ?, ?, ?, ?)""",
        (source, now, now, inserted, skipped, error,
         json.dumps(metadata) if metadata else None)
    )
    await db.commit()


