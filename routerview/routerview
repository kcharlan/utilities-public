# === MAIN ===
def find_open_port(preferred: int, max_attempts: int = 20) -> int:
    for port in range(preferred, preferred + max_attempts):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.bind(("", port))
            s.close()
            return port
        except OSError:
            continue
    raise RuntimeError(f"No open port found in range {preferred}-{preferred + max_attempts - 1}")


def testing_mode_enabled() -> bool:
    value = os.environ.get("UTILITIES_TESTING", "")
    return value.lower() not in {"", "0", "false", "no"}


def announce_resolved_port(preferred: int, resolved: int) -> None:
    if resolved != preferred:
        print(f"Port {preferred} is in use; using port {resolved} instead.")


def open_browser_when_ready(url: str, timeout_seconds: float = 15.0) -> None:
    deadline = time.monotonic() + timeout_seconds
    health_url = f"{url}/api/health"

    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(health_url, timeout=1.0) as response:
                status = getattr(response, "status", response.getcode())
                if status == 200:
                    break
        except (urllib.error.URLError, TimeoutError, OSError):
            pass
        time.sleep(0.2)

    import webbrowser
    webbrowser.open(url)


def main():
    global _db_path, _debug_mode
    args = parse_args()
    _db_path = args.db
    _debug_mode = args.debug

    secure_runtime_tree(RUNTIME_PATHS.home)

    init_database(args.db)

    port = find_open_port(args.port)
    announce_resolved_port(args.port, port)
    write_private_text(RUNTIME_PATHS.port_file, str(port))

    url = f"http://{args.host}:{port}"
    print(f"RouterView running at {url}")

    if not testing_mode_enabled():
        threading.Thread(target=open_browser_when_ready, args=(url,), daemon=True).start()

    def _cleanup(signum=None, frame=None):
        if signum == signal.SIGINT:
            raise KeyboardInterrupt

    signal.signal(signal.SIGINT, _cleanup)
    signal.signal(signal.SIGTERM, _cleanup)

    try:
        uvicorn.run(app, host=args.host, port=port,
                    log_level="debug" if args.debug else "warning")
    finally:
        _cleanup()


if __name__ == "__main__":
    main()
