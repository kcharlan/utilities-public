const LAT_CYCLES  = ['avg','p50','p95','min','max'];
function KPICard({title,value,subValue,delta,deltaLabel,positive,children}) {
  const deltaColor = delta==null?'text-slate-500':positive===false?'text-red-400':'text-green-400';
  return <div className="bg-slate-800 rounded-xl p-4 flex flex-col gap-1 min-w-0">
    <p className="text-xs text-slate-400 truncate">{title}</p>
    <p className="text-2xl font-bold text-slate-100 truncate">{value}</p>
    {subValue&&<p className="text-xs text-slate-500">{subValue}</p>}
    {delta!=null&&<p className={`text-xs ${deltaColor}`}>{delta>0?'+':''}{(delta*100).toFixed(1)}% {deltaLabel}</p>}
    {children}
  </div>;
}
function KPICards({summary,costCycle,setCostCycle,latCycle,setLatCycle}) {
  if(!summary) return <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    {Array(6).fill(0).map((_,i)=><SkeletonCard key={i}/>)}</div>;
  const s = summary;
  const comp = s.comparison;
  const compLabel = s.compare_mode ? ({dow:'DoD',wow:'WoW',mom_date:'MoM',mom_relative:'MoM',qoq:'QoQ',yoy_date:'YoY',yoy_relative:'YoY',prior_period:'vs prior'}[s.compare_mode]||'vs prior') : null;
  const delta = (cur,prev) => (prev&&prev>0)?(cur-prev)/prev:null;

  const costKey = {avg:'avg_cost_per_request',p50:'p50_cost_per_request',p95:'p95_cost_per_request',min:'min_cost_per_request',max:'max_cost_per_request'}[costCycle]||'avg_cost_per_request';
  const latKey  = {avg:'avg_latency_ms',p50:'p50_latency_ms',p95:'p95_latency_ms',min:'min_latency_ms',max:'max_latency_ms'}[latCycle]||'avg_latency_ms';

  return <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    <KPICard title="Total Requests" value={fmtNum(s.request_count)}
      delta={comp?delta(s.request_count,comp.request_count):null} deltaLabel={compLabel} positive={true}/>
    <KPICard title="Total Cost" value={fmt$(s.total_cost)}
      subValue={s.projected_cost?`~${fmt$(s.projected_cost)} projected`:null}
      delta={comp?delta(s.total_cost,comp.total_cost):null} deltaLabel={compLabel} positive={false}/>
    <KPICard title={`Cost/Req (${costCycle.toUpperCase()})`} value={fmt$4(s[costKey])}
      delta={comp?delta(s[costKey],comp[costKey]):null} deltaLabel={compLabel} positive={false}>
      <button onClick={()=>setCostCycle(c=>COST_CYCLES[(COST_CYCLES.indexOf(c)+1)%COST_CYCLES.length])}
        className="text-xs text-blue-400 hover:text-blue-300 self-start">cycle →</button>
    </KPICard>
    <KPICard title={`Latency (${latCycle.toUpperCase()})`} value={fmtMs(s[latKey])}
      delta={comp?delta(s[latKey],comp[latKey]):null} deltaLabel={compLabel} positive={false}>
      <button onClick={()=>setLatCycle(c=>LAT_CYCLES[(LAT_CYCLES.indexOf(c)+1)%LAT_CYCLES.length])}
        className="text-xs text-blue-400 hover:text-blue-300 self-start">cycle →</button>
    </KPICard>
    <KPICard title="Cache Hit Rate" value={fmtPct(s.cache_hit_rate)}
      delta={comp?delta(s.cache_hit_rate,comp.cache_hit_rate):null} deltaLabel={compLabel} positive={true}/>
    <KPICard title="Total Tokens" value={fmtNum(s.total_tokens)}
      delta={comp?delta(s.total_tokens,comp.total_tokens):null} deltaLabel={compLabel} positive={true}/>
  </div>;
}

// ── Custom Tooltip ────────────────────────────────────────────────────────────
function sumTooltipValues(items) {
  return items.reduce((sum, item) => sum + (Number(item?.value) || 0), 0);
}

function sortTooltipItems(items, metric) {
  if(metric!=='cost') return items;
  return [...items].sort((a,b)=>(Number(b?.value)||0)-(Number(a?.value)||0));
}

function ChartTooltip({active,payload,label,metric,compareRange}) {
  if(!active||!payload?.length) return null;
  const fmt = v=>metric==='cost'?fmt$(v,4):metric==='latency'?fmtMs(v):fmtNum(v);
  const primary = payload.filter(p=>!String(p.dataKey).startsWith('_c_'));
  const comp = payload.filter(p=>String(p.dataKey).startsWith('_c_'));
  const orderedPrimary = sortTooltipItems(primary, metric);
  const orderedComp = sortTooltipItems(comp, metric);
  const showTotals = metric!=='latency';
  const primaryTotal = sumTooltipValues(primary);
  const compTotal = sumTooltipValues(comp);
  return <div className="bg-slate-800 border border-slate-600 rounded-lg p-3 shadow-xl text-xs max-w-xs">
    <p className="text-slate-400 mb-2">{label}</p>
    {orderedPrimary.map((p,i)=><div key={i} className="flex justify-between gap-4">
      <span className="flex items-center gap-1"><span style={{width:8,height:8,borderRadius:'50%',background:p.color,display:'inline-block'}}/>{p.name}</span>
      <span className="font-mono text-slate-200">{fmt(p.value)}</span>
    </div>)}
    {showTotals&&primary.length>1&&<div className="flex justify-between gap-4 mt-2 pt-2 border-t border-slate-700">
      <span className="font-medium text-slate-300">Total</span>
      <span className="font-mono text-slate-100">{fmt(primaryTotal)}</span>
    </div>}
    {comp.length>0&&<>
      <p className="text-slate-500 mt-2 mb-1 border-t border-slate-700 pt-1">{compareRange||'Comparison'}</p>
      {orderedComp.map((p,i)=><div key={i} className="flex justify-between gap-4 opacity-60">
        <span className="flex items-center gap-1"><span style={{width:8,height:8,borderRadius:'50%',background:p.color,display:'inline-block'}}/>{p.name.replace(/^_c_/,'')}</span>
        <span className="font-mono text-slate-200">{fmt(p.value)}</span>
      </div>)}
      {showTotals&&comp.length>1&&<div className="flex justify-between gap-4 mt-2 pt-2 border-t border-slate-700 opacity-80">
        <span className="font-medium text-slate-300">Total</span>
        <span className="font-mono text-slate-100">{fmt(compTotal)}</span>
      </div>}
    </>}
  </div>;
}

// ── Main Chart ────────────────────────────────────────────────────────────────
function MainChart({data,chartType='area',metric='cost',groupBy='model',comparison,onExport}) {
  const ref=useRef();
  const [hidden,setHidden]=useState(new Set());
  const [hoverIdx,setHoverIdx]=useState(null);
  const [cumulative,setCumulative]=useState(false);

  // Shared Y domain across both charts so scale differences are honest
  const yDomain = useMemo(()=>{
    if(!data?.series?.length) return undefined;
    const isCum_ = metric!=='latency' && cumulative;
    // For stacked (non-cumulative): max is sum of all series at each bucket
    // For cumulative (unstacked): max is the largest individual series running total
    const maxOfData = (seriesList, nBuckets) => {
      let maxVal=0;
      if(isCum_) {
        for(const s of seriesList) {
          let run=0;
          for(let i=0;i<nBuckets;i++){ run+=(s.data[i]||0); if(run>maxVal) maxVal=run; }
        }
      } else {
        for(let i=0;i<nBuckets;i++){
          let sum=0;
          for(const s of seriesList) sum+=(s.data[i]||0);
          if(sum>maxVal) maxVal=sum;
        }
      }
      return maxVal;
    };
    let maxVal = maxOfData(data.series, data.buckets?.length||0);
    if(data?.comparison_series?.length){
      const compLen = (data.comparison_buckets||data.buckets).length;
      const compMax = maxOfData(data.comparison_series, compLen);
      if(compMax>maxVal) maxVal=compMax;
    }
    return maxVal>0 ? [0, Math.ceil(maxVal*1.05*100)/100] : undefined;
  },[data?.series,data?.comparison_series,data?.buckets,data?.comparison_buckets,cumulative,metric]);

  if(!data||!data.series) return <div className="bg-slate-800 rounded-xl p-4 h-96 flex items-center justify-center"><Spinner/></div>;
  if(!data.buckets?.length) return <div className="bg-slate-800 rounded-xl p-4"><EmptyState/></div>;

  const hasComp = !!(data.comparison_series?.length);
  const canCumulative = metric!=='latency';
  const isCum = canCumulative && cumulative;

  // Build chart data, optionally cumulative
  const buildChartData = (buckets, seriesList) => {
    const accum = {};
    return buckets.map((b,i)=>{
      const pt={bucket:b};
      seriesList.forEach(s=>{
        const val = s.data[i]??0;
        if(isCum){
          accum[s.name] = (accum[s.name]||0) + val;
          pt[s.name] = accum[s.name];
        } else {
          pt[s.name] = val;
        }
      });
      return pt;
    });
  };

  const primaryData = buildChartData(data.buckets, data.series);
  const compBuckets = data.comparison_buckets||data.buckets;
  const compData = hasComp ? buildChartData(compBuckets, data.comparison_series) : null;

  const yFmt = v=>metric==='cost'?fmt$(v,2):metric==='latency'?fmtMs(v):fmtNum(v);
  const bucketSize = data.bucket_size||'day';
  const xFmt = v=>{
    if(!v) return '';
    if(bucketSize==='minute') return v.slice(11,16);
    if(bucketSize==='hour') return v.slice(11,16)||v;
    if(bucketSize==='day') return v.slice(5,10);
    if(bucketSize==='week') return v;
    if(bucketSize==='month') return v;
    return v;
  };
  const commonAxisProps={stroke:'#475569',fontSize:11,tick:{fill:'#94a3b8'}};
  const gridProps={strokeDasharray:'3 3',stroke:'#334155'};
  const handleLegend = e => setHidden(prev=>{const n=new Set(prev);n.has(e.value)?n.delete(e.value):n.add(e.value);return n;});

  const ChartEl = chartType==='line'?LineChart:chartType==='bar'?BarChart:AreaChart;
  const SeriesEl = chartType==='line'?Line:chartType==='bar'?Bar:Area;
  const stackId = isCum?undefined:(chartType==='area'||chartType==='bar'?'1':undefined);

  // Linked crosshair: store fractional position (0-1) so charts with different bucket counts sync proportionally
  const handleMouseMove = (state, len) => {
    if(state?.activeTooltipIndex!=null && len>1) setHoverIdx(state.activeTooltipIndex/(len-1));
    else if(state?.activeTooltipIndex!=null) setHoverIdx(0);
  };
  const handleMouseLeave = () => setHoverIdx(null);

  const refLineIdx = (chartData) => {
    if(hoverIdx==null||!chartData.length) return null;
    return Math.round(hoverIdx*(chartData.length-1));
  };

  const metricLabel = metric==='cost'?'Cost':metric==='requests'?'Requests':metric==='tokens'?'Tokens':'Latency';

  const renderChart = (chartData, label, height) => (
    <div>
      {hasComp && <p className="text-xs text-slate-500 mb-1 ml-1">{label}</p>}
      <ResponsiveContainer width="100%" height={height}>
        <ChartEl data={chartData} onMouseMove={s=>handleMouseMove(s,chartData.length)} onMouseLeave={handleMouseLeave}>
          <CartesianGrid {...gridProps}/>
          <XAxis dataKey="bucket" {...commonAxisProps} tickFormatter={xFmt}/>
          <YAxis {...commonAxisProps} tickFormatter={yFmt} width={70} {...(yDomain?{domain:yDomain}:{})}/>
          <Tooltip content={<ChartTooltip metric={metric}/>} wrapperStyle={{outline:'none'}}/>
          {!hasComp && <Legend onClick={handleLegend} wrapperStyle={{paddingTop:8,fontSize:11,color:'#94a3b8'}}/>}
          {data.series.map((s)=>{
            const col=modelColor(s.name);
            const hiddenS=hidden.has(s.name);
            return <SeriesEl key={s.name} type="monotone" dataKey={s.name}
              stroke={col} fill={col}
              fillOpacity={hiddenS?0:0.5} strokeOpacity={hiddenS?0:1}
              stackId={stackId} dot={false}/>;
          })}
          {(()=>{const ri=refLineIdx(chartData);return ri!=null&&<ReferenceLine x={chartData[ri]?.bucket} stroke="#94a3b8" strokeDasharray="3 3" strokeOpacity={0.5}/>;})()}
        </ChartEl>
      </ResponsiveContainer>
    </div>
  );

  const renderCompChart = (chartData, label, height) => (
    <div>
      <p className="text-xs text-slate-500 mb-1 ml-1">{label}</p>
      <ResponsiveContainer width="100%" height={height}>
        <ChartEl data={chartData} onMouseMove={s=>handleMouseMove(s,chartData.length)} onMouseLeave={handleMouseLeave}>
          <CartesianGrid {...gridProps}/>
          <XAxis dataKey="bucket" {...commonAxisProps} tickFormatter={xFmt}/>
          <YAxis {...commonAxisProps} tickFormatter={yFmt} width={70} {...(yDomain?{domain:yDomain}:{})}/>
          <Tooltip content={<ChartTooltip metric={metric}/>} wrapperStyle={{outline:'none'}}/>
          {data.comparison_series.map((s)=>{
            const col=modelColor(s.name);
            const hiddenS=hidden.has(s.name);
            return <SeriesEl key={s.name} type="monotone" dataKey={s.name}
              stroke={col} fill={col}
              fillOpacity={hiddenS?0:0.4} strokeOpacity={hiddenS?0:0.8}
              strokeDasharray="5 3"
              stackId={stackId} dot={false}/>;
          })}
          {(()=>{const ri=refLineIdx(chartData);return ri!=null&&<ReferenceLine x={chartData[ri]?.bucket} stroke="#94a3b8" strokeDasharray="3 3" strokeOpacity={0.5}/>;})()}
        </ChartEl>
      </ResponsiveContainer>
    </div>
  );

  return <div className="bg-slate-800 rounded-xl p-4">
    <div className="flex items-center justify-between mb-3">
      <h2 className="text-sm font-medium text-slate-300">
        {metricLabel} over Time{isCum?' (Cumulative)':''}
        {groupBy!=='none'&&<span className="text-slate-500 font-normal ml-1">by {groupBy}</span>}
      </h2>
      <div className="flex items-center gap-2">
        {canCumulative&&<button onClick={()=>setCumulative(c=>!c)}
          className={`text-xs px-2 py-1 rounded ${cumulative?'bg-blue-600 text-white':'bg-slate-700 text-slate-400 hover:text-slate-300'}`}
          title="Toggle cumulative view">Σ Cumulative</button>}
        <ExportMenu chartRef={ref} onCSV={onExport} name="timeseries"/>
      </div>
    </div>
    <div ref={ref}>
      {hasComp ? <>
        {renderChart(primaryData, 'Current Period', 240)}
        <div className="my-2"/>
        {renderCompChart(compData, data.compare_range||'Prior Period', 200)}
        <div className="flex flex-wrap justify-center gap-3 mt-2 text-xs">
          {data.series.map(s=>{
            const col=modelColor(s.name);
            const dim=hidden.has(s.name);
            return <button key={s.name} className="flex items-center gap-1" style={{opacity:dim?0.3:1}}
              onClick={()=>setHidden(prev=>{const n=new Set(prev);n.has(s.name)?n.delete(s.name):n.add(s.name);return n;})}>
              <span style={{width:8,height:8,borderRadius:'50%',background:col,display:'inline-block'}}/><span className="text-slate-400">{s.name}</span>
            </button>;
          })}
        </div>
      </> : renderChart(primaryData, '', 380)}
    </div>
  </div>;
}

// ── Heatmap ───────────────────────────────────────────────────────────────────
function HeatmapView({data}) {
  if(!data) return <div className="bg-slate-800 rounded-xl p-4 h-64 animate-pulse"/>;
  const matrix = data.matrix||[];
  const allVals = matrix.flat().filter(v=>v!=null);
  const maxVal = allVals.length?Math.max(...allVals):1;
  const DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const HOURS=Array.from({length:24},(_,i)=>i);
  return <div className="bg-slate-800 rounded-xl p-4 overflow-x-auto">
    <h2 className="text-sm font-medium text-slate-300 mb-3">Usage Heatmap</h2>
    <div className="flex gap-1">
      <div className="flex flex-col gap-1 pt-5">
        {DAYS.map(d=><div key={d} className="h-6 w-8 text-xs text-slate-500 flex items-center">{d}</div>)}
      </div>
      <div>
        <div className="flex gap-1 mb-1">
          {HOURS.map(h=><div key={h} className="w-6 text-center text-slate-600" style={{fontSize:9}}>{h%6===0?h:''}</div>)}
        </div>
        {DAYS.map((d,di)=><div key={di} className="flex gap-1 mb-1">
          {HOURS.map(h=>{
            const v=matrix[di]?.[h];
            const intensity=v!=null?v/maxVal:0;
            return <div key={h} title={`${d} ${h}:00 — ${v!=null?v.toFixed(4):'no data'}`}
              className="w-6 h-6 rounded-sm cursor-default"
              style={{background:v!=null?`rgba(59,130,246,${0.1+intensity*0.9})`:'#1e293b'}}/>;
          })}
        </div>)}
      </div>
    </div>
  </div>;
}

// ── Breakdown Panel ───────────────────────────────────────────────────────────
function BreakdownPanel({title,data,type='bar',metric='cost',onFilter,chartRef,panelKey,dragProps,exportQS=''}) {
  if(!data) return <div className="bg-slate-800 rounded-xl p-4 h-64 animate-pulse"/>;
  const items = data.data||[];
  if(!items.length) return <div className="bg-slate-800 rounded-xl p-4"><h3 className="text-sm text-slate-400 mb-3">{title}</h3><EmptyState/></div>;
  const fmtVal = v=>metric==='cost'?fmt$(v,2):metric==='latency'?fmtMs(v):fmtNum(v);
  const BDTooltip = ({active,payload,label})=>{
    if(!active||!payload?.length) return null;
    const d=payload[0]?.payload;
    return <div className="bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 shadow-xl text-xs">
      <p className="text-slate-300 font-medium mb-1">{d?.dimension||label}</p>
      <p className="text-slate-400">{fmtVal(payload[0]?.value)}</p>
    </div>;
  };
  const tooltipProps={content:<BDTooltip/>,wrapperStyle:{outline:'none'}};

  return <div className="bg-slate-800 rounded-xl p-4" {...dragProps}>
    <div className="flex items-center justify-between mb-3">
      <div className="flex items-center gap-2">
        {dragProps&&<LI.GripVertical size={14} className="text-slate-600 cursor-grab"/>}
        <h3 className="text-sm font-medium text-slate-300">{title}</h3>
      </div>
      <ExportMenu chartRef={chartRef} name={panelKey} onCSV={()=>window.open(`/api/export/csv?view=breakdown&group_by=${panelKey}&metric=${metric}&${exportQS}`)}/>
    </div>
    <div ref={chartRef}>
      {type==='pie'
        ? (()=>{
            // Roll up small slices into "Other" when there are many items
            const MAX_SLICES = 7;
            let pieItems = items;
            if(items.length > MAX_SLICES) {
              const sorted = [...items].sort((a,b)=>b.value-a.value);
              const top = sorted.slice(0,MAX_SLICES-1);
              const rest = sorted.slice(MAX_SLICES-1);
              const otherVal = rest.reduce((s,r)=>s+r.value,0);
              pieItems = [...top, {dimension:`Other (${rest.length})`, value:otherVal}];
            }
            const legendRows = Math.ceil(pieItems.length/3);
            const pieH = 200 + legendRows * 22;
            return <ResponsiveContainer width="100%" height={pieH}>
              <PieChart>
                <Pie data={pieItems} dataKey="value" nameKey="dimension" cx="50%" cy="45%" innerRadius={50} outerRadius={85}
                  onClick={e=>onFilter&&e.dimension&&!e.dimension.startsWith('Other')&&onFilter(e.dimension)}>
                  {pieItems.map((_,i)=><Cell key={i} fill={COLORS[i%COLORS.length]}/>)}
                </Pie>
                <Tooltip {...tooltipProps}/>
                <Legend wrapperStyle={{fontSize:11,color:'#94a3b8'}}/>
              </PieChart>
            </ResponsiveContainer>;
          })()
        : (()=>{
            const barItems = items.slice(0,10);
            const barH = Math.max(220, barItems.length * 28 + 40);
            return <ResponsiveContainer width="100%" height={barH}>
              <BarChart layout="vertical" data={barItems} onClick={e=>onFilter&&e&&onFilter(e.activePayload?.[0]?.payload?.dimension)}>
                <XAxis type="number" stroke="#475569" fontSize={11} tickFormatter={fmtVal}/>
                <YAxis type="category" dataKey="dimension" stroke="#475569" fontSize={10} width={130}
                  tick={({x,y,payload})=>{
                    const t=payload.value||'';
                    const label=t.length>20?t.slice(0,18)+'…':t;
                    return <g transform={`translate(${x},${y})`}><title>{t}</title><text x={-4} y={0} dy={4} textAnchor="end" fill="#94a3b8" fontSize={10}>{label}</text></g>;
                  }}/>
                <Tooltip {...tooltipProps}/>
                <Bar dataKey="value" radius={[0,4,4,0]}>
                  {barItems.map((entry,i)=><Cell key={i} fill={modelColor(entry.dimension)}/>)}
                </Bar>
              </BarChart>
            </ResponsiveContainer>;
          })()
      }
    </div>
  </div>;
}

// ── Log Viewer ────────────────────────────────────────────────────────────────
const ALL_COLS=[
  {key:'created_at',label:'Time',fmt:fmtDate},
  {key:'model_short',label:'Model'},
  {key:'provider_name',label:'Provider'},
  {key:'tokens_total',label:'Tokens',fmt:fmtNum,align:'right'},
  {key:'native_tokens_cached',label:'Cached',fmt:fmtNum,align:'right'},
  {key:'native_tokens_reasoning',label:'Reasoning',fmt:fmtNum,align:'right'},
  {key:'cost_usd',label:'Cost',fmt:fmt$4,align:'right'},
  {key:'generation_time_ms',label:'Latency',fmt:fmtMs,align:'right'},
  {key:'streamed',label:'Stream',fmt:v=>v?'✓':'-',align:'center'},
  {key:'finish_reason',label:'Finish'},
  {key:'origin',label:'Origin'},
  {key:'api_key_label',label:'API Key'},
];
const DEFAULT_COLS=['created_at','model_short','provider_name','tokens_total','cost_usd','generation_time_ms','finish_reason'];

function LogViewer({logData,logSort,setLogSort,logSearch,setLogSearch,logPage,setLogPage,logPageSize,setLogPageSize,visibleCols,setVisibleCols,expandedRow,setExpandedRow,onExportCSV}) {
  const [colOpen,setColOpen]=useState(false);
  const searchTimeout=useRef(null);
  const [localSearch,setLocalSearch]=useState(logSearch);
  const data = logData?.data||[];

  const handleSearch=v=>{setLocalSearch(v); clearTimeout(searchTimeout.current); searchTimeout.current=setTimeout(()=>setLogSearch(v),300);};
  const handleSort=col=>{
    if(logSort.col===col) setLogSort(s=>({...s,dir:s.dir==='desc'?'asc':'desc'}));
    else setLogSort({col,dir:'desc'});
  };
  const SortIcon=({col})=>{
    if(logSort.col!==col) return <LI.ChevronsUpDown size={10} className="text-slate-600 ml-0.5"/>;
    return logSort.dir==='desc'?<LI.ChevronDown size={10} className="text-blue-400 ml-0.5"/>:<LI.ChevronUp size={10} className="text-blue-400 ml-0.5"/>;
  };
  const cols=ALL_COLS.filter(c=>visibleCols.includes(c.key));
  const total=logData?.total||0;
  const pages=logData?.pages||1;

  return <div className="bg-slate-800 rounded-xl p-4">
    <div className="flex items-center gap-3 mb-3 flex-wrap">
      <h2 className="text-sm font-medium text-slate-300">Recent Generations</h2>
      <div className="flex items-center gap-1 bg-slate-700 rounded px-2 flex-1 min-w-32 max-w-56">
        <LI.Search size={12} className="text-slate-500"/>
        <input id="log-search" type="text" value={localSearch} onChange={e=>handleSearch(e.target.value)}
          placeholder="Search..." className="bg-transparent text-xs text-slate-200 outline-none py-1 w-full placeholder-slate-600"/>
      </div>
      <div className="relative">
        <button onClick={()=>setColOpen(!colOpen)} className="flex items-center gap-1 px-2 py-1 text-xs text-slate-400 border border-slate-700 rounded hover:border-slate-500">
          <LI.Columns size={12}/> Cols
        </button>
        {colOpen&&<div className="absolute top-full mt-1 right-0 bg-slate-800 border border-slate-700 rounded-lg shadow-xl z-40 w-40 py-2">
          {ALL_COLS.map(c=><label key={c.key} className="flex items-center gap-2 px-3 py-1 text-xs text-slate-300 hover:bg-slate-700 cursor-pointer">
            <input type="checkbox" checked={visibleCols.includes(c.key)}
              onChange={()=>setVisibleCols(prev=>prev.includes(c.key)?prev.filter(k=>k!==c.key):[...prev,c.key])}
              className="accent-blue-500"/>
            {c.label}
          </label>)}
        </div>}
      </div>
      <button onClick={onExportCSV} className="flex items-center gap-1 px-2 py-1 text-xs text-slate-400 border border-slate-700 rounded hover:border-slate-500">
        <LI.Download size={12}/> CSV
      </button>
      <span className="text-xs text-slate-500 ml-auto">
        {total>0?`${(logPage-1)*logPageSize+1}–${Math.min(logPage*logPageSize,total)} of ${fmtNum(total)}`:'0 results'}
      </span>
    </div>

    <div className="overflow-x-auto">
      <table className="w-full text-xs">
        <thead>
          <tr className="border-b border-slate-700">
            {cols.map(c=><th key={c.key} className={`p-2 text-slate-400 font-medium cursor-pointer hover:text-slate-200 select-none ${c.align==='right'?'text-right':c.align==='center'?'text-center':'text-left'}`}
              onClick={()=>handleSort(c.key)}>
              <span className="flex items-center gap-0.5 whitespace-nowrap justify-start">{c.align==='right'&&<span className="flex-1"/>}{c.label}<SortIcon col={c.key}/></span>
            </th>)}
          </tr>
        </thead>
        <tbody>
          {data.length===0&&<tr><td colSpan={cols.length} className="p-4 text-center text-slate-500">No generations found</td></tr>}
          {data.map(row=><React.Fragment key={row.id}>
            <tr className={`border-b border-slate-700/50 hover:bg-slate-700/30 cursor-pointer transition-colors ${row.anomalies?.length?'border-l-2 border-l-amber-500':''} ${expandedRow===row.id?'bg-slate-700/40':''}`}
              onClick={()=>setExpandedRow(expandedRow===row.id?null:row.id)}>
              {cols.map(c=><td key={c.key} className={`p-2 text-slate-300 ${c.align==='right'?'text-right':c.align==='center'?'text-center':''} max-w-32 truncate`}>
                {c.fmt?c.fmt(row[c.key]):row[c.key]??'-'}
                {c.key==='model_short'&&row.anomalies?.length>0&&<span className="ml-1 text-amber-400" title={row.anomalies.join(', ')}>⚠</span>}
              </td>)}
            </tr>
            {expandedRow===row.id&&<tr>
              <td colSpan={cols.length} className="p-3 bg-slate-900/50">
                <div className="grid grid-cols-2 md:grid-cols-3 gap-2 text-xs mb-2">
                  {Object.entries(row).filter(([k])=>!['trace_metadata','anomalies'].includes(k)).map(([k,v])=><div key={k} className="flex gap-2">
                    <span className="text-slate-500 shrink-0">{k}:</span>
                    <span className="text-slate-300 break-all">{String(v??'-')}</span>
                  </div>)}
                </div>
                {row.trace_metadata&&<details className="mt-2">
                  <summary className="text-xs text-slate-500 cursor-pointer">trace_metadata</summary>
                  <pre className="mt-1 text-xs text-slate-400 bg-slate-900 rounded p-2 overflow-auto max-h-40">{JSON.stringify(JSON.parse(row.trace_metadata||'{}'),null,2)}</pre>
                </details>}
              </td>
            </tr>}
          </React.Fragment>)}
        </tbody>
      </table>
    </div>

    <div className="flex items-center justify-between mt-3 pt-3 border-t border-slate-700">
      <div className="flex items-center gap-2">
        <span className="text-xs text-slate-500">Per page:</span>
        {[25,50,100,250].map(n=><button key={n} onClick={()=>{setLogPageSize(n);setLogPage(1);}}
          className={`px-2 py-0.5 text-xs rounded ${logPageSize===n?'bg-blue-600 text-white':'text-slate-400 hover:text-slate-200'}`}>{n}</button>)}
      </div>
      <div className="flex items-center gap-1">
        <button onClick={()=>setLogPage(1)} disabled={logPage<=1}
          className="px-1.5 py-0.5 text-xs text-slate-400 hover:text-slate-200 disabled:opacity-30">First</button>
        <button onClick={()=>setLogPage(p=>Math.max(1,p-1))} disabled={logPage<=1}
          className="p-1 text-slate-400 hover:text-slate-200 disabled:opacity-30"><LI.ChevronLeft size={14}/></button>
        <input type="text" value={logPage} onChange={e=>{
          const v=parseInt(e.target.value,10);
          if(!isNaN(v)&&v>=1&&v<=pages) setLogPage(v);
          else if(e.target.value==='') setLogPage(1);
        }}
          onKeyDown={e=>{if(e.key==='Enter'){const v=parseInt(e.target.value,10);if(!isNaN(v))setLogPage(Math.max(1,Math.min(pages,v)));}}}
          className="w-10 text-center text-xs text-slate-300 bg-slate-700 rounded px-1 py-0.5 outline-none border border-slate-600 focus:border-blue-500"
        />
        <span className="text-xs text-slate-500">/ {pages}</span>
        <button onClick={()=>setLogPage(p=>Math.min(pages,p+1))} disabled={logPage>=pages}
          className="p-1 text-slate-400 hover:text-slate-200 disabled:opacity-30"><LI.ChevronRight size={14}/></button>
        <button onClick={()=>setLogPage(pages)} disabled={logPage>=pages}
          className="px-1.5 py-0.5 text-xs text-slate-400 hover:text-slate-200 disabled:opacity-30">Last</button>
      </div>
    </div>
  </div>;
}

// ── Settings Panel ────────────────────────────────────────────────────────────
function SettingsPanel({onClose,onImportComplete}) {
  const [health,setHealth]=useState(null);
  const [purgeDate,setPurgeDate]=useState('');
  const [importing,setImporting]=useState(false);
  const [importResult,setImportResult]=useState(null);
  const fileRef=useRef();

  useEffect(()=>{ fetch('/api/health').then(r=>r.json()).then(setHealth).catch(()=>{}); },[]);

  const purge=async()=>{
    if(!purgeDate||!confirm(`Delete all data before ${purgeDate}?`)) return;
    const r=await fetch(`/api/purge?before=${purgeDate}`,{method:'POST'}); const d=await r.json();
    alert(`Deleted ${d.deleted_generations} generations`);
    onImportComplete?.();
  };
  const importFile=async e=>{
    const file=e.target.files?.[0]; if(!file) return;
    setImporting(true); setImportResult(null);
    const fd=new FormData(); fd.append('file',file);
    try {
      const r=await fetch('/api/import/csv',{method:'POST',body:fd});
      const d=await r.json();
      setImportResult(d);
      if(d.status==='ok') onImportComplete?.();
    }
    catch(e){setImportResult({error:String(e)});}
    setImporting(false);
  };
  const refreshStats=async()=>{ await fetch('/api/admin/refresh-summaries',{method:'POST'}); alert('Summaries refreshed'); };
  const [rebuilding,setRebuilding]=useState(false);
  const rebuildTimestamps=async()=>{
    if(!confirm(`Rebuild created_at for every generation from its gen-ID epoch? The database will be backed up to ~/.routerview/backups/ first.`)) return;
    setRebuilding(true);
    try {
      const r=await fetch('/api/admin/rebuild-timestamps?confirm=true',{method:'POST'});
      const d=await r.json();
      if(d.error) alert('Error: '+d.error);
      else { alert(`Scanned ${d.scanned}, updated ${d.updated}. Backup: ${d.backup_path}`); onImportComplete?.(); }
    } catch(e){ alert('Error: '+String(e)); }
    setRebuilding(false);
  };

  return <div className="fixed inset-0 z-50 flex">
    <div className="flex-1 bg-black/60 backdrop-blur-sm" onClick={onClose}/>
    <div className="w-96 bg-slate-900 border-l border-slate-700 overflow-y-auto p-6 flex flex-col gap-6">
      <div className="flex items-center justify-between">
        <h2 className="text-lg font-semibold text-slate-100">Settings</h2>
        <button onClick={onClose} className="text-slate-400 hover:text-slate-200"><LI.X size={20}/></button>
      </div>

      {health&&<section className="flex flex-col gap-2">
        <h3 className="text-sm font-medium text-slate-300 border-b border-slate-700 pb-1">Database</h3>
        <div className="grid grid-cols-2 gap-2 text-xs">
          <div className="text-slate-500">Generations:</div><div className="text-slate-300">{fmtNum(health.total_generations)}</div>
          <div className="text-slate-500">DB size:</div><div className="text-slate-300">{health.db_size_mb} MB</div>
          <div className="text-slate-500">Version:</div><div className="text-slate-300">{health.version}</div>
        </div>
        <button onClick={refreshStats} className="px-3 py-1.5 text-xs border border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-500 rounded">Refresh Stats</button>
        <button onClick={rebuildTimestamps} disabled={rebuilding} className="px-3 py-1.5 text-xs border border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-500 rounded disabled:opacity-50">{rebuilding?'Rebuilding...':'Rebuild Timestamps'}</button>
      </section>}

      <section className="flex flex-col gap-3">
        <h3 className="text-sm font-medium text-slate-300 border-b border-slate-700 pb-1">Purge Data</h3>
        <input type="date" value={purgeDate} onChange={e=>setPurgeDate(e.target.value)}
          className="bg-slate-800 text-xs text-slate-200 px-3 py-2 rounded border border-slate-700 outline-none focus:border-blue-500"/>
        <button onClick={purge} className="px-3 py-2 text-xs bg-red-700 hover:bg-red-600 text-white rounded">Purge Before Date</button>
      </section>

      <section className="flex flex-col gap-3">
        <h3 className="text-sm font-medium text-slate-300 border-b border-slate-700 pb-1">Import</h3>
        <input type="file" ref={fileRef} accept=".csv" onChange={importFile} className="hidden"/>
        <button onClick={()=>fileRef.current?.click()} disabled={importing}
          className="flex items-center gap-2 px-3 py-2 text-xs border border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-500 rounded">
          {importing?<Spinner/>:<LI.Upload size={12}/>} Import CSV
        </button>
        {importResult&&<div className={`text-xs p-2 rounded ${importResult.error?'bg-red-900/40 text-red-300':'bg-green-900/40 text-green-300'}`}>
          {importResult.error||`Inserted: ${importResult.inserted}, Skipped: ${importResult.skipped}`}
        </div>}
      </section>
    </div>
  </div>;
}

