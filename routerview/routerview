];

function Header({timeRange,setTimeRange,customFrom,setCustomFrom,customTo,setCustomTo,filters,setFilters,dimensions,onSettings,compareEnabled,setCompareEnabled,compareMode,setCompareMode,views,onSelectView,onSaveView,onDeleteView,chartType,setChartType,metric,setMetric,groupBy,setGroupBy,summary,tz}) {
  const clearAll=()=>setFilters({model:[],provider:[],api_key:[],origin:[],finish_reason:[]});
  const hasFilters=Object.values(filters).some(v=>v.length>0);
  const CHART_TYPES=[{v:'area',l:'Area'},{v:'line',l:'Line'},{v:'bar',l:'Bar'},{v:'heatmap',l:'Heatmap'}];
  const METRICS=[{v:'cost',l:'Cost $'},{v:'requests',l:'Requests'},{v:'tokens',l:'Tokens'},{v:'latency',l:'Latency'}];
  const GROUPS=[{v:'model',l:'By Model'},{v:'provider',l:'By Provider'},{v:'api_key',l:'By Key'},{v:'none',l:'No Group'}];
  const activeRangeLabel = RANGE_OPTS.find(o=>o.v===timeRange)?.l||'Custom Range';
  const resolvedRange = summary?.from&&summary?.to ? formatResolvedRange(summary.from, summary.to, tz) : null;

  return <div className="bg-slate-900 border-b border-slate-800 px-4 py-2 flex flex-col gap-2 sticky top-0 z-30">
    <div className="flex items-center gap-3 flex-wrap">
      <span className="font-bold text-blue-400 text-sm tracking-wide shrink-0">RouterView</span>

      <select value={timeRange} onChange={e=>setTimeRange(e.target.value)}
        className="bg-slate-800 text-slate-200 text-xs px-2 py-1.5 rounded border border-slate-700 outline-none focus:border-blue-500 cursor-pointer">
        {RANGE_OPTS.map(o=><option key={o.v} value={o.v}>{o.l}</option>)}
      </select>

      {timeRange==='custom'&&<>
        <input type="datetime-local" value={customFrom||''} onChange={e=>setCustomFrom(e.target.value)}
          className="bg-slate-800 text-xs text-slate-300 px-2 py-1.5 rounded border border-slate-700 outline-none"/>
        <span className="text-slate-600 text-xs">to</span>
        <input type="datetime-local" value={customTo||''} onChange={e=>setCustomTo(e.target.value)}
          className="bg-slate-800 text-xs text-slate-300 px-2 py-1.5 rounded border border-slate-700 outline-none"/>
      </>}

      <div className="flex items-center gap-1.5">
        <label className="flex items-center gap-1.5 cursor-pointer">
          <div onClick={()=>setCompareEnabled(!compareEnabled)} className={`w-8 h-4 rounded-full transition-colors cursor-pointer relative ${compareEnabled?'bg-blue-600':'bg-slate-700'}`}>
            <span className={`absolute top-0.5 w-3 h-3 rounded-full bg-white transition-all ${compareEnabled?'left-4.5':'left-0.5'}`} style={{left:compareEnabled?18:2}}/>
          </div>
          <span className="text-xs text-slate-400">Compare</span>
        </label>
        {compareEnabled&&<select value={compareMode} onChange={e=>setCompareMode(e.target.value)}
          className="bg-slate-800 text-slate-200 text-xs px-2 py-1 rounded border border-slate-700 outline-none">
          {COMPARE_OPTS.map(o=><option key={o.v} value={o.v}>{o.l}</option>)}
        </select>}
      </div>

      <div className="flex items-center gap-1 ml-auto">
        <select value={chartType} onChange={e=>setChartType(e.target.value)}
          className="bg-slate-800 text-slate-400 text-xs px-1.5 py-1 rounded border border-slate-700 outline-none">
          {CHART_TYPES.map(o=><option key={o.v} value={o.v}>{o.l}</option>)}
        </select>
        <select value={metric} onChange={e=>setMetric(e.target.value)}
          className="bg-slate-800 text-slate-400 text-xs px-1.5 py-1 rounded border border-slate-700 outline-none">
          {METRICS.map(o=><option key={o.v} value={o.v}>{o.l}</option>)}
        </select>
        <select value={groupBy} onChange={e=>setGroupBy(e.target.value)}
          className="bg-slate-800 text-slate-400 text-xs px-1.5 py-1 rounded border border-slate-700 outline-none">
          {GROUPS.map(o=><option key={o.v} value={o.v}>{o.l}</option>)}
        </select>
        <SavedViewsDropdown views={views} onSelect={onSelectView} onSave={onSaveView} onDelete={onDeleteView}/>
        <button onClick={onSettings} className="p-1.5 text-slate-400 hover:text-slate-200 rounded"><LI.Settings size={14}/></button>
      </div>
    </div>

    {resolvedRange&&<div className="text-xs text-slate-500">
      {activeRangeLabel}: {resolvedRange}
    </div>}

    {dimensions&&<div className="flex items-center gap-2 flex-wrap">
      <FilterDropdown label="Model" options={dimensions.models||[]} selected={filters.model} onChange={v=>setFilters(f=>({...f,model:v}))}/>
      <FilterDropdown label="Provider" options={dimensions.providers||[]} selected={filters.provider} onChange={v=>setFilters(f=>({...f,provider:v}))}/>
      <FilterDropdown label="API Key" options={dimensions.api_keys||[]} selected={filters.api_key} onChange={v=>setFilters(f=>({...f,api_key:v}))}/>
      <FilterDropdown label="Origin" options={dimensions.origins||[]} selected={filters.origin} onChange={v=>setFilters(f=>({...f,origin:v}))}/>
      <FilterDropdown label="Finish" options={dimensions.finish_reasons||[]} selected={filters.finish_reason} onChange={v=>setFilters(f=>({...f,finish_reason:v}))}/>
      {hasFilters&&<button onClick={clearAll} className="text-xs text-slate-500 hover:text-slate-300 flex items-center gap-1"><LI.X size={10}/> Clear all</button>}
    </div>}

    {hasFilters&&<div className="flex flex-wrap gap-1.5">
      {Object.entries(filters).flatMap(([k,vals])=>vals.map(v=><span key={k+v} className="flex items-center gap-1 px-2 py-0.5 bg-blue-500/20 text-blue-300 text-xs rounded-full">
        {k}:{v}
        <button onClick={()=>setFilters(f=>({...f,[k]:f[k].filter(x=>x!==v)}))} className="hover:text-blue-100"><LI.X size={9}/></button>
      </span>))}
    </div>}
  </div>;
}

// ── Error Boundary ────────────────────────────────────────────────────────────
class ErrorBoundary extends React.Component {
  constructor(p){super(p);this.state={error:null};}
  static getDerivedStateFromError(e){return{error:e};}
  render(){
    if(this.state.error) return <div className="p-8 text-red-400 text-sm">
      <h2 className="font-bold mb-2">Something went wrong</h2>
      <pre className="text-xs opacity-70 overflow-auto">{this.state.error.message}</pre>
      <button onClick={()=>this.setState({error:null})} className="mt-4 px-3 py-1 border border-red-700 rounded text-xs hover:bg-red-900/30">Retry</button>
    </div>;
    return this.props.children;
  }
}

// ── App ───────────────────────────────────────────────────────────────────────
function App() {
  // Time range
  const [timeRange,setTimeRange]=useState(()=>new URLSearchParams(location.search).get('range')||'today');
