def _snapshot_db_to_backups(db_path: str) -> str:
    """Write a point-in-time consistent SQLite backup to ~/.routerview/backups/."""
    backups_dir = RUNTIME_PATHS.home / "backups"
    secure_private_directory(backups_dir)
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    dest = backups_dir / f"routerview-{ts}.db"
    prepare_private_file(dest, "SQLite backup")
    src_conn = sqlite3.connect(db_path)
    dst_conn = sqlite3.connect(str(dest))
    try:
        with dst_conn:
            src_conn.backup(dst_conn)
    finally:
        src_conn.close()
        dst_conn.close()
        secure_private_file(dest, "SQLite backup")
    return str(dest)


@app.post("/api/admin/rebuild-timestamps")
async def rebuild_timestamps_endpoint(confirm: bool = Query(False)):
    """Recompute ``created_at`` / ``created_date`` / ``created_hour`` from the
    Unix epoch embedded in each ``gen-<epoch>-<rand>`` generation ID.

    Writes a point-in-time backup of the database under ``~/.routerview/backups/``
    before mutating. Idempotent: rows already aligned with their embedded epoch
    are left alone.
    """
    if not confirm:
        return JSONResponse(status_code=400,
            content={"error": "Pass confirm=true to rebuild timestamps"})

    backup_path = _snapshot_db_to_backups(_db_path)

    db = await get_db()
    scanned = updated = skipped_no_epoch = 0
    try:
        cur = await db.execute(
            "SELECT id, created_at FROM generations"
        )
        rows = await cur.fetchall()
        updates: List[Tuple[str, str, int, str]] = []
        for row in rows:
            scanned += 1
            gid = row["id"]
            old_iso = row["created_at"]
            new_iso = recover_created_at(old_iso, gid)
            if new_iso is None:
                skipped_no_epoch += 1
                continue
            if new_iso == old_iso:
                continue
            try:
                new_dt = datetime.fromisoformat(new_iso)
            except (ValueError, TypeError):
                continue
            updates.append((new_iso, new_dt.strftime("%Y-%m-%d"), new_dt.hour, gid))

        if updates:
            await db.executemany(
                "UPDATE generations SET created_at=?, created_date=?, created_hour=? WHERE id=?",
                updates,
            )
            await db.commit()
        updated = len(updates)
    finally:
        await db.close()

    if updated:
        await refresh_daily_summaries(days=None)
        await refresh_model_stats()

    return {
        "status": "ok",
        "scanned": scanned,
        "updated": updated,
        "skipped_no_epoch": skipped_no_epoch,
        "backup_path": backup_path,
    }


