    ['R','Refresh data'],['Esc','Clear all filters'],['?','Show this help'],
  ];
  return html`<div class=${"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm"} onClick=${onClose}> <div class=${"bg-slate-900 border border-slate-700 rounded-2xl p-6 w-80"} onClick=${e=>e.stopPropagation()}> <div class=${"flex items-center justify-between mb-4"}> <h3 class=${"text-sm font-semibold text-slate-200"}>Keyboard Shortcuts</h3> <button onClick=${onClose} class=${"text-slate-500 hover:text-slate-300"}><${LI.X} size=${16} /></button> </div> ${shortcuts.map(([k,d])=>html`<div key=${k} class=${"flex items-center justify-between py-1.5 border-b border-slate-800"}> <span class=${"text-xs text-slate-400"}>${d}</span> <kbd class=${"bg-slate-800 border border-slate-700 rounded px-2 py-0.5 text-xs text-slate-300 font-mono"}>${k}</kbd> </div>`)} </div> </div>`;
}

// ── Saved Views ───────────────────────────────────────────────────────────────
function SavedViewsDropdown({views,onSelect,onSave,onDelete}) {
  const [open,setOpen]=useState(false);
  const [name,setName]=useState('');
  const [saving,setSaving]=useState(false);
  const ref=useRef();
  useEffect(()=>{ const h=e=>{ if(ref.current&&!ref.current.contains(e.target)) setOpen(false); };
    document.addEventListener('mousedown',h); return()=>document.removeEventListener('mousedown',h); },[]);
  return html`<div ref=${ref} class=${"relative"}> <button onClick=${()=>setOpen(!open)} class=${"flex items-center gap-1 px-2.5 py-1.5 text-xs text-slate-400 border border-slate-600 rounded hover:border-slate-500 hover:text-slate-300"}> <${LI.Bookmark} size=${12} /> Views <${LI.ChevronDown} size=${10} /> </button> ${open&&html`<div class=${"absolute top-full mt-1 right-0 bg-slate-800 border border-slate-700 rounded-lg shadow-xl z-50 w-56 py-2"}> ${saving?html`<div class=${"px-3 py-2"}> <input type=${"text"} value=${name} onInput=${e=>setName(e.target.value)} placeholder=${"View name..."} ref=${focusOnMount} onKeyDown=${e=>{if(e.key==='Enter'&&name){onSave(name);setSaving(false);setName('');setOpen(false);}if(e.key==='Escape') setSaving(false);}} class=${"w-full bg-slate-700 text-xs text-slate-200 px-2 py-1 rounded outline-none mb-2"} /> <div class=${"flex gap-2"}> <button onClick=${()=>setSaving(false)} class=${"flex-1 py-1 text-xs text-slate-400 border border-slate-700 rounded"}>Cancel</button> <button onClick=${()=>{if(name){onSave(name);setSaving(false);setName('');setOpen(false);}}} class=${"flex-1 py-1 text-xs bg-blue-600 text-white rounded"}>Save</button> </div> </div>`:html` <button onClick=${()=>setSaving(true)} class=${"w-full text-left px-3 py-1.5 text-xs text-blue-400 hover:bg-slate-700 flex items-center gap-2"}> <${LI.Plus} size=${12} /> Save current view </button> ${views.length>0&&html`<div class=${"border-t border-slate-700 mt-1 pt-1"}> ${views.map(v=>html`<div key=${v.id} class=${"flex items-center justify-between px-3 py-1.5 hover:bg-slate-700 group"}> <button onClick=${()=>{onSelect(v);setOpen(false);}} class=${"text-xs text-slate-300 truncate flex-1 text-left"}>${v.name}</button> <button onClick=${()=>onDelete(v.id)} class=${"opacity-0 group-hover:opacity-100 text-slate-500 hover:text-red-400 ml-2"}><${LI.Trash2} size=${10} /></button> </div>`)} </div>`} `} </div>`} </div>`;
}

