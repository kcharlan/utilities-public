?'text-center':'text-left'}`} onClick=${()=>handleSort(c.key)}> <span class=${"flex items-center gap-0.5 whitespace-nowrap justify-start"}>${c.align==='right'&&html`<span class=${"flex-1"} />`}${c.label}<${SortIcon} col=${c.key} /></span> </th>`)} </tr> </thead> <tbody> ${data.length===0&&html`<tr><td colSpan=${cols.length} class=${"p-4 text-center text-slate-500"}>No generations found</td></tr>`} ${data.map(row=>html`<${preact.Fragment} key=${row.id}> <tr class=${`border-b border-slate-700/50 hover:bg-slate-700/30 cursor-pointer transition-colors ${row.anomalies?.length?'border-l-2 border-l-amber-500':''} ${expandedRow===row.id?'bg-slate-700/40':''}`} onClick=${()=>setExpandedRow(expandedRow===row.id?null:row.id)}> ${cols.map(c=>html`<td key=${c.key} class=${`p-2 text-slate-300 ${c.align==='right'?'text-right':c.align==='center'?'text-center':''} max-w-32 truncate`}> ${c.fmt?c.fmt(row[c.key]):row[c.key]??'-'} ${c.key==='model_short'&&row.anomalies?.length>0&&html`<span class=${"ml-1 text-amber-400"} title=${row.anomalies.join(', ')}>⚠</span>`} </td>`)} </tr> ${expandedRow===row.id&&html`<tr> <td colSpan=${cols.length} class=${"p-3 bg-slate-900/50"}> <div class=${"grid grid-cols-2 md:grid-cols-3 gap-2 text-xs mb-2"}> ${Object.entries(row).filter(([k])=>!['trace_metadata','anomalies'].includes(k)).map(([k,v])=>html`<div key=${k} class=${"flex gap-2"}> <span class=${"text-slate-500 shrink-0"}>${k}:</span> <span class=${"text-slate-300 break-all"}>${String(v??'-')}</span> </div>`)} </div> ${row.trace_metadata&&html`<details class=${"mt-2"}> <summary class=${"text-xs text-slate-500 cursor-pointer"}>trace_metadata</summary> <pre class=${"mt-1 text-xs text-slate-400 bg-slate-900 rounded p-2 overflow-auto max-h-40"}>${JSON.stringify(JSON.parse(row.trace_metadata||'{}'),null,2)}</pre> </details>`} </td> </tr>`} <//>`)} </tbody> </table> </div> <div class=${"flex items-center justify-between mt-3 pt-3 border-t border-slate-700"}> <div class=${"flex items-center gap-2"}> <spa