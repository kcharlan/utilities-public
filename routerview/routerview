    const bounds={
      left:Math.min(...rects.map(rect=>rect.left)),
      right:Math.max(...rects.map(rect=>rect.right)),
      top:Math.min(...rects.map(rect=>rect.top)),
      bottom:Math.max(...rects.map(rect=>rect.bottom)),
    };
    bounds.width=bounds.right-bounds.left;
    bounds.height=bounds.bottom-bounds.top;
    const outside=event.clientX<bounds.left||event.clientX>bounds.right||
      event.clientY<bounds.top||event.clientY>bounds.bottom;
    if(!bounds.width||!bounds.height||outside) { setHoverIdx(null); return; }
    const position=(event.clientX-bounds.left)/bounds.width;
    const sourceIndex=sourceLength<=1 ? 0 : chartType==='bar'
      ? Math.min(sourceLength-1,Math.floor(position*sourceLength))
      : Math.round(position*(sourceLength-1));
    setHoverIdx(sourceLength<=1 ? 0 : sourceIndex/(sourceLength-1));
  };
  const handleMouseLeave = () => setHoverIdx(null);

  const refLineIdx = (chartData) => {
    if(hoverIdx==null||!chartData.length) return null;
    return Math.round(hoverIdx*(chartData.length-1));
  };

  const metricLabel = metric==='cost'?'Cost':metric==='requests'?'Requests':metric==='tokens'?'Tokens':'Latency';

  const renderChart = (chartData, label, height, isComparison=false) => {
    const source = isComparison ? data.comparison_series : data.series;
    const series = source.map(s => ({key:s.name, label:s.name, color:modelColor(s.name),
      stack:stackId, strokeWidth:1, fillOpacity:hidden.has(s.name)?0:(isComparison?0.4:0.5),
      strokeOpacity:hidden.has(s.name)?0:(isComparison?0.8:1),
      strokeDasharray:isComparison?'5 3':undefined}));
    const ri=refLineIdx(chartData);
    return html`<div onMouseMove=${event=>handleMouseMove(event,chartData.length)} onMouseLeave=${handleMouseLeave}>
      ${hasComp && html`<p class=${"text-xs text-slate-500 mb-1 ml-1"}>${label}</p>`}
      <${CartesianChart} kind=${chartType} data=${chartData} xKey=${"bucket"} series=${series}
        height=${height} margin=${{left:70, right:32, top:10, bottom:25}} yFormat=${yFmt} xFormat=${xFmt}
        yDomain=${yDomain} grid=${{horizontal:true,vertical:true,stroke:'#334155',strokeDasharray:'3 3'}}
        xAxisLine=${'#475569'} yAxisLine=${'#475569'} referenceOpacity=${0.5} plotClass=${"rv-main-chart-plot"}
        referenceX=${ri!=null?chartData[ri]?.bucket:undefined}
        tooltip=${props=>html`<${ChartTooltip} ...${props} metric=${metric} />`} />
      ${!hasComp && html`<div ref=${legendRef} class=${"rv-main-legend"}><${Legend} kind=${chartType} series=${[...series].sort((a,b)=>a.label<b.label?-1:a.label>b.label?1:0)} hidden=${hidden} onToggle=${name=>setHidden(prev=>{const n=new Set(prev);n.has(name)?n.delete(name):n.add(name);return n;})} /></div>`}
    </div>`;
  };
  const renderCompChart = (chartData,label,height) => renderChart(chartData,label,height,true);

  return html`<div class=${"bg-slate-800 rounded-xl p-4"}> <div class=${"flex items-center justify-between mb-3"}> <h2 class=${"text-sm font-medium text-slate-300"}> ${metricLabel} over Time${isCum?' (Cumulative)':''} ${groupBy!=='none'&&html`<span class=${"text-slate-500 font-normal ml-1"}>by ${groupBy}</span>`} </h2> <div class=${"flex items-center gap-2"}> ${canCumulative&&html`<button onClick=${()=>setCumulative(c=>!c)} class=${`text-xs px-2 py-1 rounded ${cumulative?'bg-blue-600 text-white':'bg-slate-700 text-slate-400 hover:text-slate-300'}`} title=${"Toggle cumulative view"}>Σ Cumulative</button>`} <${ExportMenu} chartRef=${ref} onCSV=${onExport} name=${"timeseries"} /> </div> </div> <div ref=${ref}> ${hasComp ? html` ${renderChart(primaryData, 'Current Period', 240)} <div class=${"my-2"} /> ${renderCompChart(compData, data.compare_range||'Prior Period', 200)} <div class=${"flex flex-wrap justify-center gap-3 mt-2 text-xs"}> ${data.series.map(s=>{
            const col=modelColor(s.name);
            const dim=hidden.has(s.name);
            return html`<button key=${s.name} class=${"flex items-center gap-1"} style=${{opacity:dim?0.3:1}} onClick=${()=>setHidden(prev=>{const n=new Set(prev);n.has(s.name)?n.delete(s.name):n.add(s.name);return n;})}> <span style=${{width:8,height:8,borderRadius:'50%',background:col,display:'inline-block'}} /><span class=${"text-slate-400"}>${s.name}</span> </button>`;
          })} </div> ` : renderChart(primaryData, '', Math.max(0,380-legendHeight))} </div> </div>`;
}

// ── Heatmap ───────────────────────────────────────────────────────────────────
function HeatmapView({data}) {
  if(!data) return html`<div class=${"bg-slate-800 rounded-xl p-4 h-64 animate-pulse"} />`;
  const matrix = data.matrix||[];
  const allVals = matrix.flat().filter(v=>v!=null);
  const maxVal = allVals.length?Math.max(...allVals):1;
  const DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const HOURS=Array.from({length:24},(_,i)=>i);
  return html`<div class=${"bg-slate-800 rounded-xl p-4 overflow-x-auto"}> <h2 class=${"text-sm font-medium text-slate-300 mb-3"}>Usage Heatmap</h2> <div class=${"flex gap-1"}> <div class=${"flex flex-col gap-1 pt-5"}> ${DAYS.map(d=>html`<div key=${d} class=${"h-6 w-8 text-xs text-slate-500 flex items-center"}>${d}</div>`)} </div> <div> <div class=${"flex gap-1 mb-1"}> ${HOURS.map(h=>html`<div key=${h} class=${"w-6 text-center text-slate-600"} style=${{fontSize:9}}>${h%6===0?h:''}</div>`)} </div> ${DAYS.map((d,di)=>html`<div key=${di} class=${"flex gap-1 mb-1"}> ${HOURS.map(h=>{
            const v=matrix[di]?.[h];
            const intensity=v!=null?v/maxVal:0;
            return html`<div key=${h} title=${`${d} ${h}:00 — ${v!=null?v.toFixed(4):'no data'}`} class=${"w-6 h-6 rounded-sm cursor-default"} style=${{background:v!=null?`rgba(59,130,246,${0.1+intensity*0.9})`:'#1e293b'}} />`;
          })} </div>`)} </div> </div> </div>`;
}

// ── Breakdown Panel ───────────────────────────────────────────────────────────
function BreakdownPanel({title,data,type='bar',metric='cost',onFilter,chartRef,panelKey,dragProps,exportQS=''}) {
  if(!data) return html`<div class=${"bg-slate-800 rounded-xl p-4 h-64 animate-pulse"} />`;
  const items = data.data||[];
  if(!items.length) return html`<div class=${"bg-slate-800 rounded-xl p-4"}><h3 class=${"text-sm text-slate-400 mb-3"}>${title}</h3><${EmptyState} /></div>`;
  const fmtVal = v=>metric==='cost'?fmt$(v,2):metric==='latency'?fmtMs(v):fmtNum(v);
  const BDTooltip = ({active,payload,label})=>{
    if(!active||!payload?.length) return null;
    const d=payload[0]?.payload;
    return html`<div class=${"bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 shadow-xl text-xs"}> <p class=${"text-slate-300 font-medium mb-1"}>${d?.dimension||label}</p> <p class=${"text-slate-400"}>${fmtVal(payload[0]?.value)}</p> </div>`;
  };
  const activateBarFilter = dimension => {
    if(onFilter&&dimension) onFilter(dimension);
  };

  return html`<div class=${"bg-slate-800 rounded-xl p-4"} ...${dragProps}> <div class=${"flex items-center justify-between mb-3"}> <div class=${"flex items-center gap-2"}> ${dragProps&&html`<${LI.GripVertical} size=${14} className=${"text-slate-600 cursor-grab"} />`} <h3 class=${"text-sm font-medium text-slate-300"}>${title}</h3> </div> <${ExportMenu} chartRef=${chartRef} name=${panelKey} onCSV=${()=>window.open(`/api/export/csv?view=breakdown&group_by=${panelKey}&metric=${metric}&${exportQS}`)} /> </div> <div ref=${chartRef}> ${type==='pie'
        ? (()=>{
            // Roll up small slices into "Other" when there are many items
            const MAX_SLICES = 7;
            let pieItems = items;
            if(items.length > MAX_SLICES) {
              const sorted = [...items].sort((a,b)=>b.value-a.value);
              const top = sorted.slice(0,MAX_SLICES-1);
              const rest = sorted.slice(MAX_SLICES-1);
              const otherVal = rest.reduce((s,r)=>s+r.value,0);
              pieItems = [...top, {dimension:`Other (${rest.length})`, value:otherVal}];
            }
            const chartItems=pieItems.map((item,i)=>({...item,label:item.dimension,color:COLORS[i%COLORS.length]}));
            return html`<${DonutChart} items=${chartItems} height=${200} innerRadius=${50} outerRadius=${85} startAngle=${0} clockwise=${false} stroke=${"var(--color-white)"} strokeWidth=${1} tooltip=${props=>html`<${BDTooltip} ...${props} />`} onSelect=${item=>onFilter&&item.dimension&&!item.dimension.startsWith('Other')&&onFilter(item.dimension)} />
              <div class=${"rv-donut-legend flex flex-wrap justify-center gap-3 text-xs"} style=${{fontSize:11}}>${[...chartItems].sort((a,b)=>a.label<b.label?-1:a.label>b.label?1:0).map(item=>html`<span style=${{color:item.color}}><span style=${{display:"inline-block",width:14,height:10,background:item.color,marginRight:4}} />${item.label}</span>`)}</div>`;
          })()
        : (()=>{
            const barItems = items.slice(0,10);
            const barH = Math.max(220, barItems.length * 28 + 40);
            const chartItems=barItems.map(item=>({...item,label:item.dimension,color:modelColor(item.dimension),ariaLabel:`Filter by ${panelKey.replace(/_/g,' ')} ${item.dimension}`}));
            return html`<${HBarChart} items=${chartItems} height=${barH} labelWidth=${130} labelMaxChars=${19} valueFormat=${fmtVal} tooltip=${props=>html`<${BDTooltip} ...${props} />`} onSelect=${item=>activateBarFilter(item.dimension)} />`;
          })()} </div> </div>`;
}

