@dataclass(frozen=True)
class RuntimePaths:
    home: Path
    db_default: Path
    mapping_file: Path
    port_file: Path
    traces_dir: Path


def build_runtime_paths():
    override = os.environ.get("ROUTERVIEW_HOME")
    home = Path(override).expanduser() if override else Path.home() / ".routerview"
    return RuntimePaths(
        home=home,
        db_default=home / "routerview.db",
        mapping_file=home / "attribute_mapping.json",
        port_file=home / "last_port",
        traces_dir=home / "traces",
    )


def parse_args():
    parser = argparse.ArgumentParser(
        prog="routerview",
        description="RouterView -- OpenRouter Analytics Dashboard"
