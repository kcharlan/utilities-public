def build_runtime_paths():
    override = os.environ.get("ROUTERVIEW_HOME")
    home = Path(override).expanduser() if override else Path.home() / ".routerview"
    return RuntimePaths(
        home=home,
        db_default=home / "routerview.db",
        mapping_file=home / "attribute_mapping.json",
        port_file=home / "last_port",
        traces_dir=home / "traces",
    )


