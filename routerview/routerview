    const measure=()=>setLegendHeight(node.getBoundingClientRect().height);
    measure();
    if(typeof ResizeObserver==='undefined') return;
    const observer=new ResizeObserver(measure);
    observer.observe(node);
    return ()=>observer.disconnect();
  },[data?.series, data?.comparison_series, chartType]);

  // Shared Y domain across both charts so scale differences are honest
  const yDomain = useMemo(()=>{
    if(!data?.series?.length) return undefined;
    const isCum_ = metric!=='latency' && cumulative;
    // For stacked (non-cumulative): max is sum of all series at each bucket
    // For cumulative (unstacked): max is the largest individual series running total
    const maxOfData = (seriesList, nBuckets) => {
      let maxVal=0;
      if(isCum_) {
        for(const s of seriesList) {
          let run=0;
          for(let i=0;i<nBuckets;i++){ run+=(s.data[i]||0); if(run>maxVal) maxVal=run; }
        }
      } else {
        for(let i=0;i<nBuckets;i++){
          let sum=0;
          for(const s of seriesList) sum+=(s.data[i]||0);
          if(sum>maxVal) maxVal=sum;
        }
      }
      return maxVal;
    };
    let maxVal = maxOfData(data.series, data.buckets?.length||0);
    if(data?.comparison_series?.length){
      const compLen = (data.comparison_buckets||data.buckets).length;
      const compMax = maxOfData(data.comparison_series, compLen);
      if(compMax>maxVal) maxVal=compMax;
    }
    return maxVal>0 ? [0, Math.ceil(maxVal*1.05*100)/100] : undefined;
  },[data?.series,data?.comparison_series,data?.buckets,data?.comparison_buckets,cumulative,metric]);

  if(!data||!data.series) return html`<div class=${"bg-slate-800 rounded-xl p-4 h-96 flex items-center justify-center"}><${Spinner} /></div>`;
  if(!data.buckets?.length) return html`<div class=${"bg-slate-800 rounded-xl p-4"}><${EmptyState} /></div>`;

  const hasComp = !!(data.comparison_series?.length);
  const canCumulative = metric!=='latency';
  const isCum = canCumulative && cumulative;

  // Build chart data, optionally cumulative
  const buildChartData = (buckets, seriesList) => {
    const accum = {};
    return buckets.map((b,i)=>{
      const pt={bucket:b};
      seriesList.forEach(s=>{
        const val = s.data[i]??0;
        if(isCum){
          accum[s.name] = (accum[s.name]||0) + val;
          pt[s.name] = accum[s.name];
        } else {
          pt[s.name] = val;
        }
      });
      return pt;
    });
  };

  const primaryData = buildChartData(data.buckets, data.series);
  const compBuckets = data.comparison_buckets||data.buckets;
  const compData = hasComp ? buildChartData(compBuckets, data.comparison_series) : null;

  const yFmt = v=>metric==='cost'?fmt$(v,2):metric==='latency'?fmtMs(v):fmtNum(v);
  const bucketSize = data.bucket_size||'day';
  const xFmt = v=>{
    if(!v) return '';
    if(bucketSize==='minute') return v.slice(11,16);
    if(bucketSize==='hour') return v.slice(11,16)||v;
    if(bucketSize==='day') return v.slice(5,10);
    if(bucketSize==='week') return v;
    if(bucketSize==='month') return v;
    return v;
  };
  const stackId = !isCum && (chartType==='area'||chartType==='bar');

  // Linked crosshair: measure the rendered plot rather than the outer chart,
