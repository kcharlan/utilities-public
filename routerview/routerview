// ── Settings Panel ────────────────────────────────────────────────────────────
function SettingsPanel({onClose,onImportComplete}) {
  const [health,setHealth]=useState(null);
  const [purgeDate,setPurgeDate]=useState('');
  const [importing,setImporting]=useState(false);
  const [importResult,setImportResult]=useState(null);
  const fileRef=useRef();

  useEffect(()=>{ fetch('/api/health').then(r=>r.json()).then(setHealth).catch(()=>{}); },[]);

  const purge=async()=>{
    if(!purgeDate||!confirm(`Delete all data before ${purgeDate}?`)) return;
    const r=await fetch(`/api/purge?before=${purgeDate}`,{method:'POST'}); const d=await r.json();
    alert(`Deleted ${d.deleted_generations} generations`);
    onImportComplete?.();
  };
  const importFile=async e=>{
    const file=e.target.files?.[0]; if(!file) return;
    setImporting(true); setImportResult(null);
    const fd=new FormData(); fd.append('file',file);
    try {
      const r=await fetch('/api/import/csv',{method:'POST',body:fd});
      const d=await r.json();
      setImportResult(d);
      if(d.status==='ok') onImportComplete?.();
    }
    catch(e){setImportResult({error:String(e)});}
    setImporting(false);
  };
  const refreshStats=async()=>{ await fetch('/api/admin/refresh-summaries',{method:'POST'}); alert('Summaries refreshed'); };
  const [rebuilding,setRebuilding]=useState(false);
  const rebuildTimestamps=async()=>{
    if(!confirm(`Rebuild created_at for every generation from its gen-ID epoch? The database will be backed up to ~/.routerview/backups/ first.`)) return;
    setRebuilding(true);
    try {
      const r=await fetch('/api/admin/rebuild-timestamps?confirm=true',{method:'POST'});
      const d=await r.json();
      if(d.error) alert('Error: '+d.error);
      else { alert(`Scanned ${d.scanned}, updated ${d.updated}. Backup: ${d.backup_path}`); onImportComplete?.(); }
    } catch(e){ alert('Error: '+String(e)); }
    setRebuilding(false);
  };

  return html`<div class=${"fixed inset-0 z-50 flex"}> <div class=${"flex-1 bg-black/60 backdrop-blur-sm"} onClick=${onClose} /> <div class=${"w-96 bg-slate-900 border-l border-slate-700 overflow-y-auto p-6 flex flex-col gap-6"}> <div class=${"flex items-center justify-between"}> <h2 class=${"text-lg font-semibold text-slate-100"}>Settings</h2> <button onClick=${onClose} class=${"text-slate-400 hover:text-slate-200"}><${LI.X} size=${20} /></button> </div> ${health&&html`<section class=${"flex flex-col gap-2"}> <h3 class=${"text-sm font-medium text-slate-300 border-b border-slate-700 pb-1"}>Database</h3> <div class=${"grid grid-cols-2 gap-2 text-xs"}> <div class=${"text-slate-500"}>Generations:</div><div class=${"text-slate-300"}>${fmtNum(health.total_generations)}</div> <div class=${"text-slate-500"}>DB size:</div><div class=${"text-slate-300"}>${health.db_size_mb} MB</div> <div class=${"text-slate-500"}>Version:</div><div class=${"text-slate-300"}>${health.version}</div> </div> <button onClick=${refreshStats} class=${"px-3 py-1.5 text-xs border border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-500 rounded"}>Refresh Stats</button> <button onClick=${rebuildTimestamps} disabled=${rebuilding} class=${"px-3 py-1.5 text-xs border border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-500 rounded disabled:opacity-50"}>${rebuilding?'Rebuilding...':'Rebuild Timestamps'}</button> </section>`} <section class=${"flex flex-col gap-3"}> <h3 class=${"text-sm font-medium text-slate-300 border-b border-slate-700 pb-1"}>Purge Data</h3> <input type=${"date"} value=${purgeDate} onInput=${e=>setPurgeDate(e.target.value)} class=${"bg-slate-800 text-xs text-slate-200 px-3 py-2 rounded border border-slate-700 outline-none focus:border-blue-500"} /> <button onClick=${purge} class=${"px-3 py-2 text-xs bg-red-700 hover:bg-red-600 text-white rounded"}>Purge Before Date</button> </section> <section class=${"flex flex-col gap-3"}> <h3 class=${"text-sm font-medium text-slate-300 border-b border-slate-700 pb-1"}>Import</h3> <input type=${"file"} ref=${fileRef} accept=${".csv"} onInput=${importFile} class=${"hidden"} /> <button onClick=${()=>fileRef.current?.click()} disabled=${importing} class=${"flex items-center gap-2 px-3 py-2 text-xs border border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-500 rounded"}> ${importing?html`<${Spinner} />`:html`<${LI.Upload} size=${12} />`} Import CSV </button> ${importResult&&html`<div class=${`text-xs p-2 rounded ${importResult.error?'bg-red-900/40 text-red-300':'bg-green-900/40 text-green-300'}`}> ${importResult.error||`Inserted: ${importResult.inserted}, Skipped: ${importResult.skipped}`} </div>`} </section> </div> </div>`;
}

