function Header({timeRange,setTimeRange,customFrom,setCustomFrom,customTo,setCustomTo,filters,setFilters,dimensions,onSettings,compareEnabled,setCompareEnabled,compareMode,setCompareMode,views,onSelectView,onSaveView,onDeleteView,chartType,setChartType,metric,setMetric,groupBy,setGroupBy,summary,tz}) {
  const clearAll=()=>setFilters({model:[],provider:[],api_key:[],origin:[],finish_reason:[]});
  const hasFilters=Object.values(filters).some(v=>v.length>0);
  const CHART_TYPES=[{v:'area',l:'Area'},{v:'line',l:'Line'},{v:'bar',l:'Bar'},{v:'heatmap',l:'Heatmap'}];
  const METRICS=[{v:'cost',l:'Cost $'},{v:'requests',l:'Requests'},{v:'tokens',l:'Tokens'},{v:'latency',l:'Latency'}];
  const GROUPS=[{v:'model',l:'By Model'},{v:'provider',l:'By Provider'},{v:'api_key',l:'By Key'},{v:'none',l:'No Group'}];
  const activeRangeLabel = RANGE_OPTS.find(o=>o.v===timeRange)?.l||'Custom Range';
  const resolvedRange = summary?.from&&summary?.to ? formatResolvedRange(summary.from, summary.to, tz) : null;

  return html`<div class=${"bg-slate-900 border-b border-slate-800 px-4 py-2 flex flex-col gap-2 sticky top-0 z-30"}> <div class=${"flex items-center gap-3 flex-wrap"}> <span class=${"font-bold text-blue-400 text-sm tracking-wide shrink-0"}>RouterView</span> <select value=${timeRange} onInput=${e=>setTimeRange(e.target.value)} class=${"bg-slate-800 text-slate-200 text-xs px-2 py-1.5 rounded border border-slate-700 outline-none focus:border-blue-500 cursor-pointer"}> ${RANGE_OPTS.map(o=>html`<option key=${o.v} value=${o.v}>${o.l}</option>`)} </select> ${timeRange==='custom'&&html` <input type=${"datetime-local"} value=${customFrom||''} onInput=${e=>setCustomFrom(e.target.value)} class=${"bg-slate-800 text-xs text-slate-300 px-2 py-1.5 rounded border border-slate-700 outline-none"} /> <span class=${"text-slate-600 text-xs"}>to</span> <input type=${"datetime-local"} value=${customTo||''} onInput=${e=>setCustomTo(e.target.value)} class=${"bg-slate-800 text-xs text-slate-300 px-2 py-1.5 rounded border border-slate-700 outline-none"} /> `} <div class=${"flex items-center gap-1.5"}> <label class=${"flex items-center gap-1.5 cursor-pointer"}> <div onClick=${()=>setCompareEnabled(!compareEnabled)} class=${`w-8 h-4 rounded-full transition-colors cursor-pointer relative ${compareEnabled?'bg-blue-600':'bg-slate-700'}`}> <span class=${`absolute top-0.5 w-3 h-3 rounded-full bg-white transition-all ${compareEnabled?'left-4.5':'left-0.5'}`} style=${{left:compareEnabled?18:2}} /> </div> <span class=${"text-xs text-slate-400"}>Compare</span> </label> ${compareEnabled&&html`<select value=${compareMode} onInput=${e=>setCompareMode(e.target.value)} class=${"bg-slate-800 text-slate-200 text-xs px-2 py-1 rounded border border-slate-700 outline-none"}> ${COMPARE_OPTS.map(o=>html`<option key=${o.v} value=${o.v}>${o.l}</option>`)} </select>`} </div> <div class=${"flex items-center gap-1 ml-auto"}> <select value=${chartType} onInput=${e=>setChartType(e.target.value)} class=${"bg-slate-800 text-slate-400 text-xs px-1.5 py-1 rounded border border-slate-700 outline-none"}> ${CHART_TYPES.map(o=>html`<option key=${o.v} value=${o.v}>${o.l}</option>`)} </select> <select value=${metric} onInput=${e=>setMetric(e.target.value)} class=${"bg-slate-800 text-slate-400 text-xs px-1.5 py-1 rounded border border-slate-700 outline-none"}> ${METRICS.map(o=>html`<option key=${o.v} value=${o.v}>${o.l}</option>`)} </select> <select value=${groupBy} onInput=${e=>setGroupBy(e.target.value)} class=${"bg-slate-800 text-slate-400 text-xs px-1.5 py-1 rounded border border-slate-700 outline-none"}> ${GROUPS.map(o=>html`<option key=${o.v} value=${o.v}>${o.l}</option>`)} </select> <${SavedViewsDropdown} views=${views} onSelect=${onSelectView} onSave=${onSaveView} onDelete=${onDeleteView} /> <button onClick=${onSettings} class=${"p-1.5 text-slate-400 hover:text-slate-200 rounded"}><${LI.Settings} size=${14} /></button> </div> </div> ${resolvedRange&&html`<div class=${"text-xs text-slate-500"}> ${activeRangeLabel}: ${resolvedRange} </div>`} ${dimensions&&html`<div class=${"flex items-center gap-2 flex-wrap"}> <${FilterDropdown} label=${"Model"} options=${dimensions.models||[]} selected=${filters.model} onChange=${v=>setFilters(f=>({...f,model:v}))} /> <${FilterDropdown} label=${"Provider"} options=${dimensions.providers||[]} selected=${filters.provider} onChange=${v=>setFilters(f=>({...f,provider:v}))} /> <${FilterDropdown} label=${"API Key"} options=${dimensions.api_keys||[]} selected=${filters.api_key} onChange=${v=>setFilters(f=>({...f,api_key:v}))} /> <${FilterDropdown} label=${"Origin"} options=${dimensions.origins||[]} selected=${filters.origin} onChange=${v=>setFilters(f=>({...f,origin:v}))} /> <${FilterDropdown} label=${"Finish"} options=${dimensions.finish_reasons||[]} selected=${filters.finish_reason} onChange=${v=>setFilters(f=>({...f,finish_reason:v}))} /> ${hasFilters&&html`<button onClick=${clearAll} class=${"text-xs text-slate-500 hover:text-slate-300 flex items-center gap-1"}><${LI.X} size=${10} /> Clear all</button>`} </div>`} ${hasFilters&&html`<div class=${"flex flex-wrap gap-1.5"}> ${Object.entries(filters).flatMap(([k,vals])=>vals.map(v=>html`<span key=${k+v} class=${"flex items-center gap-1 px-2 py-0.5 bg-blue-500/20 text-blue-300 text-xs rounded-full"}> ${k}:${v} <button onClick=${()=>setFilters(f=>({...f,[k]:f[k].filter(x=>x!==v)}))} class=${"hover:text-blue-100"}><${LI.X} size=${9} /></button> </span>`))} </div>`} </div>`;
}

// ── Error Boundary ────────────────────────────────────────────────────────────
class ErrorBoundary extends preact.Component {
  constructor(p){super(p);this.state={error:null};}
  static getDerivedStateFromError(e){return{error:e};}
  render(){
    if(this.state.error) return html`<div class=${"p-8 text-red-400 text-sm"}> <h2 class=${"font-bold mb-2"}>Something went wrong</h2> <pre class=${"text-xs opacity-70 overflow-auto"}>${this.state.error.message}</pre> <button onClick=${()=>this.setState({error:null})} class=${"mt-4 px-3 py-1 border border-red-700 rounded text-xs hover:bg-red-900/30"}>Retry</button> </div>`;
    return this.props.children;
  }
}

// ── App ───────────────────────────────────────────────────────────────────────
function App() {
  // Time range
  const [timeRange,setTimeRange]=useState(()=>new URLSearchParams(location.search).get('range')||'today');
  const [customFrom,setCustomFrom]=useState(null);
  const [customTo,setCustomTo]=useState(null);
  const [tz]=useState(Intl.DateTimeFormat().resolvedOptions().timeZone);

  // Filters
  const [filters,setFilters]=useState(()=>{
    const p=new URLSearchParams(location.search);
    return {
      model: p.get('model')?.split(',').filter(Boolean)||[],
      provider: p.get('provider')?.split(',').filter(Boolean)||[],
      api_key: p.get('api_key')?.split(',').filter(Boolean)||[],
      origin: p.get('origin')?.split(',').filter(Boolean)||[],
      finish_reason: p.get('finish_reason')?.split(',')||[],
    };
  });

  // Comparison
  const [compareEnabled,setCompareEnabled]=useState(false);
  const [compareMode,setCompareMode]=useState('prior_period');

  // Chart controls
  const [chartType,setChartType]=useState('area');
  const [metric,setMetric]=useState('cost');
  const [groupBy,setGroupBy]=useState('model');

  // Data
  const [summary,setSummary]=useState(null);
  const [timeseries,setTimeseries]=useState(null);
  const [logData,setLogData]=useState(null);
  const [dimensions,setDimensions]=useState(null);
  const [breakdown,setBreakdown]=useState({model:null,api_key:null,provider:null});
  const [heatmapData,setHeatmapData]=useState(null);

  // Log viewer state
  const [logSort,setLogSort]=useState({col:'created_at',dir:'desc'});
  const [logSearch,setLogSearch]=useState('');
  const [logPage,setLogPage]=useState(1);
  const [logPageSize,setLogPageSize]=useState(50);
  const [visibleCols,setVisibleCols]=useState(()=>JSON.parse(localStorage.getItem('rv_cols')||'null')||DEFAULT_COLS);
  const [expandedRow,setExpandedRow]=useState(null);

  // UI
  const [showSettings,setShowSettings]=useState(false);
  const [showShortcuts,setShowShortcuts]=useState(false);
  const [loading,setLoading]=useState(true);
  const [error,setError]=useState(null);

  // Panel order (drag-and-drop)
  const [panelOrder,setPanelOrder]=useState(()=>JSON.parse(localStorage.getItem('rv_panels')||'["model","api_key","provider"]'));
  const dragSrc=useRef(null);

  // Saved views
  const [views,setViews]=useState([]);

  // Chart refs for export
  const mainChartRef=useRef();
  const panelRefs={model:useRef(),api_key:useRef(),provider:useRef()};

  // Ensure dark mode
  useEffect(()=>{ document.documentElement.classList.add('dark'); },[]);

  // Persist cols
  useEffect(()=>{ localStorage.setItem('rv_cols',JSON.stringify(visibleCols)); },[visibleCols]);

  // URL sync
  useEffect(()=>{
    const p=new URLSearchParams();
    if(timeRange!=='today') p.set('range',timeRange);
    Object.entries(filters).forEach(([k,v])=>{if(v.length) p.set(k,v.join(','));});
    const qs=p.toString(); history.replaceState(null,'',qs?`?${qs}`:'/');
  },[timeRange,filters]);

  // Load saved views
  useEffect(()=>{ fetch('/api/views').then(r=>r.json()).then(setViews).catch(()=>{}); },[]);

  // Build query string
  const buildQS = useCallback((extra={})=>{
    const p=new URLSearchParams();
    if(timeRange==='custom'){if(customFrom)p.set('from',customFrom);if(customTo)p.set('to',customTo);}
    else p.set('range',timeRange);
    p.set('tz',tz);
    if(filters.model.length) p.set('model',filters.model.join(','));
    if(filters.provider.length) p.set('provider',filters.provider.join(','));
    if(filters.api_key.length) p.set('api_key',filters.api_key.join(','));
    if(filters.origin.length) p.set('origin',filters.origin.join(','));
    if(filters.finish_reason.length) p.set('finish_reason',filters.finish_reason.join(','));
    if(compareEnabled) p.set('compare',compareMode);
    Object.entries(extra).forEach(([k,v])=>p.set(k,v));
    return p.toString();
  },[timeRange,customFrom,customTo,tz,filters,compareEnabled,compareMode]);

  // Fetch all data
  const fetchAbort = useRef(null);
  const fetchData = useCallback(async()=>{
    if(fetchAbort.current) fetchAbort.current.abort();
    const ac = new AbortController(); fetchAbort.current = ac;
    const sig = {signal:ac.signal};
    setLoading(true); setError(null);
    const qs=buildQS();
    const tsqs=buildQS({metric,group_by:groupBy});
    try {
      const [sumRes,tsRes,dimRes] = await Promise.all([
        fetch(`/api/summary?${qs}`,sig).then(r=>r.json()),
        fetch(`/api/timeseries?${tsqs}`,sig).then(r=>r.json()),
        fetch('/api/dimensions',sig).then(r=>r.json()),
      ]);
      setSummary(sumRes); setTimeseries(tsRes); setDimensions(dimRes);

      // Breakdown panels
      const [bmRes,bkRes,bpRes] = await Promise.all([
        fetch(`/api/breakdown?group_by=model&metric=cost&${qs}`,sig).then(r=>r.json()),
        fetch(`/api/breakdown?group_by=api_key&metric=cost&${qs}`,sig).then(r=>r.json()),
        fetch(`/api/breakdown?group_by=provider&metric=requests&${qs}`,sig).then(r=>r.json()),
      ]);
      setBreakdown({model:bmRes,api_key:bkRes,provider:bpRes});

      if(chartType==='heatmap') {
        const hm=await fetch(`/api/heatmap?metric=${metric}&${qs}`,sig).then(r=>r.json());
        setHeatmapData(hm);
      }
    } catch(e){ if(e.name==='AbortError') return; setError(String(e)); }
    finally { if(!ac.signal.aborted) setLoading(false); }
  },[buildQS,metric,groupBy,chartType]);

  const fetchLog = useCallback(async()=>{
    const qs=buildQS({page:logPage,page_size:logPageSize,sort:logSort.col,order:logSort.dir,search:logSearch});
    try { const d=await fetch(`/api/generations?${qs}`).then(r=>r.json()); setLogData(d); }
    catch(e){ console.warn('Log fetch failed',e); }
  },[buildQS,logPage,logPageSize,logSort,logSearch]);

  // KPI card cycles (persisted)
  const [costCycle,setCostCycle]=useState(()=>localStorage.getItem('rv_cost_agg')||'avg');
  const [latCycle,setLatCycle]=useState(()=>localStorage.getItem('rv_lat_agg')||'avg');
  useEffect(()=>localStorage.setItem('rv_cost_agg',costCycle),[costCycle]);
  useEffect(()=>localStorage.setItem('rv_lat_agg',latCycle),[latCycle]);

  // Fetch on mount and state changes
  useEffect(()=>{ fetchData(); },[fetchData]);
  useEffect(()=>{ fetchLog(); },[fetchLog]);

  // Keyboard shortcuts
  useEffect(()=>{
    const RANGES=RANGE_OPTS.map(o=>o.v).filter(v=>v!=='custom');
    function handleKey(e){
      if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA'||e.target.tagName==='SELECT') return;
      if(e.key==='/'){e.preventDefault();document.getElementById('log-search')?.focus();}
      else if(e.key==='ArrowLeft'){const i=RANGES.indexOf(timeRange);if(i>0)setTimeRange(RANGES[i-1]);else if(i===-1)setTimeRange(RANGES[RANGES.length-1]);}
      else if(e.key==='ArrowRight'){const i=RANGES.indexOf(timeRange);if(i>=0&&i<RANGES.length-1)setTimeRange(RANGES[i+1]);else if(i===-1)setTimeRange(RANGES[0]);}
      else if(e.key==='r'&&!e.metaKey){fetchData();fetchLog();}
      else if(e.key==='Escape'){setFilters({model:[],provider:[],api_key:[],origin:[],finish_reason:[]});}
      else if(e.key==='?'){setShowShortcuts(true);}
    }
    window.addEventListener('keydown',handleKey);
    return()=>window.removeEventListener('keydown',handleKey);
  },[timeRange,fetchData,fetchLog]);

  // Auto smart compare mode — fire on range change AND when comparison is enabled
  useEffect(()=>{
    const defaults={today:'dow',yesterday:'dow',this_week:'wow',last_week:'wow',this_month:'mom_date',last_month:'mom_date',this_quarter:'qoq',last_quarter:'qoq',this_year:'yoy_date',last_year:'yoy_date'};
    if(defaults[timeRange]) setCompareMode(defaults[timeRange]);
  },[timeRange,compareEnabled]);

  // Drag-and-drop for panels
  const dragStart=(e,key)=>{dragSrc.current=key;};
  const dragOver=e=>{e.preventDefault();e.currentTarget.classList.add('drag-over');};
  const dragLeave=e=>e.currentTarget.classList.remove('drag-over');
  const drop=(e,key)=>{
    e.currentTarget.classList.remove('drag-over');
    if(!dragSrc.current||dragSrc.current===key) return;
    const src=dragSrc.current;
    setPanelOrder(prev=>{
      const next=[...prev]; const fi=next.indexOf(src); const ti=next.indexOf(key);
      next.splice(fi,1); next.splice(ti,0,src);
      localStorage.setItem('rv_panels',JSON.stringify(next));
      return next;
    });
    dragSrc.current=null;
  };

  // Saved views
  const selectView=v=>{
    const cfg=JSON.parse(v.config||'{}');
    if(cfg.timeRange) setTimeRange(cfg.timeRange);
    if(cfg.filters) setFilters(cfg.filters);
    if(cfg.chartType) setChartType(cfg.chartType);
    if(cfg.metric) setMetric(cfg.metric);
    if(cfg.groupBy) setGroupBy(cfg.groupBy);
    if(cfg.panelOrder) setPanelOrder(cfg.panelOrder);
    if(cfg.compareMode) setCompareMode(cfg.compareMode);
    if(cfg.compareEnabled!=null) setCompareEnabled(cfg.compareEnabled);
  };
  const saveView=async name=>{
    const config={timeRange,filters,chartType,metric,groupBy,panelOrder,compareMode,compareEnabled};
    await fetch('/api/views',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,config})});
    const v=await fetch('/api/views').then(r=>r.json()); setViews(v);
  };
  const deleteView=async id=>{
    await fetch(`/api/views/${id}`,{method:'DELETE'});
    setViews(prev=>prev.filter(v=>v.id!==id));
  };

  // Panel filter click -> set filter
  const onPanelFilter=(dim,val)=>{
    if(dim==='model') setFilters(f=>({...f,model:[...f.model.filter(x=>x!==val),val]}));
    else if(dim==='api_key') setFilters(f=>({...f,api_key:[...f.api_key.filter(x=>x!==val),val]}));
    else if(dim==='provider') setFilters(f=>({...f,provider:[...f.provider.filter(x=>x!==val),val]}));
  };

  const panelDefs={
    model:{title:'Cost by Model',type:'bar',metric:'cost',dim:'model'},
    api_key:{title:'Cost by API Key',type:'bar',metric:'cost',dim:'api_key'},
    provider:{title:'Requests by Provider',type:'pie',metric:'requests',dim:'provider'},
  };

  const exportLog=()=>window.open(`/api/export/csv?view=generations&${buildQS()}`);
  const exportTimeseries=()=>window.open(`/api/export/csv?view=timeseries&${buildQS()}`);

  return html`<div class=${"min-h-screen bg-slate-950"}> <${ErrorBanner} error=${error} onRetry=${()=>{fetchData();fetchLog();}} /> <${Header} timeRange=${timeRange} setTimeRange=${setTimeRange} customFrom=${customFrom} setCustomFrom=${setCustomFrom} customTo=${customTo} setCustomTo=${setCustomTo} filters=${filters} setFilters=${setFilters} dimensions=${dimensions} summary=${summary} tz=${tz} onSettings=${()=>setShowSettings(true)} compareEnabled=${compareEnabled} setCompareEnabled=${setCompareEnabled} compareMode=${compareMode} setCompareMode=${setCompareMode} views=${views} onSelectView=${selectView} onSaveView=${saveView} onDeleteView=${deleteView} chartType=${chartType} setChartType=${setChartType} metric=${metric} setMetric=${setMetric} groupBy=${groupBy} setGroupBy=${setGroupBy} /> <div class=${"p-4 flex flex-col gap-4 max-w-[1600px] mx-auto"}> <${KPICards} summary=${summary} costCycle=${costCycle} setCostCycle=${setCostCycle} latCycle=${latCycle} setLatCycle=${setLatCycle} /> <div ref=${mainChartRef}> ${chartType==='heatmap'
          ?html`<${HeatmapView} data=${heatmapData} />`
          :html`<${MainChart} data=${timeseries} chartType=${chartType} metric=${metric} groupBy=${groupBy} comparison=${compareEnabled} onExport=${exportTimeseries} />`} </div> <div class=${"grid grid-cols-1 md:grid-cols-3 gap-4"}> ${panelOrder.map(key=>{
          const def=panelDefs[key]; if(!def) return null;
          return html`<${BreakdownPanel} key=${key} title=${def.title} data=${breakdown[key]} type=${def.type} metric=${def.metric} onFilter=${val=>onPanelFilter(def.dim,val)} chartRef=${panelRefs[key]} panelKey=${key} exportQS=${buildQS()} dragProps=${{
              draggable:true,
              onDragStart:e=>dragStart(e,key),
              onDragOver:dragOver, onDragLeave:dragLeave,
