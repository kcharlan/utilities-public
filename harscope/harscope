        color: isDark ? '#e5e7eb' : '#1f2937',
      }}> <${Icon} name=${p.label === 'Browser' ? 'Globe' : 'Server'} size=${14} /> <span class=${"truncate"} style=${{ maxWidth: SEQ_PARTICIPANT_WIDTH - 44 }}>${p.label}</span> </div>`
  ));
