        htmlTag`<nav class=${"flex gap-0 px-4 bg-white/80 dark:bg-card-dark/80 border-b border-gray-200 dark:border-gray-700 backdrop-blur sticky top-[41px] z-30"}> ${TABS.map(tab => (
            htmlTag`<button key=${tab.id} onClick=${() => setActiveTab(tab.id)} class=${`flex items-center gap-1.5 px-4 py-2 text-xs font-medium transition-colors relative ${activeTab === tab.id ? 'tab-active' : 'text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'}`}> <${Icon} name=${tab.icon} size=${14} /> ${tab.label} ${tab.id === 'security' && criticalCount > 0 && (
                htmlTag`<span class=${"absolute -top-0.5 -right-0.5 bg-red-600 text-white text-[9px] font-bold rounded-full w-4 h-4 flex items-center justify-center"}>${criticalCount}</span>`
              )} </button>`
          ))} </nav>`
      )}  <main class=${"h-[calc(100vh-82px)]"} style=${status?.loaded ? { height: 'calc(100vh - 114px)' } : {}}> ${!status?.loaded ? (
          htmlTag`<${WelcomeScreen} onLoad=${handleLoad} showToast=${showToast} />`
        ) : (
          htmlTag` ${activeTab === 'waterfall' && htmlTag`<${WaterfallView} onInspect=${handleInspect} securityFindings=${securityFindings} />`} ${activeTab === 'inspector' && htmlTag`<${InspectorView} entryIndex=${selectedEntry} findingPath=${findingPath} securityFindings=${securityFindings} redactionMap=${redactionMap} onToggleRedaction=${toggleRedaction} />`} ${activeTab === 'security' && htmlTag`<${SecurityView} onInspect=${handleInspect} onRefreshSecurity=${refreshSecurity} />`} ${activeTab === 'decisions' && htmlTag`<${DecisionsView} onInspect=${handleInspect} onRefreshSecurity=${refreshSecurity} />`} ${activeTab === 'sequence' && htmlTag`<${SequenceView} onInspect=${handleInspect} isDark=${isDark} />`} ${activeTab === 'dashboard' && htmlTag`<${DashboardView} />`} ${activeTab === 'export' && htmlTag`<${ExportView} showToast=${showToast} />`} `
        )} </main> </div>`
  );
};

// --- Root Render ---
preact.render(htmlTag`<${ErrorBoundary}><${App} /><//>`, document.getElementById('root'));
</script>
</body>
</html>"""

