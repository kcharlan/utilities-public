// --- ExportView ---
const ExportView = ({ showToast }) => {
  const [security, setSecurity] = useState(null);
  const [exporting, setExporting] = useState(false);
  const [validating, setValidating] = useState(false);
  const [validationResult, setValidationResult] = useState(null);

  useEffect(() => { api('/api/security').then(setSecurity); }, []);

  const handleBulk = async (action, severity) => {
    await api('/api/security/bulk', { method: 'POST', body: JSON.stringify({ action, severity }) });
    const fresh = await api('/api/security');
    setSecurity(fresh);
  };

  const doExport = async (type) => {
    setExporting(true);
    try {
      let url, filename;
      if (type === 'har') {
        url = '/api/export/har';
        filename = 'sanitized.har';
      } else if (type === 'edl') {
        url = '/api/export/edl';
        filename = 'sanitized.edl.json';
      } else if (type === 'csv') {
        url = '/api/export/csv';
        filename = 'requests.csv';
      } else if (type === 'csv-findings') {
        url = '/api/export/csv-findings';
        filename = 'findings.csv';
      } else if (type === 'md') {
        url = '/api/export/report';
        filename = 'report.md';
      } else {
        url = '/api/export/report';
        filename = 'report.html';
      }

      const body = type === 'html' ? JSON.stringify({ format: 'html' }) : (type === 'md' ? JSON.stringify({ format: 'md' }) : '{}');
      const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
      if (!res.ok) {
        const err = await res.json().catch(() => ({ detail: 'Export failed' }));
        throw new Error(err.detail || `Export failed (${res.status})`);
      }
      const disposition = res.headers.get('Content-Disposition');
      if (disposition) {
        const fnMatch = disposition.match(/filename="?([^";]+)"?/);
        if (fnMatch) filename = fnMatch[1];
      }
      const blob = await res.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      a.click();
      URL.revokeObjectURL(a.href);
      showToast(`Exported ${type.toUpperCase()}`, 'success');
    } catch (e) {
      showToast(e.message, 'error');
    }
    setExporting(false);
  };

  const handleValidate = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json,.edl.json';
    input.onchange = async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      setValidating(true);
      setValidationResult(null);
      try {
        const formData = new FormData();
        formData.append('file', file);
        const res = await fetch('/api/validate', { method: 'POST', body: formData });
        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.detail || 'Validation failed');
        }
        const result = await res.json();
        setValidationResult(result);
        if (result.summary.valid) {
          showToast('Validation passed', 'success');
        } else {
          showToast(`Validation: ${result.summary.fail} failures, ${result.summary.error} errors`, 'error');
        }
      } catch (e) {
        showToast(e.message, 'error');
      }
      setValidating(false);
    };
    input.click();
  };

  if (!security) return htmlTag`<${LoadingSpinner} />`;

  const autoRedactCount = security.findings.filter(f => f.redact).length;
  const manualRedactions = security.manualRedactions || [];
  const manualRedactCount = manualRedactions.filter(m => m.redact).length;
  const totalRedactCount = autoRedactCount + manualRedactCount;

  return (
    htmlTag`<div class=${"p-6 overflow-auto h-full max-w-3xl mx-auto"}> <h2 class=${"text-lg font-bold text-ink dark:text-white mb-4"}>Export</h2>  <div class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 mb-6"}> <h3 class=${"text-sm font-semibold text-ink dark:text-white mb-3"}>Redaction Summary</h3> <p class=${"text-xs text-gray-500 dark:text-gray-400 mb-3"}> ${autoRedactCount} auto${manualRedactCount > 0 ? ` + ${manualRedactCount} manual` : ''} = ${totalRedactCount} value${totalRedactCount !== 1 ? 's' : ''} will be redacted </p> <div class=${"flex gap-2 mb-3"}> <button onClick=${() => handleBulk('select')} class=${"px-3 py-1 text-xs bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300 rounded hover:bg-red-200"}>Select All</button> <button onClick=${() => handleBulk('deselect')} class=${"px-3 py-1 text-xs bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300 rounded hover:bg-gray-200"}>Deselect All</button> </div> <div class=${"flex gap-2 flex-wrap"}> ${['critical', 'warning', 'info'].map(sev => {
            const count = security.findings.filter(f => f.severity === sev).length;
            const activeCount = security.findings.filter(f => f.severity === sev && f.redact).length;
            return (
              htmlTag`<div key=${sev} class=${"flex items-center gap-2 text-xs"}> <span class=${`capitalize ${severityColor(sev)}`}>${sev}: ${activeCount}/${count}</span> <button onClick=${() => handleBulk('select', sev)} class=${"text-blue-500 hover:underline"}>all</button> <button onClick=${() => handleBulk('deselect', sev)} class=${"text-gray-400 hover:underline"}>none</button> </div>`
            );
          })} </div> </div>  <div class=${"grid grid-cols-2 gap-4 mb-6"}> <button onClick=${() => doExport('har')} disabled=${exporting} class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors text-left disabled:opacity-50"}> <div class=${"flex items-center gap-2 mb-1"}><${Icon} name=${"Shield"} size=${16} className=${"text-green-600"} /><span class=${"font-medium text-sm text-ink dark:text-white"}>Sanitized HAR</span></div> <p class=${"text-xs text-gray-500"}>Download HAR with ${totalRedactCount} values redacted</p> </button> <button onClick=${() => doExport('edl')} disabled=${exporting} class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors text-left disabled:opacity-50"}> <div class=${"flex items-center gap-2 mb-1"}><${Icon} name=${"ClipboardList"} size=${16} className=${"text-amber-600"} /><span class=${"font-medium text-sm text-ink dark:text-white"}>Edit Decision List</span></div> <p class=${"text-xs text-gray-500"}>JSON decisions log (.edl.json) — ${totalRedactCount} redacted, ${security.findings.length - autoRedactCount} kept</p> </button> <button onClick=${() => doExport('csv')} disabled=${exporting} class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors text-left disabled:opacity-50"}> <div class=${"flex items-center gap-2 mb-1"}><${Icon} name=${"Table"} size=${16} className=${"text-blue-600"} /><span class=${"font-medium text-sm text-ink dark:text-white"}>CSV Requests</span></div> <p class=${"text-xs text-gray-500"}>Request summaries with finding counts</p> </button> <button onClick=${() => doExport('csv-findings')} disabled=${exporting} class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors text-left disabled:opacity-50"}> <div class=${"flex items-center gap-2 mb-1"}><${Icon} name=${"Table"} size=${16} className=${"text-red-600"} /><span class=${"font-medium text-sm text-ink dark:text-white"}>CSV Findings</span></div> <p class=${"text-xs text-gray-500"}>Security findings detail as spreadsheet</p> </button> <button onClick=${() => doExport('md')} disabled=${exporting} class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors text-left disabled:opacity-50"}> <div class=${"flex items-center gap-2 mb-1"}><${Icon} name=${"FileText"} size=${16} className=${"text-purple-600"} /><span class=${"font-medium text-sm text-ink dark:text-white"}>Markdown Report</span></div> <p class=${"text-xs text-gray-500"}>Analysis summary with stats and findings</p> </button> <button onClick=${() => doExport('html')} disabled=${exporting} class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors text-left disabled:opacity-50"}> <div class=${"flex items-center gap-2 mb-1"}><${Icon} name=${"Globe"} size=${16} className=${"text-orange-600"} /><span class=${"font-medium text-sm text-ink dark:text-white"}>HTML Report</span></div> <p class=${"text-xs text-gray-500"}>Shareable HTML report with formatting</p> </button> </div>  <div class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700 mb-6"}> <h3 class=${"text-sm font-semibold text-ink dark:text-white mb-2"}>Validate EDL</h3> <p class=${"text-xs text-gray-500 dark:text-gray-400 mb-3"}> Load a sanitized HAR, then upload the .edl.json to verify all redact/keep decisions were applied correctly. </p> <button onClick=${handleValidate} disabled=${validating} class=${"px-4 py-2 text-sm font-medium bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50 flex items-center gap-2"}> <${Icon} name=${"CheckCircle"} size=${16} /> ${validating ? 'Validating...' : 'Upload EDL to Validate'} </button> </div>  ${validationResult && (
        htmlTag`<div class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700"}> <div class=${"flex items-center gap-3 mb-4"}> <h3 class=${"text-sm font-semibold text-ink dark:text-white"}>Validation Results</h3> ${validationResult.summary.valid ? (
              htmlTag`<span class=${"px-2 py-0.5 text-xs font-bold rounded bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300"}>VALID</span>`
            ) : (
              htmlTag`<span class=${"px-2 py-0.5 text-xs font-bold rounded bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300"}>INVALID</span>`
            )} <span class=${"text-xs text-gray-500 dark:text-gray-400 ml-auto"}> ${validationResult.summary.pass} pass, ${validationResult.summary.fail} fail, ${validationResult.summary.error} error </span> </div> ${validationResult.results.length > 0 && (
            htmlTag`<div class=${"overflow-x-auto"}> <table class=${"w-full text-xs"}> <thead> <tr class=${"border-b border-gray-200 dark:border-gray-700 text-left"}> <th class=${"py-1 px-2 font-medium text-gray-500 dark:text-gray-400"}>Status</th> <th class=${"py-1 px-2 font-medium text-gray-500 dark:text-gray-400"}>#</th> <th class=${"py-1 px-2 font-medium text-gray-500 dark:text-gray-400"}>Action</th> <th class=${"py-1 px-2 font-medium text-gray-500 dark:text-gray-400"}>Area</th> <th class=${"py-1 px-2 font-medium text-gray-500 dark:text-gray-400"}>Key</th> <th class=${"py-1 px-2 font-medium text-gray-500 dark:text-gray-400"}>Detail</th> </tr> </thead> <tbody> ${validationResult.results.map((r, i) => {
