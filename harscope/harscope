def _he(v):
    """HTML-escape a value for safe interpolation into HTML templates."""
    return html_lib.escape(str(v) if v is not None else '')


def _md(v):
    """Escape markdown table-breaking characters."""
    return str(v).replace('|', '\\|').replace('`', '\\`')


