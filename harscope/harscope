const htmlTag = htm.bind(preact.h);




const {useState, useEffect, useCallback, useRef, useMemo} = preactHooks;

// --- Utilities ---
const api = async (path, opts = {}) => {
  const res = await fetch(path, {
    headers: { 'Content-Type': 'application/json', ...opts.headers },
    ...opts,
  });
  if (!res.ok) {
    const err = await res.json().catch(() => ({ detail: res.statusText }));
    throw new Error(err.detail || 'Request failed');
  }
  return res.json();
};

const formatBytes = (b) => {
  if (b === 0) return '0 B';
  if (b < 1024) return b + ' B';
  if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
  return (b / 1048576).toFixed(1) + ' MB';
};

const formatMs = (ms) => {
  if (ms < 1) return '<1 ms';
  if (ms < 1000) return Math.round(ms) + ' ms';
  return (ms / 1000).toFixed(2) + ' s';
};

const formatUrl = (url, maxLen = 60) => {
  try {
    const u = new URL(url);
    const path = u.pathname + u.search;
    if (path.length > maxLen) return path.slice(0, maxLen - 3) + '...';
    return path;
  } catch { return url.slice(0, maxLen); }
};

const statusColor = (s) => {
  if (s >= 500) return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300';
  if (s >= 400) return 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300';
  if (s >= 300) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300';
  if (s >= 200) return 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300';
  return 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
};

const severityColor = (s) => ({
  critical: 'text-red-600 dark:text-red-400',
  warning: 'text-amber-600 dark:text-amber-400',
  info: 'text-gray-500 dark:text-gray-400',
}[s] || 'text-gray-500');

const severityBg = (s) => ({
  critical: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300',
  warning: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300',
  info: 'bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300',
}[s] || 'bg-gray-100');

const TIMING_COLORS = {
  blocked: '#64748b', dns: '#06b6d4', connect: '#22c55e', ssl: '#a855f7',
  send: '#3b82f6', wait: '#eab308', receive: '#10b981',
};

// --- Icon Component ---
const Icon = ({ name, size = 18, className = '' }) => preact.h('span', { class: 'inline-flex items-center' }, preact.h(frontendKit.Icon, { name, size, class: className }));

// --- Toast ---
const Toast = ({ message, type = 'info', onClose }) => {
  useEffect(() => { const t = setTimeout(onClose, 3000); return () => clearTimeout(t); }, []);
  const bg = type === 'error' ? 'bg-red-600' : type === 'success' ? 'bg-green-600' : 'bg-blue-600';
  return (
    htmlTag`<div class=${`toast-enter fixed top-4 right-4 z-50 ${bg} text-white px-4 py-2 rounded-lg shadow-lg flex items-center gap-2 text-sm`}> <span>${message}</span> <button onClick=${onClose} class=${"ml-2 hover:opacity-70"}>×</button> </div>`
  );
};

// --- ErrorBoundary ---
class ErrorBoundary extends preact.Component {
  constructor(props) { super(props); this.state = { error: null }; }
  static getDerivedStateFromError(error) { return { error }; }
  render() {
    if (this.state.error) {
      return (
        htmlTag`<div class=${"flex items-center justify-center min-h-screen bg-cream dark:bg-ink p-8"}> <div class=${"bg-white dark:bg-card-dark rounded-xl p-8 shadow-lg max-w-lg"}> <h2 class=${"text-xl font-bold text-red-600 mb-2"}>Something went wrong</h2> <pre class=${"text-sm text-gray-600 dark:text-gray-400 whitespace-pre-wrap font-mono"}>${this.state.error.message}</pre> <button onClick=${() => this.setState({ error: null })} class=${"mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg text-sm"}>Reload</button> </div> </div>`
      );
    }
    return this.props.children;
  }
}

// --- StatusBadge ---
const StatusBadge = ({ status }) => (
  htmlTag`<span class=${`inline-block px-2 py-0.5 rounded text-xs font-mono font-medium ${statusColor(status)}`}>${status}</span>`
);

// --- LoadingSpinner ---
const LoadingSpinner = () => (
  htmlTag`<div class=${"flex items-center justify-center p-12"}> <div class=${"w-8 h-8 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"}></div> </div>`
);

// --- WelcomeScreen ---
const WelcomeScreen = ({ onLoad, showToast }) => {
  const [dragOver, setDragOver] = useState(false);
  const [pathInput, setPathInput] = useState('');
  const [loading, setLoading] = useState(false);
  const fileRef = useRef(null);

  const handleFile = async (file) => {
    setLoading(true);
    try {
      if (file.size > 50 * 1024 * 1024) {
        const form = new FormData();
        form.append('file', file);
        await fetch('/api/upload', { method: 'POST', body: form }).then(r => {
          if (!r.ok) throw new Error('Upload failed');
          return r.json();
        });
      } else {
        const text = await file.text();
        await api('/api/open-content', {
          method: 'POST',
          body: JSON.stringify({ content: text, filename: file.name }),
        });
      }
      onLoad();
    } catch (e) {
      showToast(e.message, 'error');
      if (fileRef.current) fileRef.current.value = '';
    }
    setLoading(false);
  };

  const handlePath = async () => {
    if (!pathInput.trim()) return;
    setLoading(true);
    try {
      await api('/api/open', { method: 'POST', body: JSON.stringify({ path: pathInput.trim() }) });
      onLoad();
    } catch (e) {
      showToast(e.message, 'error');
    }
    setLoading(false);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    setDragOver(false);
    const file = e.dataTransfer.files[0];
    if (file) handleFile(file);
  };

  if (loading) return htmlTag`<${LoadingSpinner} />`;

  return (
    htmlTag`<div class=${"flex flex-col items-center justify-center min-h-[70vh] px-4"}> <div class=${"text-center mb-8"}> <div class=${"flex items-center justify-center gap-3 mb-3"}> <${Icon} name=${"Shield"} size=${36} className=${"text-blue-600"} /> <h1 class=${"text-4xl font-bold text-ink dark:text-white tracking-tight"}>harscope</h1> </div> <p class=${"text-gray-500 dark:text-gray-400 text-lg"}>HAR File Analyzer & Sanitizer</p> </div> <div class=${`w-full max-w-lg border-2 border-dashed rounded-xl p-12 text-center transition-colors cursor-pointer
          ${dragOver ? 'drop-active border-blue-500' : 'border-gray-300 dark:border-gray-600 hover:border-gray-400 dark:hover:border-gray-500'}
          bg-white/50 dark:bg-white/5`} onDragOver=${(e) => { e.preventDefault(); setDragOver(true); }} onDragLeave=${() => setDragOver(false)} onDrop=${handleDrop} onClick=${() => fileRef.current?.click()}> <${Icon} name=${"FileUp"} size=${48} className=${"text-gray-400 mx-auto mb-4"} /> <p class=${"text-gray-600 dark:text-gray-300 font-medium mb-1"}>Drop a .har file here or click to browse</p> <p class=${"text-gray-400 dark:text-gray-500 text-sm"}>Maximum file size: 200 MB</p> <input ref=${fileRef} type=${"file"} accept=${".har"} class=${"hidden"} onInput=${(e) => e.target.files[0] && handleFile(e.target.files[0])} /> </div> <div class=${"flex items-center gap-3 mt-6 w-full max-w-lg"}> <input value=${pathInput} onInput=${(e) => setPathInput(e.target.value)} onKeyDown=${(e) => e.key === 'Enter' && handlePath()} placeholder=${"Or enter a file path..."} class=${"flex-1 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm text-ink dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"} /> <button onClick=${handlePath} class=${"px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors"}>Open</button> </div> </div>`
  );
};

// --- Filter Bar ---
const FilterBar = ({ domains, filters, onChange, total }) => {
  const statusOptions = ['2xx', '3xx', '4xx', '5xx'];
  return (
    htmlTag`<div class=${"flex items-center gap-3 px-4 py-2 bg-white/80 dark:bg-card-dark/80 border-b border-gray-200 dark:border-gray-700 backdrop-blur text-sm"}> <select value=${filters.domain || ''} onInput=${(e) => onChange({ ...filters, domain: e.target.value || null })} class=${"px-2 py-1 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs dark:text-white"}> <option value=${""}>All domains</option> ${domains.map(d => htmlTag`<option key=${d.domain} value=${d.domain}>${d.domain} (${d.count})</option>`)} </select> <select value=${filters.status || ''} onInput=${(e) => onChange({ ...filters, status: e.target.value || null })} class=${"px-2 py-1 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs dark:text-white"}> <option value=${""}>All statuses</option> ${statusOptions.map(s => htmlTag`<option key=${s} value=${s}>${s}</option>`)} </select> <input value=${filters.search || ''} onInput=${(e) => onChange({ ...filters, search: e.target.value || null })} placeholder=${"Search URLs..."} class=${"px-2 py-1 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs dark:text-white flex-1 max-w-xs focus:outline-none focus:ring-1 focus:ring-blue-500"} /> <span class=${"text-gray-400 dark:text-gray-500 text-xs ml-auto"}>${total} requests</span> </div>`
  );
};

// --- WaterfallView ---
const WaterfallView = ({ onInspect, securityFindings }) => {
  const [data, setData] = useState(null);
  const [domains, setDomains] = useState([]);
  const [filters, setFilters] = useState({});
  const [offset, setOffset] = useState(0);
  const limit = 50;

  // Build a map of entryIndex -> finding counts for security indicators
  const findingsByEntry = useMemo(() => {
    const map = {};
    (securityFindings || []).forEach(f => {
      if (!map[f.entryIndex]) map[f.entryIndex] = { total: 0, critical: 0 };
      map[f.entryIndex].total++;
      if (f.severity === 'critical') map[f.entryIndex].critical++;
    });
    return map;
  }, [securityFindings]);

  const fetchData = useCallback(async () => {
    const params = new URLSearchParams({ offset, limit });
    if (filters.domain) params.set('domain', filters.domain);
    if (filters.status) params.set('status', filters.status);
    if (filters.search) params.set('search', filters.search);
    const result = await api(`/api/waterfall?${params}`);
    setData(result);
  }, [offset, filters]);

  useEffect(() => { api('/api/domains').then(setDomains); }, []);
  useEffect(() => { fetchData(); }, [fetchData]);

  if (!data) return htmlTag`<${LoadingSpinner} />`;

  const totalPages = Math.ceil(data.total / limit);
  const currentPage = Math.floor(offset / limit) + 1;

  return (
    htmlTag`<div class=${"flex flex-col h-full"}> <${FilterBar} domains=${domains} filters=${filters} onChange=${(f) => { setFilters(f); setOffset(0); }} total=${data.total} /> <div class=${"grid grid-cols-[24px_42px_60px_50px_1fr_70px_70px_minmax(200px,2fr)] gap-0 px-4 py-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700 bg-white/50 dark:bg-card-dark/50"}> <span></span><span class=${"font-mono"}>#</span><span>Status</span><span>Method</span><span>URL</span><span class=${"text-right"}>Size</span><span class=${"text-right"}>Time</span><span class=${"pl-4"}>Waterfall</span> </div> <div class=${"flex-1 overflow-auto"}> ${data.entries.map((entry) => {
          const ef = findingsByEntry[entry.index];
          return (
          htmlTag`<div key=${entry.index} onClick=${() => onInspect(entry.index)} class=${`grid grid-cols-[24px_42px_60px_50px_1fr_70px_70px_minmax(200px,2fr)] gap-0 px-4 py-1.5 text-xs border-b cursor-pointer items-center ${ef ? 'bg-red-50/40 dark:bg-red-900/5 border-red-100 dark:border-red-900/20 hover:bg-red-50 dark:hover:bg-red-900/10' : 'border-gray-100 dark:border-gray-800 hover:bg-blue-50/50 dark:hover:bg-blue-900/10'}`}> <span class=${"flex items-center justify-center"}> ${ef && htmlTag`<span title=${`${ef.total} finding${ef.total !== 1 ? 's' : ''}${ef.critical ? ` (${ef.critical} critical)` : ''}`}> <${Icon} name=${"ShieldAlert"} size=${14} className=${ef.critical ? 'text-red-500' : 'text-amber-500'} /> </span>`} </span> <span class=${"inline-flex items-center justify-center px-1.5 py-0.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded text-xs font-mono font-bold"}>${entry.index}</span> <span><${StatusBadge} status=${entry.status} /></span> <span class=${"font-mono text-gray-600 dark:text-gray-400"}>${entry.method}</span> <span class=${"font-mono text-ink dark:text-gray-200 truncate"} title=${entry.url}>${formatUrl(entry.url, 80)}</span> <span class=${"text-right text-gray-500 dark:text-gray-400"}>${formatBytes(entry.bodySize)}</span> <span class=${"text-right text-gray-500 dark:text-gray-400"}>${formatMs(entry.time)}</span> <div class=${"pl-4"}> <${WaterfallBar} entry=${entry} maxEnd=${data.maxEndTime} /> </div> </div>`
          );
        })} </div> ${totalPages > 1 && (
        htmlTag`<div class=${"flex items-center justify-center gap-4 px-4 py-2 border-t border-gray-200 dark:border-gray-700 bg-white/50 dark:bg-card-dark/50"}> <button onClick=${() => setOffset(Math.max(0, offset - limit))} disabled=${offset === 0} class=${"px-3 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 disabled:opacity-30 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white"}>Prev</button> <span class=${"text-xs text-gray-500 dark:text-gray-400"}>${currentPage} / ${totalPages}</span> <button onClick=${() => setOffset(offset + limit)} disabled=${offset + limit >= data.total} class=${"px-3 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 disabled:opacity-30 hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white"}>Next</button> </div>`
      )} </div>`
  );
};

const WaterfallBar = ({ entry, maxEnd }) => {
  if (!maxEnd || maxEnd === 0) return null;
  const t = entry.timings;
  const total = t.blocked + t.dns + t.connect + t.ssl + t.send + t.wait + t.receive;
  if (!total) return htmlTag`<div class=${"relative h-4"} title=${"0 ms"} />`;
  const startPct = (entry.startOffset / maxEnd) * 100;
  const widthPct = Math.max(0.5, (total / maxEnd) * 100);
  const segments = [
    { key: 'blocked', val: t.blocked, color: TIMING_COLORS.blocked },
    { key: 'dns', val: t.dns, color: TIMING_COLORS.dns },
    { key: 'connect', val: t.connect, color: TIMING_COLORS.connect },
    { key: 'ssl', val: t.ssl, color: TIMING_COLORS.ssl },
    { key: 'send', val: t.send, color: TIMING_COLORS.send },
    { key: 'wait', val: t.wait, color: TIMING_COLORS.wait },
    { key: 'receive', val: t.receive, color: TIMING_COLORS.receive },
  ].filter(s => s.val > 0);

  return (
    htmlTag`<div class=${"relative h-4"} title=${`${formatMs(total)}`}> <div class=${"timing-bar absolute top-0"} style=${{ left: `${startPct}%`, width: `${widthPct}%` }}> ${segments.map(s => (
          htmlTag`<div key=${s.key} class=${"timing-segment"} style=${{ backgroundColor: s.color, width: `${(s.val / total) * 100}%` }} title=${`${s.key}: ${formatMs(s.val)}`} />`
        ))} </div> </div>`
  );
};

// --- InspectorView ---
const InspectorView = ({ entryIndex, findingPath, securityFindings, redactionMap, onToggleRedaction }) => {
  const [data, setData] = useState(null);
  const [section, setSection] = useState('request');
  const [subTab, setSubTab] = useState('headers');

  // Determine which security findings apply to this entry
  const entryFindings = useMemo(() => {
    if (!securityFindings || entryIndex === null) return [];
    return securityFindings.filter(f => f.entryIndex === entryIndex);
  }, [securityFindings, entryIndex]);

  // Classify each finding as request or response, then by sub-tab
  const findingCounts = useMemo(() => {
    const counts = {
      request: { total: 0, headers: 0, cookies: 0, query: 0, body: 0 },
      response: { total: 0, headers: 0, cookies: 0, body: 0 },
      websocket: 0,
    };
    entryFindings.forEach(f => {
      const loc = (f.location || '').toLowerCase();
      if (loc.includes('_websocketmessages')) { counts.websocket++; return; }

      // Determine request vs response
      const isResp = loc.includes('.response.') || (loc.includes('(parsed)') && loc.includes('.content'));
      const side = isResp ? 'response' : 'request';
      counts[side].total++;

      if (loc.includes('header') || loc.includes('.headers')) counts[side].headers++;
      else if (loc.includes('cookie')) counts[side].cookies++;
      else if (loc.includes('querystring') || loc.includes('url_param')) counts[side].query = (counts[side].query || 0) + 1;
      else if (loc.includes('body') || loc.includes('postdata') || loc.includes('content') || loc.includes('(parsed)')) counts[side].body++;
    });
    return counts;
  }, [entryFindings]);

  useEffect(() => {
    if (entryIndex === null || entryIndex === undefined) { setData(null); return; }
    api(`/api/entry/${entryIndex}`).then(setData);
  }, [entryIndex]);

  // Auto-navigate to the right tab based on finding path
  useEffect(() => {
    if (!findingPath || !data) return;
    const p = findingPath.toLowerCase();
    if (p.includes('_websocketmessages')) {
      setSubTab('websocket');
    } else if (p.includes('response.')) {
      setSection('response');
      if (p.includes('headers')) setSubTab('headers');
      else if (p.includes('cookies')) setSubTab('cookies');
      else if (p.includes('content')) setSubTab('body');
    } else if (p.includes('request.')) {
      setSection('request');
      if (p.includes('headers')) setSubTab('headers');
      else if (p.includes('cookies')) setSubTab('cookies');
      else if (p.includes('querystring')) setSubTab('query');
      else if (p.includes('postdata')) setSubTab('body');
    } else if (p.includes('(parsed)')) {
      if (p.includes('request')) { setSection('request'); setSubTab('body'); }
      else { setSubTab('raw'); }
    } else {
      setSubTab('raw');
    }
  }, [findingPath, data]);

  if (entryIndex === null || entryIndex === undefined) {
    return (
      htmlTag`<div class=${"flex items-center justify-center h-full text-gray-400 dark:text-gray-500"}> <div class=${"text-center"}> <${Icon} name=${"MousePointerClick"} size=${48} className=${"mx-auto mb-3 opacity-50"} /> <p>Select a request from the Waterfall to inspect</p> </div> </div>`
    );
  }
  if (!data) return htmlTag`<${LoadingSpinner} />`;

  const entry = data.entry;
  const req = entry.request || {};
  const resp = entry.response || {};
  const active = section === 'request' ? req : resp;

  const headers = active.headers || [];
  const cookies = section === 'request' ? (req.cookies || []) : (resp.cookies || []);
  const queryString = req.queryString || [];
  const body = section === 'request' ? (req.postData || {}) : (resp.content || {});
  const timings = entry.timings || {};
  const wsMessages = entry._webSocketMessages || [];

  // Build dynamic sub-tabs based on what exists, using section-specific counts
  const sideCounts = findingCounts[section] || { headers: 0, cookies: 0, query: 0, body: 0 };
  const subTabs = [];
  subTabs.push({ id: 'headers', label: 'Headers', count: headers.length, alertCount: sideCounts.headers });
  if (cookies.length) subTabs.push({ id: 'cookies', label: 'Cookies', count: cookies.length, alertCount: sideCounts.cookies });
  if (section === 'request' && queryString.length) subTabs.push({ id: 'query', label: 'Query', count: queryString.length, alertCount: sideCounts.query || 0 });
  if ((body.text || '').length > 0 || (section === 'request' && req.postData?.params?.length))
    subTabs.push({ id: 'body', label: 'Body', alertCount: sideCounts.body });
  if (wsMessages.length) subTabs.push({ id: 'websocket', label: 'WebSocket', count: wsMessages.length, alertCount: findingCounts.websocket });
  subTabs.push({ id: 'timings', label: 'Timings' });
  // Findings tab shows only findings for current section (+ websocket which is neutral)
  const sectionFindings = entryFindings.filter(f => {
    const loc = (f.location || '').toLowerCase();
    if (loc.includes('_websocketmessages')) return true;
    const isResp = loc.includes('.response.') || (loc.includes('(parsed)') && loc.includes('.content'));
    return section === 'response' ? isResp : !isResp;
  });
  if (sectionFindings.length) subTabs.push({ id: 'findings', label: 'Findings', count: sectionFindings.length, alert: true });
  subTabs.push({ id: 'raw', label: 'Raw' });

  // Use valid sub-tab (fall back to first if current doesn't exist in list)
  const activeSubTab = subTabs.find(t => t.id === subTab) ? subTab : (subTabs[0]?.id || 'headers');

  return (
    htmlTag`<div class=${"flex flex-col h-full"}> <div class=${"px-4 py-3 bg-white/80 dark:bg-card-dark/80 border-b border-gray-200 dark:border-gray-700"}> <div class=${"flex items-center gap-3 mb-2"}> <span class=${"inline-flex items-center px-1.5 py-0.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded text-xs font-mono font-bold"}>#${entryIndex}</span> <${StatusBadge} status=${data.status} /> <span class=${"font-mono font-medium text-sm text-ink dark:text-white"}>${data.method}</span> <span class=${"font-mono text-xs text-gray-500 dark:text-gray-400 truncate flex-1"} title=${data.url}>${data.url}</span> <span class=${"text-xs text-gray-400"}>${formatMs(data.time)}</span> ${entryFindings.length > 0 && (
            htmlTag`<span class=${"inline-flex items-center gap-1 px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full text-xs font-medium"}> <${Icon} name=${"Shield"} size=${12} /> ${entryFindings.length} finding${entryFindings.length !== 1 ? 's' : ''} </span>`
          )} </div> <div class=${"flex gap-1"}> <button onClick=${() => setSection('request')} class=${`px-3 py-1 text-xs rounded-full flex items-center gap-1 ${section === 'request' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 font-medium' : 'text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700'}`}> Request ${findingCounts.request.total > 0 && htmlTag`<span class=${"text-[10px] px-1 rounded-full bg-red-500 text-white"}>${findingCounts.request.total}</span>`} </button> <button onClick=${() => setSection('response')} class=${`px-3 py-1 text-xs rounded-full flex items-center gap-1 ${section === 'response' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 font-medium' : 'text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700'}`}> Response ${findingCounts.response.total > 0 && htmlTag`<span class=${"text-[10px] px-1 rounded-full bg-red-500 text-white"}>${findingCounts.response.total}</span>`} </button> </div> </div> <div class=${"flex gap-1 px-4 py-1 border-b border-gray-200 dark:border-gray-700 bg-white/50 dark:bg-card-dark/50 flex-wrap"}> ${subTabs.map(t => (
          htmlTag`<button key=${t.id} onClick=${() => setSubTab(t.id)} class=${`px-3 py-1 text-xs rounded flex items-center gap-1 ${activeSubTab === t.id ? 'bg-gray-200 dark:bg-gray-700 font-medium text-ink dark:text-white' : 'text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700'}`}> ${t.label} ${t.alertCount > 0 && htmlTag`<span class=${"text-[10px] px-1 rounded-full bg-red-500 text-white"}>${t.alertCount}</span>`} ${t.count !== undefined && !t.alert && htmlTag`<span class=${"text-[10px] px-1 rounded-full bg-gray-300 dark:bg-gray-600 text-gray-600 dark:text-gray-300"}>${t.count}</span>`} ${t.alert && htmlTag`<span class=${"text-[10px] px-1 rounded-full bg-red-500 text-white"}>${t.count}</span>`} </button>`
        ))} </div> <div class=${"flex-1 overflow-auto p-4"}> ${activeSubTab === 'headers' && htmlTag`<${HeaderTable} headers=${headers} findings=${entryFindings} section=${section} entryIndex=${entryIndex} redactionMap=${redactionMap} onToggleRedaction=${onToggleRedaction} />`} ${activeSubTab === 'cookies' && htmlTag`<${CookieTable} cookies=${cookies} findings=${entryFindings} section=${section} entryIndex=${entryIndex} redactionMap=${redactionMap} onToggleRedaction=${onToggleRedaction} />`} ${activeSubTab === 'query' && htmlTag`<${ParamTable} params=${queryString} findings=${entryFindings} entryIndex=${entryIndex} redactionMap=${redactionMap} onToggleRedaction=${onToggleRedaction} />`} ${activeSubTab === 'body' && htmlTag`<${BodyViewer} body=${body} findings=${entryFindings} section=${section} entryIndex=${entryIndex} redactionMap=${redactionMap} onToggleRedaction=${onToggleRedaction} />`} ${activeSubTab === 'websocket' && htmlTag`<${WebSocketViewer} messages=${wsMessages} findings=${entryFindings} entryIndex=${entryIndex} redactionMap=${redactionMap} onToggleRedaction=${onToggleRedaction} />`} ${activeSubTab === 'timings' && htmlTag`<${TimingsChart} timings=${timings} totalTime=${data.time} />`} ${activeSubTab === 'findings' && htmlTag`<${EntryFindings} findings=${sectionFindings} />`} ${activeSubTab === 'raw' && htmlTag`<${RawViewer} entry=${entry} />`} </div> </div>`
  );
};

// Check if a header/cookie name is flagged by any finding for this section
const isFlagged = (findings, name, section) => {
  if (!findings || !name) return false;
  const lower = name.toLowerCase();
  const sectionKey = section === 'response' ? '.response.' : '.request.';
  return findings.some(f => {
    const loc = f.location.toLowerCase();
    if (!loc.includes(sectionKey)) return false;
    return loc.includes(`.${lower}`) || loc.endsWith(`.${lower}`);
  });
};

