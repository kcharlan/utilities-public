white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700"}> <${BarChart} data=${stats.domains} label=${"Top Domains"} /> </div> </div> <div class=${"grid grid-cols-2 gap-6 mb-8"}> <div class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700"}> <${BarChart} data=${stats.contentTypes} label=${"Content Types"} colorFn=${() => '#8b5cf6'} /> </div> <div class=${"bg-white dark:bg-card-dark rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700"}> <h3 class=${"text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-3"}>Timing Percentiles</h3> ${Object.entries(stats.timingPercentiles || {}).map(([k, v]) => (
