(version 1)
(allow default)
; Only temporary scratch data may be written by tests.
(deny file-write*)
(allow file-write* (subpath "/private/tmp") (subpath "/tmp")
    (literal "/dev/null"))
(deny file-write*
    (subpath (param "PROJECT_DIR"))
    (subpath (string-append (param "REAL_HOME") "/.codex"))
    (subpath (string-append (param "REAL_HOME") "/.colophon"))
    (subpath (string-append (param "REAL_HOME") "/Library/Scripts"))
    (subpath (string-append (param "REAL_HOME") "/.local/bin"))
    (subpath (string-append (param "REAL_HOME") "/bin"))
    (subpath "/private/tmp/colophon-native-canary"))
(deny file-read* file-write*
    (subpath (string-append (param "REAL_HOME") "/Downloads/colophon-native"))
    (subpath (string-append (param "REAL_HOME") "/Downloads/colophon-c-experiment")))
; Claude-owned sources and config are never real test inputs.
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.claude")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.config/claude")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/Library/Application Support/Claude")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.claude-swap-backup")))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network* (local unix-socket) (remote unix-socket))
; OpenCode-owned source, state and credentials are never real test inputs.
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.local/share/opencode")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.local/state/opencode")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.config/opencode")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/.cache/opencode")))
(deny file-read* file-write* (subpath (string-append (param "REAL_HOME") "/Library/Application Support/ai.opencode.desktop")))
