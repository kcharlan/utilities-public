# ===== 4. Utilities =====
def now_ms() -> int:
    """Return the wall-clock instant in UTC epoch milliseconds."""
    return time.time_ns() // 1_000_000


def parse_rfc3339_ms(value) -> int | None:
    """Parse an aware RFC 3339 instant, retaining millisecond precision."""
    if not isinstance(value, str) or not re.fullmatch(
        r"\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})",
        value,
    ):
        return None
    if value[-1] not in "Zz" and (
        int(value[-5:-3]) > 23 or int(value[-2:]) > 59
    ):
        return None
    try:
        instant = datetime.fromisoformat(value.upper().replace("Z", "+00:00"))
        delta = instant.astimezone(timezone.utc) - datetime(1970, 1, 1, tzinfo=timezone.utc)
    except (ValueError, OverflowError):
        return None
    return (delta.days * 86_400 + delta.seconds) * 1000 + delta.microseconds // 1000


def format_rfc3339(ms: int) -> str:
    """Format UTC epoch milliseconds at whole-second ledger precision."""
    instant = datetime(1970, 1, 1, tzinfo=timezone.utc) + timedelta(milliseconds=ms)
    return instant.isoformat(timespec="seconds").replace("+00:00", "Z")


def epoch_to_ms(value, *, milliseconds: bool = False) -> int | None:
    """Convert a finite numeric epoch value; seconds are the default unit."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, float) and not math.isfinite(value):
        return None
    numeric = Decimal(repr(value))
    return int(numeric if milliseconds else numeric.scaleb(3))


def abbreviate_home(path: Path | str) -> str:
    """Shorten only paths at or below the current user's home directory."""
    candidate = Path(path)
    try:
        relative = candidate.relative_to(Path.home())
    except ValueError:
        return str(candidate)
    return "~" if relative == Path(".") else f"~/{relative}"


def runtime_home() -> Path:
    """Return the mutable runtime directory, expanding a home override."""
    return Path(os.environ.get("COLOPHON_HOME", "~/.colophon")).expanduser()


def ensure_runtime_home(path: Path) -> Path:
    """Create a private runtime directory and restore its permissions."""
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Write a complete private file before replacing its destination."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    fd_owned = True
    try:
        os.fchmod(fd, mode)
        fh = os.fdopen(fd, "wb")
        fd_owned = False
        with fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        if fd_owned:
            with contextlib.suppress(OSError):
                os.close(fd)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def atomic_write_json(path: Path, obj, *, indent: int | None = 2) -> None:
    """Write readable UTF-8 JSON with a terminating newline."""
    data = (json.dumps(obj, indent=indent, ensure_ascii=True) + "\n").encode("utf-8")
    atomic_write_bytes(path, data)


# ===== 5. Log reading =====
class RawLine(NamedTuple):
    index: int
    data: bytes
    terminated: bool


class DecodedLine(NamedTuple):
    obj: dict | None
    status: Literal["ok", "recovered", "malformed", "blank"]


def iter_log_lines(fh: BinaryIO, size: int) -> Iterator[RawLine]:
    """Stream physical lines within the caller's scan-start byte boundary."""
    remaining = size
    buffer = bytearray()
    index = 0
    while remaining > 0:
        chunk = fh.read(min(1024 * 1024, remaining))
        if not chunk:
            break
        remaining -= len(chunk)
        search_from = len(buffer)
        buffer.extend(chunk)
        start = 0
        while (end := buffer.find(b"\n", search_from)) >= 0:
            yield RawLine(index, bytes(buffer[start:end]), True)
            index += 1
            start = search_from = end + 1
        if start:
            del buffer[:start]
    if buffer:
        yield RawLine(index, bytes(buffer), False)


def _json_object(data: bytes) -> dict | None:
    try:
        obj = json.loads(data)
    except (ValueError, UnicodeError, RecursionError):
        return None
    return obj if isinstance(obj, dict) else None


def decode_line(data: bytes) -> DecodedLine:
    """Decode a terminated line, recovering a valid suffix after crash debris."""
    if not data.strip():
        return DecodedLine(None, "blank")
    obj = _json_object(data)
    if obj is not None:
        return DecodedLine(obj, "ok")
    start = 1
    while True:
        candidates = [pos for marker in (b'{"timestamp"', b'{"type"')
                      if (pos := data.find(marker, start)) >= 0]
        if not candidates:
            return DecodedLine(None, "malformed")
        pos = min(candidates)
        obj = _json_object(data[pos:])
        if obj is not None:
            return DecodedLine(obj, "recovered")
        start = pos + 1


# ===== 6. Per-file parse =====
def _object(value) -> dict:
    return value if isinstance(value, dict) else {}


def _empty_tool_counts() -> ToolCounts:
    return {"shell": 0, "shell_failed": 0, "file_edits": 0, "mcp": {},
            "web": 0, "image": 0, "other": {}}


def _merge_tool_counts(target: ToolCounts, source: ToolCounts) -> None:
    for key, value in source.items():
        if key in ("mcp", "other"):
            for name, count in value.items():
                target[key][name] = target[key].get(name, 0) + count
        else:
            target[key] += value


class ToolTally:
    """Keep both representations until structured precedence is known."""

    def __init__(self):
        self.has_structured = False
        self.structured = _empty_tool_counts()
        self.raw = _empty_tool_counts()

    @staticmethod
    def _group(counts: ToolCounts, category: str, name) -> None:
        if _history_identifier(name) is not None:
            counts[category][name] = counts[category].get(name, 0) + 1

    def add_structured(self, item: dict) -> None:
        item = _object(item)
        kind = item.get("type")
        if not isinstance(kind, str) or kind not in STRUCTURED_TOOL_TYPES:
            return
        self.has_structured = True
        counts = self.structured
        if kind == "CommandExecution":
            counts["shell"] += 1
            exit_code = item.get("exit_code")
            if isinstance(exit_code, int) and not isinstance(exit_code, bool) and exit_code != 0:
                counts["shell_failed"] += 1
        elif kind == "FileChange":
            counts["file_edits"] += len(_object(item.get("changes")))
        elif kind == "McpToolCall":
            self._group(counts, "mcp", item.get("server"))
        elif kind == "WebSearch":
            counts["web"] += 1
        elif kind == "ImageView":
            counts["image"] += 1
        elif item.get("kind") == "web.search":
            counts["web"] += 1
        elif item.get("kind") != "clock.sleep":
            self._group(counts, "other", item.get("kind"))

    def _add_js(self, text: str) -> None:
        for name in JS_TOOL_CALL.findall(text):
            if name in ORCHESTRATION_JS or name.startswith("collaboration__"):
                continue
            if name == "exec_command":
                self.raw["shell"] += 1
            elif name == "apply_patch":
                self.raw["file_edits"] += 1
            elif name.startswith("mcp__"):
                server, _, tool = name[5:].partition("__")
                if server and tool:
                    self._group(self.raw, "mcp", server)
                else:
                    self._group(self.raw, "other", name)
            elif name == "web__run":
                self.raw["web"] += 1
            elif name == "view_image":
                self.raw["image"] += 1
            else:
                self._group(self.raw, "other", name)
        self.raw["web"] += len(JS_WEB_CALL.findall(text))

    def add_raw(self, record: dict) -> None:
        if _object(record).get("type") != "response_item":
            return
        payload = _object(record.get("payload"))
        kind, name, namespace = (payload.get(key) for key in ("type", "name", "namespace"))
        if kind == "local_shell_call":
            self.raw["shell"] += 1
        elif kind == "web_search_call":
            self.raw["web"] += 1
        elif kind == "custom_tool_call":
            if name == "apply_patch":
                self.raw["file_edits"] += 1
            elif name == "exec" and isinstance(payload.get("input"), str):
                self._add_js(payload["input"])
        elif kind == "function_call" and _history_identifier(name) is not None:
            if namespace in ("collaboration", "clock") or name in ORCHESTRATION_FUNCTIONS:
                return
            if namespace is not None and not isinstance(namespace, str):
                return
            if name in ("exec_command", "shell") and not namespace:
                self.raw["shell"] += 1
            elif namespace and namespace.startswith("mcp__"):
                self._group(self.raw, "mcp", namespace[5:])
            elif namespace == "web" and name == "run":
                self.raw["web"] += 1
            elif name == "view_image":
                self.raw["image"] += 1
            else:
                self._group(self.raw, "other", f"{namespace}:{name}" if namespace else name)

    def result(self) -> ToolCounts:
        counts = _empty_tool_counts()
        _merge_tool_counts(counts, self.structured if self.has_structured else self.raw)
        return counts


class ToolCandidate(NamedTuple):
    structured: bool
    counts: ToolCounts


def _tool_candidate(record: dict, payload: dict, kind: str) -> ToolCandidate | None:
    structured = (kind.startswith("event_msg/item_completed/")
                  and kind.removeprefix("event_msg/item_completed/") in STRUCTURED_TOOL_TYPES)
    if not structured and kind not in (
        "response_item/function_call", "response_item/custom_tool_call",
        "response_item/local_shell_call", "response_item/web_search_call",
    ):
        return None
    tally = ToolTally()
    if structured:
        tally.add_structured(_object(payload.get("item")))
    elif kind.startswith("response_item/"):
        tally.add_raw(record)
    counts = tally.result()
    if tally.has_structured or any(counts.values()):
        return ToolCandidate(tally.has_structured, counts)
    return None


class LinkCandidate(NamedTuple):
    kind: str
    values: tuple


def _json_fields(value) -> dict:
    if not isinstance(value, str):
        return {}
    try:
        return _object(json.loads(value))
    except (ValueError, RecursionError):
        return {}


def _link_candidate(payload: dict, kind: str) -> LinkCandidate | None:
    item = _object(payload.get("item"))
    if kind == "event_msg/item_completed/SubAgentActivity":
        return LinkCandidate("activity", tuple(_history_identifier(item.get(key))
                             for key in ("kind", "agent_thread_id", "agent_path")))
    if kind == "event_msg/item_completed/CollabAgentToolCall":
        receivers = item.get("receiver_thread_ids")
        return LinkCandidate("receivers", tuple(value for value in receivers
                             if _history_identifier(value) is not None) if isinstance(receivers, list) else ())
    if kind == "response_item/function_call" and payload.get("namespace") == "collaboration":
        name = payload.get("name")
        if name == "spawn_agent":
            return LinkCandidate("spawn", (_history_identifier(payload.get("call_id")),))
        if name in ("followup_task", "send_message"):
            return LinkCandidate("target", (_history_identifier(
                _json_fields(payload.get("arguments")).get("target")),))
    if kind == "response_item/function_call_output":
        return LinkCandidate("output", (_history_identifier(payload.get("call_id")),
                             _history_identifier(_json_fields(payload.get("output")).get("task_name"))))
    return None


def _usage_timestamp_unix_ms(timestamp) -> int | None:
    # parseNativeRFC3339 keeps only three fraction digits (Timestamp.swift:59–69)
    # before unixMilliseconds rounds date * 1000 (Scanner.swift:4262–4267).
    # The existing strict parser already yields those integral native ms;
    # the broader upstream historical parsing/routing belongs to Task 7.
    return parse_rfc3339_ms(timestamp)


def _usage_record(record: dict, payload: dict, fact: RecordFact) -> dict:
    usage = _object(payload.get("usage"))
    timestamp = record.get("timestamp")
    return {"line": fact.line, "rec": fact.rec,
            **{key: payload.get(key) for key in ("response_id", "thread_id", "turn_id", "root_turn_id")},
            "ts": timestamp, "at_ms": fact.at_ms,
            "timestamp_unix_ms": _usage_timestamp_unix_ms(timestamp),
            **{target: usage.get(source) for target, source in (
                ("input", "input_tokens"), ("cached_input", "cached_input_tokens"),
                ("cache_read_input", "cache_read_input_tokens"), ("cache_write", "cache_write_input_tokens"),
                ("output", "output_tokens"), ("reasoning", "reasoning_output_tokens"))}}


def record_type_key(record: dict) -> str:
    """Classify only the documented record and bare-usage containers."""
    kind = record.get("type")
    if "type" not in record:
        # codexBareUsage containers, CodexBar 3bbf6bc48, Scanner.swift:3914–3923.
        containers = [record, *(_object(record.get(key)) for key in ("data", "result", "response"))]
        if any(isinstance(container.get("usage"), dict) for container in containers):
            return "bare_usage"
    if not isinstance(kind, str):
        kind = "unknown"
    if kind in ("event_msg", "response_item"):
        payload = _object(record.get("payload"))
        subtype = payload.get("type")
        subtype = subtype if isinstance(subtype, str) else "unknown"
        if kind == "event_msg" and subtype == "item_completed":
            item_type = _object(payload.get("item")).get("type")
            item_type = item_type if isinstance(item_type, str) else "unknown"
            return f"{kind}/{subtype}/{item_type}"
        return f"{kind}/{subtype}"
    return kind


def event_time(record: dict, payload: dict) -> tuple[int | None, str]:
    """Prefer the payload's lifecycle clock, preserving wrapper precision."""
    wrapper = parse_rfc3339_ms(record.get("timestamp"))
    kind = payload.get("type")
    if kind == "task_started":
        keys = ("started_at_ms", "started_at")
    elif kind in ("task_complete", "turn_aborted"):
        keys = ("completed_at_ms", "completed_at")
    else:
        keys = ("completed_at_ms",)
    for key in keys:
        value = payload.get(key)
        milliseconds = key.endswith("_ms")
        instant = epoch_to_ms(value, milliseconds=milliseconds)
        if instant is None:
            continue
        if not milliseconds and wrapper is not None:
            if abs(Decimal(repr(value)).scaleb(3) - wrapper) < 2000:
                return wrapper, "record_timestamp"
        return instant, key
    return wrapper, "record_timestamp"


def _session_meta(record: dict, payload: dict) -> dict:
    """Extract true-first display identity; the token pre-pass is separate."""
    # codexSessionMetadata(from:), CodexBar 3bbf6bc48, Scanner.swift:3994–4011.
    candidates = (payload.get("id"), record.get("id"), payload.get("session_id"),
                  payload.get("sessionId"), record.get("session_id"), record.get("sessionId"))
    session_id = next((value for value in candidates if isinstance(value, str)), None)
    source = payload.get("source")
    subagent = _object(source).get("subagent")
    is_subagent = (source.strip().lower() == "subagent" if isinstance(source, str)
                   else isinstance(subagent, (str, dict)))
    spawn = _object(_object(subagent).get("thread_spawn"))
    git = _object(payload.get("git"))
    created_at = parse_rfc3339_ms(payload.get("timestamp"))
    if created_at is None:
        created_at = event_time(record, payload)[0]
    # codexForkParentId(from:), Scanner.swift:3476–3487.
    forked_from = next((value.strip() for key in (
        "forked_from_id", "forkedFromId", "parent_session_id", "parentSessionId")
        if isinstance(value := payload.get(key), str) and value.strip()), None)
    return {
        "id": session_id, "created_at_ms": created_at,
        "timestamp_raw": payload.get("timestamp", record.get("timestamp")),
        "cwd": payload.get("cwd"), "originator": payload.get("originator"),
        "cli_version": payload.get("cli_version"), "forked_from_id": forked_from,
        "is_subagent": is_subagent,
        **{key: spawn.get(key) for key in (
            "parent_thread_id", "depth", "agent_path", "agent_nickname", "agent_role")},
        "git": {"branch": git.get("branch"), "origin_url": git.get("repository_url"),
                "sha": git.get("commit_hash")},
        "rollout_title": payload.get("thread_name") or payload.get("title"),
    }


def classify_user_part(text: str) -> tuple[str, str] | None:
    """Apply spec §5.1's ordered context, answer and image filters."""
    text = text.lstrip()
    if text.startswith(CONTEXT_WRAPPERS):
        lines = text.splitlines()
        for index, line in enumerate(lines):
            if line.strip() in REQUEST_HEADINGS:
                return "text", "\n".join(lines[index + 1:]).strip()
        return None
    if text.startswith(INJECTED_PREFIXES):
        return None
    opening, closing = f"<{ANSWER_TAG}>", f"</{ANSWER_TAG}>"
    if text.startswith(opening):
        return "answer", text[len(opening):].strip().removesuffix(closing).strip()
    if text.startswith("<image") or text.strip() == "</image>":
        return None
    return "text", text.strip()


class MessageCandidate(NamedTuple):
    """Compact display content only; family and raw ID are transient evidence."""
    role: str
    kind: str
    text: str
    images: int
    family: str


class VoiceSegment(NamedTuple):
    role: str
    text: str


def _message_candidate(payload: dict, kind: str) -> MessageCandidate | None:
    if kind in ("event_msg/item_completed/UserMessage", "event_msg/item_completed/AgentMessage"):
        content = _object(payload.get("item"))
        role = "user" if kind.endswith("/UserMessage") else "assistant"
        family = "item"
    elif kind in ("event_msg/user_message", "event_msg/agent_message"):
        content = payload
        role = "user" if kind.endswith("/user_message") else "assistant"
        family = "event"
    elif kind == "response_item/message":
        content, role, family = payload, payload.get("role"), "response"
        if role not in ("user", "assistant"):
            return None
    else:
        return None
    if role == "assistant" and content.get("phase") != "final_answer":
        return None
    parts = content.get("content")
    parts = parts if isinstance(parts, list) else []
    if family == "event" and isinstance(content.get("message"), str):
        parts = [{"type": "text", "text": content["message"]}]
    texts = []
    images = 0
    message_kind = "text" if role == "user" else "final"
    for part in parts:
        part = _object(part)
        part_type = part.get("type")
        if role == "user" and part_type in ("local_image", "image", "input_image"):
            images += 1
        accepted = ("text", "input_text") if role == "user" else ("Text", "text", "output_text")
        text = part.get("text")
        if part_type not in accepted or not isinstance(text, str):
            continue
        classified = classify_user_part(text) if role == "user" else ("final", text.strip())
        if classified is not None:
            if classified[0] == "answer":
                message_kind = "answer"
            if classified[1]:
                texts.append(classified[1])
    if not texts and not images:
        return None
    text = "\n\n".join(texts) if texts else f"+ {images} images"
    return MessageCandidate(role, message_kind, text, images, family)


def _voice_segment(payload: dict, kind: str) -> VoiceSegment | None:
    if (kind == "realtime_item" and payload.get("type") == "transcript_segment"
            and payload.get("role") in ("user", "assistant")
            and isinstance(payload.get("text"), str)):
        return VoiceSegment(payload["role"], payload["text"])
    return None


class RecordFact(NamedTuple):
    """Transient headers and display scalars; raw payloads never survive phase one."""
    rec: int
    line: int
    kind: str
    at_ms: int | None
    ts_src: str
    wrapper_ms: int | None
    turn_id: str | None
    thread_id: str | None
    meta_id: str | None
    started_at: int | float | None
    reported_ms: int | float | None
    ttft_ms: int | float | None
    item_message: bool
    message: MessageCandidate | None
    voice: VoiceSegment | None
    tool: ToolCandidate | None
    link: LinkCandidate | None


def _finite_number(value) -> int | float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return value if not isinstance(value, float) or math.isfinite(value) else None


def _nonnegative_number(value) -> int | float | None:
    value = _finite_number(value)
    return value if value is not None and value >= 0 else None


def _identifier(value) -> str | None:
    return value if isinstance(value, str) and value else None


def _history_identifier(value) -> str | None:
    """Reject blank history evidence while preserving usable IDs verbatim."""
    return value if isinstance(value, str) and value.strip() else None


def _record_fact(record: dict, payload: dict, *, rec: int, line: int, kind: str,
                 meta_id: str | None) -> RecordFact:
    at_ms, ts_src = event_time(record, payload)
    turn_id = _identifier(payload.get("turn_id"))
    if turn_id is None and record.get("type") == "response_item":
        turn_id = _identifier(_object(payload.get(
            "internal_chat_message_metadata_passthrough")).get("turn_id"))
    return RecordFact(
        rec, line, kind, at_ms, ts_src, parse_rfc3339_ms(record.get("timestamp")),
        turn_id, _identifier(payload.get("thread_id")), meta_id,
        _finite_number(payload.get("started_at")),
        _nonnegative_number(payload.get("duration_ms")),
        _nonnegative_number(payload.get("time_to_first_token_ms")),
        kind in ("event_msg/item_completed/UserMessage", "event_msg/item_completed/AgentMessage"),
        _message_candidate(payload, kind), _voice_segment(payload, kind),
        _tool_candidate(record, payload, kind), _link_candidate(payload, kind),
    )


def _merged_indexes(indexes: Iterator[int]) -> list[list[int]]:
    """Merge adjacent sorted positions without swallowing undecoded lines."""
    ranges: list[list[int]] = []
    for index in indexes:
        if ranges and ranges[-1][1] == index:
            ranges[-1][1] = index + 1
        else:
            ranges.append([index, index + 1])
    return ranges


def _started_epoch_ms(fact: RecordFact) -> Decimal | None:
    # History compares the seconds clock exactly, rather than its truncated ms.
    return None if fact.started_at is None else Decimal(repr(fact.started_at)).scaleb(3)


def _history(meta: dict | None, facts: list[RecordFact]) -> tuple[dict, list[bool]]:
    """Resolve research-extractor history paths from spec §5.3."""
    history = {"path": "none", "boundary_rec": None, "method": None,
               "inherited_recs": [], "inherited_lines": []}
    created = meta.get("created_at_ms") if meta else None
    inherited = [created is not None and f.at_ms is not None and f.at_ms < created
                 for f in facts]
    if meta and meta.get("forked_from_id"):
        history["path"] = "A"
        history["boundary_rec"] = len(facts)
        history["method"] = "unresolved"
        synthetic: dict[int | float, int] = {}
        for fact in facts:
            if fact.kind not in ("event_msg/task_started", "event_msg/task_complete"):
                continue
            is_start = fact.kind == "event_msg/task_started"
            if is_start and fact.turn_id and fact.turn_id.startswith("rollout-"):
                if fact.started_at is not None:
                    synthetic[fact.started_at] = fact.rec
                continue
            is_uuid = fact.turn_id is not None and re.fullmatch(
                r"[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}",
                fact.turn_id, re.IGNORECASE) is not None
            owned = bool(is_uuid and created is not None
                         and int(fact.turn_id.replace("-", "")[:12], 16) >= created - 1000)
            started = _started_epoch_ms(fact)
            if started is not None and created is not None and started < created - 1000:
                owned = False
            if (is_start and not is_uuid and created is not None
                    and fact.wrapper_ms is not None and fact.wrapper_ms >= created + 1000):
                owned = True
            if not owned:
                continue
            verified = not is_start and fact.started_at is not None and fact.started_at in synthetic
            history["boundary_rec"] = synthetic[fact.started_at] if verified else fact.rec
            history["method"] = ("synthetic_start_verified_by_completion" if verified
                                 else "own_lifecycle")
            break
        for index in range(1, history["boundary_rec"]):
            inherited[index] = True
    elif meta:
        history["path"] = "B"
        # Selected metadata identity follows D18 unchanged. History mismatch
        # evidence additionally requires usable identities on both sides.
        session_id = _history_identifier(meta.get("id"))
        in_run = False
        first_meta_seen = False
        for fact in facts:
            if fact.kind == "session_meta":
                if (first_meta_seen and session_id is not None
                        and _history_identifier(fact.meta_id) is not None and fact.meta_id != session_id):
                    in_run = True
                first_meta_seen = True
            started = _started_epoch_ms(fact)
            own_start = (fact.kind == "event_msg/task_started" and created is not None and (
                started >= created - 1000 if started is not None else
                fact.at_ms is not None and fact.at_ms >= created + 1000))
            if in_run and (fact.kind == "event_msg/thread_settings_applied"
                           or session_id is not None and fact.thread_id == session_id or own_start):
                in_run = False
            if in_run:
                inherited[fact.rec] = True
    history["inherited_recs"] = _merged_indexes(f.rec for f in facts if inherited[f.rec])
    history["inherited_lines"] = _merged_indexes(f.line for f in facts if inherited[f.rec])
    return history, inherited


def is_inherited(record_facts: dict, rec: int) -> bool:
    """Test a decoded record position against FileRecord history intervals."""
    ranges = record_facts["history"]["inherited_recs"]
    # Binary search keeps repeated attribution checks cheap for fragmented logs.
    low, high = 0, len(ranges)
    while low < high:
        mid = (low + high) // 2
        start, end = ranges[mid]
        if rec < start:
            high = mid
        elif rec >= end:
            low = mid + 1
        else:
            return True
    return False


class TurnBuilder:
    """Attribute owned scalar facts in file order, preserving logged clocks."""

    def __init__(self):
        self.turns: list[dict] = []
        self.by_id: dict[str, dict] = {}
        self.current: dict | None = None
        self.last_sources: dict[str, str] = {}
        # Record spans belong only to this parse, never the cached TurnFact.
        self.record_spans: dict[str, list[int | None]] = {}
        self.completion_recs: dict[str, int] = {}

    def _new_turn(self, turn_id: str | None) -> dict:
        turn = {"key": turn_id or f"turn-{len(self.turns) + 1}", "turn_id": turn_id,
                "start_ms": None, "start_src": None, "end_ms": None, "end_src": None,
                "end_kind": "open", "reported_ms": None, "ttft_ms": None,
                "start_rec": None, "last_ms": None}
        self.turns.append(turn)
        if turn_id is not None:
            self.by_id[turn_id] = turn
        return turn

    def add(self, fact: RecordFact) -> str | None:
        """Consume an owned fact and return its attributed turn key, if any."""
        is_start = fact.kind == "event_msg/task_started"
        is_end = fact.kind in ("event_msg/task_complete", "event_msg/turn_aborted")
        turn = self.by_id.get(fact.turn_id) if fact.turn_id is not None else self.current
        if is_start:
            # Current-turn fallback attributes intervening records and ends;
            # an idless start always opens a new independently numbered turn.
            if fact.turn_id is None:
                turn = None
            # Freeze interruption before the later start is attributed. A later
            # explicit end can still replace this provisional interruption.
            if self.current and self.current["end_kind"] == "open" and self.current["start_rec"] is not None:
                self.record_spans[self.current["key"]][1] = fact.rec - 1
                self.current["end_kind"] = "interrupted"
                self.current["end_ms"] = self.current["last_ms"]
                self.current["end_src"] = self.last_sources.get(self.current["key"])
            turn = turn if turn is not None else self._new_turn(fact.turn_id)
            turn.update(start_ms=fact.at_ms, start_src=fact.ts_src, start_rec=fact.rec,
                        end_ms=None, end_src=None, end_kind="open")
            self.current = turn
            self.record_spans[turn["key"]] = [fact.rec, None]
        elif is_end:
            turn = turn if turn is not None else self._new_turn(fact.turn_id)
            if turn["start_rec"] is None and fact.started_at is not None:
                turn["start_ms"] = epoch_to_ms(fact.started_at)
                turn["start_src"] = "started_at"
            turn.update(end_ms=fact.at_ms, end_src=fact.ts_src,
                        end_kind="completed" if fact.kind == "event_msg/task_complete" else "aborted",
                        reported_ms=fact.reported_ms, ttft_ms=fact.ttft_ms)
            self.completion_recs[turn["key"]] = fact.rec
            if turn["key"] in self.record_spans:
                self.record_spans[turn["key"]][1] = fact.rec
            if turn is self.current:
                self.current = None
        if turn is not None and fact.at_ms is not None:
            if turn["last_ms"] is None or fact.at_ms >= turn["last_ms"]:
                turn["last_ms"] = fact.at_ms
                self.last_sources[turn["key"]] = fact.ts_src
        return turn["key"] if turn is not None else None


def turn_timing(turn: dict, *, collapsed: bool = False) -> dict:
    """Derive spec §5.2 duration and flags without mutating cached facts."""
    start, end, reported = turn["start_ms"], turn["end_ms"], turn["reported_ms"]
    flags = []
    if start is not None and turn["start_rec"] is None and turn["start_src"] == "started_at":
        flags.append("start_from_completion")
    duration = None
    if turn["end_kind"] != "open":
        if (collapsed and reported is None and turn["start_src"] == "record_timestamp"
                and turn["end_src"] == "record_timestamp"):
            flags.append("collapsed")
        elif (reported is not None and end is not None
              and (start is None or collapsed or turn["end_src"] == "completed_at")):
            start = end - reported
            duration = reported
            flags.append("reported_duration")
        elif start is not None and end is not None and end >= start:
            duration = end - start
        else:
            flags.append("unknown_duration")
    return {"start_ms": start, "duration_ms": duration, "flags": flags}


def _deduplicate_messages(candidates: list[tuple[RecordFact, str | None]],
                          item_turns: set[str]) -> list[dict]:
    """Index kept messages only, by role, digest, family, turn and time."""
    priorities = {"item": 2, "event": 1, "response": 0}
    candidates = [(fact, key) for fact, key in candidates
                  if not (fact.message.family == "response" and key in item_turns)]
    candidates.sort(key=lambda candidate: (-priorities[candidate[0].message.family], candidate[0].rec))
    index: dict[tuple, dict] = {}
    kept = []
    for fact, turn_key in candidates:
        message = fact.message
        digest = hashlib.sha1(message.text.encode("utf-8", errors="surrogatepass")).digest()
        # A literal raw "*" is a concrete ID, distinct from the all-kept bucket.
        turn_bucket = ("turn", "*") if fact.turn_id == "*" else fact.turn_id
        duplicate = False
        for family in priorities:
            if family == message.family:
                continue
            buckets = index.get((message.role, digest, family), {})
            keys = ("*",) if fact.turn_id is None else (turn_bucket, None)
            for key in keys:
                times, unknown = buckets.get(key, ([], 0))
                if fact.at_ms is None:
                    match = unknown > 0
                else:
                    pos = bisect.bisect_left(times, fact.at_ms - 10_000)
                    match = pos < len(times) and times[pos] <= fact.at_ms + 10_000
                if match:
                    duplicate = True
                    break
            if duplicate:
                break
        if duplicate:
            continue
        kept.append({"role": message.role, "kind": message.kind, "text": message.text,
                     "images": message.images, "at_ms": fact.at_ms, "ts_src": fact.ts_src,
                     "turn_key": turn_key, "rec": fact.rec})
        buckets = index.setdefault((message.role, digest, message.family), {})
        for key in ("*", turn_bucket):
            times, unknown = buckets.setdefault(key, ([], 0))
            if fact.at_ms is None:
                buckets[key] = (times, unknown + 1)
            else:
                bisect.insort(times, fact.at_ms)
    return sorted(kept, key=lambda message: message["rec"])


def _place_voice(facts: list[RecordFact], inherited: list[bool], builder: TurnBuilder) -> dict:
    """Group transcript runs and place them by their first decoded record."""
    runs = []
    for fact in facts:
        if inherited[fact.rec] or fact.voice is None:
            continue
        if runs and runs[-1]["role"] == fact.voice.role:
            runs[-1]["parts"].append(fact.voice.text)
        else:
            runs.append({"role": fact.voice.role, "parts": [fact.voice.text],
                         "rec": fact.rec, "at_ms": fact.at_ms})
    spans = sorted((start, end, key) for key, (start, end) in builder.record_spans.items())
    starts = [span[0] for span in spans]
    # An observed completion proves that a later request follows that turn;
    # it supplies no evidence for requests before the missing start.
    boundaries = sorted((turn["start_rec"] if turn["start_rec"] is not None
                         else builder.completion_recs[turn["key"]], turn["key"])
                        for turn in builder.turns)
    boundary_recs = [boundary[0] for boundary in boundaries]
    voice = {"requests": [], "replies": []}
    last_request = None
    for run in runs:
        text = " ".join(run["parts"])
        previous = bisect.bisect_right(starts, run["rec"]) - 1
        if run["role"] == "assistant":
            if last_request is not None:
                last_request["reply"] = text
            elif previous >= 0 or not builder.turns:
                voice["replies"].append({"text": text, "at_ms": run["at_ms"],
                                         "turn_key": spans[previous][2] if previous >= 0 else None})
            continue
        turn_key = None
        before_turn = follow_up = False
        if previous >= 0 and (spans[previous][1] is None or run["rec"] <= spans[previous][1]):
            turn_key = spans[previous][2]
        elif previous + 1 < len(spans):
            turn_key, before_turn = spans[previous + 1][2], True
        else:
            last_boundary = bisect.bisect_right(boundary_recs, run["rec"]) - 1
            if last_boundary >= 0:
                turn_key, follow_up = boundaries[last_boundary][1], True
        last_request = {"text": text, "at_ms": run["at_ms"], "turn_key": turn_key,
                        "before_turn": before_turn, "follow_up": follow_up, "reply": None}
        voice["requests"].append(last_request)
    return voice


def select_final_answer(record_facts: dict, turn_key: str) -> dict | None:
    """Select spec §5.1's last recorded final, or last eligible spoken reply."""
    for message in reversed(record_facts["messages"]):
        if message["turn_key"] == turn_key and message["kind"] == "final":
            return {"text": message["text"], "voice": False}
    for request in reversed(record_facts["voice"]["requests"]):
        if (request["turn_key"] == turn_key and not request["before_turn"]
                and request["reply"] is not None):
            return {"text": request["reply"], "voice": True}
    return None


def _tools_and_links(facts: list[RecordFact], inherited: list[bool],
                     attributed: dict[int, str | None], builder: TurnBuilder) -> tuple[dict, dict]:
    tallies = {turn["key"]: ToolTally() for turn in builder.turns}
    links = {"activities": [], "spawn_calls": [], "targets": [], "collab_receivers": []}
    spawns = []
    spawn_counts = {}
    outputs = {}
    output_counts = {}
    for fact in facts:
        if inherited[fact.rec]:
            continue
        turn_key = attributed.get(fact.rec)
        if turn_key is None and fact.turn_id in builder.by_id:
            turn_key = builder.by_id[fact.turn_id]["key"]
        if fact.tool is not None and turn_key is not None:
            tally = tallies[turn_key]
            if fact.tool.structured:
                tally.has_structured = True
            _merge_tool_counts(tally.structured if fact.tool.structured else tally.raw, fact.tool.counts)
        link = fact.link
        if link is None:
            continue
        if link.kind == "activity":
            kind, child_id, agent_path = link.values
            links["activities"].append({"kind": kind, "child_id": child_id,
                                        "agent_path": agent_path, "turn_key": turn_key})
        elif link.kind == "target":
            links["targets"].append({"target": link.values[0], "turn_key": turn_key})
        elif link.kind == "receivers":
            links["collab_receivers"].extend({"child_id": child_id, "turn_key": turn_key}
                                             for child_id in link.values)
        elif link.kind == "spawn":
            call_id = link.values[0]
            spawn = {"task_name": None, "turn_key": turn_key, "at_ms": fact.at_ms}
            links["spawn_calls"].append(spawn)
            spawns.append((call_id, spawn))
            if call_id is not None:
                spawn_counts[call_id] = spawn_counts.get(call_id, 0) + 1
        elif link.kind == "output":
            call_id, task_name = link.values
            if call_id is not None:
                outputs[call_id] = task_name
                output_counts[call_id] = output_counts.get(call_id, 0) + 1
    for call_id, spawn in spawns:
        if (call_id is not None and spawn_counts[call_id] == 1
                and output_counts.get(call_id) == 1):
            spawn["task_name"] = outputs[call_id]
    return {key: tally.result() for key, tally in tallies.items()}, links


def parse_log_file(path: Path, *, size: int, mtime_ns: int, archived: bool) -> dict:
    """Read a log once, retaining facts rather than raw decoded records."""
    result = {
        "parser_version": PARSER_VERSION,
        "key": {"path": str(path.resolve()), "size": size, "mtime_ns": mtime_ns},
        "archived": archived, "status": "empty", "no_session_meta": True,
        "lines": {"malformed": 0, "recovered": 0, "partial_final_line": False},
        "unknown_types": {}, "meta": None, "extra_meta_count": 0,
        "wrapper_ts": {"count": 0, "distinct": 0},
        "usage_records": [],
    }
    wrapper_values: set[str] = set()
    facts: list[RecordFact] = []
    with path.open("rb") as fh:
        tail_start = max(0, size - TAIL_FINGERPRINT_BYTES)
        fh.seek(tail_start)
        result["key"]["tail_sha256"] = hashlib.sha256(fh.read(size - tail_start)).hexdigest()
        fh.seek(0)
        for raw in iter_log_lines(fh, size):
            if raw.terminated:
                decoded = decode_line(raw.data)
                if decoded.status in ("malformed", "recovered"):
                    result["lines"][decoded.status] += 1
                record = decoded.obj
                del decoded
            else:
                record = _json_object(raw.data)
                if record is None:
                    result["lines"]["partial_final_line"] = True
            if record is None:
                continue
            payload = _object(record.get("payload"))
            key = record_type_key(record)
            if key not in KNOWN_RECORD_KEYS:
                unknown = result["unknown_types"]
                unknown[key] = unknown.get(key, 0) + 1
            timestamp = record.get("timestamp")
            if isinstance(timestamp, str):
                result["wrapper_ts"]["count"] += 1
                if len(wrapper_values) < 3:
                    wrapper_values.add(timestamp)
            if key == "session_meta":
                header = _session_meta(record, payload)
                if result["no_session_meta"]:
                    result["meta"] = header
                    result["no_session_meta"] = False
                else:
                    result["extra_meta_count"] += 1
                if result["status"] == "empty":
                    result["status"] = "header_only"
            else:
                result["status"] = "ok"
            facts.append(_record_fact(record, payload, rec=len(facts), line=raw.index,
                                      kind=key, meta_id=header["id"] if key == "session_meta" else None))
            if key == "token_usage_record":
                result["usage_records"].append(_usage_record(record, payload, facts[-1]))
            # The next phase uses scalar facts only, including after the final
            # iteration where loop variables would otherwise retain a payload.
            del record, payload
    # Loop bindings survive exhaustion, even for a skipped damaged tail. Keep
    # neither the last line's bytes nor a later metadata header in phase two.
    raw = header = None
    result["wrapper_ts"]["distinct"] = len(wrapper_values)
    result["history"], inherited = _history(result["meta"], facts)
    builder = TurnBuilder()
    first_ms = last_ms = None
    attributed: dict[int, str | None] = {}
    for fact in facts:
        if inherited[fact.rec]:
            continue
        if fact.at_ms is not None:
            first_ms = fact.at_ms if first_ms is None else min(first_ms, fact.at_ms)
            last_ms = fact.at_ms if last_ms is None else max(last_ms, fact.at_ms)
        if result["history"]["method"] != "unresolved":
            attributed[fact.rec] = builder.add(fact)
    result["owned_span"] = {"first_ms": first_ms, "last_ms": last_ms}
    result["turns"] = builder.turns
    candidates = []
    item_turns = set()
    for fact in facts:
        if inherited[fact.rec]:
            continue
        turn_key = attributed.get(fact.rec)
        # Explicit IDs can point at a lifecycle start later in the file.
        if turn_key is None and fact.turn_id in builder.by_id:
            turn_key = builder.by_id[fact.turn_id]["key"]
        if fact.item_message and turn_key is not None:
            item_turns.add(turn_key)
        if fact.message is not None:
            candidates.append((fact, turn_key))
    result["messages"] = _deduplicate_messages(candidates, item_turns)
    result["voice"] = _place_voice(facts, inherited, builder)
    result["tools"], result["links"] = _tools_and_links(facts, inherited, attributed, builder)
    return result


# ===== 19. CLI =====
def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="colophon",
        description="Explore local Codex session logs in a self-contained offline page.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Environment variables:
  COLOPHON_HOME         Runtime home (default: ~/.colophon).
  COLOPHON_PRICING_URL  Price catalog URL (default: https://models.dev/api.json).

Runtime files (directories 0700, written files 0600):
  colophon.html          Generated offline page.
  cache/                 Per-log parse cache.
  pricing-cache.json     Cached OpenAI price catalog.
  price-history.json     Editable price history, initially empty.
  priority-turns.json    Sticky memory of detected priority turns.
  workspaces.json        Optional workspace aliases.
  workspaces.example.json  Synthetic template, never read as configuration.
  perf-baseline.json     Written only by local performance acceptance.
  parity/                Written only by local parity acceptance.
""",
    )
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser.")
    parser.add_argument("--rebuild", action="store_true", help="Reparse every log into a fresh cache.")
    parser.add_argument("--offline", action="store_true", help="Use cached prices without a network request.")
    parser.add_argument("--refresh-prices", action="store_true", help="Force an unconditional price-catalog download.")
    parser.add_argument("--output", type=Path, metavar="PATH", help="Page path instead of the runtime-home default.")
    parser.add_argument("--codex-home", type=Path, metavar="PATH", default=Path("~/.codex"),
                        help="Read Codex data from PATH (default: ~/.codex).")
    parser.add_argument("--version", action="version", version=f"colophon {__version__}")
    return parser


def run(args: argparse.Namespace) -> int:
    codex_home = args.codex_home.expanduser()
    if not codex_home.is_dir() or not os.access(codex_home, os.R_OK | os.X_OK):
        print(f"colophon: Codex home is missing or unreadable: {codex_home}", file=sys.stderr)
        return 1

    home = ensure_runtime_home(runtime_home())
    ledger_path = home / "price-history.json"
    if not ledger_path.exists():
        atomic_write_json(ledger_path, {"schema": 1, "entries": []})
    example_path = home / "workspaces.example.json"
    if not example_path.exists():
        atomic_write_json(example_path, {
            "schema": 1,
            "aliases": [{
                "name": "Example Tools",
                "origins": ["https://example.invalid/synthetic/tools.git"],
                "paths": ["/synthetic/deployed/tools"],
            }],
        })
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    if args.offline and args.refresh_prices:
        parser.error("--offline and --refresh-prices cannot be combined")
    try:
        return run(args)
    except OSError as exc:
        print(f"colophon: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
