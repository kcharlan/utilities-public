"""Colophon: a local, read-only explorer for Codex session logs."""

# ===== 1. Header, imports, constants =====
from __future__ import annotations

import argparse
import contextlib
import json
import math
import os
import re
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from pathlib import Path

__version__ = "0.1.0"
PARSER_VERSION = 1
CACHE_SCHEMA = 1
PAYLOAD_SCHEMA = 1
LIVE_QUIET_HOURS = 2
LIVE_QUIET_MS = 7_200_000
DEFAULT_PRICING_URL = "https://models.dev/api.json"
CONNECT_TIMEOUT_S = 3
BODY_TIMEOUT_S = 30
UPSTREAM_COMMIT = "3bbf6bc48"
TAIL_FINGERPRINT_BYTES = 4096
UPSTREAM_MAX_LINE_BYTES = 262144
PAGE_SIZE_WARN_BYTES = 20 * 1024 * 1024


# ===== 4. Utilities =====
def now_ms() -> int:
    """Return the wall-clock instant in UTC epoch milliseconds."""
    return time.time_ns() // 1_000_000


def parse_rfc3339_ms(value) -> int | None:
    """Parse an aware RFC 3339 instant, retaining millisecond precision."""
    if not isinstance(value, str) or not re.fullmatch(
        r"\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})",
        value,
    ):
        return None
    try:
        instant = datetime.fromisoformat(value.upper().replace("Z", "+00:00"))
        delta = instant.astimezone(timezone.utc) - datetime(1970, 1, 1, tzinfo=timezone.utc)
    except (ValueError, OverflowError):
        return None
    return (delta.days * 86_400 + delta.seconds) * 1000 + delta.microseconds // 1000


def format_rfc3339(ms: int) -> str:
    """Format UTC epoch milliseconds at whole-second ledger precision."""
    instant = datetime(1970, 1, 1, tzinfo=timezone.utc) + timedelta(milliseconds=ms)
    return instant.isoformat(timespec="seconds").replace("+00:00", "Z")


def epoch_to_ms(value, *, milliseconds: bool = False) -> int | None:
    """Convert a finite numeric epoch value; seconds are the default unit."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, float) and not math.isfinite(value):
        return None
    numeric = Decimal(repr(value))
    return int(numeric if milliseconds else numeric.scaleb(3))


def abbreviate_home(path: Path | str) -> str:
    """Shorten only paths at or below the current user's home directory."""
    candidate = Path(path)
    try:
        relative = candidate.relative_to(Path.home())
    except ValueError:
        return str(candidate)
    return "~" if relative == Path(".") else f"~/{relative}"


def runtime_home() -> Path:
    """Return the mutable runtime directory, expanding a home override."""
    return Path(os.environ.get("COLOPHON_HOME", "~/.colophon")).expanduser()


def ensure_runtime_home(path: Path) -> Path:
    """Create a private runtime directory and restore its permissions."""
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Write a complete private file before replacing its destination."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def atomic_write_json(path: Path, obj, *, indent: int | None = 2) -> None:
    """Write readable UTF-8 JSON with a terminating newline."""
    data = (json.dumps(obj, indent=indent, ensure_ascii=False) + "\n").encode("utf-8")
    atomic_write_bytes(path, data)


# ===== 19. CLI =====
def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="colophon",
        description="Explore local Codex session logs in a self-contained offline page.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Environment variables:
  COLOPHON_HOME         Runtime home (default: ~/.colophon).
  COLOPHON_PRICING_URL  Price catalog URL (default: https://models.dev/api.json).

Runtime files (directories 0700, written files 0600):
  colophon.html          Generated offline page.
  cache/                 Per-log parse cache.
  pricing-cache.json     Cached OpenAI price catalog.
  price-history.json     Editable price history, initially empty.
  priority-turns.json    Sticky memory of detected priority turns.
  workspaces.json        Optional workspace aliases.
  workspaces.example.json  Synthetic template, never read as configuration.
  perf-baseline.json     Written only by local performance acceptance.
  parity/                Written only by local parity acceptance.
""",
    )
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser.")
    parser.add_argument("--rebuild", action="store_true", help="Reparse every log into a fresh cache.")
    parser.add_argument("--offline", action="store_true", help="Use cached prices without a network request.")
    parser.add_argument("--refresh-prices", action="store_true", help="Force an unconditional price-catalog download.")
    parser.add_argument("--output", type=Path, metavar="PATH", help="Page path instead of the runtime-home default.")
    parser.add_argument("--codex-home", type=Path, metavar="PATH", default=Path("~/.codex"),
                        help="Read Codex data from PATH (default: ~/.codex).")
    parser.add_argument("--version", action="version", version=f"colophon {__version__}")
    return parser


def run(args: argparse.Namespace) -> int:
    codex_home = args.codex_home.expanduser()
    if not codex_home.is_dir() or not os.access(codex_home, os.R_OK | os.X_OK):
        print(f"colophon: Codex home is missing or unreadable: {codex_home}", file=sys.stderr)
        return 1

    home = ensure_runtime_home(runtime_home())
    ledger_path = home / "price-history.json"
    if not ledger_path.exists():
        atomic_write_json(ledger_path, {"schema": 1, "entries": []})
    example_path = home / "workspaces.example.json"
    if not example_path.exists():
        atomic_write_json(example_path, {
            "schema": 1,
            "aliases": [{
                "name": "Example Tools",
                "origins": ["https://example.invalid/synthetic/tools.git"],
                "paths": ["/synthetic/deployed/tools"],
            }],
        })
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    if args.offline and args.refresh_prices:
        parser.error("--offline and --refresh-prices cannot be combined")
    try:
        return run(args)
    except OSError as exc:
        print(f"colophon: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
