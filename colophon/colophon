def link_subagents(corpus: Corpus, metadata: CodexMetadata, snapshot_ms: int) -> None:
    """Build direct parent edges and turn links without modifying cached facts."""
    corpus.orphaned_subagents.clear()
    corpus.inferred_links.clear()
    # Filename/display IDs never establish a thread identity, even when a
    # selected parent's spelling collides with a generated corpus key.
    identified = {identifier: session for session in corpus.sessions.values()
                  if (identifier := _history_identifier((session.meta or {}).get("id"))) is not None}
    for session in corpus.sessions.values():
        meta = session.meta or {}
        session.children.clear()
        session.flags.difference_update({"orphaned", "forked"})
        session.parent_id = None
        session.kind = "subagent" if session.is_subagent else "session"
        session.link = ({"spawn_turn": None, "interaction_turns": [], "method": None}
                        if session.is_subagent else None)
        depth = meta.get("depth")
        session.depth = depth if type(depth) is int and depth >= 0 else None
        session.agent_path = next((value for value in
            (meta.get("agent_path"), session.db_info.get("agent_path")) if _metadata_text(value)), None)
        session.created_at_ms = _finite_number(meta.get("created_at_ms"))
        fork = meta.get("forked_from_id")
        session.forked_from = fork if not session.is_subagent and _metadata_text(fork) else None
        for turn in session.turns:
            turn.spawned.clear()
            turn.used.clear()
        if not session.is_subagent:
            if session.depth is None:
                session.depth = 0
            continue
        identifier = _history_identifier(meta.get("id"))
        edge = metadata.spawn_parents.get(identifier) if identifier is not None else None
        session.parent_id = next((value for value in (edge, meta.get("parent_thread_id"))
                                  if _metadata_text(value)), None)

    # Reject only edges participating in a cycle. Iterative traversal keeps
    # malformed deep chains from exhausting Python's recursion limit.
    visited = set()
    for identifier in identified:
        chain, positions = [], {}
        cursor = identifier
        while cursor in identified and cursor not in visited:
            if cursor in positions:
                for cyclic in chain[positions[cursor]:]:
                    identified[cyclic].parent_id = None
                break
            positions[cursor] = len(chain)
            chain.append(cursor)
            cursor = identified[cursor].parent_id
        visited.update(chain)

    for session in corpus.sessions.values():
        if not session.is_subagent:
            continue
        identifier = _history_identifier((session.meta or {}).get("id"))
        parent = identified.get(session.parent_id) if identifier is not None else None
        if parent is None:
            session.kind = "orphan"
            session.flags.add("orphaned")
            corpus.orphaned_subagents.append(session.id)
        else:
            parent.children.append(session.id)
        fork = (session.meta or {}).get("forked_from_id")
        if _metadata_text(fork) and fork == session.parent_id:
            session.flags.add("forked")

    # Resolve missing depths from parents, regardless of corpus insertion order.
    for session in corpus.sessions.values():
        chain = []
        cursor = session
        while cursor.depth is None:
            chain.append(cursor)
            parent = identified.get(cursor.parent_id)
            if parent is None:
                break
            cursor = parent
        depth = cursor.depth
        for child in reversed(chain):
            if depth is not None:
                depth += 1
                child.depth = depth

    by_id = {session.id: session for session in corpus.sessions.values()}
    for session in corpus.sessions.values():
        session.children.sort(key=lambda identifier: (
            by_id[identifier].start_ms is None,
            by_id[identifier].start_ms if by_id[identifier].start_ms is not None else 0))
        if not session.is_subagent or session.kind == "orphan":
            continue
        parent = identified[session.parent_id]
        spawn, method = _subagent_spawn_turn(session, parent, snapshot_ms)
        interactions = _subagent_interaction_turns(session, parent, spawn)
        session.link = {"spawn_turn": spawn, "interaction_turns": interactions, "method": method}
        if method == "inferred":
            corpus.inferred_links.append(session.id)
        interaction_ids = set(interactions)
        for turn in parent.turns:
            if turn.id == spawn:
                turn.spawned.append(session.id)
            if turn.id in interaction_ids:
                turn.used.append(session.id)


