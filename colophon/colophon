            value.foundation_int = _codex_decimal_int(text)
        elif value >= 2**63:
            value.foundation_int = 2**63 - 1
        elif value < -(2**63):
            value.foundation_int = -(2**63)
        else:
            value.foundation_int = int(value)
        return value


def _upstream_json(data: bytes):
    """Foundation JSONSerialization stand-in, including its Unicode checks."""
    try:
        object_pairs = {}

        def capture_object(pairs):
            obj = {}
            for key, item in pairs:
                obj.setdefault(key, item)  # Foundation keeps the first value.
            # Foundation validates every source pair before projecting keys.
            # Keep source pairs only for this parse's iterative validation.
            object_pairs[id(obj)] = pairs
