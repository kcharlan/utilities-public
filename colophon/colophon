# ===== 4. Utilities =====
def now_ms() -> int:
    """Return the wall-clock instant in UTC epoch milliseconds."""
    return time.time_ns() // 1_000_000


def parse_rfc3339_ms(value) -> int | None:
    """Parse an aware RFC 3339 instant, retaining millisecond precision."""
    if not isinstance(value, str) or not re.fullmatch(
        r"\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})",
        value,
    ):
        return None
    if value[-1] not in "Zz" and (
        int(value[-5:-3]) > 23 or int(value[-2:]) > 59
    ):
        return None
    try:
        instant = datetime.fromisoformat(value.upper().replace("Z", "+00:00"))
        delta = instant.astimezone(timezone.utc) - datetime(1970, 1, 1, tzinfo=timezone.utc)
    except (ValueError, OverflowError):
        return None
    return (delta.days * 86_400 + delta.seconds) * 1000 + delta.microseconds // 1000


def format_rfc3339(ms: int) -> str:
    """Format UTC epoch milliseconds at whole-second ledger precision."""
    instant = datetime(1970, 1, 1, tzinfo=timezone.utc) + timedelta(milliseconds=ms)
    return instant.isoformat(timespec="seconds").replace("+00:00", "Z")


def epoch_to_ms(value, *, milliseconds: bool = False) -> int | None:
    """Convert a finite numeric epoch value; seconds are the default unit."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, float) and not math.isfinite(value):
        return None
    numeric = Decimal(repr(value))
    return int(numeric if milliseconds else numeric.scaleb(3))


def abbreviate_home(path: Path | str) -> str:
    """Shorten only paths at or below the current user's home directory."""
    candidate = Path(path)
    try:
        relative = candidate.relative_to(Path.home())
    except ValueError:
        return str(candidate)
    return "~" if relative == Path(".") else f"~/{relative}"


def runtime_home() -> Path:
    """Return the mutable runtime directory, expanding a home override."""
    return Path(os.environ.get("COLOPHON_HOME", "~/.colophon")).expanduser()


def ensure_runtime_home(path: Path) -> Path:
    """Create a private runtime directory and restore its permissions."""
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Write a complete private file before replacing its destination."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    fd_owned = True
    try:
        os.fchmod(fd, mode)
        fh = os.fdopen(fd, "wb")
        fd_owned = False
        with fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        if fd_owned:
            with contextlib.suppress(OSError):
                os.close(fd)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def atomic_write_json(path: Path, obj, *, indent: int | None = 2) -> None:
    """Write readable UTF-8 JSON with a terminating newline."""
    data = (json.dumps(obj, indent=indent, ensure_ascii=True) + "\n").encode("utf-8")
    atomic_write_bytes(path, data)


# ===== 5. Log reading =====
class RawLine(NamedTuple):
    index: int
    data: bytes
    terminated: bool


class DecodedLine(NamedTuple):
    obj: dict | None
    status: Literal["ok", "recovered", "malformed", "blank"]


def iter_log_lines(fh: BinaryIO, size: int) -> Iterator[RawLine]:
    """Stream physical lines within the caller's scan-start byte boundary."""
    remaining = size
    buffer = bytearray()
    index = 0
    while remaining > 0:
        chunk = fh.read(min(1024 * 1024, remaining))
        if not chunk:
            break
        remaining -= len(chunk)
        search_from = len(buffer)
        buffer.extend(chunk)
        start = 0
        while (end := buffer.find(b"\n", search_from)) >= 0:
            yield RawLine(index, bytes(buffer[start:end]), True)
            index += 1
            start = search_from = end + 1
        if start:
            del buffer[:start]
    if buffer:
        yield RawLine(index, bytes(buffer), False)


def _json_object(data: bytes) -> dict | None:
    try:
        obj = json.loads(data)
    except (ValueError, UnicodeError, RecursionError):
        return None
    return obj if isinstance(obj, dict) else None


def decode_line(data: bytes) -> DecodedLine:
    """Decode a terminated line, recovering a valid suffix after crash debris."""
    if not data.strip():
        return DecodedLine(None, "blank")
    obj = _json_object(data)
    if obj is not None:
        return DecodedLine(obj, "ok")
    start = 1
    while True:
        candidates = [pos for marker in (b'{"timestamp"', b'{"type"')
                      if (pos := data.find(marker, start)) >= 0]
        if not candidates:
            return DecodedLine(None, "malformed")
        pos = min(candidates)
        obj = _json_object(data[pos:])
        if obj is not None:
            return DecodedLine(obj, "recovered")
        start = pos + 1


# ===== 6. Per-file parse =====
def _object(value) -> dict:
    return value if isinstance(value, dict) else {}


def record_type_key(record: dict) -> str:
    """Classify only the documented record and bare-usage containers."""
    kind = record.get("type")
    if "type" not in record:
        # codexBareUsage containers, CodexBar 3bbf6bc48, Scanner.swift:3914–3923.
        containers = [record, *(_object(record.get(key)) for key in ("data", "result", "response"))]
        if any(isinstance(container.get("usage"), dict) for container in containers):
            return "bare_usage"
    if not isinstance(kind, str):
        kind = "unknown"
    if kind in ("event_msg", "response_item"):
        payload = _object(record.get("payload"))
        subtype = payload.get("type")
        subtype = subtype if isinstance(subtype, str) else "unknown"
        if kind == "event_msg" and subtype == "item_completed":
            item_type = _object(payload.get("item")).get("type")
            item_type = item_type if isinstance(item_type, str) else "unknown"
            return f"{kind}/{subtype}/{item_type}"
        return f"{kind}/{subtype}"
    return kind


def event_time(record: dict, payload: dict) -> tuple[int | None, str]:
    """Prefer the payload's lifecycle clock, preserving wrapper precision."""
    wrapper = parse_rfc3339_ms(record.get("timestamp"))
    kind = payload.get("type")
    if kind == "task_started":
        keys = ("started_at_ms", "started_at")
    elif kind in ("task_complete", "turn_aborted"):
        keys = ("completed_at_ms", "completed_at")
    else:
        keys = ("completed_at_ms",)
    for key in keys:
        value = payload.get(key)
        milliseconds = key.endswith("_ms")
        instant = epoch_to_ms(value, milliseconds=milliseconds)
        if instant is None:
            continue
        if not milliseconds and wrapper is not None:
            if abs(Decimal(repr(value)).scaleb(3) - wrapper) < 2000:
                return wrapper, "record_timestamp"
        return instant, key
    return wrapper, "record_timestamp"


def _session_meta(record: dict, payload: dict) -> dict:
    """Extract true-first display identity; the token pre-pass is separate."""
    # codexSessionMetadata(from:), CodexBar 3bbf6bc48, Scanner.swift:3994–4011.
    candidates = (payload.get("id"), record.get("id"), payload.get("session_id"),
                  payload.get("sessionId"), record.get("session_id"), record.get("sessionId"))
    session_id = next((value for value in candidates if isinstance(value, str)), None)
    source = payload.get("source")
    subagent = _object(source).get("subagent")
    is_subagent = (source.strip().lower() == "subagent" if isinstance(source, str)
                   else isinstance(subagent, (str, dict)))
    spawn = _object(_object(subagent).get("thread_spawn"))
    git = _object(payload.get("git"))
    created_at = parse_rfc3339_ms(payload.get("timestamp"))
    if created_at is None:
        created_at = event_time(record, payload)[0]
    # codexForkParentId(from:), Scanner.swift:3476–3487.
    forked_from = next((value.strip() for key in (
        "forked_from_id", "forkedFromId", "parent_session_id", "parentSessionId")
        if isinstance(value := payload.get(key), str) and value.strip()), None)
    return {
        "id": session_id, "created_at_ms": created_at,
        "timestamp_raw": payload.get("timestamp", record.get("timestamp")),
        "cwd": payload.get("cwd"), "originator": payload.get("originator"),
        "cli_version": payload.get("cli_version"), "forked_from_id": forked_from,
        "is_subagent": is_subagent,
        **{key: spawn.get(key) for key in (
            "parent_thread_id", "depth", "agent_path", "agent_nickname", "agent_role")},
        "git": {"branch": git.get("branch"), "origin_url": git.get("repository_url"),
                "sha": git.get("commit_hash")},
        "rollout_title": payload.get("thread_name") or payload.get("title"),
    }


def parse_log_file(path: Path, *, size: int, mtime_ns: int, archived: bool) -> dict:
    """Read a log once, retaining facts rather than raw decoded records."""
    result = {
        "parser_version": PARSER_VERSION,
        "key": {"path": str(path.resolve()), "size": size, "mtime_ns": mtime_ns},
        "archived": archived, "status": "empty", "no_session_meta": True,
        "lines": {"malformed": 0, "recovered": 0, "partial_final_line": False},
        "unknown_types": {}, "meta": None, "extra_meta_count": 0,
        "wrapper_ts": {"count": 0, "distinct": 0},
    }
    wrapper_values: set[str] = set()
    with path.open("rb") as fh:
        tail_start = max(0, size - TAIL_FINGERPRINT_BYTES)
        fh.seek(tail_start)
        result["key"]["tail_sha256"] = hashlib.sha256(fh.read(size - tail_start)).hexdigest()
        fh.seek(0)
        for raw in iter_log_lines(fh, size):
            if raw.terminated:
                decoded = decode_line(raw.data)
                if decoded.status in ("malformed", "recovered"):
                    result["lines"][decoded.status] += 1
                record = decoded.obj
            else:
                record = _json_object(raw.data)
                if record is None:
                    result["lines"]["partial_final_line"] = True
            if record is None:
                continue
            payload = _object(record.get("payload"))
            key = record_type_key(record)
            if key not in KNOWN_RECORD_KEYS:
                unknown = result["unknown_types"]
                unknown[key] = unknown.get(key, 0) + 1
            timestamp = record.get("timestamp")
            if isinstance(timestamp, str):
                result["wrapper_ts"]["count"] += 1
                if len(wrapper_values) < 3:
                    wrapper_values.add(timestamp)
            if key == "session_meta":
                if result["no_session_meta"]:
                    result["meta"] = _session_meta(record, payload)
                    result["no_session_meta"] = False
                else:
                    result["extra_meta_count"] += 1
                if result["status"] == "empty":
                    result["status"] = "header_only"
            else:
                result["status"] = "ok"
    result["wrapper_ts"]["distinct"] = len(wrapper_values)
    return result


# ===== 19. CLI =====
def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="colophon",
        description="Explore local Codex session logs in a self-contained offline page.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Environment variables:
  COLOPHON_HOME         Runtime home (default: ~/.colophon).
  COLOPHON_PRICING_URL  Price catalog URL (default: https://models.dev/api.json).

Runtime files (directories 0700, written files 0600):
  colophon.html          Generated offline page.
  cache/                 Per-log parse cache.
  pricing-cache.json     Cached OpenAI price catalog.
  price-history.json     Editable price history, initially empty.
  priority-turns.json    Sticky memory of detected priority turns.
  workspaces.json        Optional workspace aliases.
  workspaces.example.json  Synthetic template, never read as configuration.
  perf-baseline.json     Written only by local performance acceptance.
  parity/                Written only by local parity acceptance.
""",
    )
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser.")
    parser.add_argument("--rebuild", action="store_true", help="Reparse every log into a fresh cache.")
    parser.add_argument("--offline", action="store_true", help="Use cached prices without a network request.")
    parser.add_argument("--refresh-prices", action="store_true", help="Force an unconditional price-catalog download.")
    parser.add_argument("--output", type=Path, metavar="PATH", help="Page path instead of the runtime-home default.")
    parser.add_argument("--codex-home", type=Path, metavar="PATH", default=Path("~/.codex"),
                        help="Read Codex data from PATH (default: ~/.codex).")
    parser.add_argument("--version", action="version", version=f"colophon {__version__}")
    return parser


def run(args: argparse.Namespace) -> int:
    codex_home = args.codex_home.expanduser()
    if not codex_home.is_dir() or not os.access(codex_home, os.R_OK | os.X_OK):
        print(f"colophon: Codex home is missing or unreadable: {codex_home}", file=sys.stderr)
        return 1

    home = ensure_runtime_home(runtime_home())
    ledger_path = home / "price-history.json"
    if not ledger_path.exists():
        atomic_write_json(ledger_path, {"schema": 1, "entries": []})
    example_path = home / "workspaces.example.json"
    if not example_path.exists():
        atomic_write_json(example_path, {
            "schema": 1,
            "aliases": [{
                "name": "Example Tools",
                "origins": ["https://example.invalid/synthetic/tools.git"],
                "paths": ["/synthetic/deployed/tools"],
            }],
        })
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    if args.offline and args.refresh_prices:
        parser.error("--offline and --refresh-prices cannot be combined")
    try:
        return run(args)
    except OSError as exc:
        print(f"colophon: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
