    _number_transitions = {
        ('sign', 'zero'): 'zero', ('sign', 'digit'): 'integer',
        ('zero', 'point'): 'point', ('zero', 'exponent'): 'exponent',
        ('integer', 'zero'): 'integer', ('integer', 'digit'): 'integer',
        ('integer', 'point'): 'point', ('integer', 'exponent'): 'exponent',
        ('point', 'zero'): 'fraction', ('point', 'digit'): 'fraction',
        ('fraction', 'zero'): 'fraction', ('fraction', 'digit'): 'fraction',
        ('fraction', 'exponent'): 'exponent', ('exponent', 'sign'): 'exponent_sign',
        ('exponent', 'zero'): 'exponent_digits', ('exponent', 'digit'): 'exponent_digits',
        ('exponent_sign', 'zero'): 'exponent_digits', ('exponent_sign', 'digit'): 'exponent_digits',
        ('exponent_digits', 'zero'): 'exponent_digits', ('exponent_digits', 'digit'): 'exponent_digits',
        ('zero', 'space'): 'finished', ('integer', 'space'): 'finished',
        ('fraction', 'space'): 'finished', ('exponent_digits', 'space'): 'finished',
        ('finished', 'space'): 'finished',
    }

    def __init__(self):
        self.depth = 0
        self.inside_string = self.escaping = self.saw_non_whitespace = False
        self.scalar = 'not_scalar'
        self.matched = 0
        self.number = None

    @property
    def is_structurally_complete(self) -> bool:
        if not self.saw_non_whitespace:
            return False
        if self.scalar == 'not_scalar':
            return not self.inside_string and self.depth == 0
        if self.scalar == 'number':
            return self.number in ('finished', 'invalid')
        if self.scalar == 'invalid':
            return True
        return self.matched == len(self.scalar)

    def append(self, byte: int) -> None:
        if not self.saw_non_whitespace:
            if byte in b' \t\n\r':
                return
            self.saw_non_whitespace = True
            if byte == 34:
                self.inside_string = True
            elif byte in (123, 91):
                self.depth = 1
            elif byte in (116, 102, 110):
                self.scalar = {116: 'true', 102: 'false', 110: 'null'}[byte]
                self.matched = 1
            elif byte == 45 or 48 <= byte <= 57:
                self.scalar = 'number'
                self.number = 'sign' if byte == 45 else 'zero' if byte == 48 else 'integer'
            else:
                self.scalar = 'invalid'
            return
        if self.scalar in ('true', 'false', 'null'):
            if self.matched < len(self.scalar):
                if byte == ord(self.scalar[self.matched]):
                    self.matched += 1
                else:
                    self.scalar = 'invalid'
            elif byte not in b' \t\n\r':
                self.scalar = 'invalid'
            return
        if self.scalar == 'number':
            kind = ('zero' if byte == 48 else 'digit' if 49 <= byte <= 57 else
                    'point' if byte == 46 else 'exponent' if byte in (101, 69) else
                    'sign' if byte in (43, 45) else 'space' if byte in b' \t\n\r' else 'other')
            self.number = self._number_transitions.get((self.number, kind), 'invalid')
            return
        if self.scalar == 'invalid':
            return
        if self.inside_string:
            if self.escaping:
                self.escaping = False
            elif byte == 92:
                self.escaping = True
            elif byte == 34:
                self.inside_string = False
            return
        if byte == 34:
            self.inside_string = True
        elif byte in (123, 91):
            self.depth += 1
        elif byte in (125, 93):
            self.depth = max(0, self.depth - 1)


def _reject_json_constant(value):
    raise ValueError(f'Non-JSON constant: {value}')


def _codex_decimal_int(text: str) -> int:
    """Foundation Decimal parse, then NSNumber.intValue's fixed-width cast.

    Decimal retains a UInt128 mantissa and signed eight-bit exponent. Excess
    least-significant digits are discarded, raising the exponent; validate
    its range before compaction (including zero). This models representation
    loss before the later signed Int64 mantissa conversion and decimal scaling.
    """
    sign, digits, exponent = Decimal(text).as_tuple()
    coefficient = discarded = 0
    for digit in digits:
        candidate = coefficient * 10 + digit
        if discarded or candidate > 2**128 - 1:
            discarded += 1
        else:
            coefficient = candidate
    exponent += discarded
    if not -128 <= exponent <= 127:
        raise ValueError('Foundation Decimal exponent out of range')
    while coefficient and coefficient % 10 == 0 and exponent < 127:
        coefficient //= 10
        exponent += 1
    coefficient = (coefficient + 2**63) % 2**64 - 2**63
    if exponent >= 0:
        coefficient = coefficient * pow(10, exponent, 2**64) % 2**64
    elif exponent < -20:
        coefficient = 0
    else:
        quotient = abs(coefficient) // 10**(-exponent)
        coefficient = -quotient if coefficient < 0 else quotient
    if sign:
        coefficient = -coefficient
    return (coefficient + 2**63) % 2**64 - 2**63


class _CodexJSONInteger(int):
    """Retain bounded Foundation Decimal semantics for large JSON integers."""

    def __new__(cls, text):
        value = super().__new__(cls, text)
        value.foundation_int = ((value + 2**63) % 2**64 - 2**63
            if -(2**63) <= value <= 2**64 - 1 else _codex_decimal_int(text))
        return value


class _CodexJSONFloat(float):
    """Retain the Foundation number representation for fallback integer casts."""

    def __new__(cls, text):
        value = super().__new__(cls, text)
        mantissa = re.split('[eE]', text)[0].lstrip('+-')
        whole, _, fraction = mantissa.partition('.')
        if len(whole.lstrip('0')) + len(fraction) > 17:
            value.foundation_int = _codex_decimal_int(text)
        elif value >= 2**63:
            value.foundation_int = 2**63 - 1
        elif value < -(2**63):
            value.foundation_int = -(2**63)
        else:
            value.foundation_int = int(value)
        return value


def _upstream_json(data: bytes):
    """Foundation JSONSerialization stand-in, including its Unicode checks."""
    try:
        object_pairs = {}

        def capture_object(pairs):
            obj = {}
            for key, item in pairs:
                obj.setdefault(key, item)  # Foundation keeps the first value.
            # Foundation validates every source pair before projecting keys.
            # Keep source pairs only for this parse's iterative validation.
            object_pairs[id(obj)] = pairs
            return obj

        value = json.loads(data, parse_constant=_reject_json_constant,
                           parse_int=_CodexJSONInteger, parse_float=_CodexJSONFloat,
                           object_pairs_hook=capture_object)
        pending = [(value, 0)]
        while pending:
            item, depth = pending.pop()
            if isinstance(item, str):
                if any(0xD800 <= ord(c) <= 0xDFFF for c in item):
                    return None
            elif isinstance(item, float) and item == math.inf:
                return None
            elif isinstance(item, dict):
                depth += 1
                # Foundation permits an empty terminal container at depth 513;
                # only nonempty containers beyond 512 fail serialization.
                if item and depth > 512:
                    return None
                pending.extend((child, depth) for pair in object_pairs[id(item)] for child in pair)
            elif isinstance(item, list):
                depth += 1
                if item and depth > 512:
                    return None
                pending.extend((child, depth) for child in item)
        return (value,)
    except (ValueError, UnicodeError, RecursionError, ArithmeticError):
        return None


class _CodexByteFields:
    """Literal fast extractor; deliberately does not validate a JSON envelope.

    CostUsageScanner+CodexFastJSON.swift 4–309. Keep numeric-prefix and
    unescaped-key matching separate from Foundation fallback semantics.
    """

    def __init__(self, data: bytes):
        self.data = data

    def string_range(self, index: int, limit: int):
        data = self.data
        if index >= limit or data[index] != 34:
            return None
        start = index = index + 1
        escaped = False
        while index < limit:
            if data[index] == 92:
                escaped = True
                index += 2
            elif data[index] == 34:
                return start, index, escaped, index + 1
            else:
                index += 1
        return None

    def object_range(self, index: int, limit: int):
        data = self.data
        if index >= limit or data[index] != 123:
            return None
        start, depth = index, 0
        while index < limit:
            byte = data[index]
            if byte == 34:
                parsed = self.string_range(index, limit)
                if parsed is None:
                    return None
                index = parsed[3]
                continue
            if byte == 123:
                depth += 1
            elif byte == 125:
                depth -= 1
                if depth == 0:
                    return start, index + 1
            index += 1
        return None

    def field(self, key: str, bounds, kind: str = 'string'):
        if bounds is None:
            return None
        data = self.data
        index, limit = bounds
        depth = 0
        marker = key.encode('ascii')
        while index < limit:
            byte = data[index]
            if byte == 123:
                depth += 1
                index += 1
            elif byte == 125:
                depth -= 1
                index += 1
            elif byte == 34:
                parsed = self.string_range(index, limit)
                if parsed is None:
                    return None
                start, end, escaped, value_index = parsed
                index = value_index
                if depth != 1 or escaped or data[start:end] != marker:
                    continue
                while value_index < limit and data[value_index] in b' \t\n\r':
                    value_index += 1
                if value_index >= limit or data[value_index] != 58:
                    continue
                value_index += 1
                while value_index < limit and data[value_index] in b' \t\n\r':
                    value_index += 1
                value = self.value(value_index, limit, kind)
                if value is not None:
                    return value
            else:
                index += 1
        return None

    def value(self, index: int, limit: int, kind: str):
        data = self.data
        if kind == 'object':
            return self.object_range(index, limit)
        if kind == 'int':
            sign = -1 if index < limit and data[index] == 45 else 1
            index += sign == -1
            start = index
            value = 0
            while index < limit and 48 <= data[index] <= 57:
                value = value * 10 + data[index] - 48
                if value > 2**63 - 1:
                    return None
                index += 1
            return sign * value if index > start else None
        if kind == 'bool':
            if data[index: min(index+4, limit)] == b'true':
                return True
            if data[index: min(index+5, limit)] == b'false':
                return False
            return None
        parsed = self.string_range(index, limit)
        if parsed is None:
            return None
        start, end, escaped, _ = parsed
        if start == end and kind != 'empty_string':
            return None
        raw = data[start:end]
        try:
            if not escaped:
                return raw.decode('utf-8')
            # Simple escapes are decoded without rejecting literal controls.
            # A Unicode escape switches the entire string to Foundation JSON.
            output = bytearray()
            index = 0
            escape_bytes = {34: 34, 92: 92, 47: 47, 98: 8, 102: 12, 110: 10, 114: 13, 116: 9}
            while index < len(raw):
                byte = raw[index]
                if byte != 92:
                    output.append(byte)
                else:
                    index += 1
                    if index >= len(raw):
                        return None
                    byte = raw[index]
                    if byte == 117:
                        value = _upstream_json(b'"' + raw + b'"')
                        return value[0] if value is not None else None
                    if byte not in escape_bytes:
                        return None
                    output.append(escape_bytes[byte])
                index += 1
            return output.decode('utf-8')
        except UnicodeError:
            return None


class _CodexPrefixFields:
    """TruncatedPrefix.swift text extractors (escaping is literal removal)."""

    def __init__(self, text: str):
        self.text = text

    def string(self, index: int):
        text = self.text
        if index >= len(text) or text[index] != '"':
            return None
        index += 1
        output = []
        escaped = False
        while index < len(text):
            char = text[index]
            index += 1
            if escaped:
                output.append(char)
                escaped = False
            elif char == '\\':
                escaped = True
            elif char == '"':
                return ''.join(output), index
            else:
                output.append(char)
        return None

    def field(self, key: str, kind='string'):
        text = self.text
        index = depth = 0
        while index < len(text):
            char = text[index]
            if char == '{':
                depth += 1
                index += 1
            elif char == '}':
                depth -= 1
                index += 1
            elif char == '"':
                parsed = self.string(index)
                if parsed is None:
                    return None
                name, index = parsed
                if depth != 1 or name != key:
                    continue
                while index < len(text) and _codex_character_whitespace(text[index]):
                    index += 1
                if index >= len(text) or text[index] != ':':
                    continue
                index += 1
                while index < len(text) and _codex_character_whitespace(text[index]):
                    index += 1
                if kind == 'object':
                    if index < len(text) and text[index] == '{':
                        return _CodexPrefixFields(text[index:])
                else:
                    parsed = self.string(index)
                    if parsed is not None:
                        value, index = parsed
                        if value or kind == 'empty_string':
                            return value
            else:
                index += 1
        return None

    def is_complete(self) -> bool:
        # TruncatedPrefix isCompleteJSONObject: unlike tail state, only braces.
        text = self.text
        if not text.startswith('{'):
            return False
        index = depth = 0
        while index < len(text):
            if text[index] == '"':
                parsed = self.string(index)
                if parsed is None:
                    return False
                index = parsed[1]
                continue
            if text[index] == '{':
                depth += 1
            elif text[index] == '}':
                depth -= 1
                if depth == 0:
                    return True
                if depth < 0:
                    return False
            index += 1
        return False


def _codex_timestamp_valid(timestamp) -> bool:
    """Port dayKeyFromTimestamp then dayKeyFromParsedISO, not display parsing.

    Timestamp.swift 105–180 accepts normalized Calendar components and scans
    backward for a zone; it does not validate RFC3339 ranges or end-of-string.
    Four-digit years/two-digit fields fit Foundation's Gregorian date range.
    """
    if not isinstance(timestamp, str):
        return False
    data = timestamp.encode('utf-8', errors='surrogatepass')

    def number(index, count=2):
        part = data[index:index+count]
        return int(part) if len(part) == count and all(48 <= b <= 57 for b in part) else None

    if (len(data) >= 20 and data[4] == 45 and data[7] == 45
            and all(number(i, n) is not None for i, n in ((0, 4), (5, 2), (8, 2)))):
        clock_ok = (data[10] != 84 or (data[13] == 58 and data[16] == 58
                    and all(number(i) is not None for i in (11, 14, 17))))
        if clock_ok:
            for index in range(len(data)-1, 10, -1):
                if data[index] == 90:
                    return True
                if data[index] in (43, 45):
                    start = index + 1
                    if number(start) is None:
                        break
                    if len(data) > start + 2 and data[start+2] == 58 and number(start+3) is None:
                        break
                    return True
    return _codex_historical_iso_valid(timestamp)


def _codex_int32(value: int) -> int:
    return (value + 2**31) % 2**32 - 2**31


# Foundation CharacterSet.whitespacesAndNewlines (26 Unicode scalars).
_CODEX_TRIM_CHARACTERS = ('\t\n\v\f\r \u0085\u00a0\u1680'
                          '\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007'
                          '\u2008\u2009\u200a\u200b\u2028\u2029\u202f\u205f\u3000')


_CODEX_ICU_MINUS = '-－﹣‐‑‒–−⁻₋➖'
_CODEX_ICU_PLUS = '+＋﬩﹢⁺₊➕'
_CODEX_ICU_BIDI = '\u061c\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069'
_CODEX_ICU_SPACE = _CODEX_TRIM_CHARACTERS.replace('\u200b', '') + _CODEX_ICU_BIDI
_CODEX_ICU_NUMBER = (rf'[{_CODEX_ICU_MINUS}]?(?:\d+(?:[eE][{_CODEX_ICU_MINUS}{_CODEX_ICU_PLUS}]?\d+)?|(?i:NaN)|∞)')
_CODEX_ICU_GAP = rf'[{_CODEX_ICU_SPACE}]*'
_CODEX_HISTORICAL_DATE = re.compile(
    _CODEX_ICU_GAP + '(' + _CODEX_ICU_NUMBER + ')' + _CODEX_ICU_GAP + '-' + _CODEX_ICU_GAP +
    '(' + _CODEX_ICU_NUMBER + ')' + _CODEX_ICU_GAP + '-' + _CODEX_ICU_GAP +
    '(' + _CODEX_ICU_NUMBER + ')' + rf'[{_CODEX_ICU_BIDI}]*T' + _CODEX_ICU_GAP +
    '(' + _CODEX_ICU_NUMBER + ')' + _CODEX_ICU_GAP + ':' + _CODEX_ICU_GAP +
    '(' + _CODEX_ICU_NUMBER + ')' + _CODEX_ICU_GAP + ':' + _CODEX_ICU_GAP +
    '(' + _CODEX_ICU_NUMBER + ')' + r'(?:\.(' + _CODEX_ICU_NUMBER + '))?' +
    _CODEX_ICU_GAP + '(?i:Z|UTC?|GMT|[+-][0-9]+)')


def _codex_historical_number(text: str) -> int:
    """ICU parseInt => Formattable::getLong(), including its union cast."""
    text = text.translate(str.maketrans({c: '-' for c in _CODEX_ICU_MINUS} |
                                     {c: '+' for c in _CODEX_ICU_PLUS}))
    if text.casefold().lstrip('-') == 'nan' or text.lstrip('-') == '∞':
        return 0  # Binary64 NaN/infinity have zero low Int32 mantissa bits.
    scientific = re.split('[eE]', text, maxsplit=1)
    if len(scientific) == 2:
        raw_exponent = scientific[1]
        exponent_digits = ''.join(str(int(c)) for c in raw_exponent.lstrip('+-')).lstrip('0')
        # ICU DecimalMatcher checks the exponent against Int32.max before
        # adjusting magnitude. Overflow becomes infinity; underflow clears to
        # zero. Both union casts yield zero, including signed/zero mantissas.
        if len(exponent_digits) > 10 or (exponent_digits and int(exponent_digits) > 2**31 - 1):
            return 0
        exponent_sign = '-' if raw_exponent.startswith('-') else ''
        text = scientific[0] + 'e' + exponent_sign + (exponent_digits or '0')
    decimal = Decimal(text)
    sign, digits, exponent = decimal.as_tuple()
    coefficient = 0
    for digit in digits:
        coefficient = coefficient * 10 + digit
    if exponent < 0:
        divisor = 10**(-exponent) if -exponent <= len(digits) else coefficient + 1
        integer, remainder = divmod(coefficient, divisor)
    elif len(digits) + exponent <= 19:
        integer, remainder = coefficient * 10**exponent, 0
    else:
        integer, remainder = None, 0
    if integer is not None and sign:
        integer = -integer
    if integer is not None and not remainder and -(2**63) <= integer < 2**63:
        return _codex_int32(integer)
    bits = struct.unpack('<Q', struct.pack('<d', float(decimal)))[0]
    return _codex_int32(bits)


def _codex_historical_julian_day(year: int, month: int, day: int) -> int | None:
    """Fixed GregorianCalendar day-of-month slice with checked Int32 edges."""
    if year > (2**31 - 1) // 2:
        return None
    previous_year = year - 1
    starts = (0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334)

    def compute(gregorian):
        leap = year % 4 == 0 and (not gregorian or year % 100 != 0 or year % 400 == 0)
        raw = 365 * previous_year + previous_year // 4 + 1721426 - 3
        if gregorian:
            raw += 2 - previous_year // 100 + previous_year // 400
        raw += starts[month - 1] + int(leap and month > 2)
        result = _codex_int32(raw) + day
        return result if -(2**31) <= result < 2**31 else None

    gregorian = year >= 1582
    result = compute(gregorian)
    if result is not None and gregorian != (result >= 2299161):
        result = compute(not gregorian)
    return result


def _codex_historical_iso_valid(timestamp: str) -> bool:
    """The historical formatter's fixed internet-date-time numeric slice."""
    match = _CODEX_HISTORICAL_DATE.match(timestamp)
    if match is None:
        return False
    year, month, day, hour, minute, second = map(_codex_historical_number, match.groups()[:6])
    if not (1 <= month <= 12 and 1 <= day <= 31 and 0 <= hour <= 24
            and 0 <= minute < 60 and 0 <= second < 60):
        return False
    julian = _codex_historical_julian_day(year, month, day)
    if julian is None:
        return False
    milliseconds = 0
    fraction = match[7]
    if fraction is not None:
        milliseconds = _codex_historical_number(fraction)
        # ICU countDigits uses u_isdigit (Unicode Nd), not all numeric characters.
        count = sum(c.isdecimal() for c in fraction)
        if count < 3:
            milliseconds = _codex_int32(milliseconds * 10**(3 - count))
        else:
            divisor = _codex_int32(pow(10, count - 3, 2**32))
            # subParse's Int32 a *= 10 wraps to zero for 32+ excess digits.
            # The pinned formatter's macOS ARM64 division then yields zero;
            # standalone Foundation probes retain these fractions at midnight.
            quotient = abs(milliseconds) // abs(divisor) if divisor else 0
            milliseconds = -quotient if (milliseconds < 0) != (divisor < 0) else quotient
    # ICU uses Double UDate milliseconds: at extreme dates fractional clock
    # values can disappear or carry into the next day before overflow checks.
    local_millis = float((julian - 2440588) * 86400000) + ((hour * 3600 + minute * 60 + second) * 1000 + milliseconds)
    normalized = math.floor(local_millis / 86400000) + 2440588
    return -(2**31) + 2440588 <= normalized < 2**31


def _codex_string(value):
    return value if isinstance(value, str) else None


def _codex_number(value):
    # Foundation's NSNumber.intValue includes bool, truncates floating values
    # and returns the signed platform Int for unsigned integer JSON numbers.
    if isinstance(value, (_CodexJSONInteger, _CodexJSONFloat)):
        return value.foundation_int
    if isinstance(value, int):
        return (value + 2**63) % 2**64 - 2**63
    if isinstance(value, float) and math.isfinite(value):
        return int(value) if -(2**63) <= value < 2**63 else (2**63 - 1 if value > 0 else -(2**63))
    return None


def _codex_first(*values):
    return next((value for value in values if value is not None), None)


def _codex_trim(value: str) -> str:
    return value.strip(_CODEX_TRIM_CHARACTERS)


def _codex_character_whitespace(value: str) -> bool:
    # Swift Character.isWhitespace is Unicode White_Space, excluding 200B.
    return value in _CODEX_TRIM_CHARACTERS and value != '\u200b'


def _codex_model_evidence(value):
    return _codex_trim(value) or None if isinstance(value, str) else None


def _codex_context_model(*values):
    present = [value for value in values if isinstance(value, str)]
    model = _codex_first(*(_codex_model_evidence(value) for value in present))
    return {'set': model} if model is not None else {'clear': True} if present else None


def _codex_project_path(value):
    if not isinstance(value, str) or not _codex_trim(value):
        return None
    path = os.path.expanduser(_codex_trim(value))
    return os.path.normpath('/' + path.lstrip('/')) if path.startswith('/') else None


def _codex_metadata(get, payload, info_object, root):
    """Shared scalar projection; getter retains fast versus fallback semantics."""
    parent = _codex_first(*(_codex_model_evidence(get(payload, key)) for key in
                            ('forked_from_id', 'forkedFromId', 'parent_session_id', 'parentSessionId')))
    history = _codex_first(info_object(payload, 'history_base'), info_object(payload, 'historyBase'))
    history_id = _codex_first(*(_codex_model_evidence(get(history, key)) for key in ('thread_id', 'threadId')))
    source = get(payload, 'source')
    if source is not None:
        subagent = _codex_trim(source).lower() == 'subagent'
    else:
        source = info_object(payload, 'source')
        subagent = (get(source, 'subagent') is not None or info_object(source, 'subagent') is not None)
    return {
        'session_id': _codex_first(get(payload, 'id'), get(root, 'id'), get(payload, 'session_id'),
                                  get(payload, 'sessionId'), get(root, 'session_id'), get(root, 'sessionId')),
        'forked_from_id': parent,
        'fork_ts': _codex_first(get(payload, 'timestamp'), get(root, 'timestamp')),
        'project_path': _codex_project_path(get(payload, 'cwd')),
        'is_subagent': subagent,
        'history_start_ordinal': get(payload, 'subagent_history_start_ordinal', 'int'),
        'history_base_thread_id': history_id,
    }


def _codex_projection(get, object_field, root, *, fast: bool):
    """Port parseCodexFastLine and the corresponding dictionary fallback."""
    kind = get(root, 'type')
    payload = object_field(root, 'payload')
    if kind == 'session_meta':
        return ['M', _codex_metadata(get, payload, object_field, root)]
    timestamp = get(root, 'timestamp')
    if kind == 'inter_agent_communication_metadata':
        trigger = get(payload, 'trigger_turn', 'bool')
        return None if fast and trigger is None else ['I', trigger is True]
    if kind == 'turn_context':
        info = object_field(payload, 'info')
        return ['C', timestamp, _codex_context_model(get(payload, 'model', 'empty_string'),
            get(payload, 'model_name', 'empty_string'), get(info, 'model', 'empty_string'),
            get(info, 'model_name', 'empty_string'))]
    if kind != 'event_msg' or payload is None:
        return None
    payload_type = get(payload, 'type')
    info = object_field(payload, 'info')
    turn_id = _codex_first(*(get(container, key) for container in (payload, info)
                              for key in ('turn_id', 'turnId', 'id')))
    if payload_type == 'task_started':
        return ['S', turn_id]
    if payload_type != 'token_count' or (fast and (timestamp is None or info is None)):
        return None
    model = _codex_first(*(_codex_model_evidence(get(container, key)) for container, key in
                           ((info, 'model'), (info, 'model_name'), (payload, 'model'), (root, 'model'))))

    def totals(container):
        if container is None:
            return None
        output = max(0, get(container, 'output_tokens', 'int') or 0)
        reasoning = get(container, 'reasoning_output_tokens', 'int')
        return [max(0, get(container, 'input_tokens', 'int') or 0),
                max(0, get(container, 'cached_input_tokens', 'int') or 0,
                    get(container, 'cache_read_input_tokens', 'int') or 0), output,
                min(max(0, reasoning), output) if reasoning is not None else None]

    return ['T', timestamp, model, turn_id, totals(object_field(info, 'last_token_usage')),
            totals(object_field(info, 'total_token_usage'))]


def _codex_fast_line(data: bytes):
    fields = _CodexByteFields(data)
    root = (0, len(data))

    def get(container, key, kind='string'):
        return fields.field(key, container, kind)

    def child(container, key):
        return fields.field(key, container, 'object')

    return _codex_projection(get, child, root, fast=True)


def _codex_dictionary_line(obj: dict):
    def get(container, key, kind='string'):
        if not isinstance(container, dict):
            return None
        value = container.get(key)
        if kind == 'int':
            return _codex_number(value)
        if kind == 'bool':
            return bool(value) if isinstance(value, (bool, int, float)) and value in (0, 1) else None
        return _codex_string(value)

    def child(container, key):
        if not isinstance(container, dict):
            return None
        value = container.get(key)
        return value if isinstance(value, dict) else None

    return _codex_projection(get, child, obj, fast=False)


def _codex_bare_usage(obj: dict):
    usage = _codex_first(*(container.get('usage') if isinstance(container.get('usage'), dict) else None
                          for container in (obj, _object(obj.get('data')), _object(obj.get('result')),
                                            _object(obj.get('response')))))
    if usage is None:
        return None
    def number(keys):
        return _codex_first(*(_codex_number(usage.get(key)) for key in keys))
    input_tokens = number(('input_tokens', 'prompt_tokens', 'input'))
    output = number(('output_tokens', 'completion_tokens', 'output'))
    if input_tokens is None or output is None:
        return None
    cached = max(0, number(('cached_input_tokens', 'cache_read_input_tokens', 'cached_tokens')) or 0)
    billed = max(0, max(0, input_tokens) - cached)
    output = max(0, output)
    if not (billed or output or cached):
        return None
    data = _object(obj.get('data'))
    model = _codex_first(*(_codex_model_evidence(container.get(key))
                           for container in (obj, data) for key in ('model', 'model_name')))
    return ['B', _codex_string(obj.get('timestamp')), model, [billed, cached, output, None]]


TokenStream = dict[str, list | bool]


class TokenStreamBuilder:
    """Cache-safe scalar observations, built during Colophon's single read."""

    def __init__(self):
        self.observations = []
        self.prepass = None
        self.uidx = 0
        self.unconsumed_tail = False

    def feed(self, line_index: int, data: bytes, obj: dict | None, *, terminated: bool) -> None:
        # obj is deliberately optional: the raw fast path can differ from a
        # decoded object. No caller's crash recovery participates in routing.
        truncated = len(data) > UPSTREAM_MAX_LINE_BYTES
        prefix = data[:UPSTREAM_MAX_LINE_BYTES]
        fast = None
        parsed = None
        if not truncated and data:
            fast = _codex_fast_line(data)
            if self.prepass is None:
                metadata = fast if fast is not None and fast[0] == 'M' else None
                if metadata is None:
                    parsed = _upstream_json(data)
                    if parsed is not None and isinstance(parsed[0], dict):
                        candidate = _codex_dictionary_line(parsed[0])
                        metadata = candidate if candidate is not None and candidate[0] == 'M' else None
                if metadata is not None:
                    self.prepass = ['P', metadata[1]]
        if not terminated and data:
            state = JSONTailState()
            for byte in data:
                state.append(byte)
            if not state.is_structurally_complete:
                self.unconsumed_tail = True
                return
            if not truncated:
                parsed = _upstream_json(data)
                if parsed is None:
                    self.unconsumed_tail = True
                    return
        if not data:
            return
        uidx = self.uidx
        self.uidx += 1
        if truncated:
            self._truncated(line_index, uidx, prefix)
            return
        if b'"usage"' in data:
            parsed = parsed if parsed is not None else _upstream_json(data)
            if parsed is not None and isinstance(parsed[0], dict) and 'type' not in parsed[0]:
                bare = _codex_bare_usage(parsed[0])
                if bare is not None:
                    self.observations.append([bare[0], line_index, uidx, *bare[1:]])
            return
        if not any(marker in data for marker in (b'"event_msg"', b'"turn_context"',
                    b'"session_meta"', b'"inter_agent_communication_metadata"')):
            return
        if b'"type":"event_msg"' in data and b'"token_count"' not in data and b'"task_started"' not in data:
            return
        fields = _CodexByteFields(data)
        bounds = (0, len(data))
        ordinal = fields.field('ordinal', bounds, 'int')
        if fast is not None:
            timestamp = fields.field('timestamp', bounds)
            validity = True if fast[0] == 'M' else _codex_timestamp_valid(timestamp) if timestamp is not None else None
            if validity is True:
                self.observations.append([fast[0], line_index, uidx, ordinal, *fast[1:]])
                return
            if validity is False:
                return
        parsed = parsed if parsed is not None else _upstream_json(data)
        if parsed is None or not isinstance(parsed[0], dict):
            return
        record = parsed[0]
        fallback = _codex_dictionary_line(record)
        if fallback is not None and (fallback[0] == 'M' or _codex_timestamp_valid(record.get('timestamp'))):
            self.observations.append([fallback[0], line_index, uidx, _codex_number(record.get('ordinal')), *fallback[1:]])

    def _truncated(self, line: int, uidx: int, prefix: bytes) -> None:
        text = None
        for drop in range(min(4, len(prefix)) + 1):
            try:
                text = prefix[:len(prefix)-drop].decode('utf-8')
                break
            except UnicodeError:
                pass
        if text is None:
            return
        fields = _CodexPrefixFields(text)
        kind = fields.field('type')
        payload = fields.field('payload', 'object')
        if kind == 'session_meta':
            session_id = _codex_first(*(payload.field(key) for key in ('id', 'session_id', 'sessionId'))) if payload else None
            # Planned stream adaptation: Task14 applies subagent-pending gate.
            self.observations.append(['XM', line, uidx, session_id])
        elif kind == 'turn_context' and _codex_timestamp_valid(fields.field('timestamp')) and payload is not None:
            info = payload.field('info', 'object')
            model = _codex_context_model(payload.field('model', 'empty_string'),
                payload.field('model_name', 'empty_string'),
                info.field('model', 'empty_string') if info else None,
                info.field('model_name', 'empty_string') if info else None)
            if model == {'clear': True} and not payload.is_complete():
                model = None
            self.observations.append(['XC', line, uidx, model])

    def result(self) -> TokenStream:
        observations = ([self.prepass] if self.prepass is not None else []) + self.observations
        return {'observations': observations, 'unconsumed_tail': self.unconsumed_tail}


def parse_log_file(path: Path, *, size: int, mtime_ns: int, archived: bool) -> dict:
    """Read a log once, retaining facts rather than raw decoded records."""
    result = {
        "parser_version": PARSER_VERSION,
        "key": {"path": codex_path_key(path), "size": size, "mtime_ns": mtime_ns},
        "archived": archived, "status": "empty", "no_session_meta": True,
        "lines": {"malformed": 0, "recovered": 0, "partial_final_line": False},
        "unknown_types": {}, "meta": None, "extra_meta_count": 0,
        "wrapper_ts": {"count": 0, "distinct": 0},
        "usage_records": [],
    }
    token_builder = TokenStreamBuilder()
    wrapper_values: set[str] = set()
    facts: list[RecordFact] = []
    with path.open("rb") as fh:
        tail_start = max(0, size - TAIL_FINGERPRINT_BYTES)
        fh.seek(tail_start)
        result["key"]["tail_sha256"] = hashlib.sha256(fh.read(size - tail_start)).hexdigest()
        fh.seek(0)
        for raw in iter_log_lines(fh, size):
            token_builder.feed(raw.index, raw.data, None, terminated=raw.terminated)
            if raw.terminated:
                decoded = decode_line(raw.data)
                if decoded.status in ("malformed", "recovered"):
                    result["lines"][decoded.status] += 1
                record = decoded.obj
                del decoded
            else:
                record = _json_object(raw.data)
                if record is None:
                    result["lines"]["partial_final_line"] = True
            if record is None:
                continue
            payload = _object(record.get("payload"))
            key = record_type_key(record)
            if key not in KNOWN_RECORD_KEYS:
                unknown = result["unknown_types"]
                unknown[key] = unknown.get(key, 0) + 1
            timestamp = record.get("timestamp")
            if isinstance(timestamp, str):
                result["wrapper_ts"]["count"] += 1
                if len(wrapper_values) < 3:
                    wrapper_values.add(timestamp)
            if key == "session_meta":
                header = _session_meta(record, payload)
                if result["no_session_meta"]:
                    result["meta"] = header
                    result["no_session_meta"] = False
                else:
                    result["extra_meta_count"] += 1
                if result["status"] == "empty":
                    result["status"] = "header_only"
            else:
                result["status"] = "ok"
            facts.append(_record_fact(record, payload, rec=len(facts), line=raw.index,
                                      kind=key, meta_id=header["id"] if key == "session_meta" else None))
            if key == "token_usage_record":
                result["usage_records"].append(_usage_record(record, payload, facts[-1]))
            # The next phase uses scalar facts only, including after the final
            # iteration where loop variables would otherwise retain a payload.
            del record, payload
    # Loop bindings survive exhaustion, even for a skipped damaged tail. Keep
    # neither the last line's bytes nor a later metadata header in phase two.
    raw = header = None
    result["token_stream"] = token_builder.result()
    del token_builder
    result["wrapper_ts"]["distinct"] = len(wrapper_values)
    result["history"], inherited = _history(result["meta"], facts)
    builder = TurnBuilder()
    first_ms = last_ms = None
    attributed: dict[int, str | None] = {}
    for fact in facts:
        if inherited[fact.rec]:
            continue
        if fact.at_ms is not None:
            first_ms = fact.at_ms if first_ms is None else min(first_ms, fact.at_ms)
            last_ms = fact.at_ms if last_ms is None else max(last_ms, fact.at_ms)
        if result["history"]["method"] != "unresolved":
            attributed[fact.rec] = builder.add(fact)
    result["owned_span"] = {"first_ms": first_ms, "last_ms": last_ms}
    result["turns"] = builder.turns
    candidates = []
    item_turns = set()
    for fact in facts:
        if inherited[fact.rec]:
            continue
        turn_key = attributed.get(fact.rec)
        # Explicit IDs can point at a lifecycle start later in the file.
        if turn_key is None and fact.turn_id in builder.by_id:
            turn_key = builder.by_id[fact.turn_id]["key"]
        if fact.item_message and turn_key is not None:
            item_turns.add(turn_key)
        if fact.message is not None:
            candidates.append((fact, turn_key))
    result["messages"] = _deduplicate_messages(candidates, item_turns)
    result["voice"] = _place_voice(facts, inherited, builder)
    result["tools"], result["links"] = _tools_and_links(facts, inherited, attributed, builder)
    return result


# ===== 7. Parse cache and scan =====
class LogFile(NamedTuple):
    path: Path
    archived: bool
    size: int
    mtime_ns: int


class ScanResult(NamedTuple):
    records: list[dict]
    parsed: int
    cached: int
    unreadable: list[tuple[str, str]]
    bytes_parsed: int


def codex_path_key(path: Path) -> str:
    """Port codexPathKey: standardize lexically, preserving symlink spellings."""
    value = os.path.abspath(path)
    return value[len("/private"):] if value.startswith("/private/var/") else value


def _directory_children(path: Path) -> list[Path]:
    try:
        return list(path.iterdir())
    except OSError:
        return []


def _visible_children(path: Path) -> list[Path]:
    return [p for p in _directory_children(path) if not _is_hidden(p)]


def _partition_year(name: str) -> bool:
    # Swift Character.isNumber includes numeric characters beyond ASCII digits.
    return len(name) == 4 and all(char.isnumeric() for char in name)


@lru_cache(maxsize=1)
def _darwin_resource_api():
    """Load Darwin's discovery property getters once, with explicit C signatures."""
    cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
    cf.CFURLCreateFromFileSystemRepresentation.argtypes = [
        ctypes.c_void_p, ctypes.c_char_p, ctypes.c_long, ctypes.c_bool]
    cf.CFURLCreateFromFileSystemRepresentation.restype = ctypes.c_void_p
    cf.CFURLCopyResourcePropertyForKey.argtypes = [
        ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p),
        ctypes.POINTER(ctypes.c_void_p)]
    cf.CFURLCopyResourcePropertyForKey.restype = ctypes.c_bool
    cf.CFBooleanGetValue.argtypes = [ctypes.c_void_p]
    cf.CFBooleanGetValue.restype = ctypes.c_bool
    cf.CFRelease.argtypes = [ctypes.c_void_p]
    cf.CFRelease.restype = None
    return cf, {name: ctypes.c_void_p.in_dll(cf, name)
                for name in ("kCFURLIsPackageKey", "kCFURLIsHiddenKey")}


def _darwin_resource_flag(path: Path, name: str) -> bool:
    cf, keys = _darwin_resource_api()
    key = keys[name]
    data = os.fsencode(path)
    url = cf.CFURLCreateFromFileSystemRepresentation(None, data, len(data), True)
    if not url:
        return False
    value = ctypes.c_void_p()
    error = ctypes.c_void_p()
    try:
        ok = cf.CFURLCopyResourcePropertyForKey(url, key, ctypes.byref(value), ctypes.byref(error))
        return bool(ok and value and cf.CFBooleanGetValue(value))
    finally:
        for owned in (value, error, url):
            if owned:
                cf.CFRelease(owned)


def _is_package(path: Path) -> bool:
    # Corelibs NSURLDirectoryEnumerator explicitly ignores this option on POSIX.
    return sys.platform == "darwin" and _darwin_resource_flag(path, "kCFURLIsPackageKey")


def _is_hidden(path: Path) -> bool:
    return (path.name.startswith(".")
            or (sys.platform == "darwin" and _darwin_resource_flag(path, "kCFURLIsHiddenKey")))


def _codex_root_files(root: Path) -> set[Path]:
    """List canonical calendar partitions, flat files, and legacy descendants."""
    children = _visible_children(root)
    files = {p for p in children if p.suffix.lower() == ".jsonl"}
    # The source generates day paths directly: only day entries are filtered
    # for hiddenness, never the canonical year/month/day ancestors.
    for year in _directory_children(root):
        if not re.fullmatch(r"[0-9]{4}", year.name) or not year.is_dir():
            continue
        for month in _directory_children(year):
            if not re.fullmatch(r"[0-9]{2}", month.name) or not month.is_dir():
                continue
            for day in _directory_children(month):
                if not re.fullmatch(r"[0-9]{2}", day.name) or not day.is_dir():
                    continue
                try:
                    datetime(int(year.name), int(month.name), int(day.name))
                except ValueError:
                    continue
                files.update(p for p in _visible_children(day) if p.suffix.lower() == ".jsonl")
    for directory, dirs, names in os.walk(root):
        parent = Path(directory)
        visible_dirs = [name for name in dirs if not _is_hidden(parent / name)
                        and not (parent == root and _partition_year(name))]
        files.update(parent / name for name in names + visible_dirs
                     if not _is_hidden(parent / name) and Path(name).suffix.lower() == ".jsonl")
        dirs[:] = [name for name in visible_dirs if not _is_package(parent / name)]
    return files


def discover_logs(codex_home: Path) -> list[LogFile]:
    """Port all-history recursive Codex discovery with root and identity ordering."""
    result = []
    seen_paths: set[str] = set()
    seen_ids: set[tuple[int, int]] = set()
    for name in ("sessions", "archived_sessions"):
        root = Path(os.path.abspath(codex_home / name))
        for path in sorted(_codex_root_files(root), key=str):
            key = codex_path_key(path)
            if key in seen_paths:
                continue
            seen_paths.add(key)
            path = Path(key)
            try:
                stat = path.stat()
            except OSError:
                # codexFileMetadata retains candidates with unknown stat data.
                result.append(LogFile(path, name == "archived_sessions", 0, 0))
                continue
            identity = (stat.st_dev, stat.st_ino)
            if identity in seen_ids:
                continue
            seen_ids.add(identity)
            result.append(LogFile(path, name == "archived_sessions", stat.st_size, stat.st_mtime_ns))
    return result


class ParseCache:
    """Buffer parse records; rebuilds leave the installed cache intact until swap."""
    def __init__(self, home: Path, *, rebuild: bool):
        self.home = home
        self.rebuild = rebuild
        self.installed = home / "cache"
        self.directory = home / f"cache.rebuild-{os.getpid()}" if rebuild else self.installed
        self.buffer: dict[str, dict] = {}
        self._live_paths: set[str] = set()
        self._committed = False
        self._abort_cleanup_error: BaseException | None = None
        self.finished = False
        self._read_enabled = True

    @classmethod
    def open(cls, home: Path, *, rebuild: bool) -> ParseCache:
        home = ensure_runtime_home(home)
        installed = home / "cache"
        dead_dirs = []
        for path in sorted(home.iterdir()):
            match = re.fullmatch(r"cache\.(rebuild|old)-([0-9]+)", path.name)
            if match is None or not path.is_dir() or path.is_symlink():
                continue
            pid = int(match[2])
            if pid <= 0:
                continue
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                dead_dirs.append((path, match[1]))
            except (PermissionError, OverflowError):
                pass
        for path, kind in dead_dirs:
            if kind == "old" and not installed.exists():
                path.rename(installed)
            else:
                shutil.rmtree(path)
        cache = cls(home, rebuild=rebuild)
        if rebuild:
            cache.directory.mkdir(mode=0o700)
        else:
            marker_missing = False
            try:
                valid = (installed / "FORMAT").read_text() == cache._format()
            except FileNotFoundError:
                valid = False
                marker_missing = True
            except (OSError, UnicodeError):
                valid = False
            # A concurrent first run can be between mkdir and FORMAT install.
            # Only an existing mismatched marker proves an obsolete cache.
            if not valid and not marker_missing and installed.exists():
                shutil.rmtree(installed)
            cache._read_enabled = valid
            ensure_runtime_home(installed)
        try:
            # An installed cache without a marker is untrusted for every
            # concurrent reader until all entries are replaced at commit.
            if rebuild:
                atomic_write_bytes(cache.directory / "FORMAT", cache._format().encode())
        except BaseException as failure:
            cache._abort_after_failure(failure)
            raise
        return cache

    @staticmethod
    def _format() -> str:
        return f"{CACHE_SCHEMA}:{PARSER_VERSION}"

    @staticmethod
    def _entry_name(path: str) -> str:
        return hashlib.sha256(path.encode("utf-8")).hexdigest() + ".json"

    def get(self, log: LogFile) -> dict | None:
        if self.rebuild or self.finished or not self._read_enabled:
            return None
        path = codex_path_key(log.path)
        try:
            record = json.loads((self.directory / self._entry_name(path)).read_bytes())
        except (OSError, ValueError, UnicodeError, RecursionError):
            return None
        if (not isinstance(record, dict) or type(record.get("parser_version")) is not int
                or record["parser_version"] != PARSER_VERSION):
            return None
        key = record.get("key")
        if not isinstance(key, dict) or key.get("path") != path:
            return None
        if (type(key.get("size")) is not int or type(key.get("mtime_ns")) is not int
                or key["size"] != log.size or key["mtime_ns"] != log.mtime_ns):
            return None
        with log.path.open("rb") as fh:
            start = max(0, log.size - TAIL_FINGERPRINT_BYTES)
            fh.seek(start)
            fingerprint = hashlib.sha256(fh.read(log.size - start)).hexdigest()
        return record if fingerprint == key.get("tail_sha256") else None

    def put(self, record: dict) -> None:
        if self.finished:
            raise RuntimeError("Parse cache is closed")
        self.buffer[record["key"]["path"]] = record

    @staticmethod
    def _directory_identity(path: Path) -> tuple[int, int] | None:
        try:
            info = path.stat(follow_symlinks=False)
        except FileNotFoundError:
            return None
        if not stat.S_ISDIR(info.st_mode):
            raise NotADirectoryError(f"Cache path is not a directory: {path}")
        return info.st_dev, info.st_ino

    def commit(self, live_paths: set[str]) -> None:
        if self.finished:
            return
        installed_paths = set()
        for path, record in self.buffer.items():
            if path in live_paths:
                atomic_write_json(self.directory / self._entry_name(path), record, indent=None)
                installed_paths.add(path)
        # Discovery alone cannot rehabilitate entries from an unknown format:
        # unreadable logs have no trusted replacement to publish to peers.
        keep_paths = live_paths if self._read_enabled else installed_paths
        live_names = {self._entry_name(path) for path in keep_paths}
        for path in self.directory.glob("*.json"):
            if path.name not in live_names:
                path.unlink(missing_ok=True)
        if self.rebuild:
            old = self.home / f"cache.old-{os.getpid()}"
            # Reject any existing backup before entering mutation recovery.
            if os.path.lexists(old):
                raise FileExistsError(f"Rebuild backup already exists: {old}")
            prior_identity = self._directory_identity(self.installed)
            new_identity = self._directory_identity(self.directory)
            if new_identity is None:
                raise FileNotFoundError(f"Rebuild directory is missing: {self.directory}")
            try:
                if prior_identity is not None:
                    self.installed.rename(old)
                self.directory.rename(self.installed)
                # The rename is the commit point, including when an interrupt
                # arrives before these Python bookkeeping assignments execute.
                self._committed = True
                self.buffer.clear()
                self.finished = True
            except BaseException:
                # A completed filesystem call can raise before the next Python
                # assignment. Recognize owned directories by captured identity,
                # never infer a successful move merely from an absent path.
                with contextlib.suppress(OSError):
                    installed_identity = self._directory_identity(self.installed)
                    if installed_identity == new_identity:
                        self._committed = True
                        self.buffer.clear()
                        self.finished = True
                    elif (prior_identity is not None and installed_identity is None
                          and self._directory_identity(old) == prior_identity
                          and self._directory_identity(self.directory) == new_identity):
                        old.rename(self.installed)
                # Recovery failures must not replace the original interrupt.
                raise
        else:
            if not self._read_enabled:
                atomic_write_bytes(self.directory / "FORMAT", self._format().encode())
            self._committed = True
            self.buffer.clear()
            self.finished = True
        # A partly deleted backup cannot be rolled back. Garbage cleanup occurs
        # only after installation is recorded as committed.
        if self.rebuild and prior_identity is not None:
            with contextlib.suppress(OSError):
                shutil.rmtree(old)

    def abort(self) -> None:
        self.buffer.clear()
        try:
            if self.rebuild and not self.finished:
                with contextlib.suppress(FileNotFoundError):
                    shutil.rmtree(self.directory)
        except BaseException as cleanup:
            self._abort_cleanup_error = cleanup
            raise
        finally:
            self.finished = True

    def _abort_after_failure(self, failure: BaseException) -> None:
        """Close after a primary failure without replacing it with cleanup."""
        try:
            self.abort()
        except BaseException as cleanup:
            failure.add_note(f"Parse cache abort cleanup failed: {type(cleanup).__name__}: {cleanup}")


def scan_logs(codex_home: Path, cache: ParseCache, *,
              progress: Callable[[int, int], None] | None = None) -> ScanResult:
    """Buffer cache misses from scan-start snapshots; the caller owns commit."""
    try:
        logs = sorted(discover_logs(codex_home),
                      key=lambda log: (-(log.mtime_ns // 1_000_000), log.size, str(log.path)))
        cache._live_paths = {str(log.path) for log in logs}
        hits: dict[str, dict] = {}
        misses: list[LogFile] = []
        unreadable = []
        for log in logs:
            try:
                record = cache.get(log)
            except OSError as exc:
                unreadable.append((str(log.path), str(exc)))
                continue
            if record is None:
                misses.append(log)
            else:
                hits[str(log.path)] = record
        total = sum(log.size for log in misses)
        parsed = done = 0
        for log in misses:
            try:
                record = parse_log_file(log.path, size=log.size, mtime_ns=log.mtime_ns,
                                        archived=log.archived)
            except OSError as exc:
                unreadable.append((str(log.path), str(exc)))
                continue
            hits[str(log.path)] = record
            cache.put(record)
            parsed += 1
            done += log.size
            if progress is not None:
                progress(done, total)
        records = [hits[str(log.path)] for log in logs if str(log.path) in hits]
        return ScanResult(records, parsed, len(records) - parsed, unreadable, done)
    except BaseException as failure:
        cache._abort_after_failure(failure)
        raise


# ===== 8. Codex metadata =====
@dataclass
class CodexMetadata:
    threads: dict[str, dict] = field(default_factory=dict)
    index_titles: dict[str, str] = field(default_factory=dict)
    desktop_titles: dict[str, str] = field(default_factory=dict)
    spawn_parents: dict[str, str] = field(default_factory=dict)
    rollout_paths: dict[str, str] = field(default_factory=dict)
    errors: list[str] = field(default_factory=list)


def _metadata_text(value) -> bool:
    """Test text evidence without changing a usable string's spelling."""
    return isinstance(value, str) and bool(value.strip())


def _read_codex_database(path: Path) -> CodexMetadata:
    result = CodexMetadata()
    columns = (
        "id", "name", "title", "cwd", "git_branch", "git_origin_url", "git_sha",
        "source", "originator", "archived", "first_user_message", "agent_nickname",
        "agent_role", "agent_path", "rollout_path",
    )
    # mode=ro preserves Codex data; SQLite may coordinate reads in WAL/SHM.
    # A transaction keeps threads and spawn edges in the same database snapshot.
    with contextlib.closing(sqlite3.connect(
        path.absolute().as_uri() + "?mode=ro", uri=True, timeout=1,
    )) as db:
        db.execute("BEGIN")
        available = {row[1] for row in db.execute("PRAGMA table_info(threads)")}
        if "id" not in available:
            raise sqlite3.OperationalError("threads table missing id column")
        selected = [column for column in columns if column in available]
        projection = ", ".join(f'"{column}"' for column in selected)
        ambiguous = set()
        for values in db.execute(f"SELECT {projection} FROM threads"):
            info = {key: value for key, value in zip(selected, values)
                    if value is not None and value != ""}
            identifier = info.get("id")
            if not _metadata_text(identifier) or identifier in ambiguous:
                continue
            if identifier in result.threads and result.threads[identifier] != info:
                ambiguous.add(identifier)
                del result.threads[identifier]
                result.errors.append(f"{path.name}: conflicting duplicate threads id")
            else:
                result.threads[identifier] = info
        result.rollout_paths = {identifier: info["rollout_path"]
            for identifier, info in result.threads.items()
            if _metadata_text(info.get("rollout_path"))}

        exists = db.execute("SELECT 1 FROM sqlite_master WHERE type='table' "
                            "AND name='thread_spawn_edges'").fetchone()
        if exists:
            edge_columns = {row[1] for row in db.execute("PRAGMA table_info(thread_spawn_edges)")}
            pair = next((pair for pair in (
                ("child_thread_id", "parent_thread_id"), ("child_id", "parent_id"),
            ) if set(pair) <= edge_columns), None)
            if pair is None:
                result.errors.append(f"{path.name}: unrecognized thread_spawn_edges columns")
            else:
                ambiguous_children = set()
                for child, parent in db.execute(
                    f'SELECT "{pair[0]}", "{pair[1]}" FROM thread_spawn_edges'
                ):
                    if not _metadata_text(child) or not _metadata_text(parent) or child in ambiguous_children:
                        continue
                    previous = result.spawn_parents.get(child)
                    if previous is not None and previous != parent:
                        ambiguous_children.add(child)
                        del result.spawn_parents[child]
                        result.errors.append(f"{path.name}: conflicting thread_spawn_edges parents")
                    else:
                        result.spawn_parents[child] = parent
    return result


def _index_updated_key(value) -> tuple[int, str] | None:
    """Order RFC 3339 instants exactly, including sub-millisecond fractions."""
    if parse_rfc3339_ms(value) is None:
        return None
    fraction = re.search(r"\.(\d+)", value)
    whole = value if fraction is None else value[:fraction.start()] + value[fraction.end():]
    return (parse_rfc3339_ms(whole) // 1000,
            fraction[1].rstrip("0") if fraction else "")


def load_codex_metadata(codex_home: Path) -> CodexMetadata:
    """Load optional Codex metadata; unusable sources do not prevent a run."""
    result = CodexMetadata()
    try:
        candidates = [(int(match[1]), path) for path in codex_home.glob("state_*.sqlite")
                      if (match := re.fullmatch(r"state_([0-9]+)\.sqlite", path.name))]
    except (OSError, ValueError) as exc:
        result.errors.append(f"state databases: {exc}")
        candidates = []
    for _, path in sorted(candidates, key=lambda item: (-item[0], str(item[1]))):
        try:
            database = _read_codex_database(path)
        except sqlite3.Error as exc:
            result.errors.append(f"{path.name}: {exc}")
            continue
        result.threads = database.threads
        result.spawn_parents = database.spawn_parents
        result.rollout_paths = database.rollout_paths
        result.errors.extend(database.errors)
        break

    index_path = codex_home / "session_index.jsonl"
    updated = {}
    try:
        with index_path.open("rb") as stream:
            for line in stream:
                try:
                    entry = json.loads(line.decode("utf-8"))
                except (ValueError, UnicodeError, RecursionError):
                    continue
                if not isinstance(entry, dict):
                    continue
                identifier, title = entry.get("id"), entry.get("thread_name")
                instant = _index_updated_key(entry.get("updated_at"))
                if not _metadata_text(identifier) or not _metadata_text(title) or instant is None:
                    continue
                if identifier not in updated or instant >= updated[identifier]:
                    result.index_titles[identifier] = title
                    updated[identifier] = instant
    except FileNotFoundError:
        pass
    except OSError as exc:
        result.errors.append(f"session_index.jsonl: {exc}")

    global_path = codex_home / ".codex-global-state.json"
    try:
        state = json.loads(global_path.read_text(encoding="utf-8"))
        thread_titles = state.get("thread-titles") if isinstance(state, dict) else None
        titles = thread_titles.get("titles") if isinstance(thread_titles, dict) else None
        if isinstance(titles, dict):
            result.desktop_titles = {identifier: title for identifier, title in titles.items()
                                    if _metadata_text(identifier) and _metadata_text(title)}
    except (FileNotFoundError, ValueError, UnicodeError, RecursionError):
        pass
    except OSError as exc:
        result.errors.append(f".codex-global-state.json: {exc}")
    return result


def select_title(meta: dict | None, info: dict, first_request: str | None, *,
                 cwd: str | None, session_id: str | None, path: Path) -> tuple[str, str]:
    """Select full text for your sessions; assembly supplies index/desktop titles.

    info contains database fields plus per-session index_title/desktop_title.
    Subagents and orphans use subagent_title instead of this priority chain.
    """
    candidates = (
        (info.get("name"), "database_name"),
        (info.get("index_title"), "session_index"),
        (info.get("desktop_title"), "desktop_title"),
        ((meta or {}).get("rollout_title"), "rollout_title"),
        (info.get("title"), "database_title"),
        (first_request, "first_user_message"),
        (info.get("first_user_message"), "database_first_user_message"),
    )
    for title, source in candidates:
        if _metadata_text(title):
            return title, source
    if _metadata_text(cwd) and _metadata_text(Path(cwd).name):
        return Path(cwd).name, "folder"
    if _metadata_text(session_id):
        return session_id, "session_id"
    return path.stem, "filename"


def display_title(title_full: str) -> str:
    """Format the first line, cutting at the last word boundary within 80 chars."""
    lines = title_full.splitlines()
    first_line = lines[0] if lines else ""
    if len(first_line) <= 80:
        return first_line
    boundary = next((index for index in range(80, -1, -1)
                     if first_line[index].isspace() and first_line[:index].strip()), 80)
    return first_line[:boundary].rstrip() + "…"


def humanize_agent_path(path: str | None) -> str:
    if not _metadata_text(path):
        return "subagent"
    label = path.rsplit("/", 1)[-1].replace("_", " ").replace("-", " ")
    return label if _metadata_text(label) else "subagent"


def subagent_title(meta: dict | None) -> tuple[str, str]:
    meta = meta or {}
    label = humanize_agent_path(meta.get("agent_path"))
    nickname = meta.get("agent_nickname")
    return (f"{label} · {nickname}" if _metadata_text(nickname) else label), "agent_path"


