def _reject_json_constant(value):
    raise ValueError(f'Non-JSON constant: {value}')


def _codex_decimal_int(text: str) -> int:
    """Foundation Decimal parse, then NSNumber.intValue's fixed-width cast.

    Decimal retains a UInt128 mantissa and signed eight-bit exponent. Excess
    least-significant digits are discarded, raising the exponent; validate
    its range before compaction (including zero). This models representation
    loss before the later signed Int64 mantissa conversion and decimal scaling.
    """
    sign, digits, exponent = Decimal(text).as_tuple()
    coefficient = discarded = 0
    for digit in digits:
        candidate = coefficient * 10 + digit
        if discarded or candidate > 2**128 - 1:
            discarded += 1
        else:
            coefficient = candidate
    exponent += discarded
    if not -128 <= exponent <= 127:
        raise ValueError('Foundation Decimal exponent out of range')
    while coefficient and coefficient % 10 == 0 and exponent < 127:
        coefficient //= 10
        exponent += 1
    coefficient = (coefficient + 2**63) % 2**64 - 2**63
    if exponent >= 0:
        coefficient = coefficient * pow(10, exponent, 2**64) % 2**64
    elif exponent < -20:
        coefficient = 0
    else:
        quotient = abs(coefficient) // 10**(-exponent)
        coefficient = -quotient if coefficient < 0 else quotient
    if sign:
        coefficient = -coefficient
    return (coefficient + 2**63) % 2**64 - 2**63


class _CodexJSONInteger(int):
