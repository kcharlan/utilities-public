# ===== 19. CLI =====
def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="colophon",
        description="Explore local Codex session logs in a self-contained offline page.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Environment variables:
  COLOPHON_HOME         Runtime home (default: ~/.colophon).
  COLOPHON_PRICING_URL  Price catalog URL (default: https://models.dev/api.json).

Runtime files (directories 0700, written files 0600):
  colophon.html          Generated offline page.
  cache/                 Per-log parse cache.
  pricing-cache.json     Cached OpenAI price catalog.
  price-history.json     Editable price history, initially empty.
  priority-turns.json    Sticky memory of detected priority turns.
  workspaces.json        Optional workspace aliases.
  workspaces.example.json  Synthetic template, never read as configuration.
  perf-baseline.json     Written only by local performance acceptance.
  parity/                Written only by local parity acceptance.
""",
    )
    parser.add_argument("--no-open", action="store_true", help="Do not open a browser.")
    parser.add_argument("--rebuild", action="store_true", help="Reparse every log into a fresh cache.")
    parser.add_argument("--offline", action="store_true", help="Use cached prices without a network request.")
    parser.add_argument("--refresh-prices", action="store_true", help="Force an unconditional price-catalog download.")
    parser.add_argument("--output", type=Path, metavar="PATH", help="Page path instead of the runtime-home default.")
    parser.add_argument("--codex-home", type=Path, metavar="PATH", default=Path("~/.codex"),
                        help="Read Codex data from PATH (default: ~/.codex).")
    parser.add_argument("--version", action="version", version=f"colophon {__version__}")
    return parser


def _recording_models(corpus: Corpus, priority: PriorityTurns,
                      index: ModelsDevIndex | None) -> dict[str, str]:
    models = {}
    records = [record for session in corpus.sessions.values() for record in session.records]
    records.extend(corpus.skipped_records)
    for record in records:
        for observation in record["token_stream"]["observations"]:
            tag = observation[0]
            raw = None
            if tag in ("C", "XC"):
                evidence = observation[5] if tag == "C" else observation[3]
                raw = evidence.get("set") if isinstance(evidence, dict) else None
            elif tag in ("T", "B"):
                raw = observation[5] if tag == "T" else observation[4]
            if isinstance(raw, str) and (normalized := normalize_codex_model(raw)) != "unknown":
                models[normalized] = normalized
    for metadata in priority.turns.values():
        raw = metadata.get("model")
        if isinstance(raw, str) and codex_api_fast_multiplier(raw) is not None:
            normalized = normalize_codex_model(raw)
            models[normalized] = normalized
            key = _override_key(raw, normalized, index)
            if key is not None:
                models[key] = raw
    return models


def _diagnostic_counts(diagnostics: dict) -> list[str]:
    counts = []
    for key, value in diagnostics.items():
        if key == "page_size_bytes":
            continue
        if key in ("malformed_lines", "truncated_lines", "recovered_lines"):
            count = value["total"]
        elif key == "unknown_record_types":
            count = sum(value.values())
        elif isinstance(value, list):
            count = len(value)
        else:
            count = int(value)
        if count:
            counts.append(f"{key}={count}")
    return counts


def run(args: argparse.Namespace, *, now_ms: int | None = None,
        stderr_tty: bool | None = None) -> int:
    if args.offline and args.refresh_prices:
        print("colophon: --offline and --refresh-prices cannot be combined", file=sys.stderr)
        return 2
    codex_home = args.codex_home.expanduser()
    if not codex_home.is_dir() or not os.access(codex_home, os.R_OK | os.X_OK):
        print(f"colophon: Codex home is missing or unreadable: {codex_home}", file=sys.stderr)
        return 1
    snapshot_ms = globals()["now_ms"]() if now_ms is None else now_ms
    tty = sys.stderr.isatty() if stderr_tty is None else stderr_tty
    cache = None
    progress_active = False
    page_write_failure = False
    try:
        home = ensure_runtime_home(runtime_home())
        ledger_path = home / "price-history.json"
        if not ledger_path.exists():
            atomic_write_json(ledger_path, {"schema": 1, "entries": []})
        example_path = home / "workspaces.example.json"
        if not example_path.exists():
            atomic_write_json(example_path, {"schema": 1, "aliases": [{
                "name": "Example Tools", "origins": ["https://example.invalid/synthetic/tools.git"],
                "paths": ["/synthetic/deployed/tools"]}]})
        if not (home / "priority-turns.json").exists():
            atomic_write_json(home / "priority-turns.json", {"schema": 1, "turns": {}})
        ledger_mtime = ledger_path.stat().st_mtime_ns
        url = os.environ.get("COLOPHON_PRICING_URL", DEFAULT_PRICING_URL)
        catalog_results = []
        def fetch():
            try:
                catalog_results.append(fetch_catalog(url, home / "pricing-cache.json",
                    offline=args.offline, refresh=args.refresh_prices, now_ms=snapshot_ms))
            except Exception as exc:
                catalog_results.append(CatalogResult("unavailable", None, None, snapshot_ms,
                    [f"catalog fetch failed: {type(exc).__name__}: {exc}"]))
        fetch_thread = threading.Thread(target=fetch, daemon=True)
        fetch_thread.start()
        cache = ParseCache.open(home, rebuild=args.rebuild)
        scan_start = time.monotonic()
        def progress(done, total):
            nonlocal progress_active
            if tty:
                elapsed = time.monotonic() - scan_start
                eta = elapsed * (total - done) / done if done else 0
                print(f"\rcolophon: parsing {done}/{total} bytes · ETA {eta:.1f}s", end="", file=sys.stderr, flush=True)
                progress_active = True
        scan = scan_logs(codex_home, cache, progress=progress)
        if progress_active:
            print(file=sys.stderr)
            progress_active = False
        metadata = load_codex_metadata(codex_home)
        corpus = build_corpus(scan.records, metadata, snapshot_ms)
        link_subagents(corpus, metadata, snapshot_ms)
        aliases, alias_messages = load_workspace_aliases(home / "workspaces.json")
        workspaces = resolve_workspaces(corpus, aliases)
        fetch_thread.join(CONNECT_TIMEOUT_S + BODY_TIMEOUT_S + 5)
        if fetch_thread.is_alive():
            catalog = fetch_catalog(url, home / "pricing-cache.json", offline=True,
                                    refresh=False, now_ms=snapshot_ms)
            catalog.status = "cached" if catalog.catalog is not None else "unavailable"
            catalog.messages.append("catalog fetch did not finish; using cached catalog")
        else:
            catalog = catalog_results[0]
        index = ModelsDevIndex.from_catalog(catalog.catalog) if catalog.catalog is not None else None
        priority = load_priority_turns(codex_home, home)
        try:
            doc = json.loads(ledger_path.read_bytes(), parse_constant=_reject_json_constant)
            check = validate_ledger(doc, curated=False)
        except (OSError, ValueError, UnicodeError, RecursionError) as exc:
            check = LedgerCheck([], [str(exc)], [])
        ledger_messages = [{"level": "error", "message": f"{ledger_path}: {message}"} for message in check.errors]
        ledger_messages.extend({"level": "warning", "message": f"{ledger_path}: {message}"} for message in check.warnings)
        history = PriceHistory(CURATED_PRICE_HISTORY["entries"], check.entries)
        if not check.errors and index is not None and catalog.fetched_at_ms is not None:
            new = record_catalog_rates(history, index, catalog.fetched_at_ms,
                                       _recording_models(corpus, priority, index), snapshot_ms)
            appended, warning = append_user_ledger(ledger_path, new, ledger_mtime)
            if warning is not None:
                ledger_messages.append({"level": "warning", "message": f"{ledger_path}: {warning}"})
            if appended:
                history = PriceHistory(CURATED_PRICE_HISTORY["entries"], check.entries + new)
        compose_usage(corpus, priority)
        pricing = price_units(corpus, history, index, costs_available=not check.errors)
        payload = build_payload(corpus, workspaces, pricing, {
            "generated_at_ms": snapshot_ms, "codex_home": codex_home,
            "logs": scan.parsed + scan.cached + len(scan.unreadable),
            "parsed": scan.parsed, "cached": scan.cached,
            "unreadable": [{"path": path, "reason": "unreadable"} for path, error in scan.unreadable],
            "catalog": catalog, "pricing_url": url, "metadata_errors": metadata.errors,
            "costs_available": not check.errors, "costs_reason": "; ".join(check.errors) if check.errors else None,
            "ledger": ledger_messages, "workspaces_file": alias_messages})
        measured = []
        for _ in range(3):
            page = render_page(payload)
            size = len(page)
            measured.append(size)
            diagnostic = payload["diagnostics"]
            over = size > PAGE_SIZE_WARN_BYTES
            if diagnostic["page_size_bytes"] == size and diagnostic["page_size_over_limit"] == over:
                break
            diagnostic.update(page_size_bytes=size, page_size_over_limit=over)
        else:
            diagnostic.update(page_size_bytes=max(measured), page_size_over_limit=max(measured) > PAGE_SIZE_WARN_BYTES)
            page = render_page(payload)
        output = args.output.expanduser() if args.output is not None else home / "colophon.html"
        try:
            write_page(output, page)
        except OSError as exc:
            page_write_failure = True
            raise OSError(f"cannot write {output}: {exc}") from exc
        cache.commit(cache._live_paths)
        if not args.no_open:
            try:
                opened = webbrowser.open(output.resolve().as_uri())
            except Exception:
                opened = False
            if not opened:
                print(f"colophon: open {output} in a browser", file=sys.stderr)
        all_units = [unit for session in corpus.sessions.values() for unit in session.units]
        tokens = sum(unit.input + unit.output for unit in all_units)
        cost = (f"${sum(unit.cost_usd for unit in all_units):.2f}"
                if not check.errors and all(unit.cost_usd is not None for unit in all_units) else "costs unavailable")
        counts = payload["meta"]["counts"]
        print(f"colophon: {counts['sessions']} sessions · {counts['subagents']} subagents · "
              f"{counts['logs']} logs ({scan.parsed} parsed, {scan.cached} cached) · "
              f"{tokens:,} tokens · {cost} est. · page {len(page)/(1024*1024):.2f} MB → {output}")
        diagnostic_counts = _diagnostic_counts(payload["diagnostics"])
        if diagnostic_counts:
            print("colophon: diagnostics: " + ", ".join(diagnostic_counts) + "; see the page footer", file=sys.stderr)
        for item in payload["diagnostics"]["untimed_usage"]:
            print(f"colophon: {item['model']}: priced at current rates: usage has no timestamp ({item['tokens']} tokens)", file=sys.stderr)
        for message in ledger_messages:
            print(f"colophon: {message['message']}", file=sys.stderr)
        for message in alias_messages:
            print(f"colophon: {message}", file=sys.stderr)
        return 0
    except (KeyboardInterrupt, Exception) as failure:
        if cache is not None:
            cache._abort_after_failure(failure)
        if progress_active:
            print(file=sys.stderr)
        rebuild = ("; rebuild cache installed" if cache is not None and cache._committed else
                   "; rebuild did not complete; previous cache kept") if args.rebuild else ""
        if isinstance(failure, KeyboardInterrupt):
            print(f"colophon: interrupted{rebuild}", file=sys.stderr)
        else:
            message = str(failure).replace("\r", " ").replace("\n", " ")
            prefix = "" if page_write_failure else f"{type(failure).__name__}: "
            print(f"colophon: {prefix}{message}", file=sys.stderr)
            if rebuild:
                print(f"colophon: {rebuild[2:]}", file=sys.stderr)
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    if args.offline and args.refresh_prices:
        parser.error("--offline and --refresh-prices cannot be combined")
    try:
        return run(args)
    except OSError as exc:
        print(f"colophon: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
