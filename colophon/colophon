def _pricing_unicode_class(ranges: str) -> str:
    pieces = []
    for item in ranges.split():
        bounds = item.split("-")
        pieces.append("-".join(re.escape(chr(int(bound, 16))) for bound in bounds))
    return "[" + "".join(pieces) + "]"


_PRICING_NUMERIC_CLASS = _pricing_unicode_class(_PRICING_NUMERIC_RANGES)
_PRICING_EXTEND_CLASS = _pricing_unicode_class(_PRICING_EXTEND_RANGES)
_PRICING_PREPEND_CLASS = _pricing_unicode_class(_PRICING_PREPEND_RANGES)


@lru_cache(maxsize=4)
def _pricing_grapheme_pattern(pattern: str) -> re.Pattern:
    # A digit consumes its full grapheme. Literal -, v and : must be whole
    # graphemes themselves; a preceding Prepend would attach to the first one.
    digit = "(?:" + _PRICING_NUMERIC_CLASS + _PRICING_EXTEND_CLASS + "*)"
    translated = ""
    index = 0
    while index < len(pattern):
        if pattern[index:index + 2] == r"\d":
            translated += digit
            index += 2
            continue
        character = pattern[index]
        if character in "-v:":
            translated += re.escape(character) + "(?!" + _PRICING_EXTEND_CLASS + ")"
        elif character == "$":
            translated += r"\Z"
        else:
            translated += character
        index += 1
    return re.compile("(?<!" + _PRICING_PREPEND_CLASS + ")" + translated)


def _pricing_regex_range(pattern: str, value: str) -> re.Match | None:
    """ModelsDevModelIDNormalizer.range: ASCII ICU path, else Character path."""
    if value.isascii():
        return re.search(pattern, value)
    return _pricing_grapheme_pattern(pattern).search(value)


@lru_cache(maxsize=8)
def _pricing_literal_pattern(literal: str) -> re.Pattern:
    return re.compile("(?<!" + _PRICING_PREPEND_CLASS + ")" + re.escape(literal)
                      + "(?!" + _PRICING_EXTEND_CLASS + ")")


def _pricing_literal_index(value: str, literal: str, *, last: bool = False) -> int | None:
    """Swift Character search: a scalar inside a larger grapheme is no delimiter."""
    matches = _pricing_literal_pattern(literal).finditer(value)
    match = None
    for found in matches:
        match = found
        if not last:
            break
    return match.start() if match is not None else None


def _pricing_has_prefix(value: str, prefix: str) -> bool:
    return _pricing_literal_pattern(prefix).match(value) is not None


def _pricing_has_suffix(value: str, suffix: str) -> bool:
    match = _pricing_literal_pattern(suffix).search(value, max(0, len(value) - len(suffix)))
    return match is not None and match.end() == len(value)


def normalize_codex_model(raw: str) -> str:
    """Port normalizeCodexModel (CostUsagePricing.swift 482–518)."""
    trimmed = _codex_trim(raw)
    if _pricing_has_prefix(trimmed, "openai/"):
        trimmed = trimmed[len("openai/"):]
    if trimmed == "gpt-5.6":
        return "gpt-5.6-sol"
    if trimmed == "gpt-reserve":
        return "gpt-5.6-luna"
    if trimmed == "gpt-daybreak-blue-latest":
        return "gpt-5.6-sol"
    if trimmed == "gpt-daybreak-red-latest":
        return "gpt-5.6-cyber"
    if trimmed in CURATED_BUNDLED:
        return trimmed
    dated = _pricing_regex_range(r"-\d{4}-\d{2}-\d{2}$", trimmed)
    if dated:
        base = trimmed[:dated.start()]
        if base in CURATED_BUNDLED:
            return base
    return trimmed


def codex_models_dev_pricing_targets(raw: str) -> list[tuple[str, str]]:
    """Codex targets plus TargetResolver, restricted to OpenAI per A4."""
    trimmed = _codex_trim(raw)
    if not trimmed:
        return []
    slash = _pricing_literal_index(trimmed, "/")
    if slash is not None:
        route, model = trimmed[:slash], trimmed[slash + 1:]
        route = route.lower()
        if route != "openai" or not model:
            return []
        # TargetResolver trims the route-qualified id, removes its matching
        # route and validates the remainder before emitting a target.
        targets = [] if _pricing_has_prefix(model, "/") or _pricing_has_suffix(model, "/") else [("openai", model)]
        normalized = normalize_codex_model(model)
        if normalized != model:
            targets.append(("openai", normalized))
        return targets
    normalized = normalize_codex_model(trimmed)
    targets = [("openai", trimmed)]
    if normalized != trimmed:
        targets.append(("openai", normalized))
    return targets


def _models_dev_candidates(raw: str) -> list[str]:
    """ModelsDevModelIDNormalizer.candidates (ModelsDevPricing.swift 343–395)."""
    candidates = []
    identities = set()

    def append(value):
        normalized = _codex_trim(value)
        identity = unicodedata.normalize("NFC", normalized)
        if normalized and identity not in identities:
            candidates.append(normalized)
            identities.add(identity)

    trimmed = _codex_trim(raw)
    append(trimmed)
    if _pricing_has_prefix(trimmed, "openai/"):
        append(trimmed[len("openai/"):])
    if _pricing_has_prefix(trimmed, "anthropic."):
        append(trimmed[len("anthropic."):])
    dot = _pricing_literal_index(trimmed, ".", last=True)
    if dot is not None and _pricing_literal_index(trimmed, "claude-") is not None:
        tail = trimmed[dot + 1:]
        if _pricing_has_prefix(tail, "claude-"):
            append(tail)
    index = 0
    while index < len(candidates):
        candidate = candidates[index]
        at_sign = _pricing_literal_index(candidate, "@")
        if at_sign is not None:
            base, suffix = candidate[:at_sign], candidate[at_sign + 1:]
            if _pricing_regex_range(r"^\d{8}$", suffix):
                append(base + "-" + suffix)
            append(base)
        elif _pricing_has_prefix(candidate, "claude-"):
            append(candidate + "@default")
        for pattern in (r"-\d{4}-\d{2}-\d{2}$", r"-\d{8}$"):
            dated = _pricing_regex_range(pattern, candidate)
            if dated:
                append(candidate[:dated.start()])
        version = _pricing_regex_range(r"-v\d+:\d+$", candidate)
        if version:
            append(candidate[:version.start()] + candidate[version.end():])
        index += 1
    return candidates


def _models_dev_context_is_int(value) -> bool:
    """JSONDecoder Int acceptance for an already decoded dict number's spelling."""
    if type(value) is int:
        return -(2**63) <= value < 2**63
    if type(value) is not float or not math.isfinite(value):
        return False
    # Check the JSON-compatible decimal spelling, not rounded binary magnitude
    # alone. At Int boundaries repr(float) can lie outside the checked range.
    # Raw catalog lexemes must be validated before float decoding by the fetcher.
    number = Decimal(repr(value))
    return number == number.to_integral_value() and -(2**63) <= number < 2**63


def _models_dev_decode_model(value) -> dict | None:
    """Decode the source model's known fields; invalid optional fields reject it."""
    if not isinstance(value, dict) or not isinstance(value.get("id"), str):
        return None
    if value.get("name") is not None and not isinstance(value["name"], str):
        return None
    limit = value.get("limit")
    if limit is not None:
        if not isinstance(limit, dict):
            return None
        context = limit.get("context")
        if context is not None and not _models_dev_context_is_int(context):
            return None
    cost = value.get("cost")
    if cost is None:
        return None
    if not isinstance(cost, dict):
        return None
    block = cost.get("context_over_200k")
    if block is not None and not isinstance(block, dict):
        return None
    decoded = []
    for rates in (cost, block):
        if rates is None:
            decoded.append(None)
            continue
        parsed = {}
        for source, target in (("input", "input"), ("output", "output"),
                               ("cache_read", "cached_input"), ("cache_write", "cache_write")):
            number = rates.get(source)
            if number is None:
                parsed[target] = None
                continue
            if type(number) not in (int, float):
                return None
            try:
                number = float(number)
            except OverflowError:
                return None
            if not math.isfinite(number):
                return None
            parsed[target] = number
        decoded.append(parsed)
    if decoded[0]["input"] is None or decoded[0]["output"] is None:
        return None
    return {"model_id": value["id"], "per_million": decoded[0],
            "long_context": ({"threshold": 200000} | decoded[1]) if decoded[1] is not None else None}


def _models_dev_provider_decodable(value) -> bool:
    """Provider.init's typed container contract; invalid children are skipped."""
    return (isinstance(value, dict) and isinstance(value.get("models"), dict)
            and (value.get("id") is None or isinstance(value["id"], str))
            and (value.get("name") is None or isinstance(value["name"], str)))


class ModelsDevIndex:
    """Snapshot of priceable OpenAI models, preserving Swift string identities.

    pricing returns raw (unfilled) per-million rates, long_context or None,
    model_id, provider_id and normalized_model_id. The last field is the lookup
    identity used by priority override ledgers; normalized matches retain the
    catalog's spelling, while direct-key matches retain the query candidate.
    """

    def __init__(self, models: dict):
        self._models = models
        self._normalized_models = {}
        for value in models.values():
            spelling = _codex_trim(value["model_id"])
            identity = unicodedata.normalize("NFC", spelling)
            self._normalized_models.setdefault(identity, (spelling, value))

    @classmethod
    def from_catalog(cls, catalog: dict) -> ModelsDevIndex:
        wrapper = catalog.get("providers")
        # Catalog.init tries the entire typed wrapper dictionary atomically.
        # Any invalid provider falls back to decoding individual top-level keys.
        providers = wrapper if isinstance(wrapper, dict) and all(
            isinstance(key, str) and _models_dev_provider_decodable(value)
            for key, value in wrapper.items()) else catalog
        models = {}
        for map_key, provider in providers.items():
            if not isinstance(map_key, str) or not _models_dev_provider_decodable(provider):
                continue
            provider_id = provider.get("id")
            if _codex_trim(provider_id if provider_id is not None else map_key).lower() != "openai":
                continue
            raw_models = provider["models"]
            models = {}
            for key, value in raw_models.items():
                decoded = _models_dev_decode_model(value)
                if isinstance(key, str) and decoded is not None:
                    models[unicodedata.normalize("NFC", key)] = decoded
        return cls(models)

    def pricing(self, provider_id: str, model_id: str) -> dict | None:
        if _codex_trim(provider_id).lower() != "openai":
            return None
        for candidate in _models_dev_candidates(model_id):
            identity = unicodedata.normalize("NFC", candidate)
            model = self._models.get(identity)
            spelling = candidate
            if model is None:
                normalized = self._normalized_models.get(identity)
                if normalized is None:
                    continue
                spelling, model = normalized
            return {"provider_id": "openai", "model_id": model["model_id"],
                    "normalized_model_id": spelling, "per_million": dict(model["per_million"]),
                    "long_context": dict(model["long_context"]) if model["long_context"] is not None else None}
        return None


def resolve_rates(model_key: str, index: ModelsDevIndex | None) -> dict | None:
    """resolvedCodexPricing (562–620), no historical branch; fill as 704–726."""
    key = normalize_codex_model(model_key)
    if key == "unknown":
        return None
    # Approved OpenAI-only adaptation: no unrelated provider-qualified key is priced.
    targets = codex_models_dev_pricing_targets(model_key)
    if "/" in _codex_trim(model_key) and not targets:
        return None
    bundled = CURATED_BUNDLED.get(key)
    field_map = {"inputCostPerToken": "input", "outputCostPerToken": "output",
                 "cacheReadInputCostPerToken": "cached_input", "cacheWriteInputCostPerToken": "cache_write"}
    raw_standard = {rate: None for rate in field_map.values()}
    raw_long = dict(raw_standard)
    threshold = None
    if bundled is not None:
        # Decimal conversion scales the shortest literal representation exactly,
        # rather than multiplying binary floats and introducing extra rounding.
        for source, rate in field_map.items():
            for suffix, destination in (("", raw_standard), ("AboveThreshold", raw_long)):
                number = bundled.get(source + suffix)
                if number is not None:
                    destination[rate] = float(Decimal(repr(number)).scaleb(6))
        threshold = bundled.get("thresholdTokens")
    lookup = None
    if index is not None:
        for provider, model in targets:
            lookup = index.pricing(provider, model)
            if lookup is not None:
                break
    if lookup is None and bundled is None:
        return None
    if lookup is not None:
        catalog_standard = lookup["per_million"]
        catalog_long = lookup["long_context"]
        # Missing context block means no long-context opinion; a present empty
        # block is an opinion, so do not borrow individual bundled long fields.
        if catalog_long is not None:
            raw_long = {rate: catalog_long[rate] for rate in field_map.values()}
            if threshold is None:
                threshold = catalog_long["threshold"]
            for cache in ("cached_input", "cache_write"):
                if raw_long[cache] is None:
                    raw_long[cache] = next(number for number in (
                        catalog_standard[cache], catalog_long["input"], catalog_standard["input"])
                        if number is not None)
        raw_standard["input"] = catalog_standard["input"]
        raw_standard["output"] = catalog_standard["output"]
        for cache in ("cached_input", "cache_write"):
            if catalog_standard[cache] is not None:
                raw_standard[cache] = catalog_standard[cache]
    long_context = None
    if threshold is not None:
        long_input = raw_long["input"] if raw_long["input"] is not None else raw_standard["input"]
        long_output = raw_long["output"] if raw_long["output"] is not None else raw_standard["output"]
        long_context = {"threshold": threshold, "input": long_input, "output": long_output}
        for cache in ("cached_input", "cache_write"):
            long_context[cache] = next(number for number in (raw_long[cache], raw_standard[cache], long_input)
                                       if number is not None)
    standard = dict(raw_standard)
    for cache in ("cached_input", "cache_write"):
        if standard[cache] is None:
            standard[cache] = standard["input"]
    return {"per_million": standard, "long_context": long_context}


def cost_usd(entry: dict, *, input: int, cached: int, output: int) -> float:
    """codexCostUSD (694–731); Codex cache-write argument is fixed at zero."""
    total_input = max(0, input)
    cached = min(max(0, cached), total_input)
    remaining_after_cache = total_input - cached
    cache_write = 0
    non_cached = remaining_after_cache - cache_write
    long_context = entry.get("long_context")
    rates = long_context if long_context is not None and total_input > long_context["threshold"] else entry["per_million"]
    input_rate = rates["input"] / 1_000_000
    cached_input_rate = rates["cached_input"] / 1_000_000
    cache_write_rate = rates["cache_write"] / 1_000_000
    output_rate = rates["output"] / 1_000_000
    return (float(non_cached) * input_rate + float(cached) * cached_input_rate
            + float(cache_write) * cache_write_rate + float(max(0, output)) * output_rate)


def priority_cost_usd(rates_entry: dict, priority: dict | None, *, input: int,
                      cached: int, output: int) -> float | None:
    """codexPriorityCostUSD; multiplier/cap are supplied by dated history (A4)."""
    if priority is None:
        return None
    cap = priority["max_input_tokens"]
    if cap is not None and input > cap:
        return None
    return cost_usd(rates_entry, input=input, cached=cached, output=output) * priority["multiplier"]


def codex_api_fast_multiplier(model: str) -> float | None:
    """Direct switch port from CostUsagePricing.swift 682–688."""
    key = normalize_codex_model(model)
    if key in {"gpt-5.4", "gpt-5.4-mini", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-6-astra"}:
        return 2.0
    if key == "gpt-5.5":
        return 2.5
    return None


