# CodexBar 3bbf6bc48: CacheHelpers.swift497–555, joined String equality.
def _codex_cross_file_row_key(session_id: str | None, file_identity: str, row: UsageRow) -> str:
    text = '\x1f'.join((f'session:{session_id}' if session_id is not None else f'file:{file_identity}',
        row.turn_id or '', str(row.event_index) if row.event_index is not None else '',
        row.day_key, row.model, str(row.input), str(row.cached), str(row.output),
        str(row.timestamp_unix_ms) if row.timestamp_unix_ms is not None else ''))
    return _codex_session_identity(text)


def _primary_model_timeline(record: dict, result: CodexUsageResult) -> list[tuple[float, str | None]]:
    if result.model_timeline or not record['token_stream']['unconsumed_tail']:
        return result.model_timeline
    # Only unreplayed pending tails borrow C/XC evidence; never invent a suffix.
    return [(observation[1], model.get('set'))
            for observation in record['token_stream']['observations']
            if observation[0] in ('C', 'XC')
            and (model := observation[5] if observation[0] == 'C' else observation[3]) is not None]


def compose_usage(corpus: Corpus, priority: PriorityTurns) -> None:
    """Account every file before selection and display attribution (A4, D8)."""
    records = [record for session in corpus.sessions.values() for record in session.records]
    records.extend(corpus.skipped_records)
    results = account_logs(records)
    corpus.file_diagnostics['trace_db'] = list(priority.messages)
    corpus.file_diagnostics['fork_baseline_unavailable'] = []
    duplicates = {}
    for record in records:
        observations = record['token_stream']['observations']
        identifier = observations[0][1].get('session_id') if observations and observations[0][0] == 'P' else None
        if identifier is not None:
            key = _codex_session_identity(identifier)
            entry = duplicates.setdefault(key, {'id': identifier, 'paths': [], 'display': {}})
            entry['paths'].append(record['key']['path'])
            display_id = _history_identifier((record['meta'] or {}).get('id'))
            if display_id is not None and _codex_session_identity(display_id) != key:
                entry['display'].setdefault(display_id, []).append(record['key']['path'])
    diagnostics = {}
    for entry in duplicates.values():
        if len(entry['paths']) <= 1:
            continue
        diagnostics.setdefault(entry['id'], set()).update(entry['paths'])
        for identifier, paths in entry['display'].items():
            diagnostics.setdefault(identifier, set()).update(paths)
    corpus.file_diagnostics['duplicate_session_ids'] = [
        {'id': identifier, 'paths': sorted(paths)} for identifier, paths in sorted(diagnostics.items())]
    priority_index = {_codex_session_identity(key): entry for key, entry in priority.turns.items()}
    for session in corpus.sessions.values():
        session.units = []
        session.flags.discard('fork_baseline_unavailable')
        displayed = {_codex_session_identity(turn.id): turn.id for turn in session.turns}
        responses, primary_turns, seen_rows = set(), set(), set()

        def append_unit(file_index, line, turn_id, at_ms, timestamp_unix_ms, model_raw,
                        input, cached, cache_write, output, reasoning, source):
            turn_key = _codex_session_identity(turn_id) if isinstance(turn_id, str) else None
            inherited = any(start <= line < end for start, end in
                session.records[file_index]['history']['inherited_lines'])
            display_turn = displayed.get(turn_key) if not inherited else None
            tier_metadata = priority_index.get(turn_key)
            session.units.append(UsageUnit(session.id, file_index, line, turn_id, display_turn,
                at_ms, timestamp_unix_ms, model_raw, normalize_codex_model(model_raw), tier_metadata,
                'priority' if tier_metadata is not None else 'standard',
                input, cached, cache_write, output, reasoning, source))

        # SessionModel.records already uses source ms-mtime/size/path order.
        for file_index, record in enumerate(session.records):
            result = results[record['key']['path']]
            # UsageRow is frozen; rebuild local results without changing cached facts.
            result.rows = [UsageRow(file_index, row.line, row.event_index, row.turn_id, row.ts,
                row.at_ms, row.timestamp_unix_ms, row.day_key, row.model_raw, row.model,
                row.input, row.cached, row.output, row.reasoning, row.kind) for row in result.rows]
            if result.has_unresolved_fork_baseline:
                session.flags.add('fork_baseline_unavailable')
            timeline = _primary_model_timeline(record, result)
            positions = [position for position, model in timeline]
            for usage in sorted(record['usage_records'], key=lambda usage: usage['line']):
                thread_id = usage['thread_id']
                if not isinstance(thread_id, str) or _codex_session_identity(thread_id) != _codex_session_identity(session.id):
                    continue
                response_id = usage['response_id']
                if isinstance(response_id, str) and response_id:
                    key = (_codex_session_identity(thread_id), _codex_session_identity(response_id))
                    if key in responses:
                        continue
                    responses.add(key)
                turn_id = _identifier(usage['turn_id'])
                primary_turns.add(_codex_session_identity(turn_id) if turn_id is not None else None)
                position = bisect.bisect_left(positions, usage['line']) - 1
                model = (timeline[position][1] if position >= 0 else None) or 'unknown'
                def number(key):
                    return max(0, _codex_number(usage[key]) or 0)
                output = number('output')
                reasoning = _codex_number(usage['reasoning'])
                append_unit(file_index, usage['line'], turn_id, usage['at_ms'], usage['timestamp_unix_ms'],
                    model, number('input'), max(number('cached_input'), number('cache_read_input')),
                    number('cache_write'), output,
                    min(max(0, reasoning), output) if reasoning is not None else None, 'record')
        if 'fork_baseline_unavailable' in session.flags:
            corpus.file_diagnostics['fork_baseline_unavailable'].append(session.id)
        for file_index, record in enumerate(session.records):
            accepted = set()
            result = results[record['key']['path']]
            for row in result.rows:
                if row.turn_id is not None and _codex_session_identity(row.turn_id) in primary_turns:
                    continue
                key = _codex_cross_file_row_key(result.session_id, record['key']['path'], row)
                if key in seen_rows:
                    continue
                accepted.add(key)
                append_unit(row.file, row.line, row.turn_id, row.at_ms, row.timestamp_unix_ms,
                    row.model_raw, row.input, row.cached, 0, row.output, row.reasoning, row.kind)
            # Source uniqueCodexRows never compares rows against their own file.
            seen_rows.update(accepted)


