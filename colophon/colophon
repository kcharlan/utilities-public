# ===== 4. Utilities =====
def now_ms() -> int:
    """Return the wall-clock instant in UTC epoch milliseconds."""
    return time.time_ns() // 1_000_000


def parse_rfc3339_ms(value) -> int | None:
    """Parse an aware RFC 3339 instant, retaining millisecond precision."""
    if not isinstance(value, str) or not re.fullmatch(
        r"\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})",
        value,
    ):
        return None
    if value[-1] not in "Zz" and (
        int(value[-5:-3]) > 23 or int(value[-2:]) > 59
    ):
        return None
    try:
        instant = datetime.fromisoformat(value.upper().replace("Z", "+00:00"))
        delta = instant.astimezone(timezone.utc) - datetime(1970, 1, 1, tzinfo=timezone.utc)
    except (ValueError, OverflowError):
        return None
    return (delta.days * 86_400 + delta.seconds) * 1000 + delta.microseconds // 1000


def format_rfc3339(ms: int) -> str:
    """Format UTC epoch milliseconds at whole-second ledger precision."""
    instant = datetime(1970, 1, 1, tzinfo=timezone.utc) + timedelta(milliseconds=ms)
    return instant.isoformat(timespec="seconds").replace("+00:00", "Z")


def epoch_to_ms(value, *, milliseconds: bool = False) -> int | None:
    """Convert a finite numeric epoch value; seconds are the default unit."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, float) and not math.isfinite(value):
        return None
    numeric = Decimal(repr(value))
    return int(numeric if milliseconds else numeric.scaleb(3))


def abbreviate_home(path: Path | str) -> str:
    """Shorten only paths at or below the current user's home directory."""
    candidate = Path(path)
    try:
        relative = candidate.relative_to(Path.home())
    except ValueError:
        return str(candidate)
    return "~" if relative == Path(".") else f"~/{relative}"


def runtime_home() -> Path:
    """Return the mutable runtime directory, expanding a home override."""
    return Path(os.environ.get("COLOPHON_HOME", "~/.colophon")).expanduser()


def ensure_runtime_home(path: Path) -> Path:
    """Create a private runtime directory and discard abandoned atomic writes."""
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    cutoff = time.time() - 3600
    for candidate in path.glob(".*.tmp"):
        # Never follow a symlink or descend into a temp-shaped directory.
        with contextlib.suppress(OSError):
            info = candidate.lstat()
            if stat.S_ISREG(info.st_mode) and info.st_mtime < cutoff:
                candidate.unlink()
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Write a complete private file before replacing its destination."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    fd_owned = True
    try:
        os.fchmod(fd, mode)
        fh = os.fdopen(fd, "wb")
        fd_owned = False
        with fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        if fd_owned:
            with contextlib.suppress(OSError):
                os.close(fd)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def atomic_write_json(path: Path, obj, *, indent: int | None = 2) -> None:
    """Write readable UTF-8 JSON with a terminating newline."""
    data = (json.dumps(obj, indent=indent, ensure_ascii=True) + "\n").encode("utf-8")
    atomic_write_bytes(path, data)


# ===== 5. Log reading =====
class RawLine(NamedTuple):
    index: int
    data: bytes
    terminated: bool


class DecodedLine(NamedTuple):
    obj: dict | None
    status: Literal["ok", "recovered", "malformed", "blank"]


def iter_log_lines(fh: BinaryIO, size: int) -> Iterator[RawLine]:
    """Stream physical lines within the caller's scan-start byte boundary."""
    remaining = size
    buffer = bytearray()
    index = 0
    while remaining > 0:
        chunk = fh.read(min(1024 * 1024, remaining))
        if not chunk:
            break
        remaining -= len(chunk)
        search_from = len(buffer)
        buffer.extend(chunk)
        start = 0
        while (end := buffer.find(b"\n", search_from)) >= 0:
            yield RawLine(index, bytes(buffer[start:end]), True)
            index += 1
            start = search_from = end + 1
        if start:
            del buffer[:start]
    if buffer:
        yield RawLine(index, bytes(buffer), False)


def _json_object(data: bytes) -> dict | None:
    try:
        obj = json.loads(data)
    except (ValueError, UnicodeError, RecursionError):
        return None
    return obj if isinstance(obj, dict) else None


def decode_line(data: bytes) -> DecodedLine:
    """Decode a terminated line, recovering a valid suffix after crash debris."""
    if not data.strip():
        return DecodedLine(None, "blank")
    obj = _json_object(data)
    if obj is not None:
        return DecodedLine(obj, "ok")
    start = 1
    while True:
        candidates = [pos for marker in (b'{"timestamp"', b'{"type"')
                      if (pos := data.find(marker, start)) >= 0]
        if not candidates:
            return DecodedLine(None, "malformed")
        pos = min(candidates)
        obj = _json_object(data[pos:])
        if obj is not None:
            return DecodedLine(obj, "recovered")
        start = pos + 1


# ===== 6. Per-file parse =====
def _object(value) -> dict:
    return value if isinstance(value, dict) else {}


def _empty_tool_counts() -> ToolCounts:
    return {"shell": 0, "shell_failed": 0, "file_edits": 0, "mcp": {},
            "web": 0, "image": 0, "other": {}}


def _merge_tool_counts(target: ToolCounts, source: ToolCounts) -> None:
    for key, value in source.items():
        if key in ("mcp", "other"):
            for name, count in value.items():
                target[key][name] = target[key].get(name, 0) + count
        else:
            target[key] += value


class ToolTally:
    """Keep both representations until structured precedence is known."""

    def __init__(self):
        self.has_structured = False
        self.structured = _empty_tool_counts()
        self.raw = _empty_tool_counts()

    @staticmethod
    def _group(counts: ToolCounts, category: str, name) -> None:
        if _history_identifier(name) is not None:
            counts[category][name] = counts[category].get(name, 0) + 1

    def add_structured(self, item: dict) -> None:
        item = _object(item)
        kind = item.get("type")
        if not isinstance(kind, str) or kind not in STRUCTURED_TOOL_TYPES:
            return
        self.has_structured = True
        counts = self.structured
        if kind == "CommandExecution":
            counts["shell"] += 1
            exit_code = item.get("exit_code")
            if isinstance(exit_code, int) and not isinstance(exit_code, bool) and exit_code != 0:
                counts["shell_failed"] += 1
        elif kind == "FileChange":
            counts["file_edits"] += len(_object(item.get("changes")))
        elif kind == "McpToolCall":
            self._group(counts, "mcp", item.get("server"))
        elif kind == "WebSearch":
            counts["web"] += 1
        elif kind == "ImageView":
            counts["image"] += 1
        elif item.get("kind") == "web.search":
            counts["web"] += 1
        elif item.get("kind") != "clock.sleep":
            self._group(counts, "other", item.get("kind"))

    def _add_js(self, text: str) -> None:
        for name in JS_TOOL_CALL.findall(text):
            if name in ORCHESTRATION_JS or name.startswith("collaboration__"):
                continue
            if name == "exec_command":
                self.raw["shell"] += 1
            elif name == "apply_patch":
                self.raw["file_edits"] += 1
            elif name.startswith("mcp__"):
                server, _, tool = name[5:].partition("__")
                if server and tool:
                    self._group(self.raw, "mcp", server)
                else:
                    self._group(self.raw, "other", name)
            elif name == "web__run":
                self.raw["web"] += 1
            elif name == "view_image":
                self.raw["image"] += 1
            else:
                self._group(self.raw, "other", name)
        self.raw["web"] += len(JS_WEB_CALL.findall(text))

    def add_raw(self, record: dict) -> None:
        if _object(record).get("type") != "response_item":
            return
        payload = _object(record.get("payload"))
        kind, name, namespace = (payload.get(key) for key in ("type", "name", "namespace"))
        if kind == "local_shell_call":
            self.raw["shell"] += 1
        elif kind == "web_search_call":
            self.raw["web"] += 1
        elif kind == "custom_tool_call":
            if name == "apply_patch":
                self.raw["file_edits"] += 1
            elif name == "exec" and isinstance(payload.get("input"), str):
                self._add_js(payload["input"])
        elif kind == "function_call" and _history_identifier(name) is not None:
            if namespace in ("collaboration", "clock") or name in ORCHESTRATION_FUNCTIONS:
                return
            if namespace is not None and not isinstance(namespace, str):
                return
            if name in ("exec_command", "shell") and not namespace:
                self.raw["shell"] += 1
            elif namespace and namespace.startswith("mcp__"):
                self._group(self.raw, "mcp", namespace[5:])
            elif namespace == "web" and name == "run":
                self.raw["web"] += 1
            elif name == "view_image":
                self.raw["image"] += 1
            else:
                self._group(self.raw, "other", f"{namespace}:{name}" if namespace else name)

    def result(self) -> ToolCounts:
        counts = _empty_tool_counts()
        _merge_tool_counts(counts, self.structured if self.has_structured else self.raw)
        return counts


class ToolCandidate(NamedTuple):
    structured: bool
    counts: ToolCounts


def _tool_candidate(record: dict, payload: dict, kind: str) -> ToolCandidate | None:
    structured = (kind.startswith("event_msg/item_completed/")
                  and kind.removeprefix("event_msg/item_completed/") in STRUCTURED_TOOL_TYPES)
    if not structured and kind not in (
        "response_item/function_call", "response_item/custom_tool_call",
        "response_item/local_shell_call", "response_item/web_search_call",
    ):
        return None
    tally = ToolTally()
    if structured:
        tally.add_structured(_object(payload.get("item")))
    elif kind.startswith("response_item/"):
        tally.add_raw(record)
    counts = tally.result()
    if tally.has_structured or any(counts.values()):
        return ToolCandidate(tally.has_structured, counts)
    return None


class LinkCandidate(NamedTuple):
    kind: str
    values: tuple


def _json_fields(value) -> dict:
    if not isinstance(value, str):
        return {}
    try:
        return _object(json.loads(value))
    except (ValueError, RecursionError):
        return {}


def _link_candidate(payload: dict, kind: str) -> LinkCandidate | None:
    item = _object(payload.get("item"))
    if kind == "event_msg/item_completed/SubAgentActivity":
        return LinkCandidate("activity", tuple(_history_identifier(item.get(key))
                             for key in ("kind", "agent_thread_id", "agent_path")))
    if kind == "event_msg/item_completed/CollabAgentToolCall":
        receivers = item.get("receiver_thread_ids")
        return LinkCandidate("receivers", tuple(value for value in receivers
                             if _history_identifier(value) is not None) if isinstance(receivers, list) else ())
    if kind == "response_item/function_call" and payload.get("namespace") == "collaboration":
        name = payload.get("name")
        if name == "spawn_agent":
            return LinkCandidate("spawn", (_history_identifier(payload.get("call_id")),))
        if name in ("followup_task", "send_message"):
            return LinkCandidate("target", (_history_identifier(
                _json_fields(payload.get("arguments")).get("target")),))
    if kind == "response_item/function_call_output":
        return LinkCandidate("output", (_history_identifier(payload.get("call_id")),
                             _history_identifier(_json_fields(payload.get("output")).get("task_name"))))
    return None


def _usage_timestamp_unix_ms(timestamp) -> int | None:
    # parseNativeRFC3339 keeps only three fraction digits (Timestamp.swift:59–69)
    # before unixMilliseconds rounds date * 1000 (Scanner.swift:4262–4267).
    # The existing strict parser already yields those integral native ms;
    # the broader upstream historical parsing/routing belongs to Task 7.
    return parse_rfc3339_ms(timestamp)


def _usage_record(record: dict, payload: dict, fact: RecordFact) -> dict:
    usage = _object(payload.get("usage"))
    timestamp = record.get("timestamp")
    return {"line": fact.line, "rec": fact.rec,
            **{key: payload.get(key) for key in ("response_id", "thread_id", "turn_id", "root_turn_id")},
            "ts": timestamp, "at_ms": fact.at_ms,
            "timestamp_unix_ms": _usage_timestamp_unix_ms(timestamp),
            **{target: usage.get(source) for target, source in (
                ("input", "input_tokens"), ("cached_input", "cached_input_tokens"),
                ("cache_read_input", "cache_read_input_tokens"), ("cache_write", "cache_write_input_tokens"),
                ("output", "output_tokens"), ("reasoning", "reasoning_output_tokens"))}}


def record_type_key(record: dict) -> str:
    """Classify only the documented record and bare-usage containers."""
    kind = record.get("type")
    if "type" not in record:
        # codexBareUsage containers, CodexBar 3bbf6bc48, Scanner.swift:3914–3923.
        containers = [record, *(_object(record.get(key)) for key in ("data", "result", "response"))]
        if any(isinstance(container.get("usage"), dict) for container in containers):
