    model = _codex_string(response.get('model')) if isinstance(response, dict) else None
    turn_id = _codex_trace_value('turn.id', prefix) or _codex_trace_value('turn_id', prefix)
    return (turn_id, model) if turn_id and model else None


# CodexBar 3bbf6bc48: CodexPriority.swift priority trace/submission (1020–1056).
def _parse_codex_priority_trace(timestamp: str | None, body: str) -> tuple[str, dict] | None:
    prefix, marker, tail = _codex_trace_partition(body, 'websocket request:')
    if marker:
        request = _codex_trace_json(tail)
        if (request is None or request.get('type') != 'response.create'
                or request.get('service_tier') != 'priority'):
            return None
        turn_id = _codex_first(_codex_trace_value('turn.id', prefix),
            _codex_trace_value('turn_id', prefix), _codex_string(request.get('turn_id')))
        model = _codex_string(request.get('model'))
    else:
        prefix, marker, tail = _codex_trace_partition(body, 'Submission sub=Submission {')
        if not marker or _pricing_literal_index(body, 'service_tier: Some(Some("priority"))') is None:
            return None
        turn_id = _codex_trace_quoted_value('id', tail)
        model = None
    if not turn_id:
        return None
    return turn_id, {'thread_id': _codex_trace_value('thread_id', prefix),
                     'model': model, 'timestamp': timestamp}


def _stored_priority_turns(file: Path, messages: list[str]) -> dict[str, dict]:
    if not file.exists():
        return {}
    try:
        value = json.loads(file.read_bytes())
        if not isinstance(value, dict) or type(value.get('schema')) is not int or value['schema'] != 1:
            raise ValueError('unsupported priority memory schema')
        turns = value.get('turns')
        if not isinstance(turns, dict):
            raise ValueError('invalid priority memory turns')
        validated = {}
        for turn_id, entry in turns.items():
            if (not isinstance(turn_id, str) or not turn_id or not isinstance(entry, dict)
                    or type(entry.get('first_seen_ms')) is not int
                    or any(key not in entry or entry[key] is not None and not isinstance(entry[key], str)
                           for key in ('thread_id', 'model', 'timestamp'))):
                messages.append('Invalid priority memory entry ignored')
                continue
            validated[turn_id] = {key: entry[key] for key in
                                 ('thread_id', 'model', 'timestamp', 'first_seen_ms')}
        return validated
    except (OSError, ValueError, UnicodeError) as exc:
        messages.append(f'Priority memory unavailable: {exc}')
        return {}


def load_priority_turns(codex_home: Path, home: Path) -> PriorityTurns:
    """A1 cold scan; sticky memory survives pruning and trace read failures."""
    result = PriorityTurns()
    file = home / 'priority-turns.json'
    stored = _stored_priority_turns(file, result.messages)
    turns, completed, pending = {}, {}, {}
    spellings = {}
    database = codex_home / 'logs_2.sqlite'
    if database.exists():
        try:
            with contextlib.closing(sqlite3.connect(database.absolute().as_uri() + '?mode=ro',
                                                   uri=True, timeout=0.25)) as db:
                db.text_factory = bytes
                # CodexPriority.swift973–1005: non-indexed cold query.
                rows = db.execute('''select rowid, ts, feedback_log_body from logs
                    where rowid > 0 and ts >= 0
                      and (feedback_log_body like '%websocket request:%'
                           or feedback_log_body like '%response.completed%'
                           or feedback_log_body like '%service_tier: Some(Some("priority"))%')
                    order by rowid''')
                for rowid, timestamp, raw_body in rows:
                    body = _codex_sqlite_text(raw_body)
                    if body is None:
                        continue
                    parsed_completed = _parse_codex_completed_trace(body)
                    if parsed_completed is not None:
                        turn_id, model = parsed_completed
                        key = _codex_session_identity(turn_id)
                        if key in turns:
                            completed.setdefault(key, {})[rowid] = model
                        else:
                            if key not in pending and len(pending) >= 4096:
                                del pending[next(iter(pending))]
                            pending.setdefault(key, {})[rowid] = model
                        continue
                    parsed = _parse_codex_priority_trace(_codex_sqlite_text(timestamp), body)
                    if parsed is None:
                        continue
                    turn_id, entry = parsed
                    key = _codex_session_identity(turn_id)
                    spellings.setdefault(key, turn_id)
                    turns[key] = entry
                    if key in pending:
                        completed[key] = pending.pop(key)
            # CodexPriority.swift440–459: highest rowid, irrespective of ts.
            for key, models in completed.items():
                turns[key]['model'] = models[max(models)]
        except sqlite3.Error as exc:
            result.messages.append(f'Priority trace database unavailable: {exc}')
            turns = {}
    result.turns = dict(stored)
    stored_keys = {_codex_session_identity(key): key for key in stored}
    first_seen = now_ms()
    for key, entry in turns.items():
        spelling = stored_keys.get(key, spellings[key])
        first = stored.get(spelling, {}).get('first_seen_ms', first_seen)
        result.turns[spelling] = {**entry, 'first_seen_ms': first}
    if result.turns != stored:
        atomic_write_json(file, {'schema': 1, 'turns': result.turns})
    return result


