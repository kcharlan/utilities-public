@dataclass
class LedgerCheck:
    entries: list[dict]
    errors: list[str]
    warnings: list[str]


def _ledger_instant(value) -> int | None:
    """D15 ledger instants are UTC at whole-second precision."""
    if not isinstance(value, str) or not re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", value
    ):
        return None
    return parse_rfc3339_ms(value)


def _ledger_number(value, *, positive: bool = False) -> bool:
    """A plain finite JSON number, never a boolean or nonfinite float."""
    if type(value) not in (int, float):
        return False
    try:
        return math.isfinite(float(value)) and (value > 0 if positive else value >= 0)
    except OverflowError:
        return False


def _ledger_model(value) -> bool:
    """Check the key contract without changing a valid key's spelling."""
    if not isinstance(value, str) or not value or not _codex_trim(value):
        return False
    if value.startswith("catalog:"):
        matched, separator, normalized = value.removeprefix("catalog:").rpartition("|")
        return (bool(separator and matched and normalized) and _codex_trim(matched) == matched
                and normalize_codex_model(normalized) == normalized)
    return normalize_codex_model(value) == value


def _ledger_json_equal(left, right) -> bool:
    """JSON booleans are distinct from numbers, including inside metadata."""
    if type(left) in (int, float) and type(right) in (int, float):
        return left == right
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return left.keys() == right.keys() and all(
            _ledger_json_equal(value, right[key]) for key, value in left.items())
    if isinstance(left, list):
        return len(left) == len(right) and all(
            _ledger_json_equal(a, b) for a, b in zip(left, right))
    return left == right


def _ledger_nonfinite_paths(value, path=""):
    if isinstance(value, float) and not math.isfinite(value):
        yield path
    elif isinstance(value, dict):
        for key, child in value.items():
            yield from _ledger_nonfinite_paths(child, f"{path}.{key}" if path else key)
    elif isinstance(value, list):
        for number, child in enumerate(value):
            yield from _ledger_nonfinite_paths(child, f"{path}[{number}]")


def validate_ledger(doc, *, curated: bool) -> LedgerCheck:
    """Validate without repairing: one bad entry disables the whole ledger."""
    errors, warnings, entries = [], [], []
    if not isinstance(doc, dict) or type(doc.get("schema")) is not int or doc["schema"] != 1:
        return LedgerCheck([], ["ledger schema must be 1 in a JSON object"], [])
    if not isinstance(doc.get("entries"), list):
        return LedgerCheck([], ["ledger entries must be a list"], [])
    for field_name, value in doc.items():
        if field_name != "entries":
            errors.extend(f"ledger: {path} contains a nonfinite JSON number"
                          for path in _ledger_nonfinite_paths(value, field_name))
    seen = {}
    rate_keys = ("input", "cached_input", "cache_write", "output")
    for number, entry in enumerate(doc["entries"]):
        prefix = f"entry {number}: "
        start_errors = len(errors)
        if not isinstance(entry, dict):
            errors.append(prefix + "must be an object")
            continue
        errors.extend(prefix + f"{path} contains a nonfinite JSON number"
                      for path in _ledger_nonfinite_paths(entry))
        if not _ledger_model(entry.get("model")):
            errors.append(prefix + "model must be a nonempty normalized id or catalog override key")
        if "effective_from" not in entry or not (
            curated and entry["effective_from"] is None
        ) and _ledger_instant(entry.get("effective_from")) is None:
            errors.append(prefix + "effective_from must be a whole-second RFC 3339 UTC instant"
                          + (" or null" if curated else "; null is curated-only"))
        sources = ("curated",) if curated else ("catalog", "manual")
        if entry.get("source") not in sources:
            errors.append(prefix + "source must be " + " or ".join(sources))
        for field_name in ("per_million", "long_context"):
            if field_name == "long_context" and field_name not in entry:
                continue
            rates = entry.get(field_name)
            if not isinstance(rates, dict):
                errors.append(prefix + field_name + " must be an object")
                continue
            for rate in rate_keys:
                if not _ledger_number(rates.get(rate)):
                    errors.append(prefix + field_name + "." + rate + " must be a finite number >= 0")
            if field_name == "long_context" and not (
                type(rates.get("threshold")) is int and rates["threshold"] > 0
            ):
                errors.append(prefix + "long_context.threshold must be a positive integer")
        if "priority" in entry:
            priority = entry["priority"]
            if not isinstance(priority, dict):
                errors.append(prefix + "priority must be an object")
            else:
                if not _ledger_number(priority.get("multiplier"), positive=True):
                    errors.append(prefix + "priority.multiplier must be a finite number > 0")
                cap = priority.get("max_input_tokens")
                if "max_input_tokens" not in priority or not (
                    cap is None or type(cap) is int and cap > 0
                ):
                    errors.append(prefix + "priority.max_input_tokens must be a positive integer or null")
        if entry.get("source") == "catalog" and "recorded_at" not in entry:
            errors.append(prefix + "recorded_at is required for catalog entries")
        if "recorded_at" in entry and parse_rfc3339_ms(entry["recorded_at"]) is None:
            errors.append(prefix + "recorded_at must be an RFC 3339 instant")
        if "note" in entry and not isinstance(entry["note"], str):
            errors.append(prefix + "note must be a string")
        if "approximate_date" in entry and type(entry["approximate_date"]) is not bool:
            errors.append(prefix + "approximate_date must be a boolean")
        if len(errors) != start_errors:
            continue
        key = (entry["model"], entry["effective_from"], entry["source"])
        comparable = {key: value for key, value in entry.items() if key not in ("note", "recorded_at")}
        if key in seen:
            earlier_number, earlier = seen[key]
            if _ledger_json_equal(comparable, earlier):
                warnings.append(prefix + f"duplicate of entry {earlier_number}; collapsed")
            else:
                errors.append(prefix + f"conflicts with entry {earlier_number}")
        else:
            seen[key] = (number, comparable)
            entries.append(entry)
    return LedgerCheck([] if errors else entries, errors, warnings)


class Pick(NamedTuple):
    entry: dict
    period_index: int
    before_first: bool


class PriceHistory:
    """Merged validated entries, indexed by exact pricing key and period."""

    def __init__(self, curated: list[dict], user: list[dict]):
        self._entries = {}
        self._times = {}
        ranks = {"curated": 0, "catalog": 1, "manual": 2}
        for entry in curated + user:
            self._entries.setdefault(entry["model"], []).append(entry)
        for model, entries in self._entries.items():
            entries.sort(key=lambda entry: (entry["effective_from"] is not None,
                         _ledger_instant(entry["effective_from"]) if entry["effective_from"] is not None else 0,
                         ranks[entry["source"]]))
            self._times[model] = [float("-inf") if entry["effective_from"] is None
                                  else _ledger_instant(entry["effective_from"]) for entry in entries]

    def entries_for(self, model: str) -> list[dict]:
        return list(self._entries.get(model, []))

    def has_any(self, model: str) -> bool:
        return bool(self._entries.get(model))

    def pick(self, model: str, at_ms: int) -> Pick | None:
        entries = self._entries.get(model)
        if not entries:
            return None
        times = self._times[model]
        position = bisect.bisect_right(times, at_ms) - 1
        before_first = position < 0
        if before_first:
            # Earliest date still observes manual > catalog > curated ties.
            position = bisect.bisect_right(times, times[0]) - 1
        return Pick(entries[position], position, before_first)


def _history_catalog_match(model: str, index: ModelsDevIndex) -> dict | None:
    for provider, candidate in codex_models_dev_pricing_targets(model):
        lookup = index.pricing(provider, candidate)
        if lookup is not None:
            return lookup
    return None


def _history_rate_fields(entry: dict) -> tuple:
    """Recording compares only rates and threshold; metadata stays untouched."""
    fields = ("input", "cached_input", "cache_write", "output")
    standard = tuple(entry["per_million"][field] for field in fields)
    long = entry.get("long_context")
    return standard, None if long is None else tuple(long[field] for field in ("threshold", *fields))


def record_catalog_rates(history: PriceHistory, index: ModelsDevIndex,
                         fetched_at_ms: int, recording_ids: dict[str, str], now_ms: int) -> list[dict]:
    """Record changes at fetch time, never compare against manual corrections."""
    sources = {normalize_codex_model(value["model_id"]): normalize_codex_model(value["model_id"])
               for value in index._models.values()}
    sources.update({key: key for key in history._entries})
    sources.update(recording_ids)
    effective_ms = fetched_at_ms // 1000 * 1000
    effective_from = format_rfc3339(effective_ms)
    appended = []
    for key, source_model in sorted(sources.items()):
        if _history_catalog_match(source_model, index) is None:
            continue
        entries = history.entries_for(key)
        if any(entry["effective_from"] == effective_from for entry in entries):
            continue
        rates = resolve_rates(source_model, index)
        if rates is None:
            continue
        previous = next((entry for entry in reversed(entries)
                         if entry["source"] != "manual" and (entry["effective_from"] is None
                         or _ledger_instant(entry["effective_from"]) <= effective_ms)), None)
        if previous is not None and _history_rate_fields(previous) == _history_rate_fields(rates):
            continue
        new = {"model": key, "effective_from": effective_from,
               "per_million": rates["per_million"], "source": "catalog",
               "recorded_at": format_rfc3339(now_ms), "approximate_date": True}
        if rates["long_context"] is not None:
            new["long_context"] = rates["long_context"]
        picked = history.pick(key, effective_ms)
        if picked is not None and "priority" in picked.entry:
            new["priority"] = picked.entry["priority"]
        appended.append(new)
    return appended


def append_user_ledger(path: Path, new_entries: list[dict],
                       start_mtime_ns: int | None) -> tuple[bool, str | None]:
    """Append atomically only if the start-of-run ledger is still current."""
    if not new_entries:
        return False, None
    changed = "price-history.json changed during the run; recording skipped"
    try:
        try:
            before = path.stat().st_mtime_ns
        except FileNotFoundError:
            before = None
        if before != start_mtime_ns:
            return False, changed
        if before is None:
            text = None
        else:
            text = path.read_bytes()
        try:
            after = path.stat().st_mtime_ns
        except FileNotFoundError:
            after = None
        if after != start_mtime_ns:
            return False, changed
        doc = {"schema": 1, "entries": []} if text is None else json.loads(
            text.decode("utf-8"), parse_constant=_reject_json_constant)
        checked = validate_ledger(doc, curated=False)
        if checked.errors:
            return False, "price-history.json: " + "; ".join(checked.errors)
        # Validation may collapse duplicates for pricing, but the user's existing
        # JSON entries stay unchanged when persisted.
        combined = dict(doc, entries=doc["entries"] + new_entries)
        checked = validate_ledger(combined, curated=False)
        if checked.errors:
            return False, "price-history.json: " + "; ".join(checked.errors)
        atomic_write_json(path, combined, indent=2)
        return True, None
    except (OSError, UnicodeError, ValueError) as exc:
        return False, f"price-history.json: recording skipped: {exc}"


# ===== 16. Catalog fetch =====
@dataclass
class CatalogResult:
    status: str
    catalog: dict | None
    fetched_at_ms: int | None
    checked_at_ms: int | None
    messages: list[str]


class _CatalogFloat(float):
    """Keep JSON number spelling until the typed context Int has been decoded."""

    def __new__(cls, spelling):
        value = super().__new__(cls, spelling)
        value.spelling = spelling
        return value


def _catalog_context_integer(value: _CatalogFloat) -> int | None:
    # JSONDecoder swift-6.2-RELEASE, _slowpath_unwrapFixedWidthInteger and
    # FixedWidthInteger.init (1002–1104): Double first, Decimal above 2^53.
    # Foundation Decimal._decimal (swift-6.1-RELEASE, 320–424) uses UInt128,
    # discards overflowing fractional digits and compacts trailing zeroes.
    binary = float(value)
    if not math.isfinite(binary) or not binary.is_integer() or not -(2**63) <= binary < 2**63:
        return None
    if abs(binary) < 2**53:
        return int(binary)
    sign, digits, exponent = Decimal(value.spelling).as_tuple()
    coefficient = discarded = 0
    for digit in digits:
        candidate = coefficient * 10 + digit
        if discarded or candidate > 2**128 - 1:
            discarded += 1
        else:
            coefficient = candidate
    exponent += discarded
    if not -128 <= exponent <= 127:
        return None
    while coefficient and coefficient % 10 == 0 and exponent < 127:
        coefficient //= 10
        exponent += 1
    if coefficient > 2**64 - 1:
        return None
    integer = coefficient * 10**exponent if exponent >= 0 else coefficient // 10**(-exponent)
    if sign:
        integer = -integer
    return integer if -(2**63) < integer < 2**63 else None


def _catalog_json_loads(data: bytes):
    def reject_constant(spelling):
        raise ValueError(f"invalid JSON number {spelling}")

    def first_pairs(pairs):
        # JSONDecoder KeyedContainer.stringify 1205–1208 uses _setIfNil in
        # a Swift String dictionary: canonical equality, first spelling/value.
        result, identities = {}, set()
        for key, value in pairs:
            identity = unicodedata.normalize("NFC", key)
            if identity not in identities:
                identities.add(identity)
                result[key] = value
        return result

    value = json.loads(data, parse_float=_CatalogFloat, parse_constant=reject_constant,
                       object_pairs_hook=first_pairs)
    if isinstance(value, dict) and not _catalog_keys_valid(value):
        raise ValueError("invalid Unicode in catalog object key")
    return value


def _catalog_string_valid(value) -> bool:
    # JSONDecoder.unwrapString (799–818) rejects unpaired UTF-16 escapes.
    # json.loads already combines valid escaped surrogate pairs into scalars.
    return not isinstance(value, str) or not any(0xD800 <= ord(char) <= 0xDFFF for char in value)


def _catalog_keys_valid(value) -> bool:
    return not isinstance(value, dict) or all(_catalog_string_valid(key) for key in value)


def _catalog_model_raw_valid(model) -> bool:
    """Validate only fields/containers that the source typed model decodes."""
    if not isinstance(model, dict) or not _catalog_keys_valid(model):
        return False
    if not all(_catalog_string_valid(model.get(key)) for key in ("id", "name")):
        return False
    if not _catalog_keys_valid(model.get("limit")):
        return False
    cost = model.get("cost")
    if not _catalog_keys_valid(cost):
        return False
    if isinstance(cost, dict):
        long_context = cost.get("context_over_200k")
        if not _catalog_keys_valid(long_context):
            return False
        for block in (cost, long_context):
            if not isinstance(block, dict):
                continue
            for key in ("input", "output", "cache_read", "cache_write"):
                number = block.get(key)
                # unwrapFloatingPoint 913–929: finite zero is accepted only
                # when every coefficient digit is zero, ignoring the exponent.
                # This does NOT apply to the separate context Int slow path.
                if isinstance(number, _CatalogFloat) and number == 0:
                    coefficient = number.spelling.lower().split("e", 1)[0]
                    if any("1" <= char <= "9" for char in coefficient):
                        return False
    return True


def _catalog_plain(value, *, finite: bool = False):
    """Decode Double values; ignored overflow fields carry no JSON evidence."""
    if isinstance(value, _CatalogFloat):
        number = float(value)
        return None if finite and not math.isfinite(number) else number
    if isinstance(value, dict):
        return {key: _catalog_plain(child, finite=finite) for key, child in value.items()}
    if isinstance(value, list):
        return [_catalog_plain(child, finite=finite) for child in value]
    return value


def _catalog_decode_contexts(catalog: dict) -> dict:
    # ModelsDevProvider.init skips typed model failures independently. Apply
    # the raw-lexeme check before an ordinary float erases that evidence.
    if not _catalog_keys_valid(catalog):
        raise ValueError("invalid Unicode in catalog object key")
    for providers in (catalog, catalog.get("providers")):
        if not isinstance(providers, dict):
            continue
        for provider_key, provider in list(providers.items()):
            if (not _models_dev_provider_decodable(provider)
                    or not _catalog_keys_valid(provider)
                    or not _catalog_keys_valid(provider["models"])
                    or not all(_catalog_string_valid(provider.get(key)) for key in ("id", "name"))):
                # Reject before sanitizing ignored overflow fields: changing an
                # invalid optional name/id into null must not invent a provider.
                providers[provider_key] = None
                continue
            for key, model in list(provider["models"].items()):
                if not _catalog_model_raw_valid(model):
                    del provider["models"][key]
                    continue
                limit = model.get("limit") if isinstance(model, dict) else None
                context = limit.get("context") if isinstance(limit, dict) else None
                if isinstance(context, _CatalogFloat):
                    integer = _catalog_context_integer(context)
                    if integer is None:
                        del provider["models"][key]
                    else:
                        limit["context"] = integer
                if _models_dev_decode_model(_catalog_plain(model)) is None:
                    provider["models"].pop(key, None)
    # Known typed fields were validated above; nonfinite unknown metadata is
    # ignored by the source decoder and cannot poison the persisted JSON.
    return _catalog_plain(catalog, finite=True)


def _load_catalog_cache(cache_path: Path, messages: list[str]) -> dict | None:
    try:
        cached = _catalog_json_loads(cache_path.read_bytes())
        if (not isinstance(cached, dict) or type(cached.get("schema")) is not int
                or cached["schema"] != 1 or not isinstance(cached.get("url"), str)
                or type(cached.get("fetched_at_ms")) is not int
                or (cached.get("etag") is not None and not isinstance(cached["etag"], str))
                or not isinstance(cached.get("catalog"), dict)
                or "openai" not in cached["catalog"]):
            raise ValueError("invalid cache fields or schema")
        cached["catalog"] = _catalog_decode_contexts(cached["catalog"])
        return cached
    except FileNotFoundError:
        return None
    except (OSError, ValueError, UnicodeError, RecursionError) as exc:
        messages.append(f"pricing-cache.json: unavailable: {exc}")
        return None


def fetch_catalog(url: str, cache_path: Path, *, offline: bool, refresh: bool,
                  now_ms: int) -> CatalogResult:
    """Fetch only public catalog data, with total header/body watchdog budgets."""
    messages = []
    cached = _load_catalog_cache(cache_path, messages)
    checked_at_ms = None

    def result(status: str) -> CatalogResult:
        return CatalogResult(status, cached["catalog"] if cached else None,
                             cached["fetched_at_ms"] if cached else None,
                             checked_at_ms, messages)

    same_url = cached is not None and cached["url"] == url
    if cached is not None and not same_url:
        messages.append(f"catalog cache URL {cached['url']} differs from configured URL {url}")
    if offline:
        return result("offline" if cached else "unavailable")

    conn = resp = timer = None
    lock = threading.Lock()
    state = {"sock": None, "fired": False}
    phase = "connect/headers"

    def watchdog():
        with lock:
            state["fired"] = True
            if state["sock"] is not None:
                with contextlib.suppress(OSError):
                    state["sock"].shutdown(socket.SHUT_RDWR)

    def check_deadline():
        with lock:
            if state["fired"]:
                raise TimeoutError(f"catalog {phase} timeout")

    def cancel_timer():
        if timer is not None:
            timer.cancel()
            # A cancelled timer may already be running. Finish it before
            # resetting fired for the next phase or closing/reusing the socket.
            timer.join()

    try:
        parsed = urlsplit(url)
        if parsed.scheme not in ("http", "https"):
            raise ValueError(f"unsupported catalog URL scheme: {parsed.scheme}")
        if not parsed.hostname or parsed.username is not None or parsed.password is not None:
            raise ValueError("catalog URL requires a host and no credentials")
        connection = http.client.HTTPSConnection if parsed.scheme == "https" else http.client.HTTPConnection
        conn = connection(parsed.hostname, parsed.port, timeout=CONNECT_TIMEOUT_S)
        headers = {}
        if same_url and cached.get("etag") and not refresh:
            headers["If-None-Match"] = cached["etag"]
        target = parsed.path or "/"
        if parsed.query:
            target += "?" + parsed.query
        checked_at_ms = now_ms
        timer = threading.Timer(CONNECT_TIMEOUT_S, watchdog)
        timer.daemon = True
        timer.start()
        conn.connect()
        with lock:
            state["sock"] = conn.sock
            if state["fired"]:
                raise TimeoutError("catalog connect/headers timeout")
        conn.request("GET", target, headers=headers)
        resp = conn.getresponse()
        check_deadline()
        cancel_timer()
        check_deadline()
        timer = None
        if resp.status == 304:
            if not same_url:
                raise ValueError("catalog HTTP 304 without a matching cached catalog")
            return result("not_modified")
        if resp.status != 200:
            raise ValueError(f"catalog HTTP status {resp.status}")

        phase = "body"
        with lock:
            state["fired"] = False
            state["sock"].settimeout(BODY_TIMEOUT_S)
        timer = threading.Timer(BODY_TIMEOUT_S, watchdog)
        timer.daemon = True
        timer.start()
        chunks = []
        while True:
            chunk = resp.read(65536)
            check_deadline()
            if not chunk:
                break
            chunks.append(chunk)
        cancel_timer()
        check_deadline()
        timer = None
        if resp.length not in (None, 0):
            raise ValueError("catalog body ended before its Content-Length")
        data = _catalog_json_loads(b"".join(chunks))
        if not isinstance(data, dict) or "openai" not in data:
            raise ValueError("catalog JSON has no openai provider")
        catalog = _catalog_decode_contexts({"openai": data["openai"]})
        artifact = {"schema": 1, "etag": resp.getheader("ETag"),
                    "fetched_at_ms": now_ms, "url": url, "catalog": catalog}
        atomic_write_json(cache_path, artifact)
        return CatalogResult("fetched", catalog, now_ms, checked_at_ms, messages)
    except (OSError, http.client.HTTPException, ValueError, UnicodeError, RecursionError) as exc:
        with lock:
            timed_out = state["fired"]
        message = f"catalog {phase} timeout" if timed_out or isinstance(exc, TimeoutError) else f"catalog fetch failed: {exc}"
        messages.append(message)
        return result("cached" if cached else "unavailable")
    finally:
        cancel_timer()
        if resp is not None:
            resp.close()
        if conn is not None:
            conn.close()


# ===== 17. Compile =====
@dataclass
class PricingReport:
    periods: dict[str, list[dict]] = field(default_factory=dict)
    unpriced: dict[str, int] = field(default_factory=dict)
    history_begins: dict[str, int] = field(default_factory=dict)
    priority_without_multiplier: dict[str, int] = field(default_factory=dict)
    unrecorded: set[str] = field(default_factory=set)
    untimed: dict[str, int] = field(default_factory=dict)


def _period_payload(entry: dict) -> dict:
    return {"effective_from_ms": _ledger_instant(entry["effective_from"])
            if entry.get("effective_from") is not None else None,
            "source": entry["source"], "per_million": entry["per_million"],
            "long_context": entry.get("long_context"), "priority": entry.get("priority")}


def _override_key(raw: str, normalized: str, index: ModelsDevIndex | None) -> str | None:
    if index is None:
        return None
    raw_match = _history_catalog_match(raw, index)
    normalized_match = _history_catalog_match(normalized, index)
    if raw_match is not None and (normalized_match is None or
            raw_match["normalized_model_id"] != normalized_match["normalized_model_id"]):
        return f'catalog:{raw_match["normalized_model_id"]}|{normalized}'
    return None


def price_units(corpus: Corpus, history: PriceHistory, index: ModelsDevIndex | None,
                *, costs_available: bool) -> PricingReport:
    """PricingRows4–45/87–95 with the approved dated-history adaptation."""
    report = PricingReport(periods={key: [_period_payload(entry) for entry in entries]
                                   for key, entries in history._entries.items()})

    def picked(key, at):
        pick = history.pick(key, at)
        if pick is not None and pick.before_first:
            report.history_begins[key] = _ledger_instant(pick.entry["effective_from"])
        return pick

    def rates(key, source_model, at, *, current=False, priority=None):
        pick = None if current else picked(key, at)
        if pick is not None:
            return pick.entry, (key, pick.period_index)
        entry = resolve_rates(source_model, index)
        if entry is None:
            return None, None
        transient = dict(entry, source="transient", effective_from=None)
        if priority is not None:
            transient["priority"] = priority
        periods = report.periods.setdefault(key, [])
        period = _period_payload(transient)
        if period not in periods:
            periods.append(period)
        if index is not None and _history_catalog_match(source_model, index) is not None:
            report.unrecorded.add(key)
        return transient, (key, periods.index(period))

    for session in corpus.sessions.values():
        for unit in session.units:
            unit.cost_usd = unit.period = unit.priority_period = None
            report.periods.setdefault(unit.model, [])
            if not costs_available:
                continue
            trace = (unit.priority or {}).get("model")
            override = (isinstance(trace, str) and codex_api_fast_multiplier(trace) is not None)
            raw = trace if override else unit.model_raw
            normalized = normalize_codex_model(raw)
            if normalized == "unknown":
                report.unpriced[unit.model] = report.unpriced.get(unit.model, 0) + unit.input + unit.output
                continue
            if unit.at_ms is None:
                # PricingRows passes nil pricingDate upstream: resolve today's
                # rates and static Fast policy, never select a dated ledger.
                multiplier = codex_api_fast_multiplier(raw) if unit.tier == "priority" else None
                priority = ({"multiplier": multiplier, "max_input_tokens":
                    None if normalized == "gpt-6-astra" else 272_000} if multiplier is not None else None)
                key = _override_key(raw, normalized, index) if override else None
                entry, unit.period = rates(key or normalized, raw if override else normalized,
                    None, current=True, priority=priority)
                if entry is None:
                    report.unpriced[unit.model] = report.unpriced.get(unit.model, 0) + unit.input + unit.output
                    continue
                report.untimed[unit.model] = report.untimed.get(unit.model, 0) + unit.input + unit.output
                base = cost_usd(entry, input=unit.input, cached=unit.cached, output=unit.output)
                unit.cost_usd = base
                if unit.tier == "priority":
                    priority_cost = priority_cost_usd(entry, priority, input=unit.input,
                        cached=unit.cached, output=unit.output)
                    if priority_cost is not None:
                        unit.cost_usd = max(base, priority_cost)
                    if priority is not None:
                        unit.priority_period = unit.period
                    else:
                        report.priority_without_multiplier[normalized] = report.priority_without_multiplier.get(normalized, 0) + unit.input
                continue
            at = unit.at_ms
            cutoff = HISTORICAL_CUTOFFS.get(normalized)
            historical = cutoff is not None and unit.timestamp_unix_ms is not None and unit.timestamp_unix_ms < cutoff
            rates_at = at if cutoff is None or unit.timestamp_unix_ms is not None else max(at, cutoff)
            key = _override_key(raw, normalized, index) if override and not historical else None
            if key is not None:
                pick = history.pick(key, rates_at)
                if pick is not None and pick.before_first:
                    key = None
            entry, unit.period = rates(key or normalized, raw if key else normalized, rates_at)
            if entry is None:
                report.unpriced[unit.model] = report.unpriced.get(unit.model, 0) + unit.input + unit.output
                continue
            base = cost_usd(entry, input=unit.input, cached=unit.cached, output=unit.output)
            unit.cost_usd = base
            if unit.tier == "priority":
                pick = picked(normalized, at)
                priority = pick.entry.get("priority") if pick is not None else None
                if pick is not None and priority is not None:
                    unit.priority_period = (normalized, pick.period_index)
                priority_cost = priority_cost_usd(entry, priority, input=unit.input,
                                                  cached=unit.cached, output=unit.output)
                if priority_cost is not None:
                    unit.cost_usd = max(base, priority_cost)
                elif priority is None:
                    report.priority_without_multiplier[normalized] = (
                        report.priority_without_multiplier.get(normalized, 0) + unit.input)
    return report


def _usage_payload(units: list[UsageUnit], *, costs_available: bool) -> dict:
    usage = {key: 0 for key in ("input", "cached_input", "cache_write", "output", "reasoning")}
    priced_by = set()
    cost = 0.0
    unpriced = 0
    has_unknown = not costs_available
    for unit in units:
        for key, value in (("input", unit.input), ("cached_input", unit.cached),
                           ("cache_write", unit.cache_write), ("output", unit.output),
                           ("reasoning", unit.reasoning or 0)):
            usage[key] += value
        if unit.cost_usd is None:
            has_unknown = True
            if costs_available:
                unpriced += unit.input + unit.output
        else:
            cost += unit.cost_usd
        if unit.period is not None:
            priced_by.add((*unit.period, "rates"))
        if unit.priority_period is not None:
            priced_by.add((*unit.priority_period, "priority"))
    return dict(usage, cost_usd=None if has_unknown else cost,
                unpriced_tokens=unpriced, priced_by=[list(period) for period in sorted(priced_by)])


def build_payload(corpus: Corpus, workspaces: dict, pricing: PricingReport,
                  meta_inputs: dict) -> dict:
    """Emit only the schema-locked page contract, retaining source identities."""
    source_home = Path(codex_path_key(Path(meta_inputs["codex_home"])))
    available = meta_inputs.get("costs_available", True)
    id_map = {}
    for session in corpus.sessions.values():
        identifier = session.id
        if "no_session_meta" in session.flags and identifier.startswith("file:"):
            identifier = "file:" + str(Path(session.record["key"]["path"]).relative_to(source_home))
        id_map[session.id] = identifier
    rows, subagents = [], {}
    for session in corpus.sessions.values():
        meta = session.meta or {}
        git = meta.get("git") or {}
        voice_facts = session.record["voice"]
        voice_reply_by_identity = {id(request): fact["reply"] for request, fact in session.voice_pairs}

        def requests(items, turn_key):
            return [dict(request, voice_reply=voice_reply_by_identity.get(id(request)))
                    for request in items]

        turns = []
        for turn in session.turns:
            turns.append({"id": turn.id, "n": turn.n, "status": turn.status,
                "start_ms": turn.start_ms, "end_ms": turn.end_ms,
                "duration_ms": turn.duration_ms, "ttft_ms": turn.ttft_ms,
                "flags": sorted(turn.flags), "requests": requests(turn.requests, turn.id),
                "final_answer": turn.final_answer,
                "voice_replies": [{"at_ms": reply["at_ms"], "text": reply["text"]}
                                  for reply in voice_facts["replies"] if reply["turn_key"] == turn.id],
                "tools": turn.tools,
                "usage": _usage_payload([unit for unit in session.units if unit.display_turn == turn.id], costs_available=available),
                "spawned": [id_map.get(identifier, identifier) for identifier in turn.spawned],
                "used": [id_map.get(identifier, identifier) for identifier in turn.used]})
        grouped = {}
        for unit in session.units:
            bucket = unit.at_ms // 900_000 if unit.at_ms is not None else None
            grouped.setdefault((bucket, unit.model, unit.tier), []).append(unit)
        buckets = []
        for (bucket, model, tier), units in sorted(grouped.items(), key=lambda item: (
                item[0][0] is None, item[0][0] or 0, item[0][1], item[0][2])):
            usage = _usage_payload(units, costs_available=available)
            buckets.append([bucket, model, tier, *[usage[key] for key in
                            ("input", "cached_input", "cache_write", "output", "reasoning", "cost_usd")]])
        row = {"id": id_map[session.id], "kind": session.kind,
               "title": session.title, "title_full": session.title_full,
               "title_source": session.title_source, "archived": session.archived,
               "log_path": session.log_path, "workspace": session.workspace,
               "subfolder": session.subfolder, "cwd": meta.get("cwd") or session.db_info.get("cwd"),
               "branch": git.get("branch") or session.db_info.get("git_branch"),
               "originator": meta.get("originator") or session.db_info.get("originator"),
               "forked_from": id_map.get(session.forked_from, session.forked_from),
               "start_ms": session.start_ms, "end_ms": session.end_ms,
               "idle_ms": session.idle_ms, "user_span_ms": session.user_span_ms,
               "flags": sorted(session.flags), "turns": turns,
               "session_voice": {"requests": requests(session.session_voice["requests"], None),
                                 "replies": session.session_voice["replies"] if not session.turns else []},
               "own_usage": _usage_payload(session.units, costs_available=available),
               "outside_usage": _usage_payload([unit for unit in session.units if unit.display_turn is None], costs_available=available),
               "buckets": buckets, "tools": session.tools,
               "children": [id_map.get(identifier, identifier) for identifier in session.children]}
        if session.kind == "subagent":
            row.pop("kind")
            link = session.link or {}
            row.update(parent_id=id_map.get(session.parent_id, session.parent_id), depth=session.depth,
                agent_path=session.agent_path, label=humanize_agent_path(session.agent_path),
                nickname=meta.get("agent_nickname") or session.db_info.get("agent_nickname"),
