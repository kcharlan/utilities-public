def parse_args():
    parser = argparse.ArgumentParser(
        description="jtree: Interactive JSON Viewer & Editor",
        epilog="Launches a local web server and opens the browser interface."
    )
    parser.add_argument(
        "file_path",
        nargs="?",
        default=None,
        help="Path to the JSON file to open (optional; opens empty if omitted)."
    )
    parser.add_argument(
        "--port", "-p",
        type=int,
        default=8100,
        help="Port to run the server on (default: 8100)."
    )
    parser.add_argument(
        "--readonly",
        action="store_true",
        help="Open in read-only mode (no editing)."
    )
    return parser.parse_args()


