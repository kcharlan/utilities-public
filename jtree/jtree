            )} <div class=${"context-menu-separator"} /> <div class=${"context-menu-item"} onClick=${() => { navigator.clipboard.writeText(node.path); onClose(); }}> <${Icon} name=${"link"} size=${14} /> Copy Path </div> ${node.childCount === 0 && (
