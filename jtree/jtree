const GraphNode = memo(({ node, pos, groupColor, isExpanded, isSelected, isSearchMatch, isDark, onClick, onDoubleClick, onChevronClick, onContextMenu }) => {
    const tc = typeColor(node.type, isDark);
    const isLeaf = node.childCount === 0;
    const keyName = node.path ? node.path.split('.').pop() : 'root';
    const displayKey = /^\\d+$/.test(keyName) ? `[${keyName}]` : keyName;
    // groupColor is an array of ancestor colors; use the last one (own color) for left border
    const chain = groupColor || [];
    const ownColor = chain.length > 0 ? chain[chain.length - 1] : tc.border;

    return (
        html`<div class=${`graph-node node-appear ${isSelected ? 'selected' : ''} ${isSearchMatch ? 'search-match' : ''}`} style=${{
                left: pos.x,
                top: pos.y,
                width: pos.width,
                borderLeft: isLeaf ? 'none' : `4px solid ${ownColor}`,
                background: isDark ? `linear-gradient(135deg, #0f1f3a, ${tc.bg})` : `linear-gradient(135deg, #ffffff, ${tc.bg})`,
            }} onClick=${(e) => { e.stopPropagation(); onClick(node); }} onDblClick=${(e) => { e.stopPropagation(); onDoubleClick(node); }} onContextMenu=${(e) => { e.preventDefault(); e.stopPropagation(); onContextMenu(e, node); }}> <div style=${{ flex: 1, padding: '10px 12px', minWidth: 0 }}> <div class=${"flex items-center justify-between gap-2 mb-1"}> <span class=${"font-semibold truncate text-sm"} title=${displayKey}>${displayKey}</span> <span class=${"type-badge"} style=${{ background: tc.badgeBg, color: tc.text }}>${node.type}</span> </div> ${isLeaf ? (
                    html`<div class=${"font-mono text-xs truncate opacity-80"} title=${String(node.value)}> ${formatValue(node.value, node.type)} </div>`
                ) : (
                    html`<div class=${"text-xs opacity-60"}> <span class=${"inline-flex items-center gap-1 hover:opacity-90"} onClick=${(e) => { e.stopPropagation(); onChevronClick(node); }} style=${{ cursor: 'pointer' }} title=${isExpanded ? 'Collapse' : 'Expand'}> <${Icon} name=${isExpanded ? "chevron-down" : "chevron-right"} size=${12} /> ${node.summary} </span> </div>`
                )} </div> </div>`
    );
});

const SVGEdgeLayer = ({ edges, isDark, groupColors }) => {
    return (
        html`<svg style=${{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', pointerEvents: 'none', overflow: 'visible' }}> ${edges.map((edge, i) => {
                const chain = groupColors?.get(edge.childPath);
                const edgeColor = (chain && chain.length > 0) ? chain[chain.length - 1] : typeColor(edge.childType, isDark).border;
                return (
                    html`<path key=${i} d=${bezierPath(edge.from, edge.to)} fill=${"none"} stroke=${edgeColor} stroke-width=${1.5} opacity=${0.4} />`
                );
            })} </svg>`
    );
};

const Minimap = ({ positions, viewBox, canvasSize, onNavigate, isDark }) => {
    const minimapRef = useRef(null);
    const dragRef = useRef({ active: false, startX: 0, startY: 0, startViewX: 0, startViewY: 0 });
    const allPositions = [...positions.entries()].filter(([k]) => k !== '_nextY');
    if (allPositions.length === 0) return null;

    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    for (const [, pos] of allPositions) {
        minX = Math.min(minX, pos.x);
        minY = Math.min(minY, pos.y);
        maxX = Math.max(maxX, pos.x + pos.width);
        maxY = Math.max(maxY, pos.y + pos.height);
    }
    const contentW = maxX - minX + 40;
    const contentH = maxY - minY + 40;
    const MIN_MINIMAP_SCALE = 0.01;
    const scale = Math.max(MIN_MINIMAP_SCALE, Math.min(200 / contentW, 150 / contentH, 1));

    const vpLeft = ((viewBox.x - minX + 20) * scale);
    const vpTop = ((viewBox.y - minY + 20) * scale);
    const vpW = (canvasSize.width * scale);
    const vpH = (canvasSize.height * scale);

    const minimapToWorld = useCallback((clientX, clientY) => {
        const rect = minimapRef.current.getBoundingClientRect();
        const mx = (clientX - rect.left) / scale + minX - 20;
        const my = (clientY - rect.top) / scale + minY - 20;
        return { x: mx, y: my };
    }, [scale, minX, minY]);

    const handleMouseDown = useCallback((e) => {
        e.preventDefault();
        e.stopPropagation();
        const world = minimapToWorld(e.clientX, e.clientY);
        // Check if click is inside the viewport rectangle
        const inVP = world.x >= viewBox.x && world.x <= viewBox.x + canvasSize.width
                  && world.y >= viewBox.y && world.y <= viewBox.y + canvasSize.height;
        if (inVP) {
            // Start dragging from current position
            dragRef.current = { active: true, startX: e.clientX, startY: e.clientY, startViewX: viewBox.x, startViewY: viewBox.y };
        } else {
            // Click outside viewport: jump to center on that point, then start drag
            const newX = world.x - canvasSize.width / 2;
            const newY = world.y - canvasSize.height / 2;
            onNavigate(newX, newY);
            dragRef.current = { active: true, startX: e.clientX, startY: e.clientY, startViewX: newX, startViewY: newY };
        }

        const handleMouseMove = (me) => {
            if (!dragRef.current.active) return;
            const dx = (me.clientX - dragRef.current.startX) / scale;
            const dy = (me.clientY - dragRef.current.startY) / scale;
            onNavigate(dragRef.current.startViewX + dx, dragRef.current.startViewY + dy);
        };

        const handleMouseUp = () => {
            dragRef.current.active = false;
            document.removeEventListener('mousemove', handleMouseMove);
            document.removeEventListener('mouseup', handleMouseUp);
        };

        document.addEventListener('mousemove', handleMouseMove);
        document.addEventListener('mouseup', handleMouseUp);
    }, [minimapToWorld, viewBox, canvasSize, onNavigate, scale]);

    return (
        html`<div class=${"minimap"} ref=${minimapRef} onMouseDown=${handleMouseDown} style=${{cursor: 'pointer'}}> <svg width=${200} height=${150}> ${allPositions.map(([path, pos]) => (
                    html`<rect key=${path} x=${(pos.x - minX + 20) * scale} y=${(pos.y - minY + 20) * scale} width=${pos.width * scale} height=${pos.height * scale} rx=${2} fill=${isDark ? '#1a3a5c' : '#94a3b8'} opacity=${0.6} />`
                ))} <rect x=${Math.max(0, vpLeft)} y=${Math.max(0, vpTop)} width=${Math.min(vpW, 200)} height=${Math.min(vpH, 150)} fill=${"none"} stroke=${"#3b82f6"} stroke-width=${2} rx=${2} /> </svg> </div>`
    );
};

