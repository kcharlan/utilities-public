const EditModal = ({ node, onSave, onClose, isDark }) => {
    const [value, setValue] = useState(() => {
        if (node.type === 'string') return node.value || '';
        if (node.type === 'number') return String(node.value ?? 0);
        if (node.type === 'boolean') return node.value;
        if (node.type === 'null') return 'null';
        return String(node.value);
    });

    const handleSave = () => {
        let parsed = value;
        if (node.type === 'number') {
            parsed = Number(value);
            if (isNaN(parsed)) return;
        } else if (node.type === 'boolean') {
            parsed = value;
        } else if (node.type === 'null') {
            parsed = null;
        }
        onSave(node.path, parsed);
    };

    return (
        html`<div class=${"modal-overlay"} onClick=${onClose}> <div class=${"modal-box"} onClick=${e => e.stopPropagation()}> <h3 class=${"text-sm font-semibold mb-3"}>Edit Value</h3> <div class=${"text-xs font-mono opacity-60 mb-2 truncate"}>${node.path || 'root'}</div> ${node.type === 'boolean' ? (
                    html`<div class=${"flex gap-2 mb-4"}> <button class=${`btn ${value === true ? 'btn-primary' : 'btn-ghost'}`} onClick=${() => setValue(true)}>true</button> <button class=${`btn ${value === false ? 'btn-primary' : 'btn-ghost'}`} onClick=${() => setValue(false)}>false</button> </div>`
                ) : node.type === 'null' ? (
                    html`<div class=${"text-sm opacity-60 mb-4 italic"}>Value is null</div>`
                ) : (
                    html`<input class=${"input-field mb-4"} type=${node.type === 'number' ? 'number' : 'text'} value=${value} onInput=${e => setValue(node.type === 'number' ? e.target.value : e.target.value)} onKeyDown=${e => e.key === 'Enter' && handleSave()} ref=${focusOnMount} />`
                )} <div class=${"flex justify-end gap-2"}> <button class=${"btn btn-ghost"} onClick=${onClose}>Cancel</button> ${node.type !== 'null' && html`<button class=${"btn btn-primary"} onClick=${handleSave}>Save</button>`} </div> </div> </div>`
    );
};

const AddChildModal = ({ parentNode, onSave, onClose }) => {
    const isObject = parentNode.type === 'object';
    const [key, setKey] = useState('');
    const [childType, setChildType] = useState('string');
    const [value, setDefaultValue] = useState('');

    const handleSave = () => {
        if (isObject && !key.trim()) return;
        let parsedValue;
        if (childType === 'object') parsedValue = {};
        else if (childType === 'array') parsedValue = [];
        else if (childType === 'number') parsedValue = Number(value) || 0;
        else if (childType === 'boolean') parsedValue = value === 'true';
        else if (childType === 'null') parsedValue = null;
        else parsedValue = value;
        onSave(parentNode.path, isObject ? key : null, parsedValue, childType);
    };

    return (
        html`<div class=${"modal-overlay"} onClick=${onClose}> <div class=${"modal-box"} onClick=${e => e.stopPropagation()}> <h3 class=${"text-sm font-semibold mb-3"}>Add Child</h3> ${isObject && (
                    html`<div class=${"mb-3"}> <label class=${"text-xs opacity-60 block mb-1"}>Key</label> <input class=${"input-field"} value=${key} onInput=${e => setKey(e.target.value)} ref=${focusOnMount} placeholder=${"key name"} /> </div>`
                )} <div class=${"mb-3"}> <label class=${"text-xs opacity-60 block mb-1"}>Type</label> <select class=${"input-field"} value=${childType} onInput=${e => setChildType(e.target.value)}> ${['string', 'number', 'boolean', 'null', 'object', 'array'].map(t => (
                            html`<option key=${t} value=${t}>${t}</option>`
                        ))} </select> </div> ${!['object', 'array', 'null'].includes(childType) && (
                    html`<div class=${"mb-4"}> <label class=${"text-xs opacity-60 block mb-1"}>Value</label> ${childType === 'boolean' ? (
                            html`<select class=${"input-field"} value=${value} onInput=${e => setDefaultValue(e.target.value)}> <option value=${"true"}>true</option> <option value=${"false"}>false</option> </select>`
                        ) : (
                            html`<input class=${"input-field"} type=${childType === 'number' ? 'number' : 'text'} value=${value} onInput=${e => setDefaultValue(e.target.value)} onKeyDown=${e => e.key === 'Enter' && handleSave()} />`
