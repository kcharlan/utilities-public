@app.post("/api/save-as")
def api_save_as(body: SaveAsBody):
    _require_file()
    resolved = os.path.expanduser(body.path)
    # Path traversal protection: reject '..' in raw input before resolution
    if '..' in resolved.split(os.sep) or '..' in body.path.split('/'):
        raise HTTPException(status_code=400, detail="Path traversal not allowed")
    resolved = os.path.abspath(resolved)
    resolved = os.path.realpath(resolved)
    if not resolved.endswith('.json'):
        raise HTTPException(status_code=400, detail="Save path must end with .json")
    # Validate parent directory exists
    parent_dir = os.path.dirname(resolved)
    if not os.path.isdir(parent_dir):
        raise HTTPException(status_code=500, detail=f"Parent directory does not exist: {parent_dir}")
    # Overwrite confirmation: warn if file exists and force flag not set
    if os.path.exists(resolved) and not body.force:
        return {"ok": False, "warning": "File already exists. Set force=true to overwrite.", "exists": True}
    with _manager_lock:
        try:
            json_manager.save(resolved)
            return {"ok": True}
        except OSError as e:
