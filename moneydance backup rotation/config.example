# Synthetic example only. Copy this file to a private location outside the
# repository and replace every SYNTHETIC_* value for your own environment.
NAS_SERVER=SYNTHETIC-NAS-HOST
NAS_SHARE_NAME=SYNTHETIC_SHARE
BACKUP_DIRECTORY_NAME=SYNTHETIC_BACKUP_DIRECTORY

# Only files ending in this exact suffix can be considered for deletion. Set
# the real export extension in your private config, never in this public file.
BACKUP_FILENAME_SUFFIX=.SYNTHETIC-BACKUP

# Keep every backup from the newest four distinct calendar days.
MAX_DAYS_TO_KEEP=4

# The example is intentionally non-destructive. Change this to 0 in your
# private config only after a successful --dry-run review.
DRY_RUN=1
USE_SYSLOG=0
LOG_FILE=
