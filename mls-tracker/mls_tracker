  body { font-family: 'Source Sans 3', sans-serif; background: var(--surface-50); color: var(--surface-900); transition: background 0.3s, color 0.3s; }

  /* Diagonal clip for header */
  .header-clip { clip-path: polygon(0 0, 100% 0, 100% calc(100% - 30px), 0 100%); }
