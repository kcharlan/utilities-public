# Model Sentinel provider configuration template.
#
# The live config file is created by ./setup.sh at:
#   ~/.model_sentinel/providers.env
#
# IMPORTANT:
# - Do not place raw API keys in this file.
# - Export the credential variables in your shell before running the tool.
# - Missing required credential env vars should cause the tool to halt.
# - LABEL is display text only; the <ID> in the key is the provider's identity
#   and is what reports group by. healthcheck warns about duplicate LABELs
#   across enabled or disabled providers without preventing scans.
#
# Price normalization fallback:
# Model Sentinel's canonical price columns store price per 1M tokens. The
# configured factors remain required and apply to generic/unmatched inherited
# rules. Registered provider field rules may declare an explicit scale and a
# different display unit; only rules explicitly targeted to per-million-token
# storage enter the canonical columns.
# For inherited rules:
#   canonical_price = raw_provider_price * PRICE_MULTIPLIER / PRICE_DIVISOR
#
# Examples:
# - per-token provider input:    MULTIPLIER=1000000, DIVISOR=1
# - per-1M-token provider input: MULTIPLIER=1, DIVISOR=1

# -----------------------------
# OpenRouter
# -----------------------------
MODEL_SENTINEL_PROVIDER_OPENROUTER_ENABLED=1
MODEL_SENTINEL_PROVIDER_OPENROUTER_LABEL=OpenRouter
MODEL_SENTINEL_PROVIDER_OPENROUTER_KIND=openrouter
MODEL_SENTINEL_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_SENTINEL_PROVIDER_OPENROUTER_MODELS_PATH=/models
# pragma: allowlist nextline secret
MODEL_SENTINEL_PROVIDER_OPENROUTER_API_KEY_ENV=OPENROUTER_AI_CREDS
MODEL_SENTINEL_PROVIDER_OPENROUTER_PRICE_MULTIPLIER=1000000
MODEL_SENTINEL_PROVIDER_OPENROUTER_PRICE_DIVISOR=1

# -----------------------------
# Abacus.AI
# -----------------------------
# The public endpoint exposed per-token token rates plus media rates with
# incompatible units. MULTIPLIER=1 is therefore known to be wrong for token
# rates, but no single multiplier is correct for every Abacus field. Keep this
# value until a dedicated Abacus profile maps its validated authenticated
# schema to the existing per-field price rules; see docs/provider_schema_notes.md.
MODEL_SENTINEL_PROVIDER_ABACUS_ENABLED=1
MODEL_SENTINEL_PROVIDER_ABACUS_LABEL=Abacus.AI
MODEL_SENTINEL_PROVIDER_ABACUS_KIND=abacus
MODEL_SENTINEL_PROVIDER_ABACUS_BASE_URL=https://routellm.abacus.ai/v1
MODEL_SENTINEL_PROVIDER_ABACUS_MODELS_PATH=/models
# pragma: allowlist nextline secret
MODEL_SENTINEL_PROVIDER_ABACUS_API_KEY_ENV=ABACUS_AI_CREDS
MODEL_SENTINEL_PROVIDER_ABACUS_PRICE_MULTIPLIER=1
MODEL_SENTINEL_PROVIDER_ABACUS_PRICE_DIVISOR=1

# Future providers can be added by following the same naming pattern.
# A future implementation may add optional fields such as custom headers,
# auth scheme overrides, request timeouts, or provider-specific query params.
