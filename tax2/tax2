# --- API Endpoints ---

def _base_dir() -> str:
    return os.path.dirname(os.path.abspath(__file__))


def _states_root() -> str:
    return os.path.join(_base_dir(), "rules", "states")


def _round_money(value: float) -> float:
    return round(value, 2) if math.isfinite(value) else 0.0


def _discover_states() -> list[dict[str, Any]]:
    from taxkit.rules_loader import load_rules
    from taxkit.utils import get_available_years, get_rule_path

    root = _states_root()
    discovered = []
    if not os.path.isdir(root):
        return discovered

    for entry in sorted(os.listdir(root)):
        state_dir = os.path.join(root, entry)
        if not os.path.isdir(state_dir):
            continue
        years = get_available_years(state_dir)
        display_name = entry
        qif = None
        if years:
            try:
                rules = load_rules(get_rule_path(state_dir, max(years)))
                display_name = rules.display_name or entry
                if rules.qif:
                    qif = rules.qif.model_dump()
            except Exception as exc:
                logger.warning("Failed to inspect state %s: %s", entry, exc)
        discovered.append(
            {
                "code": entry.upper(),
                "display_name": display_name,
                "years": years,
                "qif": qif,
            }
        )
    return discovered


def _state_info_by_code() -> dict[str, dict[str, Any]]:
    return {state["code"]: state for state in _discover_states()}


def _validate_state_selections(selections: list[StateSelection]) -> list[StateSelection]:
    if not selections:
        raise HTTPException(status_code=422, detail="At least one state must be selected")
    known = _state_info_by_code()
    normalized = []
    for selection in selections:
        code = selection.code.upper()
        if code not in known:
            raise HTTPException(status_code=422, detail=f"Unknown state code: {code}")
        normalized.append(StateSelection(code=code, allocation_pct=selection.allocation_pct))
    return normalized


def _lookup_monthly_tax(table_path: str, monthly_income: float, column: str) -> float:
    import pandas as pd

    if not os.path.exists(table_path):
        raise HTTPException(status_code=404, detail=f"Table not found: {os.path.basename(table_path)}")
    df = pd.read_csv(table_path)
    if df.empty:
        raise HTTPException(status_code=500, detail=f"Tax table is empty: {os.path.basename(table_path)}")
    idx = (df["MonthlyIncome"] - monthly_income).abs().idxmin()
    return float(df.loc[idx][column])


@app.get("/api/states")
async def get_states():
