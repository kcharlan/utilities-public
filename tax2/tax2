class ConfigRequest(BaseModel):
    default_states: List[str]


@app.post("/api/config")
async def update_config(request: ConfigRequest):
    from taxkit.config import load_config, save_config

    known = _state_info_by_code()
    normalized = [state.upper() for state in request.default_states]
    if not normalized:
        raise HTTPException(status_code=422, detail="At least one default state is required")
    unknown = [state for state in normalized if state not in known]
    if unknown:
        raise HTTPException(status_code=422, detail=f"Unknown state code: {', '.join(unknown)}")

    cfg = load_config()
    cfg["default_states"] = normalized
    saved = save_config(cfg)
    return {"default_states": saved["default_states"], "qif_overrides": saved["qif_overrides"]}

@app.post("/api/compute", response_model=TaxResponse)
async def compute_taxes(request: TaxRequest):
    """Compute taxes using rules engine or table lookup"""
    try:
        from taxkit.rules_loader import load_rules
        from taxkit.engine import compute_tax
        from taxkit.models import TaxInput, FilingStatus
        from taxkit.utils import get_rule_path
        from taxkit.config import load_config

        base_dir = _base_dir()
        selections = _validate_state_selections(request.states)
        known_states = _state_info_by_code()
        cfg = load_config()
        fs = FilingStatus(request.filing_status)
        monthly_total = request.monthly_earned + request.monthly_unearned

        if request.mode == "rules":
            fed_base = os.path.join(base_dir, "rules", "federal")
            fed_path = get_rule_path(fed_base, request.year)
            if not os.path.exists(fed_path):
                raise HTTPException(status_code=404, detail=f"Federal rules for {request.year} not found")
            fed_rules = load_rules(fed_path)
            federal_annual = compute_tax(
                TaxInput(
                    earned_income=request.monthly_earned * 12.0,
                    unearned_income=request.monthly_unearned * 12.0,
                    filing_status=fs,
                ),
                fed_rules,
            )
            federal_monthly = _round_money(federal_annual / 12.0)

            state_results = []
            for selection in selections:
                state_dir = os.path.join(base_dir, "rules", "states", selection.code)
                state_path = get_rule_path(state_dir, request.year)
                if not os.path.exists(state_path):
                    available_years = known_states[selection.code]["years"]
                    raise HTTPException(
                        status_code=404,
                        detail=(
                            f"State {selection.code} has no rules for {request.year}. "
                            f"Available years: {available_years or 'none'}"
                        ),
                    )
                state_rules = load_rules(state_path)
                factor = selection.allocation_pct / 100.0
                state_annual = compute_tax(
                    TaxInput(
                        earned_income=request.monthly_earned * 12.0 * factor,
                        unearned_income=request.monthly_unearned * 12.0 * factor,
                        filing_status=fs,
                    ),
                    state_rules,
                )
                state_results.append(
                    StateTaxResponse(
                        code=selection.code,
                        display_name=state_rules.display_name or selection.code,
                        monthly=_round_money(state_annual / 12.0),
                        annual=state_annual,
                        allocation_pct=selection.allocation_pct,
                    )
                )

        elif request.mode == "table":
            default_alias = cfg["legacy_combined_alias"].upper()
            first_code = selections[0].code
            first_table = os.path.join(base_dir, "tables", f"combined_{request.year}_{first_code}.csv")
            if not os.path.exists(first_table) and first_code == default_alias:
                first_table = os.path.join(base_dir, "tables", f"combined_{request.year}.csv")
            federal_monthly = _lookup_monthly_tax(first_table, monthly_total, "FederalMonthlyTax")
            federal_annual = federal_monthly * 12
            state_results = []
            for selection in selections:
                table_path = os.path.join(base_dir, "tables", f"combined_{request.year}_{selection.code}.csv")
                if not os.path.exists(table_path) and selection.code == default_alias:
                    table_path = os.path.join(base_dir, "tables", f"combined_{request.year}.csv")
                allocated_monthly = monthly_total * (selection.allocation_pct / 100.0)
                state_monthly = _lookup_monthly_tax(table_path, allocated_monthly, "StateMonthlyTax")
                state_results.append(
                    StateTaxResponse(
                        code=selection.code,
                        display_name=known_states[selection.code]["display_name"],
                        monthly=_round_money(state_monthly),
                        annual=state_monthly * 12,
                        allocation_pct=selection.allocation_pct,
                    )
                )

        else:
            raise HTTPException(status_code=400, detail="Invalid mode")

        total_monthly = federal_monthly + sum(state.monthly for state in state_results)
        total_annual = federal_annual + sum(state.annual for state in state_results)
        
        if monthly_total > 0:
            raw_rate = (total_annual / (monthly_total * 12)) * 100
            if math.isfinite(raw_rate):
                effective_rate = round(raw_rate, 2)
            else:
                effective_rate = 0.0
        else:
            effective_rate = 0.0

        return TaxResponse(
            federal_monthly=federal_monthly,
            federal_annual=federal_annual,
            states=state_results,
            total_monthly=_round_money(total_monthly),
            total_annual=total_annual,
            effective_rate=effective_rate
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Computation failed: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/years")
async def get_available_years():
    """Return list of available tax years"""
    try:
        from taxkit.utils import get_available_years as get_years

        base_dir = os.path.dirname(os.path.abspath(__file__))
        fed_dir = os.path.join(base_dir, "rules", "federal")

        years = get_years(fed_dir)

        # Get current year as default
        import datetime
        current_year = datetime.datetime.now().year

        return {
            "years": sorted(years, reverse=True),
            "default": current_year if current_year in years else max(years) if years else current_year
        }
    except Exception as e:
        logger.error(f"Failed to get years: {e}")
        return {"years": [2025, 2024], "default": 2025}

@app.post("/api/export/qif")
async def export_qif(request: QIFRequest):
    """Generate QIF file for download"""
    try:
        from taxkit.qif import build_qif_entries, QIFConfig, StateQIFItem

        cfg = QIFConfig(
            payee=request.payee,
            federal_expense=request.federal_expense,
            federal_transfer=request.federal_transfer,
        )

        states = [
            StateQIFItem(
                code=state.code.upper(),
                amount=state.amount,
                expense=state.expense,
                transfer=state.transfer,
            )
            for state in request.states
        ]
        qif_text = build_qif_entries(request.tx_date, request.federal_tax, states, cfg)

        # Return as downloadable file
        return StreamingResponse(
            io.BytesIO(qif_text.encode('utf-8')),
            media_type="application/qif",
            headers={"Content-Disposition": "attachment; filename=tax_transactions.qif"}
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"QIF export failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/generate-tables")
async def generate_tables(request: GenerateTableRequest):
    """Generate combined tax tables (async background task)"""
    try:
        from taxkit.tablegen import generate_table
        from taxkit.utils import get_rule_path
        import pandas as pd

        base_dir = os.path.dirname(os.path.abspath(__file__))

        fed_dir = os.path.join(base_dir, "rules", "federal")
        state_dir = os.path.join(base_dir, "rules", "states", request.state)

        fed_path = get_rule_path(fed_dir, request.year)
        state_path = get_rule_path(state_dir, request.year)

        # Generate tables
        df_fed = generate_table(fed_path, request.filing_status, 0, request.inc_max, request.step, "monthly")
        df_state = generate_table(state_path, request.filing_status, 0, request.inc_max, request.step, "monthly")

        # Save individual files
        out_dir = os.path.join(base_dir, "tables")
        os.makedirs(out_dir, exist_ok=True)

        fed_out = os.path.join(out_dir, f"federal_{request.year}.parquet")
        state_out = os.path.join(out_dir, f"{request.state.lower()}_{request.year}.parquet")

        df_fed.to_parquet(fed_out, index=False)
        df_state.to_parquet(state_out, index=False)

        # Merge
        rf = df_fed.rename(columns={"MonthlyTax": "FederalMonthlyTax"})[["MonthlyIncome", "FederalMonthlyTax"]]
        rs = df_state.rename(columns={"MonthlyTax": "StateMonthlyTax"})[["MonthlyIncome", "StateMonthlyTax"]]

        combined = pd.merge(rf, rs, on="MonthlyIncome", how="outer").sort_values("MonthlyIncome")

        combined_out = os.path.join(out_dir, f"combined_{request.year}.csv")
        combined.to_csv(combined_out, index=False)

        return {
            "status": "success",
            "rows": len(combined),
            "files": [fed_out, state_out, combined_out]
        }

    except Exception as e:
        logger.error(f"Table generation failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

