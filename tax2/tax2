"""Build a private offline calculator from validated local rules."""
import argparse
import os
from pathlib import Path
import sys
import webbrowser

from taxkit.config import (atomic_write_bytes, config_path, ensure_no_config_conflict, runtime_home,
                           validate_output_destination)
from taxkit.page import build_payload, render_page


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Tax2: build an offline tax calculator with QIF and table downloads.",
        epilog="Runtime: TAX2_HOME (default ~/.tax2), config.yaml and tax2.html. Help writes no files.")
    parser.add_argument('--no-browser', action='store_true', help='Build without opening the browser')
    parser.add_argument('--output', type=Path, help='Private HTML destination (default TAX2_HOME/tax2.html)')
    parser.add_argument('--rules-dir', type=Path, help='Rules root (default rules/ beside this launcher)')
    return parser.parse_args(argv)


def testing_mode_enabled():
    return os.environ.get('UTILITIES_TESTING', '').lower() not in {'', '0', 'false', 'no'}


def main(argv=None) -> int:
    args = parse_args(argv)
    try:
        output = (args.output if args.output is not None else runtime_home() / 'tax2.html').expanduser()
        validate_output_destination(output, config_path())
        root = args.rules_dir.expanduser() if args.rules_dir is not None else Path(__file__).resolve().parent / 'rules'
        payload = build_payload(root, rules_source='custom' if args.rules_dir is not None else 'bundled')
        ensure_no_config_conflict(output, config_path())
        atomic_write_bytes(output, render_page(payload))
    except Exception as error:
        print(f'Tax2: {error}', file=sys.stderr)
        return 1
    print(output)
    if not args.no_browser and not testing_mode_enabled():
        try:
            if not webbrowser.open(output.resolve().as_uri()):
                print('Tax2 warning: unable to open browser; open the written page manually.', file=sys.stderr)
        except Exception:
            print('Tax2 warning: unable to open browser; open the written page manually.', file=sys.stderr)
    return 0


if __name__ == '__main__':
    sys.exit(main())
