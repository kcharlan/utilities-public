# frontend-vendor:end
HTML_TEMPLATE = HTML_TEMPLATE.replace("<!-- frontend-vendor -->", FRONTEND_VENDOR_HTML)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def testing_mode_enabled() -> bool:
    return os.environ.get("UTILITIES_TESTING", "").lower() not in {"", "0", "false", "no"}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="model_ladder",
        description="Compare model effort levels by available Artificial Analysis indexes and cost per task.",
        epilog="Runtime home: ~/.model_ladder/ (override with MODEL_LADDER_HOME).",
    )
    parser.add_argument("command", nargs="?", choices=("refresh", "build"),
                        help="refresh: always fetch first; build: never fetch")
    parser.add_argument("--no-refresh", action="store_true", help="never fetch, even if the data is old")
    parser.add_argument("--source", choices=SOURCE_KEYS, help="fetch only this source")
    parser.add_argument("--no-open", action="store_true", help="do not open the page in a browser")
    parser.add_argument("--output", type=Path, help="write the page here instead of the runtime home")
    parser.add_argument("--version", action="version", version=f"Model Ladder {VERSION}")
    return parser


def _quota_line(result: dict) -> str:
    models = result["models"]
    scored = len(classify(models))
    text = f"Fetched {len(models)} models ({scored} scored)."
    limits = result.get("rate_limit") or {}
    if limits.get("remaining") is not None and limits.get("limit") is not None:
        text += f" {limits['remaining']} of {limits['limit']} requests left today"
        reset = _local_time(limits.get("reset"), "%H:%M")
        text += f"; resets {reset}." if reset else "."
    return text


def _is_stale(snapshot: dict, config: dict, now: datetime, source: str = "aa") -> bool:
    checked = _utc(datetime.fromisoformat(snapshot["last_checked"]))
    return _utc(now) - checked > timedelta(hours=source_max_age(config, source))


def _complain(message: str) -> None:
    print(f"Model Ladder: {message}", file=sys.stderr)


def _status(message: str) -> None:
    print(message, flush=True)


def main(argv: list[str] | None = None, *, now: datetime | None = None, fetch=fetch_all,
         get_key=get_api_key, open_page=webbrowser.open, fetchers=None, sources=SOURCE_KEYS) -> int:
    args = build_parser().parse_args(argv)
    now = now or datetime.now(timezone.utc)
    try:
        config = load_config()
    except (ValueError, OSError) as error:
        _complain(str(error))
        return 1
    home = runtime_home()
    registered = {"aa": lambda config, newest: fetch(get_key(config)), **(fetchers or {})}
    registered = {key: func for key, func in registered.items() if func is not None}
    snapshots, unavailable, reported = {}, {}, False
    for key in sources:
        try:
            paths = load_snapshots(home, key)
            snapshots[key] = read_snapshot(paths[0], key) if paths else None
        except StoreError as error:
            _complain(str(error))
            unavailable[key] = str(error)
            reported = True
    for key in sources:
        newest = snapshots.get(key)
        if key in unavailable or key not in registered or (args.source and args.source != key):
            continue
        if args.command == "build" or args.no_refresh:
            continue
        if args.command != "refresh" and newest is not None and not _is_stale(newest, config, now, key):
            continue
        try:
            result = registered[key](config, newest)
            path = save_snapshot(home, result, now, key)
            snapshots[key] = read_snapshot(path, key)
            write_status(home, key, now, None)
            if key == "aa" and not result.get("not_modified"):
                print(_quota_line(result))
            elif result.get("not_modified"):
                print(f"{SOURCE_SPECS[key]['label']}: unchanged.")
            else:
                print(f"{SOURCE_SPECS[key]['label']}: {len(result['models'])} configurations.")
        except (KeyUnavailable, FetchError, StoreError, OSError) as error:
            message = f"cannot save snapshot: {error}" if isinstance(error, OSError) else str(error)
            _complain(message)
            reported = True
            try:
                write_status(home, key, now, message)
            except OSError as status_error:
                _complain(f"cannot save status: {status_error}")
    if not any(snapshots.values()):
        if not reported:
            _complain("no snapshot yet; run model_ladder refresh to fetch one")
        return 1

    output = args.output.expanduser() if args.output else home / "model_ladder.html"
    try:
        _status("Building the page…")
        build_page(home, output, unavailable=unavailable)
    except (OSError, StoreError, ValueError) as error:
        _complain(f"cannot build the page: {error}")
        return 1
    print(output)
    if not args.no_open and not testing_mode_enabled():
        try:
            open_page(output.resolve().as_uri())
        except Exception:
            _complain("could not open a browser; open the page manually")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
