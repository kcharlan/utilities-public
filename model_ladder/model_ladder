APP_JS = r"""
(function () {
  "use strict";
  const M = window.ladderMath;
  const { linearTicks, logTicks } = window.ladderCore;
  const { h, render } = window.preact;
  const { useState, useEffect, useLayoutEffect, useMemo, useRef } = window.preactHooks;
  const html = window.htm.bind(h);

  const DATA = JSON.parse(document.getElementById("payload").textContent);
  let SRC, ALL_ROWS, RUNGS, KNOWN_FAMILIES;
  const ORDER = DATA.rung_order;
  const views = {};
  function viewFor(key, axis) {
    const cacheKey = SRC.key + ":" + key + ":" + axis;
    if (!views[cacheKey]) {
      const rows = M.rowsForIndex(ALL_ROWS, key, axis), families = M.families(rows), familyByKey = {};
      families.forEach((f) => { familyByKey[f.key] = f; });
      views[cacheKey] = { rows, families, familyByKey, allKeys: families.map((f) => f.key),
        makers: Array.from(new Set(rows.map((r) => r.maker))).sort(), attention: rows.filter((r) => r.problem) };
    }
    return views[cacheKey];
  }
  const LIMIT = 8;
  const STORAGE_KEY = "model_ladder.state";
  const MINUS = "−";
  const STEP_KEYS = ["up.points", "up.cost", "up.perPoint", "down.points", "down.cost", "down.perPoint"];
  const SORT_KEYS = {
    all: ["maker", "family", "effort", "tagText", "score", "cost", "release_date", "status"],
    steps: ["family", "effort", "score", "cost"].concat(STEP_KEYS),
    pareto: ["label", "score", "cost", "status"].concat(STEP_KEYS),
  };
  const DESC_FIRST = { effort: true, score: true };
  const DEFAULT_SORTS = { all: { key: "score", dir: "desc" }, steps: null, pareto: { key: "score", dir: "desc" } };
  const PROBLEM_TEXT = {
    "two effort words": "has two effort words",
    "more than one group": "has more than one group in parentheses",
    "duplicate rung": "shares its creator, family and effort level with another model",
  };

  // ---- state: hash first, then storage, then defaults ----
  function sourceDefaults(src) {
    const rungs = M.presentRungs(src.rows, ORDER);
    return { index: src.indexes[0]?.key || null, axis: src.default_axis, keys: [], hi: rungs[0] || null, lo: rungs[rungs.length - 1] || null, sorts: {}, start: null };
  }
  function defaults() { return {view: "all", mode: "whole", source: DATA.default_source, per: {[DATA.default_source]: sourceDefaults(DATA.sources[DATA.default_source])}}; }
  function clean(raw) {
    if (!raw || typeof raw !== "object" || Array.isArray(raw)) return null;
    const s = defaults();
    if (raw.view === "all" || raw.view === "compare") s.view = raw.view;
    if (raw.mode === "whole" || raw.mode === "decimal") s.mode = raw.mode;
    const legacy = !raw.per && ["index", "keys", "hi", "lo", "sorts"].some((k) => k in raw);
    const per = legacy ? {aa: raw} : raw.per || {};
    if (!legacy && typeof raw.source === "string" && Object.keys(DATA.sources).includes(raw.source)) s.source = raw.source;
    Object.keys(DATA.sources).forEach((key) => {
      const src = DATA.sources[key], value = per[key];
      if (!value || typeof value !== "object" || Array.isArray(value)) return;
      const p = sourceDefaults(src), rungs = M.presentRungs(src.rows, ORDER);
      if (src.indexes.some((i) => i.key === value.index)) p.index = value.index;
      if (src.axes.some((a) => a.key === value.axis)) p.axis = value.axis;
      if (Array.isArray(value.keys)) p.keys = value.keys.filter((k, i) => typeof k === "string" && value.keys.indexOf(k) === i).slice(0, LIMIT);
      if (rungs.includes(value.hi)) p.hi = value.hi;
      if (rungs.includes(value.lo)) p.lo = value.lo;
      if (rungs.indexOf(p.hi) > rungs.indexOf(p.lo)) { p.hi = rungs[0] || null; p.lo = rungs[rungs.length - 1] || null; }
      if (value.sorts && typeof value.sorts === "object" && !Array.isArray(value.sorts)) Object.keys(SORT_KEYS).forEach((table) => {
        const v = value.sorts[table], allowed = SORT_KEYS[table].concat(table === "all" ? src.extras.map((c) => c.path) : []);
        if (v && allowed.includes(v.key) && (v.dir === "asc" || v.dir === "desc")) p.sorts[table] = {key: v.key, dir: v.dir};
      });
      if (typeof value.start === "string") p.start = value.start;
      s.per[key] = p;
    });
    return s;
  }
  function parse(text) {
    try { return clean(JSON.parse(text)); } catch (e) { return null; }
  }
  function readHash() {
    const raw = location.hash.slice(1);
    if (!raw) return null;
    try { return parse(decodeURIComponent(raw)); } catch (e) { return null; }
  }
  function readStorage() {
    try {
      const text = localStorage.getItem(STORAGE_KEY);
      return text ? parse(text) : null;
    } catch (e) { return null; }
  }
  function initialState() { return readHash() || readStorage() || defaults(); }
  function saveState(state) {
    const text = JSON.stringify(state);
    try { history.replaceState(null, "", "#" + encodeURIComponent(text)); } catch (e) { /* the URL stays as it is */ }
    try { localStorage.setItem(STORAGE_KEY, text); } catch (e) { /* storage is optional */ }
  }

  // ---- presentation helpers ----
  function effortValue(row) { return row.rank === null || row.rank === undefined ? null : ORDER.length - row.rank; }
  function colorOf(keys, key) { return "var(--s" + (keys.indexOf(key) + 1) + ")"; }
  function when(iso, withTime) {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return String(iso);
    return withTime ? d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" })
      : d.toLocaleDateString(undefined, { dateStyle: "medium" });
  }
  function scoreText(raw, mode) { return mode === "decimal" ? raw.toFixed(1) : String(M.wholePoints(raw)); }
  function signedPoints(v, mode) {
    if (v === null || v === undefined) return "";
    if (v === 0) return mode === "decimal" ? "0.0" : "0";
    return (v > 0 ? "+" : MINUS) + M.showPoints(v, mode);
  }
  const QUANTITY = {money: "cost", time: "time", tokens: "output tokens"};
  function signedAxis(v, axis) {
    if (v === null || v === undefined) return "";
    return (v > 0 ? "+" : v < 0 ? MINUS : "") + M.formatAxis(Math.abs(v), axis.unit);
  }
  function missingName(key) {
    try {
      const parts = JSON.parse(key);
      if (Array.isArray(parts) && typeof parts[1] === "string") return parts[1];
    } catch (e) { /* fall through */ }
    return key;
  }
  function ordered(rows, table, sorts) {
    const cur = sorts[table] || DEFAULT_SORTS[table];
    return cur ? M.sortRows(rows, cur.key, cur.dir) : rows;
  }

  function Dot({ color }) { return html`<span class="dot" style=${"background:" + color}></span>`; }

  function ScoreCell({ row, mode }) {
    return html`<td data-c="score" data-v=${row.score}><span class="num">${scoreText(row.index, mode)}</span>${
      mode === "whole" ? html`<span class="raw">${row.index.toFixed(1)}</span>` : null}</td>`;
  }
  function CostCell({ row, borrowed, axis }) {
    return html`<td data-c="cost" class=${borrowed ? "borrowed" : ""}>${M.formatAxis(row.cost, axis.unit)}</td>`;
  }

  function Th({ table, k, label, sorts, onSort, cls }) {
    const cur = sorts[table] || DEFAULT_SORTS[table];
    const active = !!cur && cur.key === k;
    const aria = active ? (cur.dir === "desc" ? "descending" : "ascending") : "none";
    const onKey = (e) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onSort(table, k); }
    };
    return html`<th class=${cls || ""} data-k=${k} tabindex="0" aria-sort=${aria}
      onClick=${() => onSort(table, k)} onKeyDown=${onKey}>${label}${active ? (cur.dir === "desc" ? " ▼" : " ▲") : ""}</th>`;
  }

  function StepCells({ step, mode, kind, borrowed, axis }) {
    const base = kind + ".";
    if (!step) {
      return ["points", "cost", "perPoint"].map((f, i) => html`<td class=${"step" + (i === 0 ? " b" : borrowed ? " borrowed" : "")} data-c=${base + f}></td>`);
    }
    const note = step.note === "costs no more" && axis.unit !== "money" ? (axis.unit === "time" ? "takes no more time" : "uses no more output tokens") : step.note;
    const per = step.perPoint !== null ? M.formatAxis(step.perPoint, axis.unit) : (note || "");
    return [
      html`<td class="step b" data-c=${base + "points"}>${signedPoints(step.points, mode)}</td>`,
      html`<td class=${"step" + (borrowed ? " borrowed" : "")} data-c=${base + "cost"}>${signedAxis(step.cost, axis)}</td>`,
      html`<td class=${"step" + (step.note ? " note" : "") + (borrowed ? " borrowed" : "")} data-c=${base + "perPoint"}>${per}</td>`,
    ];
  }

  function StepHeads({ table, sorts, onSort, axis }) {
    const p = { table, sorts, onSort };
    const quantity = QUANTITY[axis.unit].charAt(0).toUpperCase() + QUANTITY[axis.unit].slice(1);
    return [
      html`<${Th} ...${p} k="up.points" label="Points" cls="b" />`,
      html`<${Th} ...${p} k="up.cost" label=${quantity} />`,
      html`<${Th} ...${p} k="up.perPoint" label=${quantity + " per point"} />`,
      html`<${Th} ...${p} k="down.points" label="Points" cls="b" />`,
      html`<${Th} ...${p} k="down.cost" label=${quantity} />`,
      html`<${Th} ...${p} k="down.perPoint" label="Saved per point" />`,
    ];
  }

  // ---- charts (inline SVG) ----
  const W = 560, H = 300, PAD = { l: 44, r: 18, t: 14, b: 44 };
  function scoreRange(scores) {
    const lo = Math.min.apply(null, scores), hi = Math.max.apply(null, scores);
    return [Math.floor(lo) - 2, Math.ceil(hi) + 2];
  }
  function yScale(lo, hi) { return (s) => H - PAD.b - (s - lo) / (hi - lo) * (H - PAD.t - PAD.b); }
  function YAxis({ lo, hi, y }) {
    return linearTicks(lo, hi).map((v) => html`<g key=${"y" + v}>
      <line class="grid" x1=${PAD.l} x2=${W - PAD.r} y1=${y(v)} y2=${y(v)} />
      <text x=${PAD.l - 6} y=${y(v) + 4} text-anchor="end">${v}</text></g>`);
  }

  function Scatter({ rows, front, color, title, borrowed, axis }) {
    const costs = rows.map((r) => r.cost);
    let lo = Math.min.apply(null, costs), hi = Math.max.apply(null, costs);
    if (lo === hi) { lo /= 2; hi *= 2; } else { lo /= 1.3; hi *= 1.3; }
    const [ylo, yhi] = scoreRange(rows.map((r) => r.score));
    const x = (c) => PAD.l + (Math.log(c) - Math.log(lo)) / (Math.log(hi) - Math.log(lo)) * (W - PAD.l - PAD.r);
    const y = yScale(ylo, yhi);
    const onFront = new Set(front.map((r) => r.slug));
    let d = "";
    front.forEach((r, i) => {
      d += i === 0 ? "M" + x(r.cost) + "," + y(r.score) : " H" + x(r.cost) + " V" + y(r.score);
    });
    return html`<svg viewBox=${"0 0 " + W + " " + H} role="img" aria-label=${title}>
      <${YAxis} lo=${ylo} hi=${yhi} y=${y} />
      ${logTicks(lo, hi).map((v) => html`<g key=${"x" + v}>
        <line class="grid" x1=${x(v)} x2=${x(v)} y1=${PAD.t} y2=${H - PAD.b} />
        <text x=${x(v)} y=${H - PAD.b + 16} text-anchor="middle">${axis.unit === "money" ? "$" + v : M.formatAxis(v, axis.unit)}</text></g>`)}
      <text x=${(PAD.l + W - PAD.r) / 2} y=${H - 6} text-anchor="middle">${(borrowed ? "Overall " + M.lowerFirst(axis.label) : axis.label) + ", log scale"}</text>
      ${d ? html`<path class=${borrowed ? "stair borrowed" : "stair"} d=${d} />` : null}
      ${rows.map((r) => {
        const c = color(r);
        const filled = onFront.has(r.slug);
        return html`<circle key=${r.slug} cx=${x(r.cost)} cy=${y(r.score)} r="4.5"
          fill=${filled ? c : "var(--panel)"} stroke=${c} stroke-width="1.8">
          <title>${r.label + ": " + scoreText(r.index, "decimal") + ", " + M.formatAxis(r.cost, axis.unit) + (borrowed ? " overall" : "")}</title></circle>`;
      })}
    </svg>`;
  }

  function LadderChart({ rungs, fams, cell, keys, mode, indexLabel }) {
    const asc = rungs.slice().reverse();
    const scores = [];
    fams.forEach((k) => asc.forEach((r) => { const c = cell(k, r); if (c) scores.push(c.score); }));
    const [ylo, yhi] = scoreRange(scores);
    const y = yScale(ylo, yhi);
    const span = W - PAD.l - PAD.r - 30;
    const x = (i) => PAD.l + 15 + (asc.length === 1 ? span / 2 : i * span / (asc.length - 1));
    return html`<svg viewBox=${"0 0 " + W + " " + H} role="img" aria-label=${indexLabel + " by effort level"}>
      <${YAxis} lo=${ylo} hi=${yhi} y=${y} />
      ${asc.map((r, i) => html`<text key=${r} x=${x(i)} y=${H - PAD.b + 16} text-anchor="middle">${M.rungLabel(r)}</text>`)}
      ${fams.map((k) => {
        const pts = [];
        asc.forEach((r, i) => { const c = cell(k, r); if (c) pts.push({ x: x(i), y: y(c.score), row: c }); });
        const color = colorOf(keys, k);
        return html`<g key=${k}>
          <polyline fill="none" stroke=${color} stroke-width="2" points=${pts.map((p) => p.x + "," + p.y).join(" ")} />
          ${pts.map((p) => html`<circle key=${p.row.slug} cx=${p.x} cy=${p.y} r="4" fill=${color}>
            <title>${p.row.label + ": " + scoreText(p.row.index, mode)}</title></circle>`)}
        </g>`;
      })}
    </svg>`;
  }

  // ---- header pieces ----
  function Status({ view }) {
    const [now, setNow] = useState(Date.now());
    const [copied, setCopied] = useState(null);
    useEffect(() => {
      const timer = setInterval(() => setNow(Date.now()), 60000);
      return () => clearInterval(timer);
    }, []);
    const age = M.dataAge(SRC.last_checked, now, SRC.max_age_hours);
    const rl = SRC.rate_limit || {};
    const COMMAND = "model_ladder refresh --source " + SRC.key;
    const copy = () => {
      let pending;
      try { pending = navigator.clipboard.writeText(COMMAND); } catch (e) { pending = Promise.reject(e); }
      Promise.resolve(pending).then(() => {
        setCopied("done");
        setTimeout(() => setCopied((c) => (c === "done" ? null : c)), 2500);
      }, () => setCopied("failed"));
    };
    const reset = rl.reset ? new Date(rl.reset * 1000) : null;
    return html`<div class="status">
      <span id="status-age" class=${age.stale ? "age stale" : "age"}>${age.text}</span>
      <span>Fetched <b>${when(SRC.fetched_at, true)}</b></span>
      <span>${SRC.version_label}</span>
      ${SRC.published && SRC.published.note ? html`<span>${SRC.published.note}</span>` : null}
      <span><b>${view.rows.length}</b>${view.rows.length !== ALL_ROWS.length ? html` of <b>${ALL_ROWS.length}</b>` : null} scored models</span>
      <span id="status-attention"><b>${view.attention.length}</b>${view.attention.length === 1 ? " needs" : " need"} attention</span>
      ${SRC.has_quota ? html`<span id="status-quota">${rl.remaining !== null && rl.remaining !== undefined && rl.limit !== null && rl.limit !== undefined
        ? html`<b>${rl.remaining}</b> of ${rl.limit} requests left at the last fetch${reset && !isNaN(reset.getTime()) ? ", resets " + when(reset.toISOString(), true) : ""}`
        : "Request quota unknown"}</span>` : null}
      <button id="copy-refresh" type="button" onClick=${copy}>${copied === "done" ? "Copied" : "Copy refresh command"}</button>
      ${copied === "failed" ? html`<span>Copy this command: <code class="cmd">${COMMAND}</code></span>` : null}
    </div>`;
  }

  function Attention({ view }) {
    if (!view.attention.length) return null;
    return html`<section id="needs-attention" class="box attention">
      <h2>Needs attention</h2>
      <p class="note">These names do not fit the name rule. They are listed in the all-models table under their full name and left out of effort ladders.</p>
      <ul>${view.attention.map((r) => html`<li key=${r.slug}><b>${r.name}</b> ${PROBLEM_TEXT[r.problem] || r.problem}</li>`)}</ul>
    </section>`;
  }

  function Changes({ mode, index, axis }) {
    const c = SRC.changes;
    if (!c) return null;
    const shown = M.changesToShow(c, mode, index, axis, SRC.extras);
    const maximum = (c.maxima || {})[index];
    const empty = !c.version && !maximum && !c.added.length && !c.removed.length && !shown.length;
    const describe = (item) => {
      const parts = [];
      const a = item.scores[index][0] === null ? "no score" : scoreText(item.scores[index][0], mode);
      const b = item.scores[index][1] === null ? "no score" : scoreText(item.scores[index][1], mode);
      parts.push(a === b ? "score " + a : "score " + a + " to " + b);
      const pair = item.axes[axis.key] || [null, null], quantity = QUANTITY[axis.unit];
      const ca = M.formatAxis(pair[0], axis.unit) || "no " + quantity, cb = M.formatAxis(pair[1], axis.unit) || "no " + quantity;
      parts.push(ca === cb ? quantity + " " + ca : quantity + " " + ca + " to " + cb);
      SRC.extras.filter((col) => col.kind !== "date").forEach((col) => {
        const values = (item.extras || {})[col.path];
        if (!values) return;
        const a = M.formatExtra(values[0], col.kind), b = M.formatExtra(values[1], col.kind);
