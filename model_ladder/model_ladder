KEEP = 60
SCHEMA = 1
SNAPSHOT_DIR = "snapshots"
SNAPSHOT_SUFFIX = ".json.gz"


class StoreError(Exception):
    """A snapshot could not be read; the message names the file and the reason."""


def _utc(moment: datetime) -> datetime:
    """An aware UTC datetime; a naive one is taken to be UTC already."""
    if moment.tzinfo is None:
        return moment.replace(tzinfo=timezone.utc)
    return moment.astimezone(timezone.utc)


def _write_snapshot(path: Path, data: dict) -> None:
    atomic_write_bytes(path, gzip.compress(json.dumps(data).encode("utf-8")))


def snapshot_dir(home: Path, source: str = "aa") -> Path:
    root = ensure_runtime_home(home / SNAPSHOT_DIR)
    return root if source == "aa" else ensure_runtime_home(root / source)


def load_snapshots(home: Path, source: str = "aa") -> list[Path]:
    """Snapshot files, newest first by file name."""
    root = home / SNAPSHOT_DIR
    return sorted((root if source == "aa" else root / source).glob("*" + SNAPSHOT_SUFFIX), key=lambda p: p.name, reverse=True)


def read_snapshot(path: Path, source: str = "aa") -> dict:
    try:
        with gzip.open(path, "rb") as stream:
            data = json.loads(stream.read().decode("utf-8"))
    except (OSError, EOFError, ValueError, zlib.error) as error:
        raise StoreError(f"cannot read {path}: {error or type(error).__name__}") from None
    if not isinstance(data, dict) or data.get("schema") != SCHEMA:
        raise StoreError(f"cannot read {path}: not a version {SCHEMA} snapshot")
    if not isinstance(data.get("models"), list):
        raise StoreError(f"cannot read {path}: missing the models list")
    if source == "fc":
        if not isinstance(data.get("index_version"), str) or not re.fullmatch(r"\d+(?:\.\d+)+", data["index_version"]):
            raise StoreError(f"cannot read {path}: missing the dotted index_version")
    elif not _is_number(data.get("index_version")):
        raise StoreError(f"cannot read {path}: missing the numeric index_version")
    for field in ("fetched_at", "last_checked"):
        try:
            datetime.fromisoformat(data[field])
        except (KeyError, TypeError, ValueError):
            raise StoreError(f"cannot read {path}: bad {field}") from None
    return data


def save_snapshot(home: Path, result: dict, now: datetime, source: str = "aa") -> Path:
    """Store a fetch. An unchanged one only refreshes the newest file's last_checked."""
    moment = _utc(now).replace(microsecond=0)
    directory = snapshot_dir(home, source)
    existing = load_snapshots(home, source)
    if existing:
        newest = read_snapshot(existing[0], source)
        if result.get("not_modified") or (newest["models"] == result["models"] and newest["index_version"] == result["index_version"] and newest.get("index_maxima") == result.get("index_maxima")):
            newest["last_checked"] = moment.isoformat()
            for key in ("rate_limit", "published", "etag", "current_version"):
                if key in result:
                    newest[key] = result[key]
            _write_snapshot(existing[0], newest)
            return existing[0]
    if result.get("not_modified"):
        raise StoreError("not modified, but there is no snapshot to keep")
    path = directory / (moment.strftime("%Y%m%dT%H%M%SZ") + SNAPSHOT_SUFFIX)
    _write_snapshot(path, {
        "schema": SCHEMA,
        "fetched_at": moment.isoformat(),
        "last_checked": moment.isoformat(),
        "index_version": result["index_version"],
        "rate_limit": result["rate_limit"],
        "models": result["models"],
        **{key: result[key] for key in ("index_maxima", "published", "etag", "current_version") if key in result},
    })
    for old in load_snapshots(home, source)[KEEP:]:
        old.unlink()
    return path


def read_status(home: Path) -> dict:
    path = home / "status.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("not an object")
        for source, entry in data.items():
            if (not isinstance(entry, dict) or not isinstance(entry.get("last_attempt"), str)
                    or "error" not in entry or not isinstance(entry["error"], (str, type(None)))):
                raise ValueError(f"invalid status for {source}")
            try:
                datetime.fromisoformat(entry["last_attempt"])
            except ValueError:
                raise ValueError(f"invalid status for {source}") from None
        return data
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        _complain(f"cannot read {path}: {error}")
        return {}


def write_status(home: Path, source: str, attempt: datetime, error: str | None) -> None:
    ensure_runtime_home(home)
    status = read_status(home)
    status[source] = {"last_attempt": _utc(attempt).isoformat(), "error": error}
    atomic_write_bytes(home / "status.json", (json.dumps(status, indent=2) + "\n").encode())


