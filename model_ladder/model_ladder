"""


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def testing_mode_enabled() -> bool:
    return os.environ.get("UTILITIES_TESTING", "").lower() not in {"", "0", "false", "no"}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="model_ladder",
        description="Compare model effort levels by Intelligence Index and cost per task.",
        epilog="Runtime home: ~/.model_ladder/ (override with MODEL_LADDER_HOME).",
    )
    parser.add_argument("command", nargs="?", choices=("refresh", "build"),
                        help="refresh: always fetch first; build: never fetch")
    parser.add_argument("--no-refresh", action="store_true", help="never fetch, even if the data is old")
    parser.add_argument("--no-open", action="store_true", help="do not open the page in a browser")
    parser.add_argument("--output", type=Path, help="write the page here instead of the runtime home")
    parser.add_argument("--version", action="version", version=f"Model Ladder {VERSION}")
    return parser


def _quota_line(result: dict) -> str:
    models = result["models"]
    scored = len(classify(models))
    text = f"Fetched {len(models)} models ({scored} scored)."
    limits = result.get("rate_limit") or {}
    if limits.get("remaining") is not None and limits.get("limit") is not None:
        text += f" {limits['remaining']} of {limits['limit']} requests left today"
        reset = _local_time(limits.get("reset"), "%H:%M")
        text += f"; resets {reset}." if reset else "."
    return text


def _is_stale(snapshot: dict, config: dict, now: datetime) -> bool:
    checked = _utc(datetime.fromisoformat(snapshot["last_checked"]))
    return _utc(now) - checked > timedelta(hours=config["max_age_hours"])


def _complain(message: str) -> None:
    print(f"Model Ladder: {message}", file=sys.stderr)


def main(argv: list[str] | None = None, *, now: datetime | None = None, fetch=fetch_all,
         get_key=get_api_key, open_page=webbrowser.open) -> int:
    args = build_parser().parse_args(argv)
    now = now or datetime.now(timezone.utc)
    try:
        config = load_config()
    except ValueError as error:
        _complain(str(error))
        return 1
    home = runtime_home()
    try:
        paths = load_snapshots(home)
        newest = read_snapshot(paths[0]) if paths else None
    except StoreError as error:
        _complain(str(error))
        return 1

    if args.command == "build" or args.no_refresh:
        should_fetch = False
    elif args.command == "refresh" or newest is None:
        should_fetch = True
    else:
        should_fetch = _is_stale(newest, config, now)

    if should_fetch:
        try:
            result = fetch(get_key(config))
            save_snapshot(home, result, now)
            print(_quota_line(result))
        except (KeyUnavailable, FetchError, StoreError) as error:
            _complain(str(error))
            if newest is None:
                return 1
        except OSError as error:
            _complain(f"cannot save snapshot: {error}")
            if newest is None:
                return 1
    elif newest is None:
        _complain("no snapshot yet; run model_ladder refresh to fetch one")
        return 1

    output = args.output.expanduser() if args.output else home / "model_ladder.html"
    try:
        build_page(home, output)
    except (OSError, StoreError) as error:
        _complain(f"cannot build the page: {error}")
        return 1
    print(output)
    if not args.no_open and not testing_mode_enabled():
        try:
            open_page(output.resolve().as_uri())
        except Exception:
            _complain("could not open a browser; open the page manually")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
