CONFIG_FILENAME = "config.json"
DEFAULT_CONFIG = {"op_item": "", "op_vault": "", "op_field": "credential", "max_age_hours": 12,
                  "source_max_age_hours": {"aicd": 24, "fc": 24}}
MAX_AGE_LIMIT = 87600  # ten years in hours; larger values overflow date arithmetic


def runtime_home() -> Path:
    override = os.environ.get("MODEL_LADDER_HOME")
    return Path(override).expanduser() if override else Path.home() / ".model_ladder"


def ensure_runtime_home(path: Path) -> Path:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Publish a complete same-directory private file, preserving the old file on failure."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


def load_config() -> dict:
    """Read config.json, creating it with defaults on first use."""
    home = ensure_runtime_home(runtime_home())
    path = home / CONFIG_FILENAME
    if not path.exists():
        atomic_write_bytes(path, (json.dumps(DEFAULT_CONFIG, indent=2) + "\n").encode("utf-8"))
        return dict(DEFAULT_CONFIG)
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError(f"{path} is not valid JSON: {error}") from error
    if not isinstance(loaded, dict):
        raise ValueError(f"{path} must contain a JSON object")
    config = {**DEFAULT_CONFIG, **loaded}
    ages = loaded.get("source_max_age_hours", {})
    if not isinstance(ages, dict):
        raise ValueError(f"{path}: source_max_age_hours must be an object")
    config["source_max_age_hours"] = {**DEFAULT_CONFIG["source_max_age_hours"], **ages}
    for key in ("op_item", "op_vault", "op_field"):
        if not isinstance(config[key], str):
            raise ValueError(f"{path}: {key} must be a string")
    age = config["max_age_hours"]
    if isinstance(age, bool) or not isinstance(age, (int, float)) or not 0 < age <= MAX_AGE_LIMIT:
        raise ValueError(f"{path}: max_age_hours must be a positive number of at most {MAX_AGE_LIMIT}")
    for key, age in config["source_max_age_hours"].items():
        if isinstance(age, bool) or not isinstance(age, (int, float)) or not 0 < age <= MAX_AGE_LIMIT:
            raise ValueError(f"{path}: source_max_age_hours.{key} must be a positive number of at most {MAX_AGE_LIMIT}")
    return config


def source_max_age(config: dict, key: str) -> float:
    return config["max_age_hours"] if key == "aa" else config.get("source_max_age_hours", {}).get(key, DEFAULT_CONFIG["source_max_age_hours"][key])


