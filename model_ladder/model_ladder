def _row_path(row: dict, path: str):
    value = row
    for part in path.split("."):
        if not isinstance(value, dict):
            return None
        value = value.get(part)
    return value


def diff_rows(old: dict | None, new: dict, source: str = "aa") -> dict | None:
    """What changed between two snapshots, by slug. Raw values, no rounding."""
    if old is None:
        return None
    spec = SOURCE_SPECS[source]
    before = {row["slug"]: row for row in spec["classify"](old["models"])}
    after = {row["slug"]: row for row in spec["classify"](new["models"])}
    changed = []
    for slug, row in after.items():
        prior = before.get(slug)
        extras = {item["path"]: [_row_path(prior, item["path"]), _row_path(row, item["path"])]
                  for item in spec["extras"] if prior and item["path"] != "tested" and item["path"] != "extras.tested"}
        extras = {key: pair for key, pair in extras.items() if pair[0] != pair[1]}
        if prior and (prior["scores"] != row["scores"] or prior["axes"] != row["axes"] or extras):
            changed.append({"slug": slug, "name": row["name"],
                            "scores": {item["key"]: [prior["scores"].get(item["key"]), row["scores"].get(item["key"])] for item in spec["indexes"]},
                            "axes": {item["key"]: [prior["axes"].get(item["key"]), row["axes"].get(item["key"])] for item in spec["axes"]},
                            "extras": extras})
    old_max, new_max = old.get("index_maxima", {}), new.get("index_maxima", {})
    return {
        "source": source,
        "from": old["fetched_at"],
        "to": new["fetched_at"],
        "version": None if old["index_version"] == new["index_version"]
        else [old["index_version"], new["index_version"]],
        "added": [row["name"] for slug, row in after.items() if slug not in before],
        "removed": [row["name"] for slug, row in before.items() if slug not in after],
        "changed": changed,
        "maxima": {key: [old_max.get(key), new_max.get(key)] for key in old_max.keys() | new_max.keys() if old_max.get(key) != new_max.get(key)},
    }


