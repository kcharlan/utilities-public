        ${c.removed.length ? html`<div data-changes="removed"><h3>Removed (${c.removed.length})</h3><ul>${c.removed.map((n, i) => html`<li key=${i}>${n}</li>`)}</ul></div>` : null}
        ${shown.length ? html`<div><h3>Score or ${QUANTITY[axis.unit]}${SRC.extras.length ? " or extras" : ""} changed (${shown.length})</h3><ul>${shown.map((item) => html`<li key=${item.slug}>${item.name}: ${describe(item)}</li>`)}</ul></div>` : null}
        ${empty ? html`<p class="note">Nothing changed that shows in ${mode === "whole" ? "whole points" : "decimals"}.</p>` : null}
      </div>
    </details>`;
  }

  // ---- all models view ----
  function AllView({ state, onSort, toggleKey, view, borrowed, indexLabel, axis }) {
    const [creator, setCreator] = useState("");
    const [query, setQuery] = useState("");
    useEffect(() => { if (creator && !view.makers.includes(creator)) setCreator(""); }, [view, creator]);
    const rows = useMemo(() => {
      const sel = M.selectRows(view.rows, { keys: view.allKeys, hi: null, lo: null, rungOrder: ORDER, mode: state.mode });
      const status = {};
      M.paretoRows(sel).forEach((r) => { status[r.slug] = r.status; });
      return sel.map((r) => Object.assign(r, {
        effort: effortValue(r), tagText: r.tags.length ? r.tags.join(", ") : null, status: status[r.slug] || null,
      }));
    }, [state.mode, state.index, state.axis, SRC.key]);
    const front = useMemo(() => M.frontier(rows), [rows]);
    const visible = ordered(M.searchRows(rows, query).filter((r) => !creator || r.maker === creator), "all", state.sorts);
    const priced = rows.filter((r) => r.status);
    const full = state.keys.length >= LIMIT;
    const p = { table: "all", sorts: state.sorts, onSort };
    const label = borrowed ? "Overall " + M.lowerFirst(axis.label) : axis.label, quantity = QUANTITY[axis.unit];
    return html`<div class="view">
      <section>
        <h2>Every scored model</h2>
        <p class="note">Each point is one model variant with a ${M.lowerFirst(axis.label)}. The green staircase is the frontier: nothing scores at least as high for less.</p>
        ${priced.length ? html`<div class="box chart solo"><${Scatter} rows=${priced} front=${front} title=${indexLabel + " against " + M.lowerFirst(label)} borrowed=${borrowed} axis=${axis}
          color=${(r) => (r.status === "frontier" ? "var(--front)" : "var(--muted)")} /></div>` : html`<p class="empty">No scored model has a ${M.lowerFirst(axis.label)}.</p>`}
      </section>
      <section>
        <div class="filters">
          <select id="all-creator" aria-label=${SRC.group_label} value=${creator} onChange=${(e) => setCreator(e.currentTarget.value)}>
            <option value="">All ${M.lowerFirst(SRC.group_label)}${SRC.group_label.endsWith("s") ? "es" : "s"}</option>
            ${view.makers.map((m) => html`<option key=${m} value=${m}>${m}</option>`)}
          </select>
          <input id="all-filter" type="search" placeholder="Filter by name or creator" aria-label="Filter by name or creator"
            value=${query} onInput=${(e) => setQuery(e.currentTarget.value)} />
          <span class="note">${visible.length} of ${rows.length} shown. Tick a model to compare it.</span>
        </div>
        <div class="box scroll"><table id="all-table">
          <thead><tr>
            <th class="l">Compare</th>
            <${Th} ...${p} k="maker" label=${SRC.group_label} cls="l" />
            <${Th} ...${p} k="family" label="Model" cls="l" />
            <${Th} ...${p} k="effort" label="Effort" cls="l" />
            <${Th} ...${p} k="tagText" label="Tags" cls="l" />
            <${Th} ...${p} k="score" label="Index" />
            ${SRC.extras.map((col) => html`<${Th} ...${p} k=${col.path} label=${col.label} />`)}
            <${Th} ...${p} k="cost" label=${label} />
            <${Th} ...${p} k="release_date" label="Released" />
            <${Th} ...${p} k="status" label="Frontier" cls="l" />
          </tr></thead>
          <tbody>${visible.map((r) => {
            const on = state.keys.indexOf(r.family_key) !== -1;
            return html`<tr key=${r.slug} class=${r.status === "dominated" ? "dom" : ""}>
              <td><input type="checkbox" checked=${on} disabled=${!on && full} aria-label=${"Compare " + r.family}
                onChange=${() => toggleKey(r.family_key)} /></td>
              <td class="l" data-c="maker">${r.maker}</td>
              <td class="l" data-c="family">${r.family}</td>
              <td class="l" data-c="effort">${r.problem ? "Unclassified" : (r.rung ? M.rungLabel(r.rung) : "")}</td>
              <td class="l" data-c="tags">${r.tagText || ""}</td>
              <${ScoreCell} row=${r} mode=${state.mode} />
              ${SRC.extras.map((col) => html`<td data-c=${col.path}>${M.formatExtra(window.ladderCore.pathValue(r, col.path), col.kind)}</td>`)}
              <${CostCell} row=${r} borrowed=${borrowed} axis=${axis} />
              <td data-c="release_date">${r.release_date ? M.dayText(r.release_date) : ""}</td>
              <td class="l" data-c="status">${r.status === "frontier" ? html`<span class="pill f">Frontier</span>`
                : r.status === "dominated" ? html`<span class="pill d">Dominated</span>` : html`<span class="pill n">No ${quantity}</span>`}</td>
            </tr>`;
          })}</tbody>
        </table></div>
      </section>
    </div>`;
  }

  // ---- compare view ----
  function Picker({ keys, onAdd, view }) {
    const [open, setOpen] = useState(false);
    const [query, setQuery] = useState("");
    const [active, setActive] = useState(0);
    const wrap = useRef(null), button = useRef(null), input = useRef(null);
    const full = keys.length >= LIMIT;
    const list = M.searchFamilies(view.families, query);
    const choosable = list.filter((f) => keys.indexOf(f.key) === -1);
    const current = choosable[Math.min(active, choosable.length - 1)];
    useEffect(() => { if (open && input.current) input.current.focus(); }, [open]);
    useEffect(() => { if (full) setOpen(false); }, [full]);
    useEffect(() => {
      if (!open) return undefined;
      const away = (e) => { if (wrap.current && !wrap.current.contains(e.target)) setOpen(false); };
      document.addEventListener("mousedown", away);
      return () => document.removeEventListener("mousedown", away);
    }, [open]);
    const close = () => { setOpen(false); if (button.current) button.current.focus(); };
    const pick = (f) => { if (f) { onAdd(f.key); setActive(0); } };
    const onKey = (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); setActive((a) => Math.min(a + 1, Math.max(choosable.length - 1, 0))); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive((a) => Math.max(a - 1, 0)); }
      else if (e.key === "Enter") { e.preventDefault(); pick(current); }
      else if (e.key === "Escape") { e.preventDefault(); close(); }
    };
    return html`<div class="picker" ref=${wrap}>
      <button id="add-model" type="button" ref=${button} disabled=${full} aria-expanded=${String(open)}
        onClick=${() => setOpen(!open)}>${full ? "Limit of " + LIMIT + " reached" : "Add model"}</button>
      ${open ? html`<div class="pop">
        <input id="model-search" type="search" ref=${input} placeholder="Search models or creators" aria-label="Search models or creators"
          autocomplete="off" spellcheck="false" value=${query}
          onInput=${(e) => { setQuery(e.currentTarget.value); setActive(0); }} onKeyDown=${onKey} />
        <ul id="model-list">${list.map((f) => {
          const added = keys.indexOf(f.key) !== -1;
          return html`<li key=${f.key}><button type="button" disabled=${added} class=${f === current ? "first" : ""}
            onClick=${() => pick(f)}>
            <span class="fam">${f.family}</span><span class="r">${added ? "Added" : "top " + f.top}</span>
            <small>${f.maker}</small><small class="r">${f.levels + (f.levels === 1 ? " effort level" : " effort levels")}</small>
          </button></li>`;
        })}</ul>
        <p>${list.length ? list.length + " of " + view.families.length + " models. " + keys.length + " of " + LIMIT + " selected."
          : "No model matches that search."}</p>
      </div>` : null}
    </div>`;
  }

  function Controls({ state, update, toggleKey, view, indexShort }) {
    const setHi = (hi) => update((s) => ({ hi, lo: RUNGS.indexOf(hi) > RUNGS.indexOf(s.lo) ? hi : s.lo }));
    const setLo = (lo) => update((s) => ({ lo, hi: RUNGS.indexOf(lo) < RUNGS.indexOf(s.hi) ? lo : s.hi }));
    const options = RUNGS.map((r) => html`<option key=${r} value=${r}>${M.rungLabel(r)}</option>`);
    return html`<div class="controls">
      <div class="row"><div class="group">
        <span class="lab">Models</span>
        <span class="group" id="chips">${state.keys.map((k) => {
          const f = view.familyByKey[k];
          if (!f) {
            const known = KNOWN_FAMILIES[k];
            if (known) return html`<span class="chip unscored" key=${k}><${Dot} color=${colorOf(state.keys, k)} /><span><span class="fam">${known.family}</span> has no ${indexShort} score</span>
              <button type="button" class="x" aria-label=${"Remove " + known.family} onClick=${() => toggleKey(k)}>×</button></span>`;
            const name = missingName(k);
            return html`<span class="chip gone" key=${k}><span class="gone-text"><span class="fam">${name}</span> is no longer listed</span>
              <button type="button" class="x" aria-label=${"Remove " + name} onClick=${() => toggleKey(k)}>×</button></span>`;
          }
          return html`<span class="chip" key=${k}><${Dot} color=${colorOf(state.keys, k)} /><span class="fam">${f.family}</span>
            <span class="mk">${f.maker}</span>
            <button type="button" class="x" aria-label=${"Remove " + f.family} onClick=${() => toggleKey(k)}>×</button></span>`;
        })}</span>
        <${Picker} keys=${state.keys} onAdd=${toggleKey} view=${view} />
      </div></div>
      <div class="row">
        ${RUNGS.length ? html`<div class="group">
          <label class="lab" for="effort-hi">Effort from</label>
          <select id="effort-hi" value=${state.hi} onChange=${(e) => setHi(e.currentTarget.value)}>${options}</select>
          <label class="lab" for="effort-lo">down to</label>
          <select id="effort-lo" value=${state.lo} onChange=${(e) => setLo(e.currentTarget.value)}>${options}</select>
        </div>` : null}
        <div class="group">
          <span class="lab">Scores</span>
          <span class="seg">
            <button id="mode-whole" type="button" aria-pressed=${String(state.mode === "whole")} onClick=${() => update({ mode: "whole" })}>Whole points</button>
            <button id="mode-decimal" type="button" aria-pressed=${String(state.mode === "decimal")} onClick=${() => update({ mode: "decimal" })}>Decimals</button>
          </span>
        </div>
      </div>
    </div>`;
  }

  function CompareView({ state, update, onSort, toggleKey, view, borrowed, indexLabel, indexShort, axis }) {
    const present = state.keys.filter((k) => view.familyByKey[k]);
    const controls = html`<${Controls} state=${state} update=${update} toggleKey=${toggleKey} view=${view} indexShort=${indexShort} />`;
    const missing = M.unscoredRows(ALL_ROWS, state.index, { keys: state.keys, hi: state.hi, lo: state.lo, rungOrder: ORDER, mode: state.mode });
    const labels = [];
    state.keys.forEach((k) => {
      const rows = missing.filter((r) => r.family_key === k);
      if (!rows.length) return;
      if (!view.familyByKey[k] && KNOWN_FAMILIES[k]) labels.push(KNOWN_FAMILIES[k].family + " (all levels)");
      else rows.forEach((r) => labels.push(r.label));
    });
    const note = labels.length ? html`<p id="unscored-note" class="note">Not scored in ${indexLabel}: ${labels.join(", ")}.</p>` : null;
    if (!present.length) {
      const known = state.keys.some((k) => KNOWN_FAMILIES[k]);
      return html`<div class="view">${controls}${note}<p class="empty box">${known ? "None of the selected models has a " + indexShort + " score." : "Add a model to start comparing."}</p></div>`;
    }
    const mode = state.mode;
    const sel = M.selectRows(view.rows, { keys: present, hi: state.hi, lo: state.lo, rungOrder: ORDER, mode });
    const steps = M.familySteps(sel);
    const pareto = M.paretoRows(sel);
    const notes = M.findings(pareto, steps, mode, axis);
    const quantity = QUANTITY[axis.unit], label = borrowed ? "Overall " + M.lowerFirst(axis.label) : axis.label;
    [sel, steps, pareto].forEach((list) => list.forEach((r) => { r.effort = effortValue(r); }));
    const color = (r) => colorOf(state.keys, r.family_key);

    const rungs = M.presentRungs(sel.concat(missing.filter((r) => present.includes(r.family_key))), ORDER);
    const fams = present.filter((k) => sel.concat(missing).some((r) => r.family_key === k && r.rank !== null));
    const cells = {};
    sel.forEach((r) => { if (r.rank !== null) cells[r.family_key + "\n" + r.rung] = r; });
    const cell = (k, rung) => cells[k + "\n" + rung] || null;
    const missingCell = (k, rung) => missing.some((r) => r.family_key === k && r.rung === rung);

    const stepRows = state.sorts.steps ? ordered(steps, "steps", state.sorts)
      : present.reduce((acc, k) => acc.concat(steps.filter((r) => r.family_key === k)), []);
    const paretoRows = ordered(pareto, "pareto", state.sorts);
    const unpriced = sel.length - pareto.length;
    const sp = { table: "steps", sorts: state.sorts, onSort };
    const pp = { table: "pareto", sorts: state.sorts, onSort };
    const groupRow = (lead) => html`<tr class="grp"><th colspan=${lead}></th>
      <th colspan="3" class="b">One step up</th><th colspan="3" class="b">One step down</th></tr>`;

    return html`<div class="view">
      ${controls}
      ${note}
      <section id="ladder">
        <h2>Effort ladder</h2>
        ${fams.length ? html`<div class=${sel.some((r) => r.rank !== null) ? "pair" : ""}>
          ${sel.some((r) => r.rank !== null) ? html`<div class="box chart"><${LadderChart} rungs=${rungs} fams=${fams} cell=${cell} keys=${state.keys} mode=${mode} indexLabel=${indexLabel} /></div>` : null}
          <div class="box scroll"><table id="ladder-table">
            <thead>
              <tr class="grp"><th></th>${fams.map((k) => html`<th key=${k} colspan="2" class="b"><${Dot} color=${colorOf(state.keys, k)} />${view.familyByKey[k].family}</th>`)}</tr>
              <tr><th>Effort</th>${fams.map((k) => [html`<th class="b">Index</th>`, html`<th>${label}</th>`])}</tr>
            </thead>
            <tbody>${rungs.map((rung) => html`<tr key=${rung}><th>${M.rungLabel(rung)}</th>${fams.map((k) => {
              const r = cell(k, rung);
              return r ? [html`<td class="b" data-c="score" data-v=${r.score}><span class="num">${scoreText(r.index, mode)}</span>${
                mode === "whole" ? html`<span class="raw">${r.index.toFixed(1)}</span>` : null}</td>`,
                html`<${CostCell} row=${r} borrowed=${borrowed} axis=${axis} />`]
                : [html`<td class=${missingCell(k, rung) ? "b none" : "b"}>${missingCell(k, rung) ? "No score" : ""}</td>`, html`<td></td>`];
            })}</tr>`)}</tbody>
          </table></div>
        </div>` : html`<p class="empty box">None of the selected models has effort levels in this range.</p>`}
      </section>

      <section id="steps">
        <h2>Steps within each model</h2>
        <p class="note">${axis.unit === "money" ? "What one step of effort costs or saves." : axis.unit === "time" ? "What one step of effort takes or saves in time." : "What one step of effort uses or saves in output tokens."} Steps always follow the effort order, however the table is sorted.</p>
        ${steps.length ? html`<div class="box scroll"><table id="steps-table">
          <thead>${groupRow(4)}<tr>
            <${Th} ...${sp} k="family" label="Model" cls="l" />
            <${Th} ...${sp} k="effort" label="Effort" cls="l" />
            <${Th} ...${sp} k="score" label="Index" />
            <${Th} ...${sp} k="cost" label=${label} />
            <${StepHeads} ...${sp} axis=${axis} />
          </tr></thead>
          <tbody>${stepRows.map((r) => html`<tr key=${r.slug}>
            <td class="l" data-c="family"><${Dot} color=${color(r)} />${r.family}</td>
            <td class="l" data-c="effort">${M.rungLabel(r.rung)}</td>
            <${ScoreCell} row=${r} mode=${mode} />
            <${CostCell} row=${r} borrowed=${borrowed} axis=${axis} />
            <${StepCells} step=${r.up} mode=${mode} kind="up" borrowed=${borrowed} axis=${axis} />
            <${StepCells} step=${r.down} mode=${mode} kind="down" borrowed=${borrowed} axis=${axis} />
          </tr>`)}</tbody>
        </table></div>` : html`<p class="empty box">None of the selected models has effort levels in this range.</p>`}
      </section>

      <section id="pareto">
        <h2>Pareto ladder</h2>
        <p class="note">A row is on the frontier when nothing else in the selection scores at least as high for less. Steps run between neighbouring frontier rows.${
          unpriced && pareto.length ? " " + unpriced + (unpriced === 1 ? " selected row has" : " selected rows have") + " no " + quantity + " and " + (unpriced === 1 ? "is" : "are") + " left out." : ""}</p>
        ${pareto.length ? html`<div class="stack">
          <div class="box chart solo"><${Scatter} rows=${pareto} front=${pareto.filter((r) => r.status === "frontier")} color=${color}
            title=${"Selected rows: " + indexLabel + " against " + M.lowerFirst(label)} borrowed=${borrowed} axis=${axis} /></div>
          <div class="box scroll"><table id="pareto-table">
            <thead>${groupRow(4)}<tr>
              <${Th} ...${pp} k="label" label="Model and effort" cls="l" />
              <${Th} ...${pp} k="score" label="Index" />
              <${Th} ...${pp} k="cost" label=${label} />
              <${Th} ...${pp} k="status" label="Status" cls="l" />
              <${StepHeads} ...${pp} axis=${axis} />
            </tr></thead>
            <tbody>${paretoRows.map((r) => html`<tr key=${r.slug} class=${r.status === "dominated" ? "dom" : ""}>
              <td class="l" data-c="label"><${Dot} color=${color(r)} />${r.label}</td>
              <${ScoreCell} row=${r} mode=${mode} />
              <${CostCell} row=${r} borrowed=${borrowed} axis=${axis} />
              <td class="l" data-c="status">${r.status === "frontier" ? html`<span class="pill f">Frontier</span>` : html`<span class="pill d">Dominated</span>`}</td>
              ${r.status === "frontier"
                ? [html`<${StepCells} step=${r.up} mode=${mode} kind="up" borrowed=${borrowed} axis=${axis} />`, html`<${StepCells} step=${r.down} mode=${mode} kind="down" borrowed=${borrowed} axis=${axis} />`]
                : html`<td colspan="6" class="reason b">${M.dominatedReason(r, mode, axis)}</td>`}
            </tr>`)}</tbody>
          </table></div>
        </div>` : html`<p class="empty box">None of the selected rows has a ${M.lowerFirst(axis.label)}.</p>`}
      </section>

      <section id="say">
        <h2>What the numbers say</h2>
        ${borrowed ? html`<p class="note">${axis.unit === "money" ? "Costs in these sentences are Intelligence Index costs." : "Values in these sentences are overall " + quantity + (axis.unit === "time" ? " per prompt" : "") + ", including " + quantity + " per point."}</p>` : null}
        ${notes.length ? html`<ul id="findings" class="find box">${notes.map((n, i) => html`<li key=${i}>${n}</li>`)}</ul>`
          : html`<p id="findings" class="empty box">Nothing to report for this selection.</p>`}
      </section>
    </div>`;
  }

  // ---- app ----
  function App() {
    const [saved, setState] = useState(initialState);
    SRC = DATA.sources[saved.source]; ALL_ROWS = SRC.rows;
    RUNGS = M.presentRungs(ALL_ROWS, ORDER); KNOWN_FAMILIES = {};
    ALL_ROWS.forEach((r) => { KNOWN_FAMILIES[r.family_key] = {family: r.family, maker: r.maker}; });
    const state = Object.assign({}, sourceDefaults(SRC), saved.per[saved.source] || {}, {view: saved.view, mode: saved.mode});
    // Layout effect: the hash and storage are current as soon as the change renders,
    // so a reload or bookmark right after a click keeps it.
    useLayoutEffect(() => { saveState(saved); }, [saved]);
    // Layout effect: the listener is attached before the first paint, so a hash change
    // right after the page loads is never missed.
    useLayoutEffect(() => {
      const onHash = () => { const s = readHash(); if (s) setState(s); };
      window.addEventListener("hashchange", onHash);
      return () => window.removeEventListener("hashchange", onHash);
    }, []);
    const update = (patch) => setState((prev) => {
      const current = Object.assign({}, sourceDefaults(DATA.sources[prev.source]), prev.per[prev.source] || {}, {view: prev.view, mode: prev.mode});
      const changes = typeof patch === "function" ? patch(current) : patch;
      const next = Object.assign({}, prev), per = Object.assign({}, prev.per), sourceState = Object.assign({}, current);
      Object.keys(changes).forEach((key) => {
        if (key === "view" || key === "mode" || key === "source") next[key] = changes[key];
        else sourceState[key] = changes[key];
      });
      delete sourceState.view; delete sourceState.mode;
      per[prev.source] = sourceState; next.per = per;
      return next;
    });
    const toggleKey = (key) => update((s) => {
      if (s.keys.indexOf(key) !== -1) return { keys: s.keys.filter((k) => k !== key) };
      return s.keys.length < LIMIT ? { keys: s.keys.concat([key]) } : {};
    });
    const onSort = (table, key) => update((s) => {
      const cur = s.sorts[table] || DEFAULT_SORTS[table];
      const dir = cur && cur.key === key ? (cur.dir === "asc" ? "desc" : "asc") : (DESC_FIRST[key] ? "desc" : "asc");
      const sorts = Object.assign({}, s.sorts);
      sorts[table] = { key, dir };
      return { sorts };
    });
    const tab = (view, label) => html`<button role="tab" type="button" id=${"tab-" + view} aria-selected=${String(state.view === view)}
      onClick=${() => update({ view })}>${label}</button>`;
    const view = viewFor(state.index, state.axis), borrowed = !!SRC.indexes.find((i) => i.key === state.index)?.borrowed;
    const indexInfo = SRC.indexes.find((i) => i.key === state.index);
    const axis = SRC.axes.find((a) => a.key === state.axis), indexLabel = indexInfo?.label || "", indexShort = indexInfo?.short || "";
    const props = { state, update, onSort, toggleKey, view, borrowed, indexLabel, indexShort, axis };
    const now = Date.now();
    const failed = (src) => src.error && Date.parse(src.last_attempt) > Date.parse(src.last_checked);
    return html`<div class="wrap">
      <header>
        <div><h1>Model Ladder</h1><p class="sub">${SRC.key === "aa" ? "Effort levels compared by " + (borrowed ? "the " + indexLabel + " index" : indexLabel) + " and cost per task." : axis ? "Effort levels compared by " + SRC.label + " " + M.lowerFirst(indexLabel) + " and " + M.lowerFirst(axis.label) + "." : ""}</p></div>
        <nav class="sources" aria-label="Data source">${Object.keys(DATA.sources).map((key) => {
          const src = DATA.sources[key], checked = M.checkedText(src.last_checked, now, src.max_age_hours);
          const text = !src.available ? "No data yet" : failed(src) ? "Fetch failed " + when(src.last_attempt) + "; showing " + when(src.fetched_at)
            : src.published ? "Updated " + M.dayText(src.published.date) + ", " + M.lowerFirst(checked.text) : checked.text;
          return html`<button id=${"source-" + key} type="button" aria-pressed=${String(saved.source === key)} class=${(!src.available || failed(src) ? "failed " : "") + (checked.stale ? "stale" : "")} onClick=${() => update({source: key})}><span>${src.label}</span><small>${text}</small></button>`;
        })}</nav>
        ${SRC.available ? html`<${Status} view=${view} />` : null}
      </header>
      ${!SRC.available ? html`<p class="empty">No data from ${SRC.label} yet. Run model_ladder refresh --source ${SRC.key}.</p>` : html`<${FragmentBody} ...${props} failed=${failed(SRC)} now=${now} tab=${tab} />`}
    </div>`;
  }
  function FragmentBody({state, update, onSort, toggleKey, view, borrowed, indexLabel, indexShort, axis, failed, now, tab}) {
    const props = {state, update, onSort, toggleKey, view, borrowed, indexLabel, indexShort, axis};
    return html`<div class="body">
      ${failed ? html`<p id="source-error" class="ver">The last fetch on ${when(SRC.last_attempt, true)} failed: ${SRC.error}. This page shows data fetched ${when(SRC.fetched_at, true)}.</p>` : null}
      ${SRC.published && now - Date.parse(SRC.published.date + "T00:00:00Z") > 30 * 864e5 ? html`<p id="source-quiet" class="note">No new results from ${SRC.label} since ${M.dayText(SRC.published.date)}.</p>` : null}
      ${SRC.notice ? html`<p id="source-notice" class="note">${SRC.notice}</p>` : null}
