"""Model Ladder: compare model effort levels by Intelligence Index and cost per task.

Runtime home: ~/.model_ladder/ (override with MODEL_LADDER_HOME), holding
config.json. Later releases add snapshots and the offline page there.
"""
import argparse
import contextlib
import json
import os
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

VERSION = "1.0.0"

# ---------------------------------------------------------------------------
# Config and atomic writes
# ---------------------------------------------------------------------------

CONFIG_FILENAME = "config.json"
DEFAULT_CONFIG = {"op_item": "", "op_vault": "", "op_field": "credential", "max_age_hours": 12}


def runtime_home() -> Path:
    override = os.environ.get("MODEL_LADDER_HOME")
    return Path(override).expanduser() if override else Path.home() / ".model_ladder"


def ensure_runtime_home(path: Path) -> Path:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


def atomic_write_bytes(path: Path, data: bytes, mode: int = 0o600) -> None:
    """Publish a complete same-directory private file, preserving the old file on failure."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


def load_config() -> dict:
    """Read config.json, creating it with defaults on first use."""
    home = ensure_runtime_home(runtime_home())
    path = home / CONFIG_FILENAME
    if not path.exists():
        atomic_write_bytes(path, (json.dumps(DEFAULT_CONFIG, indent=2) + "\n").encode("utf-8"))
        return dict(DEFAULT_CONFIG)
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError(f"{path} is not valid JSON: {error}") from error
    if not isinstance(loaded, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return {**DEFAULT_CONFIG, **loaded}


# ---------------------------------------------------------------------------
# Names
# ---------------------------------------------------------------------------

EFFORTS = ("max", "xhigh", "high", "medium", "low", "minimal")  # highest first
NON_REASONING = "non-reasoning"
RUNG_ORDER = EFFORTS + (NON_REASONING,)


def _whole_name(text: str, problem: str) -> dict:
    return {"family": text, "rung": None, "tags": [], "problem": problem}


def split_name(name: str) -> dict:
    """Split a display name into family, effort rung and tags using string operations only."""
    text = name.strip()
    if text.endswith(")") and "(" in text:
        start = text.rfind("(")
        family, inner = text[:start].rstrip(), text[start + 1:-1]
        if "(" in family or ")" in family:
            return _whole_name(text, "more than one group")
        words = [w.strip() for w in inner.split(",") if w.strip()]
    else:
        family, words = text, []
    efforts = [w for w in words if w.lower() in EFFORTS]
    if len(efforts) > 1:
        return _whole_name(text, "two effort words")
    rung = None
    rest = list(words)
    if efforts:
        rung = efforts[0].lower()
        rest.remove(efforts[0])
    else:
        for word in words:
            if word.lower() == NON_REASONING:
                rung = NON_REASONING
                rest.remove(word)
                break
    return {"family": family, "rung": rung, "tags": rest, "problem": None}


def _family_key(maker: str, family: str) -> str:
    return json.dumps([maker, family])


def classify(models: list[dict]) -> list[dict]:
    """One row per scored model, in input order, with its family and effort rung."""
    rows = []
    for item in models:
        index = (item.get("evaluations") or {}).get("artificial_analysis_intelligence_index")
        if isinstance(index, bool) or not isinstance(index, (int, float)):
            continue
        cost_block = item.get("artificial_analysis_intelligence_index_cost") or {}
        per_task = cost_block.get("cost_per_task") or {}
        cost = per_task.get("total_cost") or None
        maker = (item.get("model_creator") or {}).get("name")
        parts = split_name(item.get("name") or "")
        rows.append({
            "slug": item.get("slug"),
            "name": item.get("name"),
            "maker": maker,
            "family": parts["family"],
            "family_key": _family_key(maker, parts["family"]),
            "rung": parts["rung"],
            "tags": parts["tags"],
            "index": index,
            "cost": cost,
            "total_cost": cost_block.get("total_cost"),
            "release_date": item.get("release_date"),
            "problem": parts["problem"],
        })
    seen: dict[tuple, list[dict]] = {}
    for row in rows:
        if row["rung"] is not None:
            seen.setdefault((row["family_key"], row["rung"]), []).append(row)
    for group in seen.values():
        if len(group) > 1:
            for row in group:
                row["family"] = row["name"]
                row["family_key"] = _family_key(row["maker"], row["name"])
                row["rung"] = None
                row["problem"] = "duplicate rung"
    return rows


# ---------------------------------------------------------------------------
# Fetch
# ---------------------------------------------------------------------------

API_URL = "https://artificialanalysis.ai/api/v2/language/models/free"
OP_PATHS = ("/opt/homebrew/bin/op", "/usr/local/bin/op")
MAX_PAGES = 20
KEY_ENV = "MODEL_LADDER_AA_KEY"
INDEX_FIELD = "artificial_analysis_intelligence_index"


class KeyUnavailable(Exception):
    """The API key could not be obtained; the message says what to configure or do."""


class FetchError(Exception):
    """A fetch failed; the message is one line and safe to print."""


def get_api_key(config: dict, env=os.environ, op_paths=OP_PATHS, run=subprocess.run) -> str:
    """Read the key from the environment, else 1Password. Held in memory only."""
    value = env.get(KEY_ENV)
    if value:
        return value
    item = config.get("op_item")
    if not item:
        raise KeyUnavailable(
            f"No API key configured. Set the {KEY_ENV} environment variable, or set op_item "
            "(and optionally op_vault and op_field) in config.json to a 1Password item."
        )
    op = next((path for path in op_paths if os.path.exists(path)), None)
    if op is None:
        raise KeyUnavailable("1Password CLI not found at " + " or ".join(op_paths)
                             + f"; install it or set {KEY_ENV} instead")
    argv = [op, "--cache=false", "item", "get", item, "--fields",
            f"label={config.get('op_field') or 'credential'}", "--reveal"]
    if config.get("op_vault"):
        argv += ["--vault", config["op_vault"]]
    try:
        result = run(argv, capture_output=True, text=True, timeout=20)
    except (subprocess.TimeoutExpired, OSError):
        raise KeyUnavailable("Could not read the API key from 1Password: "
                             "open and unlock 1Password, then retry") from None
    if result.returncode != 0:
        raise KeyUnavailable("Could not read the API key from 1Password: "
                             "open and unlock 1Password, then retry")
    key = (result.stdout or "").strip()
    if not key:
        raise KeyUnavailable("1Password returned an empty value for the configured item and field; "
                             "check op_item, op_vault and op_field in config.json")
    return key


def _header_int(headers, name: str):
    try:
        return int(str(headers.get(name)).strip())
    except (TypeError, ValueError):
        return None


def _rate_limit(headers) -> dict:
    return {"limit": _header_int(headers, "x-ratelimit-limit"),
            "remaining": _header_int(headers, "x-ratelimit-remaining"),
            "reset": _header_int(headers, "x-ratelimit-reset")}


def _http_failure(error: urllib.error.HTTPError) -> FetchError:
    if error.code == 429:
        reset = _header_int(error.headers, "x-ratelimit-reset")
        when = (datetime.fromtimestamp(reset).strftime("%Y-%m-%d %H:%M")
                if reset is not None else "an unknown time")
        return FetchError(f"Artificial Analysis daily quota is used; it resets at {when} (local time)")
    if error.code in (401, 403):
        return FetchError("Artificial Analysis rejected the API key")
    return FetchError(f"Artificial Analysis returned HTTP {error.code}")


def _is_number(value) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _fetch_page(key: str, number: int, open_url) -> tuple[dict, dict]:
    request = urllib.request.Request(f"{API_URL}?page={number}",
                                     headers={"x-api-key": key, "Accept": "application/json"})
    try:
        with open_url(request, timeout=30) as response:
            body, headers = response.read(), response.headers
    except urllib.error.HTTPError as error:
        raise _http_failure(error) from None
    except urllib.error.URLError as error:
        raise FetchError(f"Could not reach Artificial Analysis: {error.reason}") from None
    except (OSError, TimeoutError) as error:
        raise FetchError(f"Could not reach Artificial Analysis: {error}") from None
    try:
        envelope = json.loads(body)
    except ValueError:
        raise FetchError(f"Page {number} from Artificial Analysis is not valid JSON") from None
    if not isinstance(envelope, dict):
        raise FetchError(f"Page {number} from Artificial Analysis is not a JSON object")
    if not isinstance(envelope.get("data"), list):
        raise FetchError(f"Page {number} is missing the list field data")
    pagination = envelope.get("pagination")
    if not isinstance(pagination, dict) or not isinstance(pagination.get("has_more"), bool):
        raise FetchError(f"Page {number} is missing the boolean field pagination.has_more")
    if not _is_number(envelope.get("intelligence_index_version")):
        raise FetchError(f"Page {number} is missing the numeric field intelligence_index_version")
    return envelope, headers


def fetch_all(key: str, open_url=urllib.request.urlopen) -> dict:
    """Fetch every page; return models, index version and the last rate-limit headers."""
    models: list = []
    version = None
    for number in range(1, MAX_PAGES + 1):
        envelope, headers = _fetch_page(key, number, open_url)
        if version is not None and envelope["intelligence_index_version"] != version:
            raise FetchError(f"Pages disagree on intelligence_index_version "
                             f"({version} and {envelope['intelligence_index_version']}); retry later")
        version = envelope["intelligence_index_version"]
        models.extend(envelope["data"])
        if not envelope["pagination"]["has_more"]:
            validate_models(models)
            return {"models": models, "index_version": version, "rate_limit": _rate_limit(headers)}
    raise FetchError(f"Artificial Analysis still reported more pages after {MAX_PAGES}; stopped")


def validate_models(models: list) -> None:
    """Check only the fields the tool uses; everything else is ignored."""
    for position, item in enumerate(models, start=1):
        if not isinstance(item, dict):
            raise FetchError(f"model {position} is not an object")
        slug = item.get("slug")
        label = slug if isinstance(slug, str) and slug else f"model {position}"
        for field in ("name", "slug"):
            if not isinstance(item.get(field), str) or not item[field]:
                raise FetchError(f"{label}: field {field} must be a non-empty string")
        creator = item.get("model_creator")
        if not isinstance(creator, dict) or not isinstance(creator.get("name"), str):
            raise FetchError(f"{label}: field model_creator.name must be a string")
        index = (item.get("evaluations") or {}).get(INDEX_FIELD)
        if index is not None and not _is_number(index):
            raise FetchError(f"{label}: field {INDEX_FIELD} must be a number")
        per_task = (item.get("artificial_analysis_intelligence_index_cost") or {}).get("cost_per_task")
        if per_task is not None:
            total = per_task.get("total_cost") if isinstance(per_task, dict) else "invalid"
            if total is not None and not _is_number(total):
                raise FetchError(f"{label}: field cost_per_task.total_cost must be a number")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="model_ladder",
        description="Compare model effort levels by Intelligence Index and cost per task.",
        epilog="Runtime home: ~/.model_ladder/ (override with MODEL_LADDER_HOME).",
    )
    parser.add_argument("--version", action="version", version=f"Model Ladder {VERSION}")
    return parser


def main(argv: list[str] | None = None) -> int:
    build_parser().parse_args(argv)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
