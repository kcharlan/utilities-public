                "count": sum(row["scores"].get(item["key"]) is not None for row in rows)} for item in spec["indexes"]]
    indexes = [item for item in indexes if item["count"] or item["key"] == DEFAULT_INDEX]
    entry = {field: spec[field] for field in ("label", "attribution", "axes", "default_axis", "group_label", "borrowed_notice", "extras", "has_quota")}
    entry.update({"key": key, "indexes": indexes, "available": newest is not None,
                  "version_label": spec["version_label"].format(version=newest["index_version"]) if newest else "",
                  "version": newest["index_version"] if newest else None,
                  "rate_limit": (newest or {}).get("rate_limit") or {"limit": None, "remaining": None, "reset": None},
                  "max_age_hours": source_max_age(config, key), "rows": rows,
                  "notice": spec["notice"](rows) if newest else None,
                  "changes": diff_rows(previous, newest, key) if newest else None,
                  "last_attempt": status.get("last_attempt"), "error": status.get("error")})
    entry.update({field: (newest or {}).get(field) for field in ("fetched_at", "last_checked", "published", "current_version")})
    return entry


def build_payload(inputs: dict, config: dict, status: dict | None = None) -> dict:
    return {
        "schema": PAGE_SCHEMA,
        "app": {"name": "Model Ladder", "version": VERSION},
        "rung_order": list(RUNG_ORDER),
        "default_source": "aa",
        "sources": {key: build_source_entry(key, *inputs.get(key, (None, None)), (status or {}).get(key, {}), config) for key in SOURCE_KEYS},
    }


def render_page(payload: dict) -> bytes:
    """Fill the template; embedded data can never close its script element."""
    assets = {"PAGE_CSS": PAGE_CSS, "LADDER_MATH_JS": LADDER_MATH_JS, "APP_JS": APP_JS}
    for name, text in assets.items():
        if "</script" in text.lower():
            raise ValueError(f"{name} contains a closing script tag")
    parts = {
        "{{CSS}}": PAGE_CSS,
        "{{SCRIPTS}}": f"<script>{LADDER_MATH_JS}</script>\n<script>{APP_JS}</script>",
        "{{PAYLOAD}}": json.dumps(payload, separators=(",", ":")).replace("<", "\\u003c"),
    }
    # One pass in template order, so text inside a filled part is never treated as a placeholder.
    out, rest = [], HTML_TEMPLATE
    for marker in sorted(parts, key=HTML_TEMPLATE.index):
        before, found, rest = rest.partition(marker)
        if not found:
            raise ValueError(f"page template is missing {marker}")
        out += [before, parts[marker]]
    out.append(rest)
    return "".join(out).encode("utf-8")


def _shows_a_change(diff: dict) -> bool:
    return bool(diff["version"] or diff["added"] or diff["removed"] or diff["changed"] or diff["maxima"])


def _last_real_change(older: list[Path], snapshot: dict, source: str = "aa") -> dict | None:
    """The newest older snapshot that differs from snapshot in what the page shows.

    A new snapshot is stored whenever any delivered field differs, including fields the page
    never uses, so the one just before the newest may show nothing changed. Walking back keeps
    the last real change visible until the next one. Unreadable snapshots are reported and skipped.
    """
    for path in older:
        try:
            candidate = read_snapshot(path, source)
        except StoreError as error:
            _complain(f"{error}; skipping it for the list of changes")
            continue
        if _shows_a_change(diff_rows(candidate, snapshot, source)):
            return candidate
    return None


def build_page(home: Path, output: Path, *, unavailable=None) -> None:
    """Build from the newest snapshot, comparing with the last older one that differs in what is shown."""
    inputs, unavailable = {}, dict(unavailable or {})
    for key in SOURCE_KEYS:
        if key in unavailable:
            continue
        try:
            paths = load_snapshots(home, key)
            if paths:
                snapshot = read_snapshot(paths[0], key)
                inputs[key] = (snapshot, _last_real_change(paths[1:], snapshot, key))
        except StoreError as error:
            _complain(str(error))
            unavailable[key] = str(error)
    if not inputs:
        raise StoreError("no snapshot to build from")
    status = read_status(home)
    for key, error in unavailable.items():
        status[key] = {**status.get(key, {}), "error": error}
    atomic_write_bytes(output, render_page(build_payload(inputs, load_config(), status)))


