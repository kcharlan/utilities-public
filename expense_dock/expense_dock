      --ink: #193a25;
      --muted: #5f6d60;
      --accent: #ad5a42;
      --accent-2: #5e7c52;
      --shadow: rgba(17, 24, 39, 0.14);
    }
    html.dark {
      --bg: #122219;
      --card: #112219;
      --line: rgba(214, 204, 176, 0.12);
      --ink: #ecdfc4;
      --muted: #b6b7aa;
      --accent: #eb9b80;
      --accent-2: #a7c796;
      --shadow: rgba(0, 0, 0, 0.38);
    }
    body {
      font-family: 'Work Sans', sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(173, 90, 66, 0.12), transparent 28%),
        radial-gradient(circle at top right, rgba(94, 124, 82, 0.15), transparent 32%),
        var(--bg);
      min-height: 100vh;
    }
    .font-display { font-weight: 600; }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      box-shadow: 0 2px 12px var(--shadow);
    }
    .pill {
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.55);
    }
    html.dark .pill {
      background: rgba(255,255,255,0.08);
    }
    .receipt-accent {
      border-left: 4px solid var(--accent);
    }
    .toast-enter {
      animation: toast-in 180ms ease-out;
    }
    @keyframes toast-in {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="module">
const html = htm.bind(preact.h);
const {Icon} = frontendKit;

    const {useEffect, useMemo, useState} = preactHooks;
    const todayIso = () => new Date().toISOString().slice(0, 10);
    const DEFAULT_LOOKUPS = {
      categories: [],
      payment_methods: [],
      paid_by: [],
      reimbursement_statuses: [],
      reimbursable: ['Yes', 'No'],
    };

    class ErrorBoundary extends preact.Component {
      constructor(props) {
        super(props);
        this.state = { hasError: false, message: '' };
      }
      static getDerivedStateFromError(error) {
        return { hasError: true, message: error?.message || 'Unknown UI error' };
      }
      render() {
        if (this.state.hasError) {
          return (
            html`<div class=${"min-h-screen flex items-center justify-center p-6"}> <div class=${"card max-w-xl rounded-2xl p-8"}> <div class=${"text-sm uppercase tracking-[0.25em] text-[var(--accent)]"}>Expense Dock</div> <h1 class=${"font-display text-3xl mt-3"}>UI runtime error</h1> <p class=${"mt-3 text-[var(--muted)]"}>${this.state.message}</p> <button onClick=${() => window.location.reload()} class=${"mt-6 rounded-full bg-[var(--ink)] text-[var(--bg)] px-5 py-3"}> Reload </button> </div> </div>`
          );
        }
        return this.props.children;
      }
    }

    function icon(name, props = {}) {
      const size = props.size || 18;
      const className = props.className || '';
      return html`<${Icon} name=${name} size=${size} class=${`inline-block ${className}`.trim()} />`;
    }

    function sanitizeSegment(value, fallback) {
      let text = (value || '').trim().replace(/[\\\\/:*?"<>|]+/g, ' ').replace(/[\\x00-\\x1f]+/g, ' ');
      text = text.replace(/\\s+/g, ' ').replace(/^[ ._-]+|[ ._-]+$/g, '');
      return text || fallback;
    }

    function buildFilename(draft, fileName) {
      const extMatch = (fileName || '').match(/(\\.[^.]+)$/);
      const ext = extMatch ? extMatch[1] : '.bin';
      const vendor = sanitizeSegment(draft.vendor, 'Vendor');
      let purpose = sanitizeSegment(draft.filename_purpose || draft.business_purpose, 'Expense');
      if (purpose.length > 80) purpose = purpose.slice(0, 80).replace(/[ ._-]+$/g, '');
      const amount = Number.isFinite(Number(draft.amount)) ? Number(draft.amount).toFixed(2) : '0.00';
      return `${draft.date || todayIso()}-${vendor}-${amount}-${purpose}${ext}`;
    }

    async function fetchJson(url, options = {}) {
      const res = await fetch(url, options);
      const text = await res.text();
      let data = {};
      try {
        data = text ? JSON.parse(text) : {};
      } catch {
        data = { detail: text || 'Unexpected server response.' };
      }
      if (!res.ok) {
        const message = data.detail || data.error || `Request failed (${res.status})`;
        const error = new Error(message);
        error.payload = data;
        throw error;
      }
      return data;
    }

    function downloadCsv(csvText, fileName) {
      const blob = new Blob([csvText], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      a.click();
      URL.revokeObjectURL(url);
    }

    function Badge({ children, tone = 'default' }) {
      const tones = {
        default: 'text-[var(--ink)]',
        good: 'text-emerald-700 dark:text-emerald-300',
        warn: 'text-amber-700 dark:text-amber-300',
        bad: 'text-rose-700 dark:text-rose-300',
      };
      return html`<span class=${`pill inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] ${tones[tone]}`}>${children}</span>`;
    }

    function Toast({ message, onClose }) {
      if (!message) return null;
      const accentClass = message.tone === 'good'
        ? 'border-emerald-500/40'
        : message.tone === 'warn'
          ? 'border-amber-500/40'
          : 'border-rose-500/40';
      return (
        html`<div class=${"fixed right-4 bottom-20 z-50 max-w-md w-[min(92vw,28rem)] toast-enter"}> <div class=${`card rounded-xl border-2 ${accentClass} px-5 py-4`}> <div class=${"flex items-start justify-between gap-4"}> <div class=${"min-w-0"}> <div class=${"flex items-center gap-3"}> <${Badge} tone=${message.tone}>${message.tone === 'good' ? 'Success' : message.tone === 'warn' ? 'Attention' : 'Failure'}<//> </div> <div class=${"mt-3 font-semibold"}>${message.text}</div> ${message.link ? (
                  html`<div class=${"mt-3 text-sm"}> <a class=${"underline decoration-[var(--accent)] underline-offset-4 break-all"} href=${message.link} target=${"_blank"} rel=${"noreferrer"}>Open receipt link</a> </div>`
                ) : null} ${message.pending ? (
                  html`<div class=${"mt-3 text-sm text-[var(--muted)]"}> Workbook retry queued as <span class=${"font-mono"}>${message.pending.id}</span>. </div>`
                ) : null} ${message.csv ? (
                  html`<div class=${"mt-3"}> <button onClick=${() => downloadCsv(message.csv, `expense-dock-fallback-${todayIso()}.csv`)} class=${"pill rounded-full px-3 py-2 text-xs font-semibold"}> Download CSV fallback </button> </div>`
                ) : null} </div> <button onClick=${onClose} class=${"pill rounded-full px-3 py-1 text-xs font-semibold"}>Close</button> </div> </div> </div>`
      );
    }

    function StatusDot({ tone = 'default' }) {
      const fills = { good: 'bg-emerald-500', warn: 'bg-amber-500', bad: 'bg-rose-500', default: 'bg-slate-400' };
      const rings = { good: 'ring-emerald-500/25', warn: 'ring-amber-500/25', bad: 'ring-rose-500/25', default: 'ring-slate-400/20' };
      return html`<span class=${`inline-block h-3.5 w-3.5 rounded-full ${fills[tone] || fills.default} ring-4 ${rings[tone] || rings.default}`} />`;
    }

    function NavButton({ active, iconName, label, meta, onClick }) {
      return (
        html`<button onClick=${onClick} class=${`w-full rounded-xl border px-4 py-4 text-left transition ${
            active
              ? 'border-[var(--accent)] bg-white dark:bg-white/10 shadow-sm'
              : 'border-[var(--line)] bg-transparent hover:bg-white/40 dark:hover:bg-white/5'
          }`}> <div class=${"flex items-center gap-3"}> <span class=${"pill rounded-full p-2"}>${icon(iconName, { size: 16 })}</span> <div> <div class=${"font-semibold"}>${label}</div> ${meta ? html`<div class=${"text-xs text-[var(--muted)] mt-1"}>${meta}</div>` : null} </div> </div> </button>`
      );
    }

    function HelpModal({ open, onClose }) {
      if (!open) return null;
      return (
        html`<div class=${"fixed inset-0 z-50 flex items-center justify-center p-4"}> <button class=${"absolute inset-0 bg-black/30 backdrop-blur-sm"} onClick=${onClose} aria-label=${"Close help"} /> <div class=${"relative card w-full max-w-3xl rounded-2xl p-6 md:p-8"}> <div class=${"flex items-start justify-between gap-4"}> <div> <div class=${"text-xs uppercase tracking-[0.22em] text-[var(--accent)]"}>Help</div> <h2 class=${"font-display text-3xl mt-2"}>How Expense Dock runs</h2> </div> <button onClick=${onClose} class=${"pill rounded-full px-4 py-2 text-sm font-semibold"}>Close</button> </div> <div class=${"grid gap-6 md:grid-cols-2 mt-6"}> <div class=${"rounded-xl border border-[var(--line)] p-5"}> <div class=${"text-xs uppercase tracking-[0.18em] text-[var(--accent)]"}>Workflow</div> <ol class=${"mt-4 space-y-3 text-sm leading-7"}> <li>1. Resolve the shared <span class=${"font-mono"}>Business Expenses</span> folder from the configured OneDrive share URL.</li> <li>2. Ensure the target year and month folders exist.</li> <li>3. Upload the receipt if the normalized filename is not already present.</li> <li>4. Create an anonymous read-only OneDrive link for the receipt.</li> <li>5. Download the workbook, append one row, and upload the workbook back.</li> </ol> </div> <div class=${"rounded-xl border border-[var(--line)] p-5"}> <div class=${"text-xs uppercase tracking-[0.18em] text-[var(--accent)]"}>Microsoft setup</div> <ol class=${"mt-4 space-y-3 text-sm leading-7"}> <li>1. Create an app registration in Microsoft Entra ID.</li> <li>2. Supported account type: <span class=${"font-mono"}>Personal Microsoft accounts only</span>.</li> <li>3. Add platform <span class=${"font-mono"}>Mobile and desktop applications</span>.</li> <li>4. Add redirect URI <span class=${"font-mono"}>http://localhost</span>.</li> <li>5. Paste the client ID into Setup, save config, then click Connect Microsoft.</li> </ol> </div> </div> </div> </div>`
      );
    }

    function Field({ label, hint, children }) {
      return (
        html`<label class=${"block"}> <div class=${"flex items-end justify-between gap-3 mb-2"}> <span class=${"text-sm font-semibold"}>${label}</span> ${hint ? html`<span class=${"text-xs text-[var(--muted)]"}>${hint}</span>` : null} </div> ${children} </label>`
      );
    }

    function inputClass() {
      return 'w-full rounded-xl border border-[var(--line)] bg-white dark:bg-[#1a3327] px-4 py-3 text-sm outline-none transition focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20';
    }

    function SelectOrInput({ label, value, onChange, options, placeholder, hint }) {
      const useSelect = options && options.length > 0;
      return (
        html`<${Field} label=${label} hint=${hint}> ${useSelect ? (
            html`<select class=${inputClass()} value=${value} onInput=${(e) => onChange(e.target.value)}> <option value=${""}>${placeholder || 'Select one'}</option> ${options.map((option) => html`<option key=${option} value=${option}>${option}</option>`)} </select>`
          ) : (
            html`<input class=${inputClass()} value=${value} placeholder=${placeholder} onInput=${(e) => onChange(e.target.value)} />`
          )} <//>`
      );
    }

    function App() {
      const [status, setStatus] = useState(null);
      const [loading, setLoading] = useState(true);
      const [busy, setBusy] = useState('');
      const [message, setMessage] = useState(null);
      const [theme, setTheme] = useState(() => localStorage.getItem('expenseDockTheme') || 'light');
      const [file, setFile] = useState(null);
      const [activeView, setActiveView] = useState('submit');
      const [helpOpen, setHelpOpen] = useState(false);
      const [autoViewLocked, setAutoViewLocked] = useState(false);
      const [configDraft, setConfigDraft] = useState({
        client_id: '',
        root_share_url: '',
        workbook_name: 'Expense_Tracker.xlsx',
        worksheet_name: 'Expense Log',
        categories_sheet_name: 'Categories',
        defaults: {
          paid_by: '',
          payment_method: '',
          reimbursable: 'Yes',
          reimbursement_status: '',
        },
      });
      const [formDraft, setFormDraft] = useState({
        date: todayIso(),
        vendor: '',
        amount: '',
        category: '',
        business_purpose: '',
        filename_purpose: '',
        paid_by: '',
        payment_method: '',
        reimbursable: 'Yes',
        reimbursement_status: '',
        notes: '',
      });

      useEffect(() => {
        document.documentElement.classList.toggle('dark', theme === 'dark');
        localStorage.setItem('expenseDockTheme', theme);
      }, [theme]);

      useEffect(() => {
        if (!message) return;
        const delay = message.tone === 'good' ? 2200 : message.tone === 'warn' ? 3500 : 6000;
        const timer = window.setTimeout(() => setMessage((current) => current === message ? null : current), delay);
        return () => window.clearTimeout(timer);
      }, [message]);

      async function loadStatus() {
        setLoading(true);
        try {
          const data = await fetchJson('/api/status');
          setStatus(data);
          setConfigDraft(data.config);
          setFormDraft((prev) => ({
            ...prev,
            date: prev.date || todayIso(),
            paid_by: data.config.defaults?.paid_by || prev.paid_by,
            payment_method: data.config.defaults?.payment_method || prev.payment_method,
            reimbursable: data.config.defaults?.reimbursable || prev.reimbursable,
            reimbursement_status: data.config.defaults?.reimbursement_status || prev.reimbursement_status,
          }));
        } finally {
          setLoading(false);
        }
      }

      useEffect(() => { loadStatus(); }, []);

      useEffect(() => {
        if (!status || autoViewLocked) return;
        setActiveView((!status.ready || !status.auth?.connected) ? 'setup' : 'submit');
        setAutoViewLocked(true);
      }, [status, autoViewLocked]);

      const lookups = status?.lookups || DEFAULT_LOOKUPS;
      const filenamePreview = useMemo(() => buildFilename(formDraft, file?.name || ''), [formDraft, file]);
      const hasLookups = Boolean(status?.lookup_cache_updated_at || (lookups.categories || []).length || (lookups.payment_methods || []).length);
      const queueCount = (status?.pending || []).length;
      const statusItems = [
        { label: 'Config', tone: status?.ready ? 'good' : 'bad', detail: status?.ready ? 'Saved' : 'Needs setup' },
        { label: 'Microsoft', tone: status?.auth?.connected ? 'good' : 'bad', detail: status?.auth?.connected ? (status?.auth?.account || 'Connected') : 'Not connected' },
        { label: 'Lookups', tone: hasLookups ? 'good' : (status?.auth?.connected ? 'warn' : 'default'), detail: hasLookups ? 'Workbook cached' : (status?.auth?.connected ? 'Refresh needed' : 'Waiting for auth') },
        { label: 'Queue', tone: queueCount ? 'warn' : 'good', detail: queueCount ? `${queueCount} pending` : 'Clear' },
      ];

      async function saveConfig() {
        setBusy('config');
        setMessage(null);
        try {
          await fetchJson('/api/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(configDraft),
          });
          await loadStatus();
          setMessage({ tone: 'good', text: 'Config saved.' });
        } catch (error) {
          setMessage({ tone: 'bad', text: error.message });
        } finally {
          setBusy('');
        }
      }

      async function login() {
        setBusy('login');
        setMessage({ tone: 'warn', text: 'Microsoft login is opening in a browser window.' });
        try {
          await fetchJson('/api/auth/login', { method: 'POST' });
          await loadStatus();
          setMessage({ tone: 'good', text: 'Microsoft account connected.' });
        } catch (error) {
          setMessage({ tone: 'bad', text: error.message });
        } finally {
          setBusy('');
        }
      }

      async function logout() {
        setBusy('logout');
        try {
          await fetchJson('/api/auth/logout', { method: 'POST' });
          await loadStatus();
          setMessage({ tone: 'good', text: 'Microsoft session cleared.' });
        } catch (error) {
          setMessage({ tone: 'bad', text: error.message });
        } finally {
          setBusy('');
        }
      }

      async function refreshLookups() {
        setBusy('lookups');
        try {
          await fetchJson('/api/lookups/refresh', { method: 'POST' });
          await loadStatus();
          setMessage({ tone: 'good', text: 'Lookup values refreshed from the workbook.' });
        } catch (error) {
          setMessage({ tone: 'bad', text: error.message });
        } finally {
          setBusy('');
        }
      }

      async function submitExpense(event) {
        event.preventDefault();
        if (!file) {
          setMessage({ tone: 'bad', text: 'Choose a receipt file first.' });
          return;
        }
        setBusy('submit');
        setMessage(null);
        const formData = new FormData();
        formData.append('payload', JSON.stringify(formDraft));
        formData.append('receipt', file);
        try {
          const res = await fetch('/api/submit', { method: 'POST', body: formData });
          const data = await res.json();
          if (!res.ok) {
            throw Object.assign(new Error(data.error || data.detail || 'Submit failed.'), { payload: data });
          }
          await loadStatus();
          setFile(null);
          setFormDraft((prev) => ({
            ...prev,
            date: todayIso(),
            vendor: '',
            amount: '',
            category: '',
            business_purpose: '',
            filename_purpose: '',
            notes: '',
            paid_by: status?.config?.defaults?.paid_by || prev.paid_by,
            payment_method: status?.config?.defaults?.payment_method || prev.payment_method,
            reimbursable: status?.config?.defaults?.reimbursable || prev.reimbursable,
            reimbursement_status: status?.config?.defaults?.reimbursement_status || prev.reimbursement_status,
          }));
          setMessage({
            tone: data.duplicate ? 'warn' : 'good',
            text: data.duplicate ? `Receipt was already logged at row ${data.row_number}.` : `Expense appended on row ${data.row_number}.`,
            link: data.receipt_link,
          });
        } catch (error) {
          const payload = error.payload || {};
          setMessage({
            tone: 'bad',
            text: payload.error || error.message,
            link: payload.receipt_link || '',
            pending: payload.pending || null,
            csv: payload.fallback_csv || '',
          });
          await loadStatus();
        } finally {
          setBusy('');
        }
      }

      async function retryPending(id) {
        setBusy(`retry-${id}`);
        setMessage(null);
        try {
          const res = await fetch(`/api/pending/${id}/retry`, { method: 'POST' });
          const data = await res.json();
          if (!res.ok) {
            throw Object.assign(new Error(data.error || 'Retry failed.'), { payload: data });
          }
          await loadStatus();
          setMessage({
            tone: data.duplicate ? 'warn' : 'good',
            text: data.duplicate ? `Pending item was already logged at row ${data.row_number}.` : `Pending item appended on row ${data.row_number}.`,
            link: data.receipt_link,
          });
        } catch (error) {
          const payload = error.payload || {};
          setMessage({
            tone: 'bad',
            text: payload.error || error.message,
            link: payload.receipt_link || '',
            csv: payload.fallback_csv || '',
          });
          await loadStatus();
        } finally {
          setBusy('');
        }
      }

      if (loading && !status) {
        return html`<div class=${"min-h-screen flex items-center justify-center text-lg"}>Loading Expense Dock…</div>`;
      }

      const setupView = (
        html`<div class=${"space-y-6"}> ${(!status?.ready || !status?.auth?.connected) ? (
