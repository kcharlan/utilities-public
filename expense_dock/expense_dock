@app.post("/api/lookups/refresh")
def refresh_lookups():
    config = load_config()
    if not config_is_complete(config):
        raise HTTPException(status_code=400, detail="Complete the config first.")
    access_token = get_access_token(config)
    graph = GraphClient(access_token)
    try:
        _, workbook_item, drive_id = resolve_root_and_workbook(graph, config)
        workbook_bytes = graph.download_item_content(drive_id, workbook_item["id"])
        lookups = extract_lookup_values(workbook_bytes, config["categories_sheet_name"])
        config["lookup_cache"] = lookups
        config["lookup_cache_updated_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
        save_config(config)
        return {"ok": True, "lookups": lookups, "updated_at": config["lookup_cache_updated_at"]}
    except GraphAPIError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    finally:
        graph.close()


@app.post("/api/submit")
def submit_expense(payload: str = Form(...), receipt: UploadFile = File(...)):
    config = load_config()
    if not config_is_complete(config):
        raise HTTPException(status_code=400, detail="Config is incomplete.")
    try:
        submission = parse_submission(json.loads(payload))
    except json.JSONDecodeError as exc:
        raise HTTPException(status_code=400, detail="Payload must be valid JSON.") from exc
    file_bytes = receipt.file.read()
    if not file_bytes:
        raise HTTPException(status_code=400, detail="Receipt file is empty.")
    if len(file_bytes) > 100 * 1024 * 1024:
        raise HTTPException(status_code=413, detail="File too large (max 100 MB).")
    result = process_submission(config, submission, file_bytes, receipt.filename or "receipt", receipt.content_type or "")
    if result["ok"]:
        return result
    return JSONResponse(status_code=500, content=result)


@app.get("/api/pending")
def get_pending():
    return {"pending": list_pending_operations()}


@app.post("/api/pending/{operation_id}/retry")
def retry_pending(operation_id: str):
    config = load_config()
    if not config_is_complete(config):
        raise HTTPException(status_code=400, detail="Config is incomplete.")
    result = retry_pending_operation(config, operation_id)
    if result["ok"]:
        return result
    return JSONResponse(status_code=500, content=result)


@app.get("/api/pending/{operation_id}/csv")
def download_pending_csv(operation_id: str):
    entry = load_pending_operation(operation_id)
    csv_text = entry.get("fallback_csv") or build_csv_text(entry["submission"], entry["receipt_link"], entry["receipt_filename"])
    return StreamingResponse(
        iter([csv_text.encode("utf-8")]),
        media_type="text/csv",
        headers={"Content-Disposition": f'attachment; filename="expense-dock-{operation_id}.csv"'},
    )


