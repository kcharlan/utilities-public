    function Treemap({ breakdowns, activeRoot, onSelectRoot, isScanning }) {
      const roots = ['data_root', 'home_root', 'library_root', 'applications_root'];
      const sizes = roots.map(r => breakdowns[r]?.total_bytes || 0);
      const total = sizes.reduce((a, b) => a + b, 0) || 1;
      // CSS grid columns proportional to sizes, minimum 0.15fr
      const cols = sizes.map(s => Math.max(0.15, s / total).toFixed(3) + 'fr').join(' ');

      return (
        <div style={{ display: 'grid', gridTemplateColumns: cols, gap: 3, marginBottom: 10 }}>
          {roots.map((root, i) => {
            const bd = breakdowns[root];
            const hasData = bd && bd.items && bd.items.length > 0;
            return (
              <div
                key={root}
                className={`treemap-block ${activeRoot === root ? 'active' : ''}`}
                onClick={() => onSelectRoot(activeRoot === root ? null : root)}
                style={{
                  background: ROOT_COLORS[root],
                  color: '#fff',
                  minHeight: 90,
                  opacity: hasData ? 1 : 0.5,
                }}
              >
                {hasData ? (
                  <>
                    <div>
                      <div style={{ fontWeight: 700, fontSize: 15 }}>{ROOT_LABELS[root]}</div>
                      <div style={{ fontSize: 13, opacity: 0.85 }}>{formatBytes(bd.total_bytes)}</div>
                    </div>
                    <div style={{ fontSize: 11, opacity: 0.65, marginTop: 4 }}>
                      {bd.items.slice(0, 3).map(it => it.label).join(', ')}
                      {bd.items.length > 3 ? ` +${bd.items.length - 3}` : ''}
                    </div>
                  </>
                ) : (
                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', height: '100%' }}>
                    {isScanning ? <div className="shimmer" style={{ width: '60%', height: 12 }} /> : <span style={{ opacity: 0.5, fontSize: 13 }}>{ROOT_LABELS[root]}</span>}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      );
    }

    function AccordionBreakdown({ rootKey, breakdown, isScanning, onReveal, onRescan, externalPath }) {
      const [drillPath, setDrillPath] = useState([]);  // array of {path, label}
      const [drillData, setDrillData] = useState(null);
      const [drillLoading, setDrillLoading] = useState(false);
      const [showAll, setShowAll] = useState(false);
      const [cachedPaths, setCachedPaths] = useState(new Set());
      const [rescanning, setRescanning] = useState(false);
      const VISIBLE_COUNT = 10;

      // Reset drill state when root changes
      useEffect(() => {
        setDrillPath([]);
        setDrillData(null);
        setShowAll(false);
        setCachedPaths(new Set());
        setRescanning(false);
      }, [rootKey]);

      // Prune local cached-paths overrides for items the server now confirms as cached.
      // Avoids dot flicker — only drops overrides where server says is_cached: true.
      const breakdownRef = useRef(breakdown);
      useEffect(() => {
        if (breakdown !== breakdownRef.current) {
          breakdownRef.current = breakdown;
          setCachedPaths(prev => {
            const serverCached = new Set(
              (breakdown?.items || []).filter(i => i.is_cached).map(i => i.path)
            );
            const next = new Set(prev);
            for (const p of next) {
              if (serverCached.has(p)) next.delete(p);
            }
            return next;
          });
        }
      }, [breakdown]);

      const currentItems = drillData ? drillData.items : (breakdown?.items || []);
      const currentTotal = drillData ? drillData.total_bytes : (breakdown?.total_bytes || 0);
      const displayItems = showAll ? currentItems : currentItems.slice(0, VISIBLE_COUNT);
      const maxBytes = displayItems.length > 0 ? (displayItems[0].allocated_bytes || 0) : 0;
      const updatedAt = drillData?.updated_at || breakdown?.updated_at;

      const drillInto = async (item) => {
        // Cycle detection: skip if this path is already in the breadcrumb trail
        if (drillPath.some(crumb => crumb.path === item.path)) return;
        setDrillLoading(true);
        try {
          const res = await fetch(`/api/breakdown?path=${encodeURIComponent(item.path)}`);
          if (!res.ok) { const d = await res.json(); throw new Error(d.detail); }
          const data = await res.json();
          setCachedPaths(prev => {
            const next = new Set(prev);
            next.add(item.path);
            if (data.path) next.add(data.path);
            return next;
          });
          setDrillPath(prev => [...prev, { path: item.path, label: item.label }]);
          setDrillData(data);
          setShowAll(false);
        } catch (e) {
          console.error('Drill-down failed:', e);
        }
        setDrillLoading(false);
      };

      useEffect(() => {
        if (!externalPath) return;
        drillInto({ path: externalPath, label: externalPath.split('/').pop() || externalPath });
      }, [externalPath]);

      const navigateBack = (index) => {
        if (index < 0) {
          // Back to root
          setDrillPath([]);
          setDrillData(null);
          setShowAll(false);
        } else {
          // Navigate to specific breadcrumb level
          const newPath = drillPath.slice(0, index + 1);
          setDrillPath(newPath);
          setDrillLoading(true);
          fetch(`/api/breakdown?path=${encodeURIComponent(newPath[newPath.length - 1].path)}`)
            .then(r => r.json())
            .then(data => setDrillData(data))
            .catch((e) => {
              console.error('Breadcrumb navigation failed:', e);
              setDrillData(null);
            })
            .finally(() => setDrillLoading(false));
        }
      };

      if (!breakdown || !breakdown.items) {
        return isScanning ? (
          <div style={{ padding: 16 }}>
            <div className="shimmer" style={{ height: 16, marginBottom: 8 }} />
            <div className="shimmer" style={{ height: 12, marginBottom: 6 }} />
            <div className="shimmer" style={{ height: 12, marginBottom: 6 }} />
            <div className="shimmer" style={{ height: 12 }} />
          </div>
        ) : null;
      }

      return (
        <div className="surface" style={{ borderRadius: 8, overflow: 'hidden' }}>
          {/* Header */}
          <div style={{
            display: 'flex', justifyContent: 'space-between', alignItems: 'center',
            padding: '8px 12px', borderBottom: '1px solid var(--border)',
            background: `${ROOT_COLORS[rootKey]}15`,
          }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 14, flexWrap: 'wrap' }}>
              {/* Breadcrumb */}
              <span style={{ cursor: drillPath.length > 0 ? 'pointer' : 'default', fontWeight: 600, textDecoration: drillPath.length > 0 ? 'underline' : 'none' }}
                    onClick={() => drillPath.length > 0 && navigateBack(-1)}>
                {ROOT_LABELS[rootKey]}
              </span>
              {drillPath.map((crumb, i) => (
                <span key={i}>
                  <span style={{ opacity: 0.4, margin: '0 4px' }}>&gt;</span>
                  <span style={{ cursor: i < drillPath.length - 1 ? 'pointer' : 'default', textDecoration: i < drillPath.length - 1 ? 'underline' : 'none' }}
                        onClick={() => i < drillPath.length - 1 && navigateBack(i)}>
                    {crumb.label}
                  </span>
                </span>
              ))}
            </div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <span style={{ fontSize: 12, color: 'var(--text-secondary)' }}>
                {formatBytes(currentTotal)} &middot; {currentItems.length} items
                {updatedAt && ` · ${formatRelativeTime(updatedAt)}`}
              </span>
              {onReveal && drillPath.length > 0 && (
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    const revealTarget = drillData?.path || drillPath[drillPath.length - 1].path;
                    onReveal(revealTarget);
                  }}
                  title="Reveal in Finder"
                  style={{
                    padding: '2px 7px',
                    borderRadius: 4,
                    fontSize: 11,
                    border: '1px solid var(--border)',
                    cursor: 'pointer',
                    background: 'transparent',
                    color: 'var(--text-secondary)',
                    whiteSpace: 'nowrap',
                  }}
                >
                  Reveal
                </button>
              )}
              {onRescan && drillPath.length > 0 && (
                <button
                  onClick={async (e) => {
                    e.stopPropagation();
                    const target = drillData?.path || drillPath[drillPath.length - 1].path;
                    setRescanning(true);
                    try {
                      const freshData = await onRescan(target);
                      if (freshData) {
                        setDrillData(freshData);
                        setCachedPaths(new Set());
                      }
                    } finally {
                      setRescanning(false);
                    }
                  }}
                  disabled={rescanning}
                  title="Rescan this directory"
                  style={{
                    padding: '2px 7px',
                    borderRadius: 4,
                    fontSize: 11,
                    border: '1px solid var(--border)',
                    cursor: rescanning ? 'wait' : 'pointer',
                    background: 'transparent',
                    color: 'var(--text-secondary)',
                    whiteSpace: 'nowrap',
                    opacity: rescanning ? 0.5 : 1,
                  }}
                >
                  {rescanning ? 'Scanning…' : 'Rescan'}
                </button>
              )}
            </div>
          </div>

          {/* Item rows */}
          {drillLoading ? (
            <div style={{ padding: '20px 12px', textAlign: 'center' }}>
              <div style={{ display: 'inline-flex', alignItems: 'center', gap: 8, color: 'var(--text-secondary)', fontSize: 13 }}>
                <span role="presentation" style={{ display: 'inline-block', width: 14, height: 14, border: '2px solid var(--border)', borderTopColor: 'var(--accent)', borderRadius: '50%', animation: 'spin 0.8s linear infinite' }} />
                Scanning directory…
              </div>
              <div style={{ marginTop: 12 }}>
                <div className="shimmer" style={{ height: 14, marginBottom: 8 }} />
                <div className="shimmer" style={{ height: 14, marginBottom: 8 }} />
                <div className="shimmer" style={{ height: 14 }} />
              </div>
            </div>
          ) : (
            <div style={{ maxHeight: 320, overflowY: 'auto', fontSize: 13 }}>
              {displayItems.map((item) => (
                <div key={item.path} className={item.is_file ? '' : 'surface-hover'} role={item.is_file ? undefined : 'button'} tabIndex={item.is_file ? undefined : 0}
                     style={{ display: 'flex', alignItems: 'center', padding: '5px 12px', borderBottom: '1px solid var(--border)', cursor: item.is_file ? 'default' : 'pointer', opacity: item.is_file ? 0.75 : 1 }}
                     onClick={item.is_file ? undefined : () => drillInto(item)}
                     onKeyDown={item.is_file ? undefined : (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); drillInto(item); } }}>
                  <span style={{
                    width: 'clamp(180px, 38%, 240px)',
                    minWidth: 0,
                    display: 'flex',
                    alignItems: 'center',
                    gap: 6,
                  }}>
                    {item.is_file ? (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ flex: '0 0 auto', opacity: 0.5 }}>
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
                      </svg>
                    ) : (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ flex: '0 0 auto', opacity: 0.5 }}>
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                      </svg>
                    )}
                    {item.is_cached === false && !cachedPaths.has(item.path) && (
                      <span
                        title="Not yet scanned — click to load"
                        aria-label="Not yet scanned"
                        style={{
                          display: 'inline-block',
                          width: 6,
                          height: 6,
                          borderRadius: '50%',
                          background: 'var(--accent)',
                          opacity: 0.6,
                          animation: 'pulse 2s ease-in-out infinite',
                          flex: '0 0 auto',
                        }}
                      />
                    )}
                    <span style={{ minWidth: 0, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                      {item.label}
                    </span>
                  </span>
                  <div style={{ flex: 1, margin: '0 10px' }}>
                    <div className="bar-track">
                      <div className="bar-fill" style={{ width: `${pct(item.allocated_bytes, maxBytes)}%`, background: ROOT_COLORS[rootKey] }} />
                    </div>
                  </div>
                  <span className="mono" style={{ width: 65, textAlign: 'right' }}>
                    {formatBytes(item.allocated_bytes)}
                  </span>
                </div>
              ))}
              {!showAll && currentItems.length > VISIBLE_COUNT && (
                <div onClick={() => setShowAll(true)}
                     style={{ padding: '5px 12px', fontSize: 12, color: 'var(--text-secondary)', cursor: 'pointer' }}>
                  Show all {currentItems.length} items...
                </div>
              )}
            </div>
          )}
        </div>
      );
    }

    function FindingsTab({ findings, busyToken, onExecute, onReveal, isScanning }) {
      const [riskFilter, setRiskFilter] = useState('all');
      const [sortCol, setSortCol] = useState('size');
      const [sortAsc, setSortAsc] = useState(false);

      const items = useMemo(() => {
        let list = findings?.items || [];
        if (riskFilter !== 'all') list = list.filter(f => f.risk === riskFilter);
        const sorted = [...list];
        sorted.sort((a, b) => {
          let va, vb;
          if (sortCol === 'size') {
            va = a.estimated_reclaim_bytes || a.allocated_bytes || 0;
            vb = b.estimated_reclaim_bytes || b.allocated_bytes || 0;
          } else if (sortCol === 'risk') {
            const order = { low: 1, medium: 2, high: 3 };
            va = order[a.risk] || 0; vb = order[b.risk] || 0;
          } else {
            va = a.label?.toLowerCase() || ''; vb = b.label?.toLowerCase() || '';
          }
          if (va < vb) return sortAsc ? -1 : 1;
          if (va > vb) return sortAsc ? 1 : -1;
          return 0;
        });
        return sorted;
      }, [findings, riskFilter, sortCol, sortAsc]);

      const handleSort = (col) => {
        if (sortCol === col) setSortAsc(!sortAsc);
        else { setSortCol(col); setSortAsc(false); }
      };

      const topReclaimPaths = useMemo(() => {
        const sorted = [...(findings?.items || [])].sort((a, b) =>
          (b.estimated_reclaim_bytes || 0) - (a.estimated_reclaim_bytes || 0)
        );
        return new Set(sorted.slice(0, 3).map(f => f.path));
      }, [findings]);

      return (
        <div style={{ fontSize: 13 }}>
          {/* Filter bar */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '8px 12px', borderBottom: '1px solid var(--border)' }}>
            <span style={{ fontSize: 11, color: 'var(--text-secondary)' }}>Filter:</span>
            {['all', 'low', 'medium', 'high'].map(r => (
              <button key={r} onClick={() => setRiskFilter(r)} style={{
                padding: '2px 8px', borderRadius: 4, fontSize: 11, cursor: 'pointer', border: 'none',
                background: riskFilter === r ? 'var(--accent)' : 'var(--surface-hover)',
                color: riskFilter === r ? '#fff' : 'var(--text-secondary)',
              }}>{r}</button>
            ))}
            <div style={{ flex: 1 }} />
            <span style={{ fontSize: 11, color: 'var(--text-secondary)' }}>
              {items.length} items
              {findings?.updated_at && ` · ${formatRelativeTime(findings.updated_at)}`}
            </span>
          </div>

          {/* Column headers */}
          <div style={{ display: 'grid', gridTemplateColumns: '2fr 80px 55px 75px 100px', gap: 4, padding: '6px 12px', borderBottom: '1px solid var(--border)', fontSize: 11, textTransform: 'uppercase', color: 'var(--text-secondary)' }}>
            <button onClick={() => handleSort('name')} style={{ cursor: 'pointer', background: 'none', border: 'none', padding: 0, font: 'inherit', color: 'inherit', textTransform: 'inherit' }}>Finding</button>
            <span>Category</span>
            <button onClick={() => handleSort('risk')} style={{ cursor: 'pointer', background: 'none', border: 'none', padding: 0, font: 'inherit', color: 'inherit', textTransform: 'inherit' }} title="Low = safe to delete (caches). Medium = review first. High = manual review.">
              Risk &#9432;
            </button>
            <button onClick={() => handleSort('size')} style={{ cursor: 'pointer', textAlign: 'right', background: 'none', border: 'none', padding: 0, font: 'inherit', color: 'inherit', textTransform: 'inherit' }}>Size</button>
            <span style={{ textAlign: 'right' }}>Actions</span>
          </div>

          {/* Rows */}
          <div style={{ maxHeight: 400, overflowY: 'auto' }}>
            {isScanning && items.length === 0 && (
              <div style={{ padding: 12 }}>
                <div className="shimmer" style={{ height: 14, marginBottom: 8 }} />
                <div className="shimmer" style={{ height: 14, marginBottom: 8 }} />
                <div className="shimmer" style={{ height: 14 }} />
              </div>
            )}
            {items.map((item) => {
              const risk = RISK_STYLES[item.risk] || {};
              const isTopReclaim = topReclaimPaths.has(item.path);
              return (
                <div key={item.path + item.label} className="surface-hover" style={{
                  display: 'grid', gridTemplateColumns: '2fr 80px 55px 75px 100px', gap: 4,
                  padding: '5px 12px', borderBottom: '1px solid var(--border)', alignItems: 'center',
                  background: isTopReclaim ? `${ROOT_COLORS.data_root}08` : undefined,
                }}>
                  <span style={{ whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }} title={item.path}>
                    {item.label}
                  </span>
                  <span style={{
                    padding: '1px 6px', borderRadius: 4, fontSize: 11, textAlign: 'center',
                    background: `${CATEGORY_COLORS[item.category] || '#666'}22`,
                    color: CATEGORY_COLORS[item.category] || 'var(--text-secondary)',
                  }}>{(item.category || '').replace(/_/g, ' ')}</span>
                  <span style={{ padding: '1px 6px', borderRadius: 4, fontSize: 11, textAlign: 'center', background: risk.bg, color: risk.color }}>
                    {risk.label}
                  </span>
                  <span className="mono" style={{ textAlign: 'right' }}>
                    {formatBytes(item.estimated_reclaim_bytes || item.allocated_bytes)}
                  </span>
                  <span style={{ display: 'flex', gap: 3, justifyContent: 'flex-end' }}>
                    {item.actions?.filter(a => a.kind === 'execute').map(a => (
                      <button key={a.label} disabled={busyToken === a.action_token}
                        onClick={() => onExecute(a.action_token)}
                        style={{ padding: '2px 7px', borderRadius: 4, fontSize: 11, border: 'none', cursor: 'pointer', background: 'var(--accent)', color: '#fff' }}>
                        {busyToken === a.action_token ? '...' : (a.label === 'Move to Trash' ? 'Trash' : a.label)}
                      </button>
                    ))}
                    <button onClick={() => onReveal(item.path)}
                      style={{ padding: '2px 7px', borderRadius: 4, fontSize: 11, border: '1px solid var(--border)', cursor: 'pointer', background: 'transparent', color: 'var(--text-secondary)' }}>
                      Reveal
                    </button>
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      );
    }

    function SnapshotsTab({ snapshots, busyToken, onExecute, isScanning }) {
      const [selected, setSelected] = useState(new Set());
      const [sortNewest, setSortNewest] = useState(false);
      const [deleting, setDeleting] = useState(false);
      const [thinning, setThinning] = useState(false);

      const items = useMemo(() => {
        const list = [...(snapshots?.items || [])];
        list.sort((a, b) => {
          const da = a.parsed_date || ''; const db = b.parsed_date || '';
          return sortNewest ? db.localeCompare(da) : da.localeCompare(db);
        });
        return list;
      }, [snapshots, sortNewest]);

      const toggleSelect = (name) => {
        setSelected(prev => {
          const next = new Set(prev);
          if (next.has(name)) next.delete(name); else next.add(name);
          return next;
        });
      };

      const selectAll = () => {
        if (selected.size === items.length) setSelected(new Set());
        else setSelected(new Set(items.map(s => s.snapshot_name)));
      };

      const deleteSelected = async () => {
        if (!window.confirm(`Delete ${selected.size} snapshot${selected.size > 1 ? 's' : ''}? This cannot be undone.`)) return;
        setDeleting(true);
        try {
          for (const name of selected) {
            const snap = items.find(s => s.snapshot_name === name);
            if (snap?.action_token) {
              await onExecute(snap.action_token);
            }
          }
        } catch (e) {
          console.error('Batch snapshot delete error:', e);
        } finally {
          setSelected(new Set());
          setDeleting(false);
        }
      };

      const formatSnapshotDate = (isoDate) => {
        if (!isoDate) return 'Unknown date';
        const d = new Date(isoDate);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
          + ' at ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      };

      const thinSnapshots = async () => {
        const amount = window.prompt('How many GB should macOS try to reclaim?', '10');
        if (amount === null) return;
        const gb = Number(amount);
        if (!Number.isFinite(gb) || gb <= 0) return window.alert('Enter a positive GB amount.');
        const urgency = Number(window.prompt('Urgency from 1 (low) to 4 (high):', '2'));
        if (![1, 2, 3, 4].includes(urgency)) return window.alert('Urgency must be 1–4.');
        if (!window.confirm('macOS chooses which snapshots to thin. Continue?')) return;
        setThinning(true);
        try {
          const res = await fetch('/api/snapshots/thin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bytes: Math.round(gb * 1024 * 1024 * 1024), urgency }) });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Snapshot thinning failed');
          window.alert(`Observed free-space change: ${data.observed_reclaimed_bytes == null ? 'unavailable' : formatBytes(data.observed_reclaimed_bytes)}`);
        } catch (error) { window.alert(error.message); }
        finally { setThinning(false); }
      };

      return (
        <div style={{ fontSize: 13 }}>
          {/* Header */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '8px 12px', borderBottom: '1px solid var(--border)', flexWrap: 'wrap' }}>
            <input type="checkbox" checked={selected.size === items.length && items.length > 0} onChange={selectAll} aria-label="Select all snapshots" />
            <span style={{ fontSize: 12, color: 'var(--text-secondary)' }}>{items.length} local snapshot{items.length !== 1 ? 's' : ''}</span>
            {selected.size > 0 && (
              <button onClick={deleteSelected} disabled={deleting}
                style={{ padding: '3px 10px', borderRadius: 4, fontSize: 12, border: 'none', cursor: 'pointer', background: 'var(--danger)', color: '#fff' }}>
                {deleting ? 'Deleting...' : `Delete ${selected.size}`}
              </button>
            )}
            <button onClick={thinSnapshots} disabled={thinning || !items.length}
              style={{ padding: '3px 10px', borderRadius: 4, fontSize: 12, border: '1px solid var(--accent)', background: 'transparent', color: 'var(--accent)' }}>
              {thinning ? 'Reclaiming…' : 'Reclaim space…'}
            </button>
            <div style={{ flex: 1 }} />
            <button onClick={() => setSortNewest(!sortNewest)}
              style={{ fontSize: 11, color: 'var(--text-secondary)', cursor: 'pointer', textDecoration: 'underline', background: 'none', border: 'none', padding: 0 }}>
              {sortNewest ? 'newest first' : 'oldest first'}
            </button>
          </div>

          {/* Info note */}
          <div style={{ padding: '6px 12px', fontSize: 12, color: 'var(--text-secondary)', borderBottom: '1px solid var(--border)', lineHeight: 1.5 }}>
            Snapshot space is managed by APFS and reclaimed as needed. Deleting old snapshots can free space, but the exact amount depends on shared block references.
          </div>

          {/* Rows */}
          <div style={{ maxHeight: 350, overflowY: 'auto' }}>
            {isScanning && items.length === 0 && (
              <div style={{ padding: 12 }}>
                <div className="shimmer" style={{ height: 14, marginBottom: 8 }} />
                <div className="shimmer" style={{ height: 14 }} />
              </div>
            )}
            {items.map((snap) => (
              <div key={snap.snapshot_name} style={{
                display: 'flex', alignItems: 'center', gap: 10, padding: '6px 12px',
                borderBottom: '1px solid var(--border)',
              }}>
                <input type="checkbox" checked={selected.has(snap.snapshot_name)} onChange={() => toggleSelect(snap.snapshot_name)} aria-label={`Select snapshot ${snap.parsed_date || snap.snapshot_name}`} />
                <span style={{ flex: 1 }}>{formatSnapshotDate(snap.parsed_date)}</span>
                <span style={{ fontSize: 12, color: 'var(--text-secondary)' }}>{formatRelativeTime(snap.parsed_date)}</span>
                {snap.purgeable === true && <span style={{ fontSize: 10, padding: '1px 5px', borderRadius: 4, background: 'var(--success-bg)', color: 'var(--success)' }}>Purgeable</span>}
                {snap.limiting_container_shrink === true && <span title="Deleting this snapshot can lower the container shrink floor" style={{ fontSize: 10, padding: '1px 5px', borderRadius: 4, background: 'var(--warning-bg)', color: 'var(--warning)' }}>Limits container shrink</span>}
                <button onClick={() => onExecute(snap.action_token)} disabled={busyToken === snap.action_token}
                  style={{ padding: '2px 8px', borderRadius: 4, fontSize: 11, border: 'none', cursor: 'pointer', background: 'var(--danger-bg)', color: 'var(--danger)' }}>
                  {busyToken === snap.action_token ? '...' : 'Delete'}
                </button>
                <button onClick={() => onExecute(snap.action_token, { elevate: true })} disabled={busyToken === snap.action_token}
                  title="Delete with admin privileges (password prompt)"
                  style={{ padding: '2px 8px', borderRadius: 4, fontSize: 11, border: '1px solid var(--danger)', cursor: 'pointer', background: 'transparent', color: 'var(--danger)' }}>
                  &#x1F512;
                </button>
              </div>
            ))}
          </div>
        </div>
      );
    }

    function LargeFilesTab({ largeFiles, onReveal, isScanning }) {
      const items = largeFiles?.items || [];
      return (
        <div style={{ fontSize: 13 }}>
          <div style={{ display: 'grid', gridTemplateColumns: '2fr 75px 100px', gap: 4, padding: '6px 12px', borderBottom: '1px solid var(--border)', fontSize: 11, textTransform: 'uppercase', color: 'var(--text-secondary)' }}>
            <span>File</span>
            <span style={{ textAlign: 'right' }}>Size</span>
            <span style={{ textAlign: 'right' }}>Action</span>
          </div>
          <div style={{ maxHeight: 400, overflowY: 'auto' }}>
            {isScanning && items.length === 0 && (
              <div style={{ padding: 12 }}>
                <div className="shimmer" style={{ height: 14, marginBottom: 8 }} />
                <div className="shimmer" style={{ height: 14 }} />
              </div>
            )}
            {items.map((item) => (
              <div key={item.path} className="surface-hover" style={{
                display: 'grid', gridTemplateColumns: '2fr 75px 100px', gap: 4,
                padding: '5px 12px', borderBottom: '1px solid var(--border)', alignItems: 'center',
              }}>
                <span style={{ whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }} title={item.path}>
                  {item.label}
                </span>
                <span className="mono" style={{ textAlign: 'right' }}>{formatBytes(item.allocated_bytes)}</span>
                <span style={{ textAlign: 'right' }}>
                  <button onClick={() => onReveal(item.path)}
                    style={{ padding: '2px 7px', borderRadius: 4, fontSize: 11, border: '1px solid var(--border)', cursor: 'pointer', background: 'transparent', color: 'var(--text-secondary)' }}>
                    Reveal
                  </button>
                </span>
              </div>
            ))}
            {!isScanning && items.length === 0 && (
              <div style={{ padding: 12, color: 'var(--text-secondary)', textAlign: 'center' }}>No files &ge; 1 GB found</div>
            )}
          </div>
          {largeFiles?.updated_at && (
            <div style={{ padding: '4px 12px', fontSize: 11, color: 'var(--text-secondary)', borderTop: '1px solid var(--border)' }}>
              Scanned {formatRelativeTime(largeFiles.updated_at)}
            </div>
          )}
        </div>
      );
    }

    function ProvidersTab({ providers, busyToken, onExecute }) {
      const items = providers?.items || [];
      return <div style={{ fontSize: 13, maxHeight: 400, overflowY: 'auto' }}>
        {items.map(item => <div key={item.slug} className="surface-hover" style={{ padding: '9px 12px', borderBottom: '1px solid var(--border)', opacity: item.available ? 1 : 0.55 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
            <strong style={{ flex: 1 }}>{item.label}</strong>
            <span style={{ fontSize: 11, color: item.risk === 'medium' ? 'var(--warning)' : 'var(--success)' }}>{item.risk}</span>
            <span className="mono">{item.estimate_bytes == null ? '—' : `${item.estimate_kind === 'upper_bound' ? 'up to ' : '~'}${formatBytes(item.estimate_bytes)}`}</span>
            {item.execution === 'manual' ? (
              <button disabled={!item.available} onClick={() => navigator.clipboard.writeText(item.manual_command)}
                title="Copy command"
                style={{ padding: '3px 9px', border: '1px solid var(--border)', borderRadius: 4, background: 'transparent', color: 'var(--text-primary)', cursor: item.available ? 'pointer' : 'not-allowed' }}>
                Copy command
              </button>
            ) : (
              <button disabled={!item.available || busyToken === item.action_token}
                onClick={() => window.confirm(`Run ${item.label}?`) && onExecute(item.action_token)}
                style={{ padding: '3px 9px', border: 'none', borderRadius: 4, background: 'var(--accent)', color: '#fff', cursor: item.available ? 'pointer' : 'not-allowed' }}>
                {busyToken === item.action_token ? 'Running…' : 'Run'}
              </button>
            )}
          </div>
          <div style={{ color: 'var(--text-secondary)', marginTop: 3 }}>{item.available ? item.description : item.unavailable_reason}</div>
          {item.available && item.execution === 'manual' && <div style={{ marginTop: 6, padding: 7, borderRadius: 4, background: 'var(--surface-hover)' }}>
            <code className="mono">{item.manual_command}</code>
            <div style={{ marginTop: 3, color: 'var(--warning)' }}>{item.manual_instruction}</div>
          </div>}
        </div>)}
        {!items.length && <div style={{ padding: 16, textAlign: 'center', color: 'var(--text-secondary)' }}>Provider results appear after a scan.</div>}
      </div>;
    }

    function OrphansTab({ orphans, onReveal }) {
      return <div style={{ fontSize: 13 }}>
        <div style={{ padding: 10, background: 'var(--warning-bg)', color: 'var(--warning)' }}>Heuristic only: apps outside standard Applications folders or background-only tools may appear here. Verify before deleting manually.</div>
        <div style={{ maxHeight: 360, overflowY: 'auto' }}>{(orphans?.items || []).map(item =>
          <div key={item.path} className="surface-hover" style={{ display: 'grid', gridTemplateColumns: '2fr 100px 80px 70px', gap: 8, padding: '6px 12px', borderBottom: '1px solid var(--border)' }}>
            <span title={item.path} style={{ overflow: 'hidden', textOverflow: 'ellipsis' }}>{item.name}</span>
            <span>{item.source === 'group_containers' ? 'Group' : 'Container'}</span>
            <span className="mono" style={{ textAlign: 'right' }}>{formatBytes(item.allocated_bytes)}</span>
            <button onClick={() => onReveal(item.path)} style={{ border: '1px solid var(--border)', background: 'transparent', color: 'var(--text-secondary)', borderRadius: 4 }}>Reveal</button>
          </div>)}</div>
      </div>;
    }

    function GrowthTab({ onOpenPath }) {
      const [data, setData] = useState({ baselines: [], items: [] });
      const [direction, setDirection] = useState('gainers');
      const load = useCallback((id) => {
        const query = id ? `?baseline_scan_id=${id}` : '';
        fetch(`/api/growth${query}`).then(r => r.json()).then(setData).catch(console.error);
      }, []);
      useEffect(() => { load(null); }, [load]);
      const items = (data.items || []).filter(item => direction === 'gainers' ? item.delta_bytes > 0 : item.delta_bytes < 0);
      return <div style={{ fontSize: 13 }}>
        <div style={{ display: 'flex', gap: 8, padding: 8, borderBottom: '1px solid var(--border)' }}>
          <select value={data.baseline_scan_id || ''} onChange={e => load(e.target.value)} style={{ background: 'var(--surface)', color: 'var(--text-primary)', border: '1px solid var(--border)' }}>
            {(data.baselines || []).filter(b => b.scan_id !== data.current_scan_id).map(b => <option key={b.scan_id} value={b.scan_id}>{formatRelativeTime(b.completed_at)}</option>)}
          </select>
          {['gainers', 'shrinkers'].map(value => <button key={value} onClick={() => setDirection(value)} style={{ border: 'none', borderRadius: 4, background: direction === value ? 'var(--accent)' : 'var(--surface-hover)', color: direction === value ? '#fff' : 'var(--text-primary)' }}>{value}</button>)}
        </div>
        <div style={{ maxHeight: 370, overflowY: 'auto' }}>{items.map(item => <div key={item.path} className="surface-hover" role="button" tabIndex="0" onClick={() => onOpenPath(item)} onKeyDown={event => { if (event.key === 'Enter') onOpenPath(item); }} style={{ display: 'grid', gridTemplateColumns: '2fr 90px 90px 70px', gap: 8, padding: '6px 12px', cursor: 'pointer', borderBottom: '1px solid var(--border)' }}>
          <span title={item.path} style={{ overflow: 'hidden', textOverflow: 'ellipsis' }}>{item.path}</span>
          <span className="mono" style={{ color: item.delta_bytes > 0 ? 'var(--danger)' : 'var(--success)', textAlign: 'right' }}>{item.delta_bytes > 0 ? '+' : '-'}{formatBytes(Math.abs(item.delta_bytes))}</span>
          <span className="mono" style={{ textAlign: 'right' }}>{formatBytes(item.current_bytes)}</span><span>{item.status}</span>
        </div>)}</div>
        {!data.baseline_scan_id && <div style={{ padding: 18, textAlign: 'center', color: 'var(--text-secondary)' }}>Complete two scans to compare directory growth.</div>}
      </div>;
    }

    function ActionPanel({ findings, snapshots, largeFiles, providers, orphans, busyToken, onExecute, onReveal, onOpenGrowthPath, isScanning }) {
      const [activeTab, setActiveTab] = useState('findings');
      const findingsCount = findings?.items?.length || 0;
      const snapshotsCount = snapshots?.items?.length || 0;
      const largeFilesCount = largeFiles?.items?.length || 0;
      const providersCount = providers?.items?.length || 0;
      const orphansCount = orphans?.items?.length || 0;

      return (
        <div className="surface" style={{ borderRadius: 8, overflow: 'hidden' }}>
          {/* Tab bar */}
          <div style={{ display: 'flex', borderBottom: '1px solid var(--border)' }}>
            {[
              { key: 'findings', label: 'Findings', count: findingsCount },
              { key: 'snapshots', label: 'Snapshots', count: snapshotsCount },
              { key: 'large_files', label: 'Large Files', count: largeFilesCount },
              { key: 'providers', label: 'Providers', count: providersCount },
              { key: 'growth', label: 'Growth', count: 0 },
              { key: 'orphans', label: 'App Leftovers', count: orphansCount },
            ].map(t => (
              <button key={t.key} className={`tab ${activeTab === t.key ? 'active' : ''}`}
                   onClick={() => setActiveTab(t.key)}
                   style={{ background: 'none', border: 'none', borderBottom: undefined }}>
                {t.label}
                <span style={{ marginLeft: 4, padding: '1px 6px', borderRadius: 8, fontSize: 11, background: activeTab === t.key ? 'var(--accent)' : 'var(--surface-hover)', color: activeTab === t.key ? '#fff' : 'var(--text-secondary)' }}>
                  {t.count}
                </span>
              </button>
            ))}
          </div>

          {/* Tab content */}
          {activeTab === 'findings' && (
            <FindingsTab findings={findings} busyToken={busyToken} onExecute={onExecute} onReveal={onReveal} isScanning={isScanning} />
          )}
          {activeTab === 'snapshots' && (
            <SnapshotsTab snapshots={snapshots} busyToken={busyToken} onExecute={onExecute} isScanning={isScanning} />
          )}
          {activeTab === 'large_files' && (
            <LargeFilesTab largeFiles={largeFiles} onReveal={onReveal} isScanning={isScanning} />
          )}
          {activeTab === 'providers' && <ProvidersTab providers={providers} busyToken={busyToken} onExecute={onExecute} />}
          {activeTab === 'growth' && <GrowthTab onOpenPath={onOpenGrowthPath} />}
          {activeTab === 'orphans' && <OrphansTab orphans={orphans} onReveal={onReveal} />}
        </div>
      );
    }

    function App() {
      const {
        metadata, summary, breakdowns, findings, snapshots, largeFiles, providers, orphans,
        checks, scanStatus, busyToken, message, messageType,
        triggerScan, executeAction, revealPath, rescanPath, dismissMessage,
      } = useMonitorState();

      const [activeRoot, setActiveRoot] = useState(null);
      const [growthPath, setGrowthPath] = useState(null);
      const isScanning = scanStatus?.running;

      // Auto-dismiss messages: 3s for success, 6s for errors
      useEffect(() => {
        if (!message) return;
        const delay = messageType === 'error' ? 6000 : 3000;
        const timer = setTimeout(dismissMessage, delay);
        return () => clearTimeout(timer);
      }, [message, messageType, dismissMessage]);

      // Auto-select first available root
      useEffect(() => {
        if (activeRoot) return;
        for (const key of ['data_root', 'home_root', 'library_root', 'applications_root']) {
          if (breakdowns[key]?.items?.length > 0) {
            setActiveRoot(key);
            break;
          }
        }
      }, [breakdowns, activeRoot]);

      return (
        <div style={{ minHeight: '100vh', display: 'flex', flexDirection: 'column' }}>
          {/* Zone 1: Header */}
          <HeaderBar
            metadata={metadata}
            summary={summary}
            scanStatus={scanStatus}
            onRescan={triggerScan}
            onToggleTheme={toggleTheme}
            checks={checks}
          />

          {/* Message bar */}
          {message && (
            <div style={{
