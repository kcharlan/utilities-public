          html`<div style=${{ padding: 16 }}> <div class=${"shimmer"} style=${{ height: 16, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 12, marginBottom: 6 }} /> <div class=${"shimmer"} style=${{ height: 12, marginBottom: 6 }} /> <div class=${"shimmer"} style=${{ height: 12 }} /> </div>`
