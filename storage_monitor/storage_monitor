def allocated_bytes_from_stat(stat_result: Optional[os.stat_result]) -> Optional[int]:
    if stat_result is None:
        return None
    blocks = getattr(stat_result, "st_blocks", None)
    if blocks is None:
        return None
    return int(blocks) * 512


@dataclass
class WalkResult:
    dir_local: Dict[str, int]
    hardlink_candidates: List[Tuple[int, int, str, str, int, int]]
    large_files: List[Dict[str, Any]]
    dir_count: int
    file_count: int
    error_count: int
    duration_ms: int


def walk_tree(
    root: Path,
    *,
    workers: int = SCAN_WORKER_COUNT,
    excluded_paths: Optional[List[Path]] = None,
    registered_inodes: Optional[Set[int]] = None,
    progress_callback: Optional[Callable[[int], None]] = None,
) -> WalkResult:
    started = time.time()
    root_str = str(root)
    root_stat = os.lstat(root_str)
    root_dev = root_stat.st_dev
    excluded = {str(path) for path in (excluded_paths or [])}
    registered = registered_inodes or set()
    dir_local: Dict[str, int] = {}
    hardlinks: List[Tuple[int, int, str, str, int, int]] = []
    large_files: List[Dict[str, Any]] = []
    counts = {"dirs": 0, "files": 0, "errors": 0, "pending": 1}
    lock = threading.Lock()
    done = threading.Event()
    executor: Optional[concurrent.futures.ThreadPoolExecutor] = None

    def scan_dir(path_str: str, own_bytes: int) -> None:
        nonlocal executor
        local_bytes = own_bytes
        children: List[Tuple[str, int]] = []
        local_hardlinks: List[Tuple[int, int, str, str, int, int]] = []
        local_large: List[Dict[str, Any]] = []
        local_files = 0
        local_errors = 0
        try:
            with os.scandir(path_str) as entries:
                for entry in entries:
                    try:
                        stat_result = entry.stat(follow_symlinks=False)
                    except OSError:
                        local_errors += 1
                        continue
                    if stat_result.st_dev != root_dev:
                        continue
                    allocated = int(getattr(stat_result, "st_blocks", 0)) * 512
                    entry_path = os.path.join(path_str, entry.name)
                    if entry.is_dir(follow_symlinks=False):
                        if entry_path not in excluded:
                            children.append((entry_path, allocated))
                        continue
                    local_files += 1
                    if stat_result.st_nlink > 1 or stat_result.st_ino in registered:
                        local_hardlinks.append(
                            (stat_result.st_dev, stat_result.st_ino, entry_path, path_str, allocated, stat_result.st_nlink)
                        )
                    else:
                        local_bytes += allocated
                    if stat_result.st_size >= LARGE_FILE_THRESHOLD_BYTES:
                        local_large.append({
                            "path": entry_path,
                            "parent_path": path_str,
                            "name": entry.name,
                            "apparent_bytes": int(stat_result.st_size),
                            "allocated_bytes": allocated,
                        })
        except OSError:
            local_errors += 1
        with lock:
            dir_local[path_str] = local_bytes
            hardlinks.extend(local_hardlinks)
            large_files.extend(local_large)
            counts["dirs"] += 1
            counts["files"] += local_files
            counts["errors"] += local_errors
            counts["pending"] += len(children)
            completed = counts["dirs"]
        assert executor is not None
        for child_path, child_bytes in children:
            executor.submit(scan_dir, child_path, child_bytes)
        with lock:
            counts["pending"] -= 1
            if counts["pending"] == 0:
                done.set()
        if progress_callback is not None and completed % 2000 == 0:
            progress_callback(completed)

    executor = concurrent.futures.ThreadPoolExecutor(max_workers=max(1, workers))
    try:
        executor.submit(scan_dir, root_str, int(getattr(root_stat, "st_blocks", 0)) * 512)
        done.wait()
    finally:
        executor.shutdown(wait=True)
    return WalkResult(
        dir_local=dir_local,
        hardlink_candidates=hardlinks,
        large_files=large_files,
        dir_count=counts["dirs"],
        file_count=counts["files"],
        error_count=counts["errors"],
        duration_ms=int((time.time() - started) * 1000),
    )


def rollup_subtree_totals(dir_local: Dict[str, int], root: str) -> Dict[str, int]:
    totals = dict(dir_local)
    for path_str in sorted(totals, key=lambda value: value.count(os.sep), reverse=True):
        if path_str == root:
            continue
        parent = os.path.dirname(path_str)
        if parent in totals:
            totals[parent] += totals[path_str]
    return totals


def build_walk_translation() -> List[Tuple[str, str, str]]:
    mappings: List[Tuple[str, str, str]] = []
    data_home = DATA_VOLUME / "Users" / HOME_DIR.name
    home = HOME_DIR.resolve()
    data_apps = DATA_VOLUME / "Applications"
    apps = APPLICATIONS_DIR.resolve()
    if samefile_or_false(data_home, home):
        mappings.append((str(data_home), str(home), "home_root"))
    mappings.append((str(home), str(home), "home_root"))
    if samefile_or_false(data_apps, apps):
        mappings.append((str(data_apps), str(apps), "applications_root"))
    mappings.append((str(apps), str(apps), "applications_root"))
    return sorted(mappings, key=lambda item: len(item[0]), reverse=True)


def translate_walk_path(path_str: str, translation: List[Tuple[str, str, str]]) -> Tuple[str, str]:
    for walked_prefix, stored_prefix, root_key in translation:
        if path_str == walked_prefix:
            return stored_prefix, root_key
        if path_str.startswith(walked_prefix + os.sep):
            return stored_prefix + path_str[len(walked_prefix):], root_key
    return path_str, "data_root"


def resolve_hardlink_ownership(
    scan_id: int,
    candidates: List[Tuple[int, int, str, str, int, int]],
    translation: List[Tuple[str, str, str]],
    *,
    full_scan: bool,
    connection: Optional[sqlite3.Connection] = None,
) -> Tuple[List[Tuple[str, int]], List[Tuple[str, int]], List[Tuple[str, Tuple[Any, ...]]]]:
    grouped: Dict[Tuple[int, int], List[Tuple[int, int, str, str, int, int]]] = {}
    for candidate in candidates:
        grouped.setdefault((candidate[0], candidate[1]), []).append(candidate)
    attributions: List[Tuple[str, int]] = []
    adjustments: List[Tuple[str, int]] = []
    changes: List[Tuple[str, Tuple[Any, ...]]] = []
    existing: Dict[int, sqlite3.Row] = {}
    db = connection
    owns_connection = db is None
    if db is None and not full_scan:
        db = open_db_connection()
    try:
        if not full_scan and grouped:
            assert db is not None
            inos = [key[1] for key in grouped]
            for offset in range(0, len(inos), 900):
                chunk = inos[offset:offset + 900]
                placeholders = ",".join("?" for _ in chunk)
                for row in db.execute(
                    f"SELECT ino, dev, owner_path, allocated_bytes FROM hardlink_inodes WHERE scan_id = ? AND ino IN ({placeholders})",
                    (scan_id, *chunk),
                ):
                    existing[int(row["ino"])] = row
        for (dev, ino), group in grouped.items():
            translated = [(translate_walk_path(item[2], translation)[0], item) for item in group]
            translated.sort(key=lambda item: item[0])
            row = existing.get(ino)
            if row is None and all(item[1][5] == 1 for item in translated):
                attributions.extend((item[1][3], item[1][4]) for item in translated)
                continue
            owner_path = translated[0][0]
            owner_item = translated[0][1]
            if row is not None:
                valid = False
                try:
                    owner_stat = os.lstat(row["owner_path"])
                    valid = owner_stat.st_dev == row["dev"] and owner_stat.st_ino == row["ino"]
                except OSError:
                    pass
                candidates_by_path = {path: item for path, item in translated}
                if row["owner_path"] in candidates_by_path:
                    owner_path = row["owner_path"]
                    owner_item = candidates_by_path[owner_path]
                elif valid:
                    continue
                else:
                    adjustments.append((os.path.dirname(row["owner_path"]), -int(row["allocated_bytes"])))
            attributions.append((owner_item[3], owner_item[4]))
            if all(item[1][5] == 1 for item in translated):
                changes.append(("delete", (scan_id, ino)))
            else:
                changes.append(("upsert", (scan_id, ino, dev, owner_path, owner_item[4])))
    finally:
        if owns_connection and db is not None:
            db.close()
    return attributions, adjustments, changes


def du_bytes(path: Path, timeout: int = 240) -> Optional[int]:
    if not path.exists():
        return None
    result = run_command(["d" + "u", "-xsk", str(path)], timeout=timeout)
    if not result["stdout"].strip():
        return None
    first = result["stdout"].strip().splitlines()[0]
    match = re.match(r"^\s*(\d+)", first)
    if not match:
        return None
    return int(match.group(1)) * 1024


def stat_file_sizes(path: Path) -> Dict[str, Optional[int]]:
    stat_result = safe_stat(path)
    if stat_result is None:
        return {"apparent_bytes": None, "allocated_bytes": None}
    return {
        "apparent_bytes": int(stat_result.st_size),
        "allocated_bytes": allocated_bytes_from_stat(stat_result) or int(stat_result.st_size),
    }


def bytes_or_zero(value: Optional[int]) -> int:
    return int(value or 0)


def format_number(value: Optional[int]) -> str:
    if value is None:
        return "Unknown"
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    amount = float(value)
    for unit in units:
        if amount < 1024.0 or unit == units[-1]:
            if unit == "B":
                return f"{int(amount)} {unit}"
            return f"{amount:.1f} {unit}"
        amount /= 1024.0
    return f"{int(value)} B"


def encode_action_token(payload: Dict[str, Any]) -> str:
    return base64.urlsafe_b64encode(json.dumps(payload, sort_keys=True).encode("utf-8")).decode("ascii")


def decode_action_token(token: str) -> Dict[str, Any]:
    return json.loads(base64.urlsafe_b64decode(token.encode("ascii")).decode("utf-8"))


def publish_event(event_type: str, payload: Dict[str, Any]) -> None:
    message = {"type": event_type, "payload": payload}
    stale_ids: List[str] = []
    with STATE.lock:
        subscribers = list(STATE.subscribers.items())
    for subscriber_id, subscriber_queue in subscribers:
        try:
            subscriber_queue.put_nowait(message)
        except Exception:
            stale_ids.append(subscriber_id)
    if stale_ids:
        with STATE.lock:
            for subscriber_id in stale_ids:
                STATE.subscribers.pop(subscriber_id, None)


def set_scan_status(**updates: Any) -> None:
    with STATE.lock:
        STATE.scan_status.update(updates)
        STATE.scan_status["updated_at"] = iso_now()
        snapshot = dict(STATE.scan_status)
    publish_event("scan_status", snapshot)


def load_latest_report() -> None:
    scan_id = fetch_active_scan_id()
    report = fetch_scan_report_json(scan_id) if scan_id is not None else None
    if report is None and RUNTIME_PATHS.latest_scan.is_file():
        try:
            report = json.loads(RUNTIME_PATHS.latest_scan.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            return
    if report is None:
        return
    with STATE.lock:
        STATE.report = report


def add_subscriber() -> str:
    subscriber_id = str(uuid.uuid4())
    with STATE.lock:
        STATE.subscribers[subscriber_id] = queue.Queue()
    return subscriber_id


def remove_subscriber(subscriber_id: str) -> None:
    with STATE.lock:
        STATE.subscribers.pop(subscriber_id, None)


def sse_event_stream():
    subscriber_id = add_subscriber()
    try:
        with STATE.lock:
            if STATE.report is not None:
                yield f"data: {json.dumps({'type': 'report', 'payload': STATE.report})}\n\n"
            yield f"data: {json.dumps({'type': 'scan_status', 'payload': STATE.scan_status})}\n\n"
        while True:
            try:
                message = STATE.subscribers[subscriber_id].get(timeout=15)
            except queue.Empty:
                yield "event: heartbeat\ndata: {}\n\n"
                continue
            yield f"data: {json.dumps(message)}\n\n"
    finally:
        remove_subscriber(subscriber_id)


def extract_parenthetical_bytes(text: str) -> Optional[int]:
    match = re.search(r"\((\d+)\s+Bytes\)", text)
    if match:
        return int(match.group(1))
    return None


def parse_diskutil_info(stdout: str) -> Dict[str, Optional[int]]:
    info = {
        "volume_used_bytes": None,
        "container_free_bytes": None,
        "disk_size_bytes": None,
        "container_total_space_bytes": None,
    }
    for line in stdout.splitlines():
        if "Volume Used Space:" in line:
            info["volume_used_bytes"] = extract_parenthetical_bytes(line)
        elif "Container Free Space:" in line:
            info["container_free_bytes"] = extract_parenthetical_bytes(line)
        elif "Container Total Space:" in line:
            info["container_total_space_bytes"] = extract_parenthetical_bytes(line)
        elif "Disk Size:" in line:
            info["disk_size_bytes"] = extract_parenthetical_bytes(line)
    return info


def parse_apfs_list(stdout: str) -> Dict[str, Optional[int]]:
    parsed = {
        "container_size_bytes": None,
        "container_used_bytes": None,
    }
    size_match = re.search(r"Size \(Capacity Ceiling\):\s+(\d+)\s+B", stdout)
    used_match = re.search(r"Capacity In Use By Volumes:\s+(\d+)\s+B", stdout)
    if size_match:
        parsed["container_size_bytes"] = int(size_match.group(1))
    if used_match:
        parsed["container_used_bytes"] = int(used_match.group(1))
    return parsed


def parse_local_snapshot_names(stdout: str) -> List[str]:
    names: List[str] = []
    for line in stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("Snapshots for volume group"):
            continue
        if line.startswith("com.apple."):
            names.append(line)
    return names


def parse_snapshot_token(snapshot_name: str) -> Optional[str]:
    match = re.match(r"com\.apple\.TimeMachine\.(\d{4}-\d{2}-\d{2}-\d{6})\.local", snapshot_name)
    if match:
        return match.group(1)
    return None


def list_root_breakdown(root: Path, limit: Optional[int] = MAX_TOP_ITEMS) -> Dict[str, Any]:
    started = time.time()
    if not root.exists():
        return {"total_bytes": None, "items": [], "duration_ms": 0}
    result = run_command(["d" + "u", "-x", "-k", "-d", "1", str(root)], timeout=360)
    if not result["stdout"].strip():
        return {"total_bytes": None, "items": [], "duration_ms": result["duration_ms"]}
    items: List[Dict[str, Any]] = []
    total_bytes: Optional[int] = None
    root_str = str(root).rstrip("/")
    root_resolved = str(root.resolve()).rstrip("/")
    for line in result["stdout"].splitlines():
        line = line.strip()
        if not line:
            continue
        if "\t" in line:
            size_str, path_str = line.split("\t", 1)
        else:
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            size_str, path_str = parts
        if not size_str.isdigit():
            continue
        allocated_bytes = int(size_str) * 1024
        path_obj = Path(path_str)
        path_raw = path_str.rstrip("/")
        try:
            path_resolved = str(path_obj.resolve()).rstrip("/")
        except OSError:
            path_resolved = path_raw
        if path_raw in {root_str, root_resolved} or path_resolved in {root_str, root_resolved}:
            total_bytes = allocated_bytes
            continue
        # Detect firmlinks: on macOS /Users and /System/Volumes/Data/Users are
        # the same directory but Path.resolve() does not resolve firmlinks.
        # os.path.samefile compares device/inode and handles this correctly.
        try:
            if os.path.samefile(path_str, str(root)):
                total_bytes = allocated_bytes
                continue
        except OSError:
            pass
        items.append(
            {
                "path": path_str,
                "label": path_obj.name or path_str,
                "allocated_bytes": allocated_bytes,
            }
        )
    # If du found no subdirectory items, list individual files in this directory.
    # du -d 1 only reports directories, so leaf directories with only files appear empty.
    if not items:
        try:
            for entry in root.iterdir():
                try:
                    if entry.is_file(follow_symlinks=False):
                        stat = entry.stat(follow_symlinks=False)
                        items.append(
                            {
                                "path": str(entry),
                                "label": entry.name,
                                "allocated_bytes": stat.st_blocks * 512 if hasattr(stat, "st_blocks") else stat.st_size,
                                "is_file": True,
                            }
                        )
                except (PermissionError, OSError):
                    continue
        except (PermissionError, OSError):
            pass
    items.sort(key=lambda item: item["allocated_bytes"], reverse=True)
    if total_bytes is None and items:
        total_bytes = sum(item["allocated_bytes"] for item in items)
    return {
        "total_bytes": total_bytes,
        "items": items[:limit] if limit is not None else items,
        "duration_ms": int((time.time() - started) * 1000),
    }


def scan_directory_index(root: Path, root_key: str, timeout: int = 1800) -> Dict[str, Any]:
    started = time.time()
    if not root.exists():
        return {"total_bytes": None, "items": [], "rows": [], "duration_ms": 0}
    result = run_command(["d" + "u", "-x", "-k", str(root)], timeout=timeout)
    if not result["stdout"].strip():
        return {"total_bytes": None, "items": [], "rows": [], "duration_ms": result["duration_ms"]}

    updated_at = iso_now()
    rows: List[Dict[str, Any]] = []
    root_path = str(root.resolve())
    immediate_items: List[Dict[str, Any]] = []
    total_bytes: Optional[int] = None

    for line in result["stdout"].splitlines():
        line = line.strip()
        if not line:
            continue
        if "\t" in line:
            size_str, path_str = line.split("\t", 1)
        else:
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            size_str, path_str = parts
        if not size_str.isdigit():
            continue
        try:
            resolved = str(Path(path_str).resolve())
        except OSError:
            resolved = path_str
        allocated_bytes = int(size_str) * 1024
        parent_path = None if resolved == root_path else str(Path(resolved).parent)
        rows.append(
            {
                "path": resolved,
                "parent_path": parent_path,
                "name": Path(resolved).name or resolved,
                "root_key": root_key,
                "depth": path_depth(root, resolved),
                "allocated_bytes": allocated_bytes,
                "children_indexed": True,
                "updated_at": updated_at,
            }
        )
        if resolved == root_path:
            total_bytes = allocated_bytes
        elif parent_path == root_path:
            immediate_items.append(
                {
                    "path": resolved,
                    "label": Path(resolved).name or resolved,
                    "allocated_bytes": allocated_bytes,
                }
            )

    immediate_items.sort(key=lambda item: item["allocated_bytes"], reverse=True)
    return {
        "total_bytes": total_bytes,
        "items": immediate_items[:MAX_TOP_ITEMS],
        "rows": rows,
        "duration_ms": int((time.time() - started) * 1000),
    }


def scan_immediate_child_breakdown(
    root: Path,
    *,
    exclude_names: Optional[List[str]] = None,
    injected_items: Optional[List[Dict[str, Any]]] = None,
    limit: int = MAX_TOP_ITEMS,
) -> Dict[str, Any]:
    started = time.time()
    if not root.exists():
        return {"total_bytes": None, "items": [], "duration_ms": 0}
    exclude = set(exclude_names or [])
    try:
        children = [child for child in root.iterdir() if child.name not in exclude]
    except OSError:
        return {"total_bytes": None, "items": [], "duration_ms": int((time.time() - started) * 1000)}
    task_map = {
        str(child): (lambda child=child: du_bytes(child, timeout=300))
        for child in children
    }
    child_sizes = run_parallel_call_map(task_map, max_workers=min(SCAN_WORKER_COUNT, max(1, len(task_map))))
    items: List[Dict[str, Any]] = []
    for child in children:
        allocated_bytes = child_sizes.get(str(child))
        if allocated_bytes is None:
            continue
        items.append(
            {
                "path": str(child),
                "label": child.name or str(child),
                "allocated_bytes": allocated_bytes,
            }
        )
    for item in injected_items or []:
        if item.get("allocated_bytes") is None:
            continue
        items.append(item)
    items.sort(key=lambda item: item["allocated_bytes"], reverse=True)
    total_bytes = sum(item["allocated_bytes"] for item in items)
    return {
        "total_bytes": total_bytes,
        "items": items[:limit],
        "duration_ms": int((time.time() - started) * 1000),
    }


def scan_watchlist_entry(spec: Dict[str, Any], scan_id: Optional[int] = None) -> Dict[str, Any]:
    path = expand_path(spec["path"])
    exists = path.exists()
    allocated = None
    scan_id = scan_id or fetch_active_scan_id() or fetch_running_scan_id()
    if exists and path.is_dir() and scan_id is not None:
        with open_db_connection() as connection:
            row = connection.execute(
                "SELECT allocated_bytes FROM nodes WHERE scan_id = ? AND path = ?",
                (scan_id, str(path)),
            ).fetchone()
        allocated = int(row["allocated_bytes"]) if row else None
    if exists and path.is_dir() and allocated is None:
        fallback = walk_tree(path, workers=SCAN_WORKER_COUNT, excluded_paths=[])
        _, _, changes = resolve_hardlink_ownership(-1, fallback.hardlink_candidates, build_walk_translation(), full_scan=True)
        for operation, payload in changes:
            if operation == "upsert":
                owner = payload[3]
                for candidate in fallback.hardlink_candidates:
                    if translate_walk_path(candidate[2], build_walk_translation())[0] == owner:
                        fallback.dir_local[candidate[3]] = fallback.dir_local.get(candidate[3], 0) + candidate[4]
                        break
        allocated = rollup_subtree_totals(fallback.dir_local, str(path)).get(str(path))
    apparent = allocated
    if exists and path.is_file():
        file_sizes = stat_file_sizes(path)
        apparent = file_sizes["apparent_bytes"]
        allocated = file_sizes["allocated_bytes"]
    token = encode_action_token(
        {
            "kind": spec["cleanup_kind"],
            "path": str(path),
            "slug": spec["slug"],
        }
    ) if exists and spec["cleanup_kind"] else None
    return {
        "slug": spec["slug"],
        "label": spec["label"],
        "path": str(path),
        "exists": exists,
        "category": spec["category"],
        "risk": spec["risk"],
        "description": spec["description"],
        "actionable": bool(exists and spec["actionable"] and spec["cleanup_kind"]),
        "cleanup_kind": spec["cleanup_kind"],
        "apparent_bytes": apparent,
        "allocated_bytes": allocated,
        "estimated_reclaim_bytes": allocated if exists and spec["cleanup_kind"] else None,
        "action_token": token,
    }


def scan_watchlist(scan_id: Optional[int] = None) -> Dict[str, Any]:
    started = time.time()
    task_map = {
        spec["slug"]: (lambda spec=spec: scan_watchlist_entry(spec, scan_id))
        for spec in WATCHLIST_SPECS
    }
    results = list(run_parallel_call_map(task_map).values())
    results.sort(key=lambda item: bytes_or_zero(item["allocated_bytes"]), reverse=True)
    return {
        "items": results,
        "duration_ms": int((time.time() - started) * 1000),
    }


def scan_large_files_in_root(root: Path) -> List[Dict[str, Any]]:
    result = run_command(
        [
            "f" + "ind",
            str(root),
            "-xdev",
            "-type",
            "f",
            "-size",
            f"+{int(LARGE_FILE_THRESHOLD_BYTES / (1024 * 1024))}M",
            "-print",
        ],
        timeout=240,
    )
    if not result["ok"]:
        return []
    items: List[Dict[str, Any]] = []
    for line in result["stdout"].splitlines():
        if not line.strip():
            continue
        path = Path(line.strip())
        sizes = stat_file_sizes(path)
        if sizes["apparent_bytes"] is None:
            continue
        items.append(
            {
                "label": path.name,
                "path": str(path),
                "parent_path": str(path.parent),
                "category": "large_file",
                "risk": "high",
                "apparent_bytes": sizes["apparent_bytes"],
                "allocated_bytes": sizes["allocated_bytes"],
                "description": LARGE_FILE_DESCRIPTION,
                "actionable": False,
            }
        )
    return items


def scan_large_files(
    roots: List[Path],
    limit: int = 25,
    progress_callback: Optional[Any] = None,
) -> Dict[str, Any]:
    started = time.time()
    items: List[Dict[str, Any]] = []
    seen_paths = set()
    task_roots = [root for root in roots if root.exists()]
    task_map = {
        str(root): (lambda root=root: scan_large_files_in_root(root))
        for root in task_roots
    }
    grouped = run_parallel_call_map(task_map, progress_callback=progress_callback)
    for root_items in grouped.values():
        for item in root_items:
            if item["path"] in seen_paths:
                continue
            seen_paths.add(item["path"])
            items.append(item)
    items.sort(key=lambda item: bytes_or_zero(item["allocated_bytes"]), reverse=True)
    return {
        "items": items[:limit],
        "duration_ms": int((time.time() - started) * 1000),
    }



def build_finding_actions(finding: Dict[str, Any]) -> List[Dict[str, Any]]:
    actions: List[Dict[str, Any]] = []
    actions.append(
        {
            "label": "Reveal in Finder",
            "kind": "reveal",
            "target_path": finding["path"],
            "risk": "none",
            "estimated_reclaim_bytes": None,
        }
    )
    if finding.get("actionable") and finding.get("action_token"):
        action_kind = finding.get("cleanup_kind") or "cleanup"
        if action_kind == "trash_path":
            actions.append(
                {
                    "label": "Move to Trash",
                    "kind": "execute",
                    "action_token": finding["action_token"],
                    "risk": finding["risk"],
                    "estimated_reclaim_bytes": finding.get("estimated_reclaim_bytes"),
                }
            )
        elif action_kind == "delete_snapshot":
            actions.append(
                {
                    "label": "Delete Snapshot",
                    "kind": "execute",
                    "action_token": finding["action_token"],
                    "risk": finding["risk"],
                    "estimated_reclaim_bytes": None,
                }
            )
    return actions


def summarize_checks(checks: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    return checks


def _legacy_collect_scan_report(scan_id: int) -> Dict[str, Any]:
    started_at = iso_now()
    checks: List[Dict[str, Any]] = []
    warnings: List[str] = []
    phases = [
        ("Metadata probes", 0.12),
        ("Parallel root scans", 0.63),
        ("Large file scan", 0.20),
        ("Report assembly", 0.05),
    ]
    phase_offsets: Dict[str, float] = {}
    offset = 0.0
    for phase_name, weight in phases:
        phase_offsets[phase_name] = offset
        offset += weight

    def set_phase_progress(phase_name: str, completed: int, total: int, detail: str) -> None:
        phase_weight = dict(phases)[phase_name]
        phase_ratio = 1.0 if total <= 0 else max(0.0, min(1.0, completed / total))
        progress = phase_offsets[phase_name] + (phase_weight * phase_ratio)
        set_scan_status(
            running=True,
            phase=phase_name,
            detail=detail,
            progress=progress,
            error=None,
        )

    def phase_callback_builder(phase_name: str):
        def _callback(task_name: str, completed: int, total: int) -> None:
            pretty = task_name.replace("_", " ")
            set_phase_progress(phase_name, completed, total, f"{pretty} complete")
        return _callback

    metadata_phase = "Metadata probes"
    root_phase = "Parallel root scans"
    large_phase = "Large file scan"
    assembly_phase = "Report assembly"

    set_phase_progress(metadata_phase, 0, 4, "Starting metadata probes")
    metadata_results = run_parallel_call_map(
        {
            "apfs_list": lambda: run_command(["diskutil", "apfs", "list"], timeout=120),
            "data_info": lambda: run_command(["diskutil", "info", str(DATA_VOLUME)], timeout=120),
            "root_info": lambda: run_command(["diskutil", "info", "/"], timeout=120),
            "snapshot_info": lambda: run_command(["tmutil", "listlocalsnapshots", "/"], timeout=120),
        },
        progress_callback=phase_callback_builder(metadata_phase),
    )
    apfs_list = metadata_results["apfs_list"]
    data_info = metadata_results["data_info"]
    root_info = metadata_results["root_info"]
    snapshot_info = metadata_results["snapshot_info"]
    checks.append(
        {
            "label": "APFS container",
            "command": apfs_list["command"],
            "ok": apfs_list["ok"],
            "duration_ms": apfs_list["duration_ms"],
            "summary": "Collected APFS container accounting." if apfs_list["ok"] else apfs_list["stderr"],
        }
    )
    checks.append(
        {
            "label": "Data volume info",
            "command": data_info["command"],
            "ok": data_info["ok"],
            "duration_ms": data_info["duration_ms"],
            "summary": "Collected Data volume usage." if data_info["ok"] else data_info["stderr"],
        }
    )
    checks.append(
        {
            "label": "System volume info",
            "command": root_info["command"],
            "ok": root_info["ok"],
            "duration_ms": root_info["duration_ms"],
            "summary": "Collected mounted system snapshot usage." if root_info["ok"] else root_info["stderr"],
        }
    )

    checks.append(
        {
            "label": "Local snapshots",
            "command": snapshot_info["command"],
            "ok": snapshot_info["ok"],
            "duration_ms": snapshot_info["duration_ms"],
            "summary": "Enumerated local snapshots." if snapshot_info["ok"] else snapshot_info["stderr"],
        }
    )

    # Parse metadata results early so we can stream them before root scans begin
    apfs_container = parse_apfs_list(apfs_list["stdout"] if apfs_list["ok"] else "")
    data_volume = parse_diskutil_info(data_info["stdout"] if data_info["ok"] else "")
    system_volume = parse_diskutil_info(root_info["stdout"] if root_info["ok"] else "")
    snapshot_names = parse_local_snapshot_names(snapshot_info["stdout"] if snapshot_info["ok"] else "")

    publish_event("metadata_ready", {
        "container_size_bytes": apfs_container["container_size_bytes"] or data_volume["disk_size_bytes"],
        "container_used_bytes": apfs_container["container_used_bytes"],
        "container_free_bytes": data_volume["container_free_bytes"],
        "data_volume_used_bytes": data_volume["volume_used_bytes"],
        "system_volume_used_bytes": system_volume["volume_used_bytes"],
        "updated_at": iso_now(),
    })

    for name in snapshot_names:
        token = parse_snapshot_token(name)
        if token is None:
            continue
        action_token = encode_action_token({"kind": "delete_snapshot", "snapshot_name": name, "token": token})
        try:
            parsed_date = datetime.strptime(token, "%Y-%m-%d-%H%M%S").replace(tzinfo=timezone.utc).isoformat()
        except ValueError:
            parsed_date = None
        publish_event("snapshot_found", {
            "snapshot_name": name,
            "parsed_date": parsed_date,
            "token": token,
            "action_token": action_token,
        })

    set_phase_progress(root_phase, 0, 5, "Starting root scans")
    root_scan_tasks = {
        "data_breakdown": lambda: list_root_breakdown(DATA_VOLUME, limit=None),
        "home_index": lambda: scan_directory_index(HOME_DIR, "home_root"),
        "applications_index": lambda: scan_directory_index(APPLICATIONS_DIR, "applications_root"),
        "watchlist": scan_watchlist,
    }
    parallel_scans = run_parallel_call_map(
        {
            **root_scan_tasks,
            "library_exists": lambda: {"exists": (HOME_DIR / "Library").exists()},
        },
        max_workers=min(SCAN_WORKER_COUNT, 5),
        progress_callback=phase_callback_builder(root_phase),
    )
    data_breakdown_result = parallel_scans["data_breakdown"]
    store_immediate_breakdown(scan_id, "data_root", DATA_VOLUME.resolve(), data_breakdown_result)
    data_prefetch_plan = select_data_prefetch_plan(data_breakdown_result["items"])
    for source_path, target_path in data_prefetch_plan["aliases"]:
        mark_alias_path_cached(scan_id, source_path, target_path, "data_root")
    data_prefetch_tasks = {
        str(path): (lambda path=path: scan_directory_index(path, "data_root"))
        for path in data_prefetch_plan["scan_paths"]
        if path.exists()
    }
    if data_prefetch_tasks:
        set_phase_progress(
            root_phase,
            5,
            5 + len(data_prefetch_tasks),
            "Prefetching top Data Volume subtrees",
        )
        prefetched = run_parallel_call_map(
            data_prefetch_tasks,
            max_workers=min(SCAN_WORKER_COUNT, max(1, len(data_prefetch_tasks))),
            progress_callback=lambda task_name, completed, total: set_phase_progress(
                root_phase,
                5 + completed,
                5 + total,
                f"{Path(task_name).name or task_name} prefetched",
            ),
        )
        for result in prefetched.values():
            upsert_node_rows(scan_id, result["rows"])
    visible_data_bytes = data_breakdown_result["total_bytes"]
    data_root_breakdown = fetch_breakdown_from_db(scan_id, str(DATA_VOLUME.resolve()))
    data_breakdown = data_root_breakdown["items"] if data_root_breakdown else data_breakdown_result["items"][:MAX_TOP_ITEMS]
    checks.append(
        {
            "label": "Visible Data volume usage",
            "command": f"du -xsk {DATA_VOLUME}",
            "ok": visible_data_bytes is not None,
            "duration_ms": data_breakdown_result.get("duration_ms"),
            "summary": f"Visible live data totals {format_number(visible_data_bytes)}.",
        }
    )

    home_index_result = parallel_scans["home_index"]
    upsert_node_rows(scan_id, home_index_result["rows"])
    home_root_breakdown = fetch_breakdown_from_db(scan_id, str(HOME_DIR.resolve()))
    home_breakdown = home_root_breakdown["items"] if home_root_breakdown else []
    home_total_bytes = home_root_breakdown["total_bytes"] if home_root_breakdown else None

    library_path = str((HOME_DIR / "Library").resolve())
    library_breakdown_result = fetch_breakdown_from_db(scan_id, library_path)
    if library_breakdown_result is None and parallel_scans["library_exists"]["exists"]:
        library_breakdown_result = {"path": library_path, "total_bytes": None, "items": [], "updated_at": iso_now()}
    library_breakdown = library_breakdown_result["items"] if library_breakdown_result else []
    large_file_roots: List[Path] = []
    for item in home_breakdown:
        if bytes_or_zero(item.get("allocated_bytes")) < 512 * 1024 * 1024:
            continue
        candidate = Path(item["path"])
        if not candidate.exists():
            continue
        large_file_roots.append(candidate)
    for fallback_name in ["Downloads", "Documents", "Pictures", "Movies"]:
        fallback_path = HOME_DIR / fallback_name
        if fallback_path.exists() and fallback_path not in large_file_roots:
            large_file_roots.append(fallback_path)
    checks.append(
        {
            "label": "Home directory usage",
            "command": f"du -xsk {HOME_DIR}",
            "ok": home_total_bytes is not None,
            "duration_ms": home_index_result.get("duration_ms"),
            "summary": f"Home directory totals {format_number(home_total_bytes)}.",
        }
    )
    checks.append(
        {
            "label": "Library usage",
            "command": f"du -xsk {HOME_DIR / 'Library'}",
            "ok": library_breakdown_result is not None and library_breakdown_result["total_bytes"] is not None,
            "duration_ms": home_index_result.get("duration_ms"),
            "summary": f"Library totals {format_number(library_breakdown_result['total_bytes'] if library_breakdown_result else None)}.",
        }
    )

    applications_breakdown_result = parallel_scans["applications_index"]
    upsert_node_rows(scan_id, applications_breakdown_result["rows"])
    applications_root_breakdown = fetch_breakdown_from_db(scan_id, str(APPLICATIONS_DIR.resolve()))
    applications_total_bytes = applications_root_breakdown["total_bytes"] if applications_root_breakdown else None
    applications_breakdown = applications_root_breakdown["items"] if applications_root_breakdown else []
    checks.append(
        {
            "label": "Applications usage",
            "command": f"du -xsk {APPLICATIONS_DIR}",
            "ok": applications_total_bytes is not None,
            "duration_ms": applications_breakdown_result.get("duration_ms"),
            "summary": f"Applications total {format_number(applications_total_bytes)}.",
        }
    )

    watchlist_result = parallel_scans["watchlist"]
    watchlist = watchlist_result["items"]
    checks.append(
        {
            "label": "Safe cleanup watchlist",
            "command": "internal watchlist probe set",
            "ok": True,
            "duration_ms": watchlist_result.get("duration_ms"),
            "summary": f"Scanned {len(watchlist)} known cache/runtime targets.",
        }
    )

    # Publish breakdown_ready events — home_root gets Library injected first (already done above)
    publish_event("breakdown_ready", {
        "root": "data_root",
        "items": data_breakdown,
        "total_bytes": data_breakdown_result["total_bytes"],
        "updated_at": iso_now(),
    })
    publish_event("breakdown_ready", {
        "root": "library_root",
        "items": library_breakdown,
        "total_bytes": library_breakdown_result["total_bytes"] if library_breakdown_result else None,
        "updated_at": iso_now(),
    })
    publish_event("breakdown_ready", {
        "root": "applications_root",
        "items": applications_breakdown,
        "total_bytes": applications_total_bytes,
        "updated_at": iso_now(),
    })
    publish_event("breakdown_ready", {
        "root": "home_root",
        "items": home_breakdown,
        "total_bytes": home_total_bytes,
        "updated_at": iso_now(),
    })

    set_phase_progress(large_phase, 0, max(1, len(large_file_roots)), "Starting large-file scan")
    large_files_result = scan_large_files(
        large_file_roots,
        progress_callback=phase_callback_builder(large_phase),
    )
    large_files = large_files_result["items"]
    replace_large_file_rows(scan_id, "home_root", [
        {
            "path": item["path"],
            "parent_path": item["parent_path"],
            "name": item["label"],
            "apparent_bytes": item["apparent_bytes"],
            "allocated_bytes": item["allocated_bytes"],
            "updated_at": iso_now(),
        }
        for item in large_files
    ])
    checks.append(
        {
            "label": "Large file inventory",
            "command": "targeted find probes across large home buckets",
            "ok": True,
            "duration_ms": large_files_result.get("duration_ms"),
            "summary": f"Found {len(large_files)} large files >= 1 GB.",
        }
    )

    set_phase_progress(assembly_phase, 0, 1, "Assembling final report")
    hidden_delta_bytes = None
    if data_volume["volume_used_bytes"] is not None and visible_data_bytes is not None:
        hidden_delta_bytes = max(data_volume["volume_used_bytes"] - visible_data_bytes, 0)

    # Build snapshots as a separate top-level section
    snapshots_updated_at = iso_now()
    snapshots_list: List[Dict[str, Any]] = []
    for name in snapshot_names:
        token = parse_snapshot_token(name)
        if token is None:
            continue
        action_token = encode_action_token({"kind": "delete_snapshot", "snapshot_name": name, "token": token})
        # Parse token (YYYY-MM-DD-HHMMSS) into ISO date string
        try:
            parsed_date = datetime.strptime(token, "%Y-%m-%d-%H%M%S").replace(tzinfo=timezone.utc).isoformat()
        except ValueError:
            parsed_date = None
        snapshots_list.append(
            {
                "snapshot_name": name,
                "token": token,
                "parsed_date": parsed_date,
                "action_token": action_token,
            }
        )

    findings_updated_at = iso_now()
    findings: List[Dict[str, Any]] = []
    for item in watchlist:
        if item["exists"]:
            findings.append(
                {
                    "label": item["label"],
                    "path": item["path"],
                    "category": item["category"],
                    "risk": item["risk"],
                    "description": item["description"],
                    "apparent_bytes": item["apparent_bytes"],
                    "allocated_bytes": item["allocated_bytes"],
                    "estimated_reclaim_bytes": item["estimated_reclaim_bytes"],
                    "actionable": item["actionable"],
                    "cleanup_kind": item["cleanup_kind"],
                    "action_token": item["action_token"],
                }
            )
    findings.sort(
        key=lambda item: (
            bytes_or_zero(item.get("estimated_reclaim_bytes")) or bytes_or_zero(item.get("allocated_bytes")),
        ),
        reverse=True,
    )
    findings = findings[:MAX_FINDINGS]
    for finding in findings:
        finding["actions"] = build_finding_actions(finding)
        publish_event("finding_added", finding)

    large_files_updated_at = iso_now()
    large_files_with_actions = list(large_files)
    for lf in large_files_with_actions:
        if "actions" not in lf:
            lf["actions"] = build_finding_actions(lf)
        publish_event("large_file_found", lf)

    safe_reclaimable_bytes = sum(
        bytes_or_zero(item.get("estimated_reclaim_bytes"))
        for item in findings
        if item.get("risk") == "low" and item.get("actionable")
    )
    medium_reclaimable_bytes = sum(
        bytes_or_zero(item.get("estimated_reclaim_bytes"))
        for item in findings
        if item.get("risk") == "medium" and item.get("actionable")
    )
    snapshot_count = len(snapshots_list)

    if not apfs_list["ok"]:
        warnings.append(f"Failed to collect APFS list: {apfs_list['stderr']}")
    if not snapshot_info["ok"]:
        warnings.append(f"Failed to collect local snapshots: {snapshot_info['stderr']}")
    if hidden_delta_bytes is None:
        warnings.append("Could not compute hidden/system-managed delta on the Data volume.")

    breakdowns_updated_at = iso_now()
    report = {
        "version": VERSION,
        "generated_at": iso_now(),
        "started_at": started_at,
        "warnings": warnings,
        "summary": {
            "container_size_bytes": apfs_container["container_size_bytes"] or data_volume["disk_size_bytes"],
            "container_used_bytes": apfs_container["container_used_bytes"],
            "container_free_bytes": data_volume["container_free_bytes"],
            "data_volume_used_bytes": data_volume["volume_used_bytes"],
            "system_volume_used_bytes": system_volume["volume_used_bytes"],
            "visible_data_bytes": visible_data_bytes,
            "hidden_delta_bytes": hidden_delta_bytes,
            "home_total_bytes": home_total_bytes,
            "applications_total_bytes": applications_total_bytes,
            "snapshot_count": snapshot_count,
            "safe_reclaimable_bytes": safe_reclaimable_bytes,
            "medium_reclaimable_bytes": medium_reclaimable_bytes,
        },
        "breakdowns": {
            "data_root": {
                "items": data_breakdown,
                "total_bytes": data_breakdown_result["total_bytes"],
                "updated_at": breakdowns_updated_at,
            },
            "home_root": {
                "items": home_breakdown,
                "total_bytes": home_total_bytes,
                "updated_at": breakdowns_updated_at,
            },
            "library_root": {
                "items": library_breakdown,
                "total_bytes": library_breakdown_result["total_bytes"],
                "updated_at": breakdowns_updated_at,
            },
            "applications_root": {
                "items": applications_breakdown,
                "total_bytes": applications_total_bytes,
                "updated_at": breakdowns_updated_at,
            },
        },
        "watchlist": watchlist,
        "large_files": {
            "items": large_files_with_actions,
            "updated_at": large_files_updated_at,
        },
        "findings": {
            "items": findings,
            "updated_at": findings_updated_at,
        },
        "snapshots": {
            "items": snapshots_list,
            "updated_at": snapshots_updated_at,
        },
        "checks": summarize_checks(checks),
    }
    set_phase_progress(assembly_phase, 1, 1, "Report assembled")
    return report


def persist_full_walk(
    scan_id: int,
    result: WalkResult,
    totals: Dict[str, int],
    translation: List[Tuple[str, str, str]],
    registry_changes: List[Tuple[str, Tuple[Any, ...]]],
) -> None:
    updated_at = iso_now()
    rows = []
    for walked_path, allocated in totals.items():
        stored_path, root_key = translate_walk_path(walked_path, translation)
        rows.append({
            "path": stored_path,
            "parent_path": os.path.dirname(stored_path),
            "name": os.path.basename(stored_path) or stored_path,
            "root_key": root_key,
            "depth": path_depth(ROOT_PATHS[root_key], stored_path),
            "allocated_bytes": allocated,
            "children_indexed": True,
            "updated_at": updated_at,
        })
    for offset in range(0, len(rows), 20000):
        upsert_node_rows(scan_id, rows[offset:offset + 20000])
    large_by_root: Dict[str, List[Dict[str, Any]]] = {}
    for item in result.large_files:
        stored_path, root_key = translate_walk_path(item["path"], translation)
        if any(stored_path == prefix or stored_path.startswith(prefix + os.sep) for prefix in LARGE_FILE_EXCLUDED_PREFIXES):
            continue
        large_by_root.setdefault(root_key, []).append({
            **item,
            "path": stored_path,
            "parent_path": os.path.dirname(stored_path),
            "updated_at": updated_at,
        })
    with DB_WRITE_LOCK:
        with open_db_connection() as connection:
            for operation, payload in registry_changes:
                if operation == "upsert":
                    connection.execute(
                        "INSERT INTO hardlink_inodes (scan_id, ino, dev, owner_path, allocated_bytes) VALUES (?, ?, ?, ?, ?) ON CONFLICT(scan_id, ino) DO UPDATE SET dev=excluded.dev, owner_path=excluded.owner_path, allocated_bytes=excluded.allocated_bytes",
                        payload,
                    )
            for root_key, items in large_by_root.items():
                connection.executemany(
                    "INSERT INTO large_files (scan_id, path, parent_path, name, root_key, apparent_bytes, allocated_bytes, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(scan_id, path) DO UPDATE SET parent_path=excluded.parent_path, name=excluded.name, root_key=excluded.root_key, apparent_bytes=excluded.apparent_bytes, allocated_bytes=excluded.allocated_bytes, updated_at=excluded.updated_at",
                    [(scan_id, item["path"], item["parent_path"], item["name"], root_key, item["apparent_bytes"], item["allocated_bytes"], item["updated_at"]) for item in items],
                )
            connection.commit()
    for source, target in [
        (DATA_VOLUME / "Users" / HOME_DIR.name, HOME_DIR),
        (DATA_VOLUME / "Applications", APPLICATIONS_DIR),
    ]:
        if samefile_or_false(source, target):
            mark_alias_path_cached(scan_id, source, target, "data_root")


def collect_scan_report(scan_id: int) -> Dict[str, Any]:
    started_at = iso_now()
    phases = [("Metadata probes", 0.05), ("Volume walk", 0.65), ("Index persistence", 0.13), ("Cleanup intelligence", 0.10), ("Report assembly", 0.07)]
    offsets: Dict[str, float] = {}
    offset = 0.0
    for name, weight in phases:
        offsets[name] = offset
        offset += weight

    def progress(phase: str, ratio: float, detail: str) -> None:
        set_scan_status(running=True, phase=phase, detail=detail, progress=offsets[phase] + dict(phases)[phase] * min(1.0, ratio), error=None)

    progress("Metadata probes", 0, "Starting metadata probes")
    metadata_results = run_parallel_call_map({
        "apfs_list": lambda: run_command(["diskutil", "apfs", "list"], timeout=120),
        "data_info": lambda: run_command(["diskutil", "info", str(DATA_VOLUME)], timeout=120),
        "root_info": lambda: run_command(["diskutil", "info", "/"], timeout=120),
        "snapshot_info": lambda: run_command(["tmutil", "listlocalsnapshots", "/"], timeout=120),
    })
    apfs_list = metadata_results["apfs_list"]
    data_info = metadata_results["data_info"]
    root_info = metadata_results["root_info"]
    snapshot_info = metadata_results["snapshot_info"]
    apfs_container = parse_apfs_list(apfs_list["stdout"] if apfs_list["ok"] else "")
    data_volume = parse_diskutil_info(data_info["stdout"] if data_info["ok"] else "")
    system_volume = parse_diskutil_info(root_info["stdout"] if root_info["ok"] else "")
    metadata = {
        "container_size_bytes": apfs_container["container_size_bytes"] or data_volume["disk_size_bytes"],
        "container_used_bytes": apfs_container["container_used_bytes"],
        "container_free_bytes": data_volume["container_free_bytes"],
        "data_volume_used_bytes": data_volume["volume_used_bytes"],
        "system_volume_used_bytes": system_volume["volume_used_bytes"],
        "updated_at": iso_now(),
    }
    publish_event("metadata_ready", metadata)
    snapshots = collect_snapshot_section()
    for item in snapshots["items"]:
        publish_event("snapshot_found", item)

    with open_db_connection() as connection:
        row = connection.execute("SELECT COUNT(*) AS count FROM nodes WHERE scan_id = (SELECT id FROM scan_runs WHERE active=1 LIMIT 1)").fetchone()
        estimate = int(row["count"] or 400000)
    progress("Volume walk", 0, "Starting volume walk")
    result = walk_tree(
        DATA_VOLUME.resolve(), workers=SCAN_WORKER_COUNT, excluded_paths=EXCLUDED_BREAKDOWN_PATHS,
        progress_callback=lambda count: progress("Volume walk", min(0.95, count / max(1, estimate)), f"{count:,} directories scanned"),
    )
    translation = build_walk_translation()
    attributions, _, changes = resolve_hardlink_ownership(scan_id, result.hardlink_candidates, translation, full_scan=True)
    for parent, allocated in attributions:
        result.dir_local[parent] = result.dir_local.get(parent, 0) + allocated
    totals = rollup_subtree_totals(result.dir_local, str(DATA_VOLUME.resolve()))
    progress("Index persistence", 0, "Persisting volume index")
    persist_full_walk(scan_id, result, totals, translation, changes)
    progress("Index persistence", 1, "Volume index persisted")
    progress("Cleanup intelligence", 0, "Analyzing cleanup opportunities")
    intelligence = run_parallel_call_map({
        "providers": lambda: probe_providers(scan_id),
        "caches": lambda: discover_cache_candidates(scan_id),
        "installed_ids": collect_installed_bundle_ids,
    })
    providers = intelligence["providers"]
    discovered = intelligence["caches"]
    orphans = collect_orphan_candidates(scan_id, intelligence["installed_ids"])
    for item in providers["items"]:
        publish_event("provider_ready", item)
    for item in orphans["items"]:
        publish_event("orphan_found", item)
    progress("Cleanup intelligence", 1, "Cleanup analysis complete")
    watchlist = scan_watchlist(scan_id)["items"]
    breakdowns = build_breakdowns_from_db(scan_id)
    findings = build_findings_section(watchlist, scan_id, discovered)
    large_files = fetch_large_files_from_db(scan_id)
    for key, breakdown in breakdowns.items():
        publish_event("breakdown_ready", {"root": key, **breakdown})
    for finding in findings["items"]:
        publish_event("finding_added", finding)
    for item in large_files["items"]:
        publish_event("large_file_found", item)
    visible = totals.get(str(DATA_VOLUME.resolve()))
    hidden = max(data_volume["volume_used_bytes"] - visible, 0) if data_volume["volume_used_bytes"] is not None and visible is not None else None
    safe = sum(bytes_or_zero(item.get("estimated_reclaim_bytes")) for item in findings["items"] if item.get("risk") == "low" and item.get("actionable"))
    medium = sum(bytes_or_zero(item.get("estimated_reclaim_bytes")) for item in findings["items"] if item.get("risk") == "medium" and item.get("actionable"))
    checks = []
    for label, command_result in [("APFS container", apfs_list), ("Data volume info", data_info), ("System volume info", root_info), ("Local snapshots", snapshot_info)]:
        checks.append({"label": label, "command": command_result["command"], "ok": command_result["ok"], "duration_ms": command_result["duration_ms"], "summary": "Metadata probe completed." if command_result["ok"] else command_result["stderr"]})
    walk_summary = f"Scanned {result.dir_count:,} directories and {result.file_count:,} files with {result.error_count:,} recoverable errors."
    for label in ["Visible Data volume usage", "Home directory usage", "Library usage", "Applications usage", "Large file inventory"]:
        checks.append({"label": label, "command": f"parallel scandir walk of {DATA_VOLUME}", "ok": True, "duration_ms": result.duration_ms, "summary": walk_summary})
    checks.append({"label": "Safe cleanup watchlist", "command": "fresh scan index lookup", "ok": True, "duration_ms": 0, "summary": f"Checked {len(watchlist)} known targets."})
    report = {
        "version": VERSION, "generated_at": iso_now(), "started_at": started_at, "warnings": [],
        "summary": {**metadata, "visible_data_bytes": visible, "hidden_delta_bytes": hidden, "home_total_bytes": breakdowns["home_root"]["total_bytes"], "applications_total_bytes": breakdowns["applications_root"]["total_bytes"], "snapshot_count": len(snapshots["items"]), "safe_reclaimable_bytes": safe, "medium_reclaimable_bytes": medium},
        "breakdowns": breakdowns, "watchlist": watchlist, "large_files": large_files,
        "findings": findings, "snapshots": snapshots, "providers": providers,
        "orphans": orphans, "checks": checks,
    }
    progress("Report assembly", 1, "Report assembled")
    return report


def persist_report(report: Dict[str, Any]) -> None:
    atomic_write_json(RUNTIME_PATHS.latest_scan, report)
    timestamp = report["generated_at"].replace(":", "-")
    history_path = RUNTIME_PATHS.history_dir / f"scan-{timestamp}.json"
    atomic_write_json(history_path, report)


def run_scan_thread(scan_id: int) -> None:
    try:
        report = collect_scan_report(scan_id)
        persist_report(report)
        finalize_scan_run(scan_id, report)
        with STATE.lock:
            STATE.report = report
            STATE.scan_status = {
                "running": False,
                "phase": "idle",
                "detail": "Idle",
                "started_at": None,
                "updated_at": iso_now(),
                "progress": 1.0,
                "error": None,
            }
            STATE.scan_thread = None
        publish_event("scan_complete", report)
        publish_event("scan_status", dict(STATE.scan_status))
    except Exception as exc:
        logger.exception("Storage scan failed")
        mark_scan_run_failed(scan_id, str(exc))
        with STATE.lock:
            STATE.scan_status = {
                "running": False,
                "phase": "error",
                "detail": str(exc),
                "started_at": None,
                "updated_at": iso_now(),
                "progress": 0.0,
                "error": str(exc),
            }
            STATE.scan_thread = None
        publish_event("scan_status", dict(STATE.scan_status))


def start_scan() -> bool:
    with STATE.lock:
        if STATE.scan_thread is not None and STATE.scan_thread.is_alive():
            return False
        clear_breakdown_cache()
        scan_id = create_scan_run(iso_now())
        STATE.scan_status = {
            "running": True,
            "phase": "initializing",
            "detail": "Preparing task graph",
            "started_at": iso_now(),
            "updated_at": iso_now(),
            "progress": 0.0,
            "error": None,
        }
        thread = threading.Thread(target=run_scan_thread, args=(scan_id,), daemon=True)
        STATE.scan_thread = thread
        thread.start()
    publish_event("scan_status", dict(STATE.scan_status))
    return True


def resolve_action(action_token: str) -> Dict[str, Any]:
    try:
        payload = decode_action_token(action_token)
    except Exception as exc:
        raise HTTPException(status_code=400, detail=f"Invalid action token: {exc}") from exc
    with STATE.lock:
        report = STATE.report
    if report is None:
        raise HTTPException(status_code=400, detail="No scan report is loaded yet.")
    findings_items = report.get("findings", {}).get("items", [])
    snapshots_items = report.get("snapshots", {}).get("items", [])
    providers_items = report.get("providers", {}).get("items", [])
    allowed_tokens = {
        item.get("action_token")
        for item in (*findings_items, *snapshots_items, *providers_items)
        if item.get("action_token")
    }
    if action_token not in allowed_tokens:
        raise HTTPException(status_code=400, detail="Action token is not present in the latest report.")
    return payload


def unique_trash_destination(path: Path) -> Path:
    TRASH_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    candidate = TRASH_DIR / f"storage-monitor-{stamp}-{path.name}"
    if not candidate.exists():
        return candidate
    suffix = 1
    while True:
        test = TRASH_DIR / f"storage-monitor-{stamp}-{suffix}-{path.name}"
        if not test.exists():
            return test
        suffix += 1


def execute_trash_path(path: Path) -> Dict[str, Any]:
    if not path.exists():
        raise HTTPException(status_code=404, detail=f"Path does not exist: {path}")
    destination = unique_trash_destination(path)
    if path.is_file():
        sizes = stat_file_sizes(path)
    else:
        indexed = None
        scan_id = fetch_active_scan_id()
        if scan_id is not None:
            with open_db_connection() as connection:
                indexed = connection.execute("SELECT allocated_bytes FROM nodes WHERE scan_id=? AND path=?", (scan_id, str(path.resolve()))).fetchone()
        if indexed:
            allocated = int(indexed["allocated_bytes"])
        else:
            walked = walk_tree(path, workers=SCAN_WORKER_COUNT, excluded_paths=[])
            allocated = rollup_subtree_totals(walked.dir_local, str(path))[str(path)]
        sizes = {"allocated_bytes": allocated, "apparent_bytes": allocated}
    shutil.move(str(path), str(destination))
    return {
        "ok": True,
        "label": "Moved to Trash",
        "source_path": str(path),
        "trash_path": str(destination),
        "estimated_reclaim_bytes": sizes["allocated_bytes"],
    }


def _execute_delete_snapshot(snapshot_name: str, token: str, *, elevate: bool = False) -> Dict[str, Any]:
    if elevate:
        # token is validated by parse_snapshot_token as \d{4}-\d{2}-\d{2}-\d{6}
        # so it is safe for shell interpolation.
        result = run_command(
            [
                "osascript", "-e",
                f'do shell script "tmutil deletelocalsnapshots {token}" with administrator privileges',
            ],
            timeout=300,
        )
    else:
        result = run_command(["tmutil", "deletelocalsnapshots", token], timeout=300)

    if result["ok"]:
        return {
            "ok": True,
            "label": "Deleted Snapshot",
            "snapshot_name": snapshot_name,
            "stdout": result["stdout"],
            "estimated_reclaim_bytes": None,
        }

    stderr = result["stderr"] or ""
    if "70" in stderr or "Stale" in stderr or "busy" in stderr.lower():
        detail = (
            f"macOS refused to delete snapshot {token}. "
            "This snapshot may be mounted or referenced by Time Machine. "
            "Try disconnecting your Time Machine backup disk and retrying, "
            "or wait for macOS to release it automatically."
        )
    elif not elevate and ("permission" in stderr.lower() or "not permitted" in stderr.lower() or result.get("returncode") in {1, 70}):
        detail = (
            f"Snapshot {token} requires admin privileges to delete. "
            "Use the 'Delete (admin)' button to authenticate."
        )
    elif "canceled" in stderr.lower() or "-128" in stderr:
        detail = "Authentication was cancelled."
    else:
        detail = stderr or "Failed to delete snapshot."
    raise HTTPException(status_code=500, detail=detail)


def execute_delete_snapshot(snapshot_name: str, token: str, *, elevate: bool = False) -> Dict[str, Any]:
    result, observed = measure_free_space_delta(
        lambda: _execute_delete_snapshot(snapshot_name, token, elevate=elevate)
    )
    result["observed_reclaimed_bytes"] = observed
    return result


def execute_provider(slug: str) -> Dict[str, Any]:
    spec = PROVIDER_SPECS.get(slug)
    if spec is None:
        raise HTTPException(status_code=400, detail="Unknown cleanup provider.")
    if spec["execution"] != "action":
        raise HTTPException(status_code=400, detail="This provider must be run manually outside Storage Monitor.")

    def operation() -> Dict[str, Any]:
        command_result = run_command(spec["execute"], timeout=600)
        if not command_result["ok"]:
            raise HTTPException(
                status_code=500,
                detail=command_result["stderr"] or f"{spec['label']} failed.",
            )
        return {
            "ok": True, "label": f"{spec['label']} completed", "slug": slug,
            "stdout": "\n".join(command_result["stdout"].splitlines()[-20:]),
        }

    result, observed = measure_free_space_delta(operation)
    with STATE.lock:
        providers = (STATE.report or {}).get("providers", {}).get("items", [])
        prior = next((item for item in providers if item.get("slug") == slug), {})
    result["estimated_reclaim_bytes"] = prior.get("estimate_bytes")
    result["observed_reclaimed_bytes"] = observed
    return result


