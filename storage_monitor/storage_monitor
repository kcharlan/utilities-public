    function ProvidersTab({ providers, busyToken, onExecute }) {
      const items = providers?.items || [];
      return html`<div style=${{ fontSize: 13, maxHeight: 400, overflowY: 'auto' }}> ${items.map(item => html`<div key=${item.slug} class=${"surface-hover"} style=${{ padding: '9px 12px', borderBottom: '1px solid var(--border)', opacity: item.available ? 1 : 0.55 }}> <div style=${{ display: 'flex', alignItems: 'center', gap: 8 }}> <strong style=${{ flex: 1 }}>${item.label}</strong> <span style=${{ fontSize: 11, color: item.risk === 'medium' ? 'var(--warning)' : 'var(--success)' }}>${item.risk}</span> <span class=${"mono"}>${item.estimate_bytes == null ? '—' : `${item.estimate_kind === 'upper_bound' ? 'up to ' : '~'}${formatBytes(item.estimate_bytes)}`}</span> ${item.execution === 'manual' ? (
              html`<button disabled=${!item.available} onClick=${() => navigator.clipboard.writeText(item.manual_command)} title=${"Copy command"} style=${{ padding: '3px 9px', border: '1px solid var(--border)', borderRadius: 4, background: 'transparent', color: 'var(--text-primary)', cursor: item.available ? 'pointer' : 'not-allowed' }}> Copy command </button>`
