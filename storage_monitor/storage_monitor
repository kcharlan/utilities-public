      const [providers, setProviders] = useState({ items: [], updated_at: null });
      const [orphans, setOrphans] = useState({ items: [], updated_at: null });
      const [checks, setChecks] = useState([]);
      const [summary, setSummary] = useState({});
      const [scanStatus, setScanStatus] = useState({ running: true, phase: 'Booting', progress: 0 });
      const [busyToken, setBusyToken] = useState(null);
      const [message, setMessage] = useState('');
      const [messageType, setMessageType] = useState('success'); // 'success' or 'error'

      // Apply a full report (from initial load or scan_complete)
      // Normalize a section that should be {items: [], updated_at} but might
      // be a plain array (from a pre-redesign cached scan on disk).
      const normalizeSection = (val) => {
        if (!val) return { items: [], updated_at: null };
        if (Array.isArray(val)) return { items: val, updated_at: null };
        return { items: val.items || [], updated_at: val.updated_at || null };
      };

      const applyReport = useCallback((report) => {
        if (!report) return;
        setSummary(report.summary || {});
        setBreakdowns(report.breakdowns || {});
        const findingsSection = normalizeSection(report.findings);
        const snapshotsSection = normalizeSection(report.snapshots);
        const largeFilesSection = normalizeSection(report.large_files);
        const providersSection = normalizeSection(report.providers);
        const orphansSection = normalizeSection(report.orphans);
        setFindings({
          ...findingsSection,
          items: dedupeBy(findingsSection.items, item => `${item.path || ''}::${item.label || ''}`),
        });
        setSnapshots({
          ...snapshotsSection,
          items: dedupeBy(snapshotsSection.items, item => item.snapshot_name || item.token || ''),
        });
        setLargeFiles({
          ...largeFilesSection,
          items: dedupeBy(largeFilesSection.items, item => item.path || item.label || ''),
        });
        setProviders(providersSection);
        setOrphans(orphansSection);
        setChecks(report.checks || []);
        if (report.summary) {
          setMetadata({
            container_size_bytes: report.summary.container_size_bytes,
            container_used_bytes: report.summary.container_used_bytes,
            container_free_bytes: report.summary.container_free_bytes,
            data_volume_used_bytes: report.summary.data_volume_used_bytes,
            system_volume_used_bytes: report.summary.system_volume_used_bytes,
            updated_at: report.generated_at,
          });
        }
      }, []);

      useEffect(() => {
        let cancelled = false;
        fetch('/api/state')
          .then(r => r.json())
          .then(data => {
            if (cancelled) return;
            applyReport(data.report);
            setScanStatus(data.scan_status);
            if (!data.report && !data.scan_status?.running) {
              fetch('/api/scan', { method: 'POST' }).catch(() => {});
            }
          })
          .catch(() => {});

        const events = new EventSource('/api/events');
        events.onmessage = (event) => {
          try {
            const pkt = JSON.parse(event.data);
            switch (pkt.type) {
              case 'scan_status':
                setScanStatus(pkt.payload);
                // Reset streaming state when a new scan starts
                if (pkt.payload.phase === 'initializing') {
                  setFindings({ items: [], updated_at: null });
                  setSnapshots({ items: [], updated_at: null });
                  setLargeFiles({ items: [], updated_at: null });
                  setProviders({ items: [], updated_at: null });
                  setOrphans({ items: [], updated_at: null });
                }
                break;
              case 'metadata_ready':
                setMetadata(pkt.payload);
                break;
              case 'breakdown_ready':
                setBreakdowns(prev => ({
                  ...prev,
                  [pkt.payload.root]: {
                    items: pkt.payload.items,
                    total_bytes: pkt.payload.total_bytes,
                    updated_at: pkt.payload.updated_at,
                  },
                }));
                break;
              case 'finding_added':
                setFindings(prev => {
                  const items = dedupeBy([...(prev.items || []), pkt.payload], item => `${item.path || ''}::${item.label || ''}`);
                  items.sort((a, b) => (b.estimated_reclaim_bytes || b.allocated_bytes || 0) - (a.estimated_reclaim_bytes || a.allocated_bytes || 0));
                  return { items, updated_at: new Date().toISOString() };
                });
                break;
              case 'snapshot_found':
                setSnapshots(prev => {
                  const items = dedupeBy([...(prev.items || []), pkt.payload], item => item.snapshot_name || item.token || '');
                  return { items, updated_at: new Date().toISOString() };
                });
                break;
              case 'large_file_found':
                setLargeFiles(prev => {
                  const items = dedupeBy([...(prev.items || []), pkt.payload], item => item.path || item.label || '');
                  items.sort((a, b) => (b.allocated_bytes || 0) - (a.allocated_bytes || 0));
                  return { items, updated_at: new Date().toISOString() };
                });
                break;
              case 'provider_ready':
                setProviders(prev => ({
                  items: dedupeBy([...(prev.items || []), pkt.payload], item => item.slug),
                  updated_at: new Date().toISOString(),
                }));
                break;
              case 'orphan_found':
