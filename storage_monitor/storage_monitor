                    )} <span style=${{ minWidth: 0, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}> ${item.label} </span> </span> <div style=${{ flex: 1, margin: '0 10px' }}> <div class=${"bar-track"}> <div class=${"bar-fill"} style=${{ width: `${pct(item.allocated_bytes, maxBytes)}%`, background: ROOT_COLORS[rootKey] }} /> </div> </div> <span class=${"mono"} style=${{ width: 65, textAlign: 'right' }}> ${formatBytes(item.allocated_bytes)} </span> </div>`
              ))} ${!showAll && currentItems.length > VISIBLE_COUNT && (
                html`<div onClick=${() => setShowAll(true)} style=${{ padding: '5px 12px', fontSize: 12, color: 'var(--text-secondary)', cursor: 'pointer' }}> Show all ${currentItems.length} items... </div>`
              )} </div>`
          )} </div>`
      );
    }

    function FindingsTab({ findings, busyToken, onExecute, onReveal, isScanning }) {
      const [riskFilter, setRiskFilter] = useState('all');
      const [sortCol, setSortCol] = useState('size');
      const [sortAsc, setSortAsc] = useState(false);

      const items = useMemo(() => {
        let list = findings?.items || [];
        if (riskFilter !== 'all') list = list.filter(f => f.risk === riskFilter);
        const sorted = [...list];
        sorted.sort((a, b) => {
          let va, vb;
          if (sortCol === 'size') {
            va = a.estimated_reclaim_bytes || a.allocated_bytes || 0;
            vb = b.estimated_reclaim_bytes || b.allocated_bytes || 0;
          } else if (sortCol === 'risk') {
            const order = { low: 1, medium: 2, high: 3 };
            va = order[a.risk] || 0; vb = order[b.risk] || 0;
          } else {
            va = a.label?.toLowerCase() || ''; vb = b.label?.toLowerCase() || '';
          }
          if (va < vb) return sortAsc ? -1 : 1;
          if (va > vb) return sortAsc ? 1 : -1;
          return 0;
        });
        return sorted;
      }, [findings, riskFilter, sortCol, sortAsc]);

      const handleSort = (col) => {
        if (sortCol === col) setSortAsc(!sortAsc);
        else { setSortCol(col); setSortAsc(false); }
      };

      const topReclaimPaths = useMemo(() => {
        const sorted = [...(findings?.items || [])].sort((a, b) =>
          (b.estimated_reclaim_bytes || 0) - (a.estimated_reclaim_bytes || 0)
        );
        return new Set(sorted.slice(0, 3).map(f => f.path));
      }, [findings]);

      return (
        html`<div style=${{ fontSize: 13 }}>  <div style=${{ display: 'flex', alignItems: 'center', gap: 6, padding: '8px 12px', borderBottom: '1px solid var(--border)' }}> <span style=${{ fontSize: 11, color: 'var(--text-secondary)' }}>Filter:</span> ${['all', 'low', 'medium', 'high'].map(r => (
              html`<button key=${r} onClick=${() => setRiskFilter(r)} style=${{
                padding: '2px 8px', borderRadius: 4, fontSize: 11, cursor: 'pointer', border: 'none',
                background: riskFilter === r ? 'var(--accent)' : 'var(--surface-hover)',
                color: riskFilter === r ? '#fff' : 'var(--text-secondary)',
              }}>${r}</button>`
            ))} <div style=${{ flex: 1 }} /> <span style=${{ fontSize: 11, color: 'var(--text-secondary)' }}> ${items.length} items ${findings?.updated_at && ` · ${formatRelativeTime(findings.updated_at)}`} </span> </div>  <div style=${{ display: 'grid', gridTemplateColumns: '2fr 80px 55px 75px 100px', gap: 4, padding: '6px 12px', borderBottom: '1px solid var(--border)', fontSize: 11, textTransform: 'uppercase', color: 'var(--text-secondary)' }}> <button onClick=${() => handleSort('name')} style=${{ cursor: 'pointer', background: 'none', border: 'none', padding: 0, font: 'inherit', color: 'inherit', textTransform: 'inherit' }}>Finding</button> <span>Category</span> <button onClick=${() => handleSort('risk')} style=${{ cursor: 'pointer', background: 'none', border: 'none', padding: 0, font: 'inherit', color: 'inherit', textTransform: 'inherit' }} title=${"Low = safe to delete (caches). Medium = review first. High = manual review."}> Risk ⓘ </button> <button onClick=${() => handleSort('size')} style=${{ cursor: 'pointer', textAlign: 'right', background: 'none', border: 'none', padding: 0, font: 'inherit', color: 'inherit', textTransform: 'inherit' }}>Size</button> <span style=${{ textAlign: 'right' }}>Actions</span> </div>  <div style=${{ maxHeight: 400, overflowY: 'auto' }}> ${isScanning && items.length === 0 && (
              html`<div style=${{ padding: 12 }}> <div class=${"shimmer"} style=${{ height: 14, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 14, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 14 }} /> </div>`
            )} ${items.map((item) => {
              const risk = RISK_STYLES[item.risk] || {};
              const isTopReclaim = topReclaimPaths.has(item.path);
              return (
                html`<div key=${item.path + item.label} class=${"surface-hover"} style=${{
                  display: 'grid', gridTemplateColumns: '2fr 80px 55px 75px 100px', gap: 4,
                  padding: '5px 12px', borderBottom: '1px solid var(--border)', alignItems: 'center',
                  background: isTopReclaim ? `${ROOT_COLORS.data_root}08` : undefined,
                }}> <span style=${{ whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }} title=${item.path}> ${item.label} </span> <span style=${{
                    padding: '1px 6px', borderRadius: 4, fontSize: 11, textAlign: 'center',
                    background: `${CATEGORY_COLORS[item.category] || '#666'}22`,
                    color: CATEGORY_COLORS[item.category] || 'var(--text-secondary)',
                  }}>${(item.category || '').replace(/_/g, ' ')}</span> <span style=${{ padding: '1px 6px', borderRadius: 4, fontSize: 11, textAlign: 'center', background: risk.bg, color: risk.color }}> ${risk.label} </span> <span class=${"mono"} style=${{ textAlign: 'right' }}> ${formatBytes(item.estimated_reclaim_bytes || item.allocated_bytes)} </span> <span style=${{ display: 'flex', gap: 3, justifyContent: 'flex-end' }}> ${item.actions?.filter(a => a.kind === 'execute').map(a => (
                      html`<button key=${a.label} disabled=${busyToken === a.action_token} onClick=${() => onExecute(a.action_token)} style=${{ padding: '2px 7px', borderRadius: 4, fontSize: 11, border: 'none', cursor: 'pointer', background: 'var(--accent)', color: '#fff' }}> ${busyToken === a.action_token ? '...' : (a.label === 'Move to Trash' ? 'Trash' : a.label)} </button>`
                    ))} <button onClick=${() => onReveal(item.path)} style=${{ padding: '2px 7px', borderRadius: 4, fontSize: 11, border: '1px solid var(--border)', cursor: 'pointer', background: 'transparent', color: 'var(--text-secondary)' }}> Reveal </button> </span> </div>`
              );
            })} </div> </div>`
      );
    }

    function SnapshotsTab({ snapshots, busyToken, onExecute, isScanning }) {
      const [selected, setSelected] = useState(new Set());
      const [sortNewest, setSortNewest] = useState(false);
      const [deleting, setDeleting] = useState(false);
      const [thinning, setThinning] = useState(false);

      const items = useMemo(() => {
        const list = [...(snapshots?.items || [])];
        list.sort((a, b) => {
          const da = a.parsed_date || ''; const db = b.parsed_date || '';
          return sortNewest ? db.localeCompare(da) : da.localeCompare(db);
        });
        return list;
      }, [snapshots, sortNewest]);

      const toggleSelect = (name) => {
        setSelected(prev => {
          const next = new Set(prev);
          if (next.has(name)) next.delete(name); else next.add(name);
          return next;
        });
      };

      const selectAll = () => {
        if (selected.size === items.length) setSelected(new Set());
        else setSelected(new Set(items.map(s => s.snapshot_name)));
      };

      const deleteSelected = async () => {
        if (!window.confirm(`Delete ${selected.size} snapshot${selected.size > 1 ? 's' : ''}? This cannot be undone.`)) return;
        setDeleting(true);
        try {
          for (const name of selected) {
            const snap = items.find(s => s.snapshot_name === name);
            if (snap?.action_token) {
              await onExecute(snap.action_token);
            }
          }
        } catch (e) {
          console.error('Batch snapshot delete error:', e);
        } finally {
          setSelected(new Set());
          setDeleting(false);
        }
      };

      const formatSnapshotDate = (isoDate) => {
        if (!isoDate) return 'Unknown date';
        const d = new Date(isoDate);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
          + ' at ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      };

      const thinSnapshots = async () => {
        const amount = window.prompt('How many GB should macOS try to reclaim?', '10');
        if (amount === null) return;
        const gb = Number(amount);
        if (!Number.isFinite(gb) || gb <= 0) return window.alert('Enter a positive GB amount.');
        const urgency = Number(window.prompt('Urgency from 1 (low) to 4 (high):', '2'));
        if (![1, 2, 3, 4].includes(urgency)) return window.alert('Urgency must be 1–4.');
        if (!window.confirm('macOS chooses which snapshots to thin. Continue?')) return;
        setThinning(true);
        try {
          const res = await fetch('/api/snapshots/thin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bytes: Math.round(gb * 1024 * 1024 * 1024), urgency }) });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Snapshot thinning failed');
          window.alert(`Observed free-space change: ${data.observed_reclaimed_bytes == null ? 'unavailable' : formatBytes(data.observed_reclaimed_bytes)}`);
        } catch (error) { window.alert(error.message); }
        finally { setThinning(false); }
      };

      return (
        html`<div style=${{ fontSize: 13 }}>  <div style=${{ display: 'flex', alignItems: 'center', gap: 10, padding: '8px 12px', borderBottom: '1px solid var(--border)', flexWrap: 'wrap' }}> <input type=${"checkbox"} checked=${selected.size === items.length && items.length > 0} onInput=${selectAll} aria-label=${"Select all snapshots"} /> <span style=${{ fontSize: 12, color: 'var(--text-secondary)' }}>${items.length} local snapshot${items.length !== 1 ? 's' : ''}</span> ${selected.size > 0 && (
              html`<button onClick=${deleteSelected} disabled=${deleting} style=${{ padding: '3px 10px', borderRadius: 4, fontSize: 12, border: 'none', cursor: 'pointer', background: 'var(--danger)', color: '#fff' }}> ${deleting ? 'Deleting...' : `Delete ${selected.size}`} </button>`
            )} <button onClick=${thinSnapshots} disabled=${thinning || !items.length} style=${{ padding: '3px 10px', borderRadius: 4, fontSize: 12, border: '1px solid var(--accent)', background: 'transparent', color: 'var(--accent)' }}> ${thinning ? 'Reclaiming…' : 'Reclaim space…'} </button> <div style=${{ flex: 1 }} /> <button onClick=${() => setSortNewest(!sortNewest)} style=${{ fontSize: 11, color: 'var(--text-secondary)', cursor: 'pointer', textDecoration: 'underline', background: 'none', border: 'none', padding: 0 }}> ${sortNewest ? 'newest first' : 'oldest first'} </button> </div>  <div style=${{ padding: '6px 12px', fontSize: 12, color: 'var(--text-secondary)', borderBottom: '1px solid var(--border)', lineHeight: 1.5 }}> Snapshot space is managed by APFS and reclaimed as needed. Deleting old snapshots can free space, but the exact amount depends on shared block references. </div>  <div style=${{ maxHeight: 350, overflowY: 'auto' }}> ${isScanning && items.length === 0 && (
              html`<div style=${{ padding: 12 }}> <div class=${"shimmer"} style=${{ height: 14, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 14 }} /> </div>`
            )} ${items.map((snap) => (
              html`<div key=${snap.snapshot_name} style=${{
                display: 'flex', alignItems: 'center', gap: 10, padding: '6px 12px',
                borderBottom: '1px solid var(--border)',
              }}> <input type=${"checkbox"} checked=${selected.has(snap.snapshot_name)} onInput=${() => toggleSelect(snap.snapshot_name)} aria-label=${`Select snapshot ${snap.parsed_date || snap.snapshot_name}`} /> <span style=${{ flex: 1 }}>${formatSnapshotDate(snap.parsed_date)}</span> <span style=${{ fontSize: 12, color: 'var(--text-secondary)' }}>${formatRelativeTime(snap.parsed_date)}</span> ${snap.purgeable === true && html`<span style=${{ fontSize: 10, padding: '1px 5px', borderRadius: 4, background: 'var(--success-bg)', color: 'var(--success)' }}>Purgeable</span>`} ${snap.limiting_container_shrink === true && html`<span title=${"Deleting this snapshot can lower the container shrink floor"} style=${{ fontSize: 10, padding: '1px 5px', borderRadius: 4, background: 'var(--warning-bg)', color: 'var(--warning)' }}>Limits container shrink</span>`} <button onClick=${() => onExecute(snap.action_token)} disabled=${busyToken === snap.action_token} style=${{ padding: '2px 8px', borderRadius: 4, fontSize: 11, border: 'none', cursor: 'pointer', background: 'var(--danger-bg)', color: 'var(--danger)' }}> ${busyToken === snap.action_token ? '...' : 'Delete'} </button> <button onClick=${() => onExecute(snap.action_token, { elevate: true })} disabled=${busyToken === snap.action_token} title=${"Delete with admin privileges (password prompt)"} style=${{ padding: '2px 8px', borderRadius: 4, fontSize: 11, border: '1px solid var(--danger)', cursor: 'pointer', background: 'transparent', color: 'var(--danger)' }}> 🔒 </button> </div>`
            ))} </div> </div>`
      );
    }

    function LargeFilesTab({ largeFiles, onReveal, isScanning }) {
      const items = largeFiles?.items || [];
      return (
        html`<div style=${{ fontSize: 13 }}> <div style=${{ display: 'grid', gridTemplateColumns: '2fr 75px 100px', gap: 4, padding: '6px 12px', borderBottom: '1px solid var(--border)', fontSize: 11, textTransform: 'uppercase', color: 'var(--text-secondary)' }}> <span>File</span> <span style=${{ textAlign: 'right' }}>Size</span> <span style=${{ textAlign: 'right' }}>Action</span> </div> <div style=${{ maxHeight: 400, overflowY: 'auto' }}> ${isScanning && items.length === 0 && (
              html`<div style=${{ padding: 12 }}> <div class=${"shimmer"} style=${{ height: 14, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 14 }} /> </div>`
            )} ${items.map((item) => (
              html`<div key=${item.path} class=${"surface-hover"} style=${{
                display: 'grid', gridTemplateColumns: '2fr 75px 100px', gap: 4,
                padding: '5px 12px', borderBottom: '1px solid var(--border)', alignItems: 'center',
              }}> <span style=${{ whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }} title=${item.path}> ${item.label} </span> <span class=${"mono"} style=${{ textAlign: 'right' }}>${formatBytes(item.allocated_bytes)}</span> <span style=${{ textAlign: 'right' }}> <button onClick=${() => onReveal(item.path)} style=${{ padding: '2px 7px', borderRadius: 4, fontSize: 11, border: '1px solid var(--border)', cursor: 'pointer', background: 'transparent', color: 'var(--text-secondary)' }}> Reveal </button> </span> </div>`
            ))} ${!isScanning && items.length === 0 && (
