              <button onClick={onToggleTheme} aria-label="Toggle dark mode" style={{ background: 'none', border: 'none', cursor: 'pointer', fontSize: 16, color: 'var(--text-secondary)', padding: 4 }}>&#9790;</button>
            </div>
