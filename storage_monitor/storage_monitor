def run_command(args: List[str], timeout: int = 120) -> Dict[str, Any]:
    start = time.time()
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return {
            "ok": result.returncode == 0,
            "returncode": result.returncode,
            "stdout": result.stdout,
            "stderr": result.stderr,
            "duration_ms": int((time.time() - start) * 1000),
            "command": " ".join(args),
        }
    except Exception as exc:
        return {
            "ok": False,
            "returncode": None,
            "stdout": "",
            "stderr": str(exc),
            "duration_ms": int((time.time() - start) * 1000),
            "command": " ".join(args),
        }


def run_parallel_call_map(
    task_map: Dict[str, Any],
    max_workers: Optional[int] = None,
    progress_callback: Optional[Any] = None,
) -> Dict[str, Any]:
    if not task_map:
        return {}
    worker_count = max_workers or min(SCAN_WORKER_COUNT, len(task_map))
    results: Dict[str, Any] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=worker_count) as executor:
        future_map = {executor.submit(func): key for key, func in task_map.items()}
        for future in concurrent.futures.as_completed(future_map):
            key = future_map[future]
            results[key] = future.result()
            if progress_callback is not None:
                progress_callback(key, len(results), len(task_map))
    return results


def parse_size_token(value: str, unit: str) -> int:
    multipliers = {"B": 1, "KB": 1000, "MB": 1000**2, "GB": 1000**3, "TB": 1000**4}
    normalized = unit.upper()
    if normalized not in multipliers:
        raise ValueError(f"Unsupported size unit: {unit}")
    return int(float(value) * multipliers[normalized])


def parse_brew_cleanup_estimate(stdout: str) -> Optional[int]:
    matches = re.findall(r"approximately\s+([\d.]+)\s*([KMGT]?B)", stdout, re.IGNORECASE)
    if not matches:
        return None
    return parse_size_token(*matches[-1])


def parse_docker_reclaim_estimate(stdout: str) -> Optional[int]:
    total = 0
    found = False
    included_types = {"Images", "Containers", "Build Cache"}
    for line in stdout.splitlines():
        try:
            item = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            continue
        if item.get("Type") not in included_types:
            continue
        match = re.match(r"^([\d.]+)\s*([KMGT]?B)", str(item.get("Reclaimable", "")), re.IGNORECASE)
        if not match:
            continue
        total += parse_size_token(match.group(1), match.group(2))
        found = True
    return total if found else None


