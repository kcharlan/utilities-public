        await fetch('/api/scan', { method: 'POST' });
      }, []);

      const executeAction = useCallback(async (actionToken, { elevate = false } = {}) => {
        setBusyToken(actionToken);
        setMessage('');
        try {
          const res = await fetch('/api/actions/execute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
