@app.get("/api/breakdown")
def api_breakdown(path: str) -> Dict[str, Any]:
    validated = validate_breakdown_path(path)
    cache_key = str(canonicalize_breakdown_path(validated))
    cached = get_cached_breakdown(cache_key)
    if cached is not None:
        return cached
    scan_id = choose_scan_id_for_path(cache_key)
    response = fetch_breakdown_from_db(scan_id, cache_key) if scan_id is not None else None
    # If the node exists but has no children indexed, trigger an on-demand scan
    # so the user sees actual directory contents instead of an empty list.
    if response is not None and not response["items"]:
        response = None
    if response is None:
        if scan_id is not None:
            response = store_breakdown_for_path(scan_id, validated)
        else:
            walked = walk_tree(validated, workers=SCAN_WORKER_COUNT, excluded_paths=EXCLUDED_BREAKDOWN_PATHS)
            totals = rollup_subtree_totals(walked.dir_local, str(validated))
            items = [
                {"path": child, "label": os.path.basename(child), "allocated_bytes": size}
                for child, size in totals.items()
                if os.path.dirname(child) == str(validated)
            ]
            items.sort(key=lambda item: item["allocated_bytes"], reverse=True)
            response = {
                "path": cache_key,
                "total_bytes": totals.get(str(validated)),
                "items": items[:MAX_TOP_ITEMS],
                "updated_at": iso_now(),
            }
    set_cached_breakdown(cache_key, response)
    return response


@app.post("/api/actions/execute")
def api_execute_action(payload: Dict[str, Any]) -> Dict[str, Any]:
    action_token = payload.get("action_token")
    if not action_token:
        raise HTTPException(status_code=400, detail="Missing action_token.")
    action = resolve_action(action_token)
    kind = action.get("kind")
    if kind == "trash_path":
        result = execute_trash_path(Path(action["path"]))
    elif kind == "delete_snapshot":
        elevate = payload.get("elevate", False)
        result = execute_delete_snapshot(action["snapshot_name"], action["token"], elevate=elevate)
    elif kind == "provider_execute":
        result = execute_provider(action["slug"])
    else:
        raise HTTPException(status_code=400, detail=f"Unsupported action kind: {kind}")
    record_action(action, result)
    publish_event("action_result", result)
    try:
        refresh_after_action(action, result)
    except Exception:
        logger.exception("Immediate post-action refresh failed")
    return result


@app.post("/api/snapshots/thin")
def api_thin_snapshots(payload: Dict[str, Any]) -> Dict[str, Any]:
    requested = payload.get("bytes")
    urgency = payload.get("urgency", 2)
    if not isinstance(requested, int) or isinstance(requested, bool) or requested <= 0:
        raise HTTPException(status_code=400, detail="bytes must be a positive integer.")
    if not isinstance(urgency, int) or isinstance(urgency, bool) or urgency not in range(1, 5):
        raise HTTPException(status_code=400, detail="urgency must be between 1 and 4.")

    def operation() -> Dict[str, Any]:
        command_result = run_command(
            ["tmutil", "thinlocalsnapshots", "/", str(requested), str(urgency)], timeout=600
        )
        if not command_result["ok"]:
            raise HTTPException(status_code=500, detail=command_result["stderr"] or "Snapshot thinning failed.")
        names = [
            line.strip() for line in command_result["stdout"].splitlines()
            if line.strip().startswith("com.apple.TimeMachine.")
        ]
        return {"ok": True, "thinned": names}

    result, observed = measure_free_space_delta(operation)
    result["observed_reclaimed_bytes"] = observed
    action = {"kind": "thin_snapshots", "bytes": requested, "urgency": urgency}
    record_action(action, result)
    scan_id = fetch_active_scan_id()
    if scan_id is not None:
        rebuild_and_publish_report(scan_id, collect_metadata())
    return result


@app.post("/api/rescan-path")
def api_rescan_path(payload: Dict[str, Any]) -> Dict[str, Any]:
    """Rescan a single directory subtree and refresh metadata."""
    path_str = payload.get("path")
    if not path_str:
        raise HTTPException(status_code=400, detail="Missing path.")
    validated = validate_breakdown_path(path_str)
    canonical = canonicalize_breakdown_path(validated)
    scan_id = fetch_active_scan_id()
    if scan_id is None:
        raise HTTPException(status_code=409, detail="No active scan. Run a full scan first.")

    # Invalidate the in-memory cache for this path and ancestors
    invalidate_breakdown_cache_chain(canonical)

    # Rescan the directory chain from this path up to the root
    refresh_directory_chain(scan_id, canonical)

    # Refresh top-level metadata (container used/free bytes)
    metadata = collect_metadata()

    # Rebuild and persist the report so summary stats update
    rebuild_and_publish_report(scan_id, metadata)

    # Return the refreshed breakdown for the requested path
    response = fetch_breakdown_from_db(scan_id, str(canonical))
    if response is None:
        response = store_breakdown_for_path(scan_id, validated)
    set_cached_breakdown(str(canonical), response)
    return response


@app.post("/api/reveal")
def api_reveal(payload: Dict[str, Any]) -> Dict[str, Any]:
    path = payload.get("path")
    if not path:
        raise HTTPException(status_code=400, detail="Missing path.")
    return reveal_path(path)


@app.post("/api/shutdown")
def api_shutdown() -> Dict[str, Any]:
    """Gracefully shut down the server."""
    logger.info("Shutdown requested via API")
    RUNTIME_PATHS.pid_file.unlink(missing_ok=True)
    # Schedule shutdown after response is sent
    threading.Thread(target=lambda: (time.sleep(0.5), os.kill(os.getpid(), signal.SIGTERM)), daemon=True).start()
    return {"ok": True, "label": "Shutting down..."}


