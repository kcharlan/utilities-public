def find_free_port(start_port: int, max_attempts: int = 20) -> int:
    for port in range(start_port, start_port + max_attempts):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.bind(("127.0.0.1", port))
                return port
            except OSError:
                continue
    raise RuntimeError(f"No free port found in range {start_port}-{start_port + max_attempts - 1}")


def open_browser(port: int) -> None:
    time.sleep(1.25)
    webbrowser.open(f"http://127.0.0.1:{port}")


def ensure_runtime_dirs() -> None:
    ensure_runtime_home(RUNTIME_PATHS)
    initialize_scan_db(RUNTIME_PATHS)


def kill_prior_instance() -> None:
    """If a PID file exists from a prior run, kill that process and its children."""
    pid_file = RUNTIME_PATHS.pid_file
    if not pid_file.exists():
        return
    try:
        old_pid = int(pid_file.read_text().strip())
    except (ValueError, OSError):
        pid_file.unlink(missing_ok=True)
        return
    if old_pid == os.getpid():
        return
    try:
        os.kill(old_pid, 0)  # Check if alive
    except OSError:
        pid_file.unlink(missing_ok=True)
        return
    logger.info("Stopping prior instance (PID %s)", old_pid)
    try:
        os.kill(old_pid, signal.SIGTERM)
        # Give it a moment to shut down gracefully
        for _ in range(20):
            time.sleep(0.1)
            try:
                os.kill(old_pid, 0)
            except OSError:
                break
        else:
            os.kill(old_pid, signal.SIGKILL)
    except OSError:
        pass
    pid_file.unlink(missing_ok=True)


def write_pid_file() -> None:
    RUNTIME_PATHS.pid_file.write_text(str(os.getpid()), encoding="utf-8")


def main() -> None:
    args = parse_args()
    ensure_runtime_dirs()
    kill_prior_instance()
    write_pid_file()
    load_latest_report()
    port = find_free_port(args.port)
    if port != args.port:
        logger.warning("Port %s is in use; using port %s instead.", args.port, port)
    RUNTIME_PATHS.last_port.write_text(str(port), encoding="utf-8")
    logger.info("Storage Monitor available at http://127.0.0.1:%s", port)
    start_scan()
    if not args.no_browser and not testing_mode_enabled():
        threading.Thread(target=open_browser, args=(port,), daemon=True).start()
    uvicorn.run(app, host="127.0.0.1", port=port, log_level="info")


if __name__ == "__main__":
    main()
