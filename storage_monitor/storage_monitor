def iso_now() -> str:
    return datetime.now(timezone.utc).isoformat()


STATE = AppState()

# In-memory TTL cache for breakdown (du) results, keyed by resolved path string.
# Cleared on each new scan so rescans always produce fresh data.
_breakdown_cache: Dict[str, tuple] = {}  # {path_str: (timestamp, result_dict)}
_breakdown_cache_lock = threading.Lock()


def get_cached_breakdown(path_key: str) -> Optional[Dict[str, Any]]:
    """Return cached breakdown result if present and not expired, else None."""
    with _breakdown_cache_lock:
        entry = _breakdown_cache.get(path_key)
    if entry is None:
        return None
    cached_at, result = entry
    if time.time() - cached_at > BREAKDOWN_CACHE_TTL_SECONDS:
        with _breakdown_cache_lock:
            _breakdown_cache.pop(path_key, None)
        return None
    return result


def set_cached_breakdown(path_key: str, result: Dict[str, Any]) -> None:
    """Store a breakdown result in the cache."""
    with _breakdown_cache_lock:
        _breakdown_cache[path_key] = (time.time(), result)


def clear_breakdown_cache() -> None:
    """Flush the entire breakdown cache (called on scan start and after actions)."""
    with _breakdown_cache_lock:
        _breakdown_cache.clear()


def clear_cached_breakdown(path_key: str) -> None:
    """Remove a single path from the breakdown cache."""
    with _breakdown_cache_lock:
        _breakdown_cache.pop(path_key, None)


def invalidate_breakdown_cache_chain(path: Path) -> None:
    """Remove in-memory cache entries for path and all ancestors up to root."""
    current = path.resolve()
    root = None
    for allowed_root in ALLOWED_BREAKDOWN_ROOTS:
        try:
            current.relative_to(allowed_root)
            root = allowed_root
            break
        except ValueError:
            continue
    if root is None:
        return
    while True:
        clear_cached_breakdown(str(current))
        if current == root:
            break
        parent = current.parent
        if parent == current:
            break
        current = parent


def path_parent(path_str: str) -> Optional[str]:
    path = Path(path_str)
    return str(path.parent) if path.parent != path else None


def path_depth(root: Path, path_str: str) -> int:
    # Exactly two leading slashes form a distinct POSIX anchor.
    anchor = ""
    if path_str.startswith("/"):
        anchor = "//" if path_str.startswith("//") and not path_str.startswith("///") else "/"
    if anchor != root.anchor:
        return 0
    root_str = str(root)
    prefix = root_str if root_str.endswith("/") else root_str + "/"
    if path_str.startswith(prefix):
        return sum(1 for part in path_str[len(prefix):].split("/") if part not in ("", "."))

    # Normalize lexical components before matching, keeping '..' untouched.
    parts = tuple(part for part in path_str.split("/") if part not in ("", "."))
    root_parts = root.parts[1:] if root.anchor else root.parts
    if parts[:len(root_parts)] != root_parts:
        return 0
    return len(parts) - len(root_parts)


def sql_like_prefix(path_str: str) -> str:
    escaped = path_str.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    return f"{escaped}/%"


def samefile_or_false(left: Path, right: Path) -> bool:
    try:
        return os.path.samefile(str(left), str(right))
    except OSError:
        return False


def create_scan_run(started_at: str) -> int:
    with DB_WRITE_LOCK:
        with open_db_connection() as connection:
            cursor = connection.execute(
                "INSERT INTO scan_runs (started_at, status, active) VALUES (?, 'running', 0)",
                (started_at,),
            )
            connection.commit()
            return int(cursor.lastrowid)


def finalize_scan_run(scan_id: int, report: Dict[str, Any]) -> None:
    report_json = json.dumps(report, sort_keys=True)
    with DB_WRITE_LOCK:
        with open_db_connection() as connection:
            completed_at = iso_now()
            connection.execute("UPDATE scan_runs SET active = 0 WHERE active = 1")
            connection.execute(
                """
                UPDATE scan_runs
                SET completed_at = ?, status = 'completed', active = 1, report_json = ?
                WHERE id = ?
                """,
                (completed_at, report_json, scan_id),
            )
            # Capture growth history before pruning nodes. Both sides of a
            # growth comparison must use this identical depth/size domain;
            # comparing history with live nodes would make floored-out paths
            # masquerade as growth.
            connection.execute(
                """
                INSERT OR REPLACE INTO scan_dir_history
                    (scan_id, completed_at, path, root_key, depth, allocated_bytes)
                SELECT scan_id, ?, path, root_key, depth, allocated_bytes
                FROM nodes
                WHERE scan_id = ? AND depth <= ?
                  AND (allocated_bytes >= ? OR depth <= 1)
                """,
                (completed_at, scan_id, GROWTH_HISTORY_MAX_DEPTH, GROWTH_HISTORY_MIN_BYTES),
            )
            connection.execute(
                """
                DELETE FROM scan_dir_history
                WHERE scan_id NOT IN (
                    SELECT scan_id FROM scan_dir_history
                    GROUP BY scan_id ORDER BY scan_id DESC LIMIT ?
                )
                """,
                (GROWTH_HISTORY_MAX_SCANS,),
            )
            connection.execute("DELETE FROM nodes WHERE scan_id != ?", (scan_id,))
            connection.execute("DELETE FROM large_files WHERE scan_id != ?", (scan_id,))
            connection.execute("DELETE FROM hardlink_inodes WHERE scan_id != ?", (scan_id,))
            connection.execute(
                "DELETE FROM scan_runs WHERE id NOT IN (SELECT id FROM scan_runs ORDER BY id DESC LIMIT 30)"
            )
            connection.commit()
            freelist = int(connection.execute("PRAGMA freelist_count").fetchone()[0])
            page_size = int(connection.execute("PRAGMA page_size").fetchone()[0])
            if freelist * page_size > 100 * 1024 * 1024:
                connection.execute("VACUUM")


def mark_scan_run_failed(scan_id: int, error_text: str) -> None:
    with DB_WRITE_LOCK:
        with open_db_connection() as connection:
            connection.execute(
                """
                UPDATE scan_runs
                SET completed_at = ?, status = 'failed', report_json = ?
                WHERE id = ?
                """,
                (
                    iso_now(),
                    json.dumps({"error": error_text, "updated_at": iso_now()}, sort_keys=True),
                    scan_id,
                ),
            )
            connection.commit()


def fetch_active_scan_id() -> Optional[int]:
    with open_db_connection() as connection:
        row = connection.execute(
            "SELECT id FROM scan_runs WHERE active = 1 ORDER BY id DESC LIMIT 1"
        ).fetchone()
    return int(row["id"]) if row else None


def fetch_running_scan_id() -> Optional[int]:
    with open_db_connection() as connection:
        row = connection.execute(
            "SELECT id FROM scan_runs WHERE status = 'running' ORDER BY id DESC LIMIT 1"
        ).fetchone()
    return int(row["id"]) if row else None


def fetch_scan_report_json(scan_id: int) -> Optional[Dict[str, Any]]:
    with open_db_connection() as connection:
        row = connection.execute(
            "SELECT report_json FROM scan_runs WHERE id = ? LIMIT 1",
            (scan_id,),
        ).fetchone()
    if not row or not row["report_json"]:
        return None
    try:
        payload = json.loads(row["report_json"])
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def build_growth_report(
    baseline_scan_id: Optional[int] = None,
    limit: int = 50,
) -> Dict[str, Any]:
    current_scan_id = fetch_active_scan_id()
    with open_db_connection() as connection:
        baseline_rows = connection.execute(
            """SELECT scan_id, MAX(completed_at) AS completed_at
               FROM scan_dir_history GROUP BY scan_id ORDER BY scan_id DESC"""
        ).fetchall()
        baselines = [
            {"scan_id": int(row["scan_id"]), "completed_at": row["completed_at"]}
            for row in baseline_rows
        ]
        available_ids = {item["scan_id"] for item in baselines}
        resolved_baseline = baseline_scan_id
        if resolved_baseline is None and current_scan_id is not None:
            resolved_baseline = next(
                (item["scan_id"] for item in baselines if item["scan_id"] < current_scan_id),
                None,
            )
        if resolved_baseline is not None and resolved_baseline not in available_ids:
            raise HTTPException(status_code=400, detail="Baseline scan is not available.")
        if current_scan_id is None or resolved_baseline is None:
            return {
                "baselines": baselines,
                "baseline_scan_id": resolved_baseline,
                "current_scan_id": current_scan_id,
                "items": [],
                "updated_at": iso_now(),
            }
        rows = connection.execute(
            """SELECT scan_id, path, root_key, depth, allocated_bytes
               FROM scan_dir_history WHERE scan_id IN (?, ?)""",
            (current_scan_id, resolved_baseline),
        ).fetchall()

    by_scan: Dict[int, Dict[str, sqlite3.Row]] = {
        current_scan_id: {}, resolved_baseline: {}
    }
    for row in rows:
        by_scan[int(row["scan_id"])][row["path"]] = row
    current = by_scan[current_scan_id]
    baseline = by_scan[resolved_baseline]
    items: List[Dict[str, Any]] = []
    for path in current.keys() | baseline.keys():
        current_row = current.get(path)
        baseline_row = baseline.get(path)
        current_bytes = int(current_row["allocated_bytes"]) if current_row else 0
        baseline_bytes = int(baseline_row["allocated_bytes"]) if baseline_row else 0
        delta = current_bytes - baseline_bytes
        if delta == 0:
            continue
        representative = current_row or baseline_row
        items.append({
            "path": path,
            "root_key": representative["root_key"],
            "depth": int(representative["depth"]),
            "baseline_bytes": baseline_bytes,
            "current_bytes": current_bytes,
            "delta_bytes": delta,
            "status": "new" if baseline_row is None else "removed" if current_row is None else "changed",
        })
    items.sort(key=lambda item: abs(item["delta_bytes"]), reverse=True)
    return {
        "baselines": baselines,
        "baseline_scan_id": resolved_baseline,
        "current_scan_id": current_scan_id,
        "items": items[:limit],
        "updated_at": iso_now(),
    }


def upsert_node_rows(scan_id: int, rows: List[Dict[str, Any]]) -> None:
    if not rows:
        return
    payload = [
        (
            scan_id,
            row["path"],
            row["parent_path"],
            row["name"],
            row["root_key"],
            row["depth"],
            row["allocated_bytes"],
            int(bool(row.get("children_indexed", False))),
            row["updated_at"],
        )
        for row in rows
    ]
    with DB_WRITE_LOCK:
        with open_db_connection() as connection:
            connection.executemany(
                """
                INSERT INTO nodes (
                    scan_id, path, parent_path, name, root_key, depth, allocated_bytes, children_indexed, updated_at
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(scan_id, path) DO UPDATE SET
                    parent_path = excluded.parent_path,
                    name = excluded.name,
                    root_key = excluded.root_key,
                    depth = excluded.depth,
                    allocated_bytes = excluded.allocated_bytes,
                    children_indexed = excluded.children_indexed,
                    updated_at = excluded.updated_at
                """,
                payload,
            )
            connection.commit()


