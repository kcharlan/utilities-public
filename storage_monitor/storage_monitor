            )} </div> <div style=${{ color: 'var(--text-secondary)', marginTop: 3 }}>${item.available ? item.description : item.unavailable_reason}</div> ${item.available && item.execution === 'manual' && html`<div style=${{ marginTop: 6, padding: 7, borderRadius: 4, background: 'var(--surface-hover)' }}> <code class=${"mono"}>${item.manual_command}</code> <div style=${{ marginTop: 3, color: 'var(--warning)' }}>${item.manual_instruction}</div> </div>`} </div>`)} ${!items.length && html`<div style=${{ padding: 16, textAlign: 'center', color: 'var(--text-secondary)' }}>Provider results appear after a scan.</div>`} </div>`;
    }

    function OrphansTab({ orphans, onReveal }) {
      return html`<div style=${{ fontSize: 13 }}> <div style=${{ padding: 10, background: 'var(--warning-bg)', color: 'var(--warning)' }}>Heuristic only: apps outside standard Applications folders or background-only tools may appear here. Verify before deleting manually.</div> <div style=${{ maxHeight: 360, overflowY: 'auto' }}>${(orphans?.items || []).map(item =>
          html`<div key=${item.path} class=${"surface-hover"} style=${{ display: 'grid', gridTemplateColumns: '2fr 100px 80px 70px', gap: 8, padding: '6px 12px', borderBottom: '1px solid var(--border)' }}> <span title=${item.path} style=${{ overflow: 'hidden', textOverflow: 'ellipsis' }}>${item.name}</span> <span>${item.source === 'group_containers' ? 'Group' : 'Container'}</span> <span class=${"mono"} style=${{ textAlign: 'right' }}>${formatBytes(item.allocated_bytes)}</span> <button onClick=${() => onReveal(item.path)} style=${{ border: '1px solid var(--border)', background: 'transparent', color: 'var(--text-secondary)', borderRadius: 4 }}>Reveal</button> </div>`)}</div> </div>`;
    }

    function GrowthTab({ onOpenPath }) {
      const [data, setData] = useState({ baselines: [], items: [] });
      const [direction, setDirection] = useState('gainers');
      const load = useCallback((id) => {
        const query = id ? `?baseline_scan_id=${id}` : '';
        fetch(`/api/growth${query}`).then(r => r.json()).then(setData).catch(console.error);
      }, []);
      useEffect(() => { load(null); }, [load]);
      const items = (data.items || []).filter(item => direction === 'gainers' ? item.delta_bytes > 0 : item.delta_bytes < 0);
      return html`<div style=${{ fontSize: 13 }}> <div style=${{ display: 'flex', gap: 8, padding: 8, borderBottom: '1px solid var(--border)' }}> <select value=${data.baseline_scan_id || ''} onInput=${e => load(e.target.value)} style=${{ background: 'var(--surface)', color: 'var(--text-primary)', border: '1px solid var(--border)' }}> ${(data.baselines || []).filter(b => b.scan_id !== data.current_scan_id).map(b => html`<option key=${b.scan_id} value=${b.scan_id}>${formatRelativeTime(b.completed_at)}</option>`)} </select> ${['gainers', 'shrinkers'].map(value => html`<button key=${value} onClick=${() => setDirection(value)} style=${{ border: 'none', borderRadius: 4, background: direction === value ? 'var(--accent)' : 'var(--surface-hover)', color: direction === value ? '#fff' : 'var(--text-primary)' }}>${value}</button>`)} </div> <div style=${{ maxHeight: 370, overflowY: 'auto' }}>${items.map(item => html`<div key=${item.path} class=${"surface-hover"} role=${"button"} tabIndex=${"0"} onClick=${() => onOpenPath(item)} onKeyDown=${event => { if (event.key === 'Enter') onOpenPath(item); }} style=${{ display: 'grid', gridTemplateColumns: '2fr 90px 90px 70px', gap: 8, padding: '6px 12px', cursor: 'pointer', borderBottom: '1px solid var(--border)' }}> <span title=${item.path} style=${{ overflow: 'hidden', textOverflow: 'ellipsis' }}>${item.path}</span> <span class=${"mono"} style=${{ color: item.delta_bytes > 0 ? 'var(--danger)' : 'var(--success)', textAlign: 'right' }}>${item.delta_bytes > 0 ? '+' : '-'}${formatBytes(Math.abs(item.delta_bytes))}</span> <span class=${"mono"} style=${{ textAlign: 'right' }}>${formatBytes(item.current_bytes)}</span><span>${item.status}</span> </div>`)}</div> ${!data.baseline_scan_id && html`<div style=${{ padding: 18, textAlign: 'center', color: 'var(--text-secondary)' }}>Complete two scans to compare directory growth.</div>`} </div>`;
    }

    function ActionPanel({ findings, snapshots, largeFiles, providers, orphans, busyToken, onExecute, onReveal, onOpenGrowthPath, isScanning }) {
      const [activeTab, setActiveTab] = useState('findings');
      const findingsCount = findings?.items?.length || 0;
      const snapshotsCount = snapshots?.items?.length || 0;
      const largeFilesCount = largeFiles?.items?.length || 0;
      const providersCount = providers?.items?.length || 0;
      const orphansCount = orphans?.items?.length || 0;

      return (
        html`<div class=${"surface"} style=${{ borderRadius: 8, overflow: 'hidden' }}>  <div style=${{ display: 'flex', borderBottom: '1px solid var(--border)' }}> ${[
              { key: 'findings', label: 'Findings', count: findingsCount },
              { key: 'snapshots', label: 'Snapshots', count: snapshotsCount },
              { key: 'large_files', label: 'Large Files', count: largeFilesCount },
              { key: 'providers', label: 'Providers', count: providersCount },
              { key: 'growth', label: 'Growth', count: 0 },
              { key: 'orphans', label: 'App Leftovers', count: orphansCount },
            ].map(t => (
              html`<button key=${t.key} class=${`tab ${activeTab === t.key ? 'active' : ''}`} onClick=${() => setActiveTab(t.key)} style=${{ background: 'none', border: 'none', borderBottom: undefined }}>${t.label}<span style=${{ marginLeft: 4, padding: '1px 6px', borderRadius: 8, fontSize: 11, background: activeTab === t.key ? 'var(--accent)' : 'var(--surface-hover)', color: activeTab === t.key ? '#fff' : 'var(--text-secondary)' }}>${t.count}</span></button>`
            ))} </div>  ${activeTab === 'findings' && (
            html`<${FindingsTab} findings=${findings} busyToken=${busyToken} onExecute=${onExecute} onReveal=${onReveal} isScanning=${isScanning} />`
          )} ${activeTab === 'snapshots' && (
            html`<${SnapshotsTab} snapshots=${snapshots} busyToken=${busyToken} onExecute=${onExecute} isScanning=${isScanning} />`
          )} ${activeTab === 'large_files' && (
            html`<${LargeFilesTab} largeFiles=${largeFiles} onReveal=${onReveal} isScanning=${isScanning} />`
          )} ${activeTab === 'providers' && html`<${ProvidersTab} providers=${providers} busyToken=${busyToken} onExecute=${onExecute} />`} ${activeTab === 'growth' && html`<${GrowthTab} onOpenPath=${onOpenGrowthPath} />`} ${activeTab === 'orphans' && html`<${OrphansTab} orphans=${orphans} onReveal=${onReveal} />`} </div>`
      );
    }

    function App() {
      const {
        metadata, summary, breakdowns, findings, snapshots, largeFiles, providers, orphans,
        checks, scanStatus, busyToken, message, messageType,
        triggerScan, executeAction, revealPath, rescanPath, dismissMessage,
      } = useMonitorState();

      const [activeRoot, setActiveRoot] = useState(null);
      const [growthPath, setGrowthPath] = useState(null);
      const isScanning = scanStatus?.running;

      // Auto-dismiss messages: 3s for success, 6s for errors
      useEffect(() => {
        if (!message) return;
        const delay = messageType === 'error' ? 6000 : 3000;
        const timer = setTimeout(dismissMessage, delay);
        return () => clearTimeout(timer);
      }, [message, messageType, dismissMessage]);

      // Auto-select first available root
      useEffect(() => {
        if (activeRoot) return;
        for (const key of ['data_root', 'home_root', 'library_root', 'applications_root']) {
          if (breakdowns[key]?.items?.length > 0) {
            setActiveRoot(key);
            break;
          }
        }
      }, [breakdowns, activeRoot]);

      return (
        html`<div style=${{ minHeight: '100vh', display: 'flex', flexDirection: 'column' }}>  <${HeaderBar} metadata=${metadata} summary=${summary} scanStatus=${scanStatus} onRescan=${triggerScan} onToggleTheme=${toggleTheme} checks=${checks} />  ${message && (
            html`<div style=${{
              display: 'flex', alignItems: 'center', justifyContent: 'space-between',
              padding: '6px 16px', fontSize: 13,
              background: messageType === 'error' ? 'var(--danger-bg)' : 'var(--success-bg)',
              color: messageType === 'error' ? 'var(--danger)' : 'var(--success)',
            }}> <span>${message}</span> <button onClick=${dismissMessage} aria-label=${"Dismiss"} style=${{ background: 'none', border: 'none', cursor: 'pointer', color: 'inherit', fontSize: 16, padding: '0 4px', lineHeight: 1, opacity: 0.7 }}> × </button> </div>`
          )} <div style=${{ flex: 1, padding: '12px 16px', display: 'flex', flexDirection: 'column', gap: 12, maxWidth: 1600, margin: '0 auto', width: '100%' }}>  <section> <${Treemap} breakdowns=${breakdowns} activeRoot=${activeRoot} onSelectRoot=${setActiveRoot} isScanning=${isScanning} /> ${activeRoot && (
                html`<${AccordionBreakdown} rootKey=${activeRoot} breakdown=${breakdowns[activeRoot]} isScanning=${isScanning} onReveal=${revealPath} onRescan=${rescanPath} externalPath=${growthPath} />`
              )} </section>  <section style=${{ flex: 1, minHeight: 0 }}> <${ActionPanel} findings=${findings} snapshots=${snapshots} largeFiles=${largeFiles} providers=${providers} orphans=${orphans} busyToken=${busyToken} onExecute=${executeAction} onReveal=${revealPath} onOpenGrowthPath=${(item) => { setActiveRoot(item.root_key); setGrowthPath(item.path); }} isScanning=${isScanning} /> </section> </div> </div>`
      );
    }

    preact.render(html`<${App} />`, document.getElementById('root'));
  </script>
</body>
</html>
