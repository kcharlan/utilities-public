def probe_provider(scan_id: int, slug: str) -> Dict[str, Any]:
    spec = PROVIDER_SPECS[slug]
    available = shutil.which(spec["binary"]) is not None
    reason = None if available else f"{spec['binary']} is not installed."
    estimate: Optional[int] = None
    duration_ms = 0
    if available:
        result = run_command(spec["probe"], timeout=spec["probe_timeout"])
        duration_ms = result["duration_ms"]
        if not result["ok"]:
            available = False
            reason = next((line.strip() for line in result["stderr"].splitlines() if line.strip()), "Probe failed.")
        elif slug == "brew-cleanup":
            estimate = parse_brew_cleanup_estimate(result["stdout"])
            if estimate is None:
                available = False
                reason = "Homebrew did not report a cleanup estimate."
        elif slug == "docker-prune":
            estimate = parse_docker_reclaim_estimate(result["stdout"])
        else:
            cache_dir = result["stdout"].strip()
            estimate = indexed_path_bytes(scan_id, Path(cache_dir)) if cache_dir else None
    action_token = (
        encode_action_token({"kind": "provider_execute", "slug": slug})
        if available and spec["execution"] == "action" else None
    )
    return {
        "slug": slug, "label": spec["label"], "description": spec["description"],
        "available": available, "unavailable_reason": reason,
        "estimate_bytes": estimate, "estimate_kind": spec["estimate_kind"],
        "risk": spec["risk"], "duration_ms": duration_ms,
        "execution": spec["execution"], "action_token": action_token,
        "manual_command": spec.get("manual_command"),
        "manual_instruction": spec.get("manual_instruction"),
        "actions": ([{"label": "Run cleanup", "kind": "execute", "action_token": action_token,
                      "risk": spec["risk"], "estimated_reclaim_bytes": estimate}]
                    if available and spec["execution"] == "action" else []),
    }


def probe_providers(scan_id: int) -> Dict[str, Any]:
    results = run_parallel_call_map({
        slug: (lambda slug=slug: probe_provider(scan_id, slug)) for slug in PROVIDER_SPECS
    })
    return {"items": [results[slug] for slug in PROVIDER_SPECS], "updated_at": iso_now()}


