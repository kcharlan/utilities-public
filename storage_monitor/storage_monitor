    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(payload, sort_keys=True) + "\n")


def testing_mode_enabled() -> bool:
    value = os.environ.get("UTILITIES_TESTING", "")
    return value.lower() not in {"", "0", "false", "no"}


def run_command(args: List[str], timeout: int = 120) -> Dict[str, Any]:
    start = time.time()
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return {
            "ok": result.returncode == 0,
            "returncode": result.returncode,
            "stdout": result.stdout,
            "stderr": result.stderr,
            "duration_ms": int((time.time() - start) * 1000),
            "command": " ".join(args),
        }
    except Exception as exc:
        return {
            "ok": False,
            "returncode": None,
            "stdout": "",
            "stderr": str(exc),
            "duration_ms": int((time.time() - start) * 1000),
            "command": " ".join(args),
        }


def run_parallel_call_map(
    task_map: Dict[str, Any],
    max_workers: Optional[int] = None,
    progress_callback: Optional[Any] = None,
) -> Dict[str, Any]:
    if not task_map:
        return {}
    worker_count = max_workers or min(SCAN_WORKER_COUNT, len(task_map))
    results: Dict[str, Any] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=worker_count) as executor:
        future_map = {executor.submit(func): key for key, func in task_map.items()}
        for future in concurrent.futures.as_completed(future_map):
            key = future_map[future]
            results[key] = future.result()
            if progress_callback is not None:
                progress_callback(key, len(results), len(task_map))
    return results


def parse_size_token(value: str, unit: str) -> int:
    multipliers = {"B": 1, "KB": 1000, "MB": 1000**2, "GB": 1000**3, "TB": 1000**4}
    normalized = unit.upper()
    if normalized not in multipliers:
        raise ValueError(f"Unsupported size unit: {unit}")
    return int(float(value) * multipliers[normalized])


def parse_brew_cleanup_estimate(stdout: str) -> Optional[int]:
    matches = re.findall(r"approximately\s+([\d.]+)\s*([KMGT]?B)", stdout, re.IGNORECASE)
    if not matches:
        return None
    return parse_size_token(*matches[-1])


def parse_docker_reclaim_estimate(stdout: str) -> Optional[int]:
    total = 0
    found = False
    included_types = {"Images", "Containers", "Build Cache"}
    for line in stdout.splitlines():
        try:
            item = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            continue
        if item.get("Type") not in included_types:
            continue
        match = re.match(r"^([\d.]+)\s*([KMGT]?B)", str(item.get("Reclaimable", "")), re.IGNORECASE)
        if not match:
            continue
        total += parse_size_token(match.group(1), match.group(2))
        found = True
    return total if found else None


def indexed_path_bytes(scan_id: int, path: Path) -> Optional[int]:
    with open_db_connection() as connection:
        row = connection.execute(
            "SELECT allocated_bytes FROM nodes WHERE scan_id=? AND path=?",
            (scan_id, str(path.expanduser().resolve())),
        ).fetchone()
    return int(row["allocated_bytes"]) if row else None


def run_provider_probe(slug: str) -> Optional[Dict[str, Any]]:
    spec = PROVIDER_SPECS[slug]
    if shutil.which(spec["binary"]) is None:
        return None
    return run_command(spec["probe"], timeout=spec["probe_timeout"])


def build_provider_item(scan_id: int, slug: str, probe_result: Optional[Dict[str, Any]]) -> Dict[str, Any]:
    spec = PROVIDER_SPECS[slug]
    available = probe_result is not None
    reason = None if available else f"{spec['binary']} is not installed."
    estimate: Optional[int] = None
    duration_ms = 0
    if available:
        result = probe_result
        duration_ms = result["duration_ms"]
        if not result["ok"]:
            available = False
            reason = next((line.strip() for line in result["stderr"].splitlines() if line.strip()), "Probe failed.")
        elif slug == "brew-cleanup":
            estimate = parse_brew_cleanup_estimate(result["stdout"])
            if estimate is None:
                available = False
                reason = "Homebrew did not report a cleanup estimate."
        elif slug == "docker-prune":
            estimate = parse_docker_reclaim_estimate(result["stdout"])
        else:
            cache_dir = result["stdout"].strip()
            estimate = indexed_path_bytes(scan_id, Path(cache_dir)) if cache_dir else None
    action_token = (
        encode_action_token({"kind": "provider_execute", "slug": slug})
        if available and spec["execution"] == "action" else None
    )
    return {
        "slug": slug, "label": spec["label"], "description": spec["description"],
        "available": available, "unavailable_reason": reason,
        "estimate_bytes": estimate, "estimate_kind": spec["estimate_kind"],
        "risk": spec["risk"], "duration_ms": duration_ms,
        "execution": spec["execution"], "action_token": action_token,
        "manual_command": spec.get("manual_command"),
        "manual_instruction": spec.get("manual_instruction"),
        "actions": ([{"label": "Run cleanup", "kind": "execute", "action_token": action_token,
                      "risk": spec["risk"], "estimated_reclaim_bytes": estimate}]
                    if available and spec["execution"] == "action" else []),
    }


def probe_provider(scan_id: int, slug: str) -> Dict[str, Any]:
    return build_provider_item(scan_id, slug, run_provider_probe(slug))


def probe_providers(scan_id: int, probe_results: Optional[Dict[str, Optional[Dict[str, Any]]]] = None) -> Dict[str, Any]:
    results = run_parallel_call_map({
        slug: (lambda slug=slug: probe_provider(scan_id, slug) if probe_results is None
               else build_provider_item(scan_id, slug, probe_results[slug]))
        for slug in PROVIDER_SPECS
    })
    return {"items": [results[slug] for slug in PROVIDER_SPECS], "updated_at": iso_now()}


def expand_path(path_str: str) -> Path:
    return Path(os.path.expanduser(path_str)).resolve()


def safe_stat(path: Path) -> Optional[os.stat_result]:
    try:
        return path.stat()
    except OSError:
        return None


def allocated_bytes_from_stat(stat_result: Optional[os.stat_result]) -> Optional[int]:
    if stat_result is None:
        return None
    blocks = getattr(stat_result, "st_blocks", None)
    if blocks is None:
        return None
    return int(blocks) * 512


@dataclass
class WalkResult:
    dir_local: Dict[str, int]
    hardlink_candidates: List[Tuple[int, int, str, str, int, int]]
    large_files: List[Dict[str, Any]]
    dir_count: int
    file_count: int
    error_count: int
    duration_ms: int


WALKER_PROTOCOL = 1


class WalkerUnavailable(RuntimeError):
    pass


def _walker_unavailable(detail: str) -> WalkerUnavailable:
    return WalkerUnavailable(
        f"Storage Monitor's native walker is missing or incompatible ({detail}). "
        "Deploy with: node tools/deploy_storage_monitor.mjs  — or, in a development checkout: make -C storage_monitor/native"
    )


def walker_path() -> Path:
    override = os.environ.get("STORAGE_MONITOR_WALKER")
    if override is not None:
        path = Path(override)
        if path.is_file():
            return path
        raise _walker_unavailable("configured helper not found")
    directory = Path(__file__).resolve().parent
    for path in (directory / "storage_monitor_walk", directory / "native/build/storage_monitor_walk"):
        if path.is_file():
            return path
    raise _walker_unavailable("helper not found")


def check_walker() -> str:
    try:
        result = subprocess.run([str(walker_path()), "--version"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError, UnicodeError) as exc:
        raise _walker_unavailable(str(exc)) from exc
    version = result.stdout.strip()
    if result.returncode or not re.fullmatch(r"storage_monitor_walk \S+ protocol " + str(WALKER_PROTOCOL), version):
        raise _walker_unavailable(f"version check failed: {version[:200]}")
    return version


_FIELDS = {b"D": 2, b"H": 6, b"L": 4, b"P": 1, b"S": 4}


def _iter_walker_records(stream):
    pending = b""
    fields: List[bytes] = []
    while True:
        chunk = stream.read(1 << 20)
        if not chunk:
            break
        pending += chunk
        parts = pending.split(b"\0")
        pending = parts.pop()
        for part in parts:
            fields.append(part)
            kind = fields[0]
            if kind not in _FIELDS:
                raise RuntimeError(f"storage_monitor_walk protocol error: record type {kind!r}")
            if len(fields) == _FIELDS[kind] + 1:
                yield kind, fields[1:]
                fields = []
    if pending or fields:
        raise RuntimeError("storage_monitor_walk protocol error: truncated record stream")


def walk_tree(
    root: Path,
    *,
    workers: int = SCAN_WORKER_COUNT,
    excluded_paths: Optional[List[Path]] = None,
    registered_inodes: Optional[Set[int]] = None,
    progress_callback: Optional[Callable[[int], None]] = None,
) -> WalkResult:
    started = time.time()
    argv = [str(walker_path()), "walk", "--root", str(root), "--workers", str(workers),
            "--large-file-bytes", str(LARGE_FILE_THRESHOLD_BYTES), "--progress-every", "2000"]
    for path in excluded_paths or []:
        argv.extend(["--exclude", str(path)])
    if registered_inodes:
        argv.append("--registered-inodes-stdin")
    dir_local: Dict[str, int] = {}
    hardlinks: List[Tuple[int, int, str, str, int, int]] = []
    large_files: List[Dict[str, Any]] = []
    summary = None
    with tempfile.TemporaryFile() as stderr:
        process = subprocess.Popen(
            argv, stdin=subprocess.PIPE if registered_inodes else subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=stderr, bufsize=0,
        )
        try:
            if registered_inodes:
                try:
                    payload = "\n".join(map(str, sorted(registered_inodes))).encode()
                    # Raw pipes may accept only part of a large registration list.
                    remaining = memoryview(payload)
                    while remaining:
                        remaining = remaining[process.stdin.write(remaining):]
                finally:
                    process.stdin.close()
            for kind, fields in _iter_walker_records(process.stdout):
                if summary is not None:
                    raise RuntimeError("storage_monitor_walk protocol error: record after S")
                if kind == b"D":
                    dir_local[os.fsdecode(fields[0])] = int(fields[1])
                elif kind == b"H":
                    dev, ino, nlink, alloc, parent, name = fields
                    parent, name = os.fsdecode(parent), os.fsdecode(name)
                    hardlinks.append((int(dev), int(ino), os.path.join(parent, name), parent, int(alloc), int(nlink)))
                elif kind == b"L":
                    parent, name = os.fsdecode(fields[2]), os.fsdecode(fields[3])
                    large_files.append({"path": os.path.join(parent, name), "parent_path": parent,
                                        "name": name, "apparent_bytes": int(fields[0]),
                                        "allocated_bytes": int(fields[1])})
                elif kind == b"P":
                    count = int(fields[0])
                    if progress_callback is not None:
                        progress_callback(count)
                else:
                    summary = tuple(map(int, fields))
            status = process.wait()
            stderr.seek(0)
            detail = stderr.read(8000).decode(errors="replace")[:2000]
            if status == 3:
                match = re.search(r"errno=(\d+)", detail)
                if match is None:
                    raise RuntimeError(f"storage_monitor_walk root failure without errno: {detail}")
                number = int(match.group(1))
                raise OSError(number, os.strerror(number), str(root))
            if status or summary is None:
                raise RuntimeError(f"storage_monitor_walk failed (exit {status}, summary={summary is not None}): {detail}")
        except BaseException as exc:
            if process.poll() is None:
                process.kill()
            process.wait()
            if isinstance(exc, (RuntimeError, ValueError)):
                stderr.seek(0)
                detail = stderr.read(8000).decode(errors="replace")[:2000]
                raise RuntimeError(f"{exc}: {detail}") from exc
            raise
        finally:
            if process.poll() is None:
                process.kill()
            process.wait()
            if process.stdin is not None:
                process.stdin.close()
            process.stdout.close()
    return WalkResult(
        dir_local=dir_local, hardlink_candidates=hardlinks, large_files=large_files,
        dir_count=summary[0], file_count=summary[1], error_count=summary[2],
        duration_ms=int((time.time() - started) * 1000),
    )


def rollup_subtree_totals(dir_local: Dict[str, int], root: str) -> Dict[str, int]:
    totals = dict(dir_local)
    for path_str in sorted(totals, key=lambda value: value.count(os.sep), reverse=True):
        if path_str == root:
            continue
        parent = os.path.dirname(path_str)
        if parent in totals:
            totals[parent] += totals[path_str]
    return totals


def build_walk_translation() -> List[Tuple[str, str, str]]:
    mappings: List[Tuple[str, str, str]] = []
    data_home = DATA_VOLUME / "Users" / HOME_DIR.name
    home = HOME_DIR.resolve()
    data_apps = DATA_VOLUME / "Applications"
    apps = APPLICATIONS_DIR.resolve()
    if samefile_or_false(data_home, home):
        mappings.append((str(data_home), str(home), "home_root"))
    mappings.append((str(home), str(home), "home_root"))
    if samefile_or_false(data_apps, apps):
        mappings.append((str(data_apps), str(apps), "applications_root"))
    mappings.append((str(apps), str(apps), "applications_root"))
    return sorted(mappings, key=lambda item: len(item[0]), reverse=True)


def translate_walk_path(path_str: str, translation: List[Tuple[str, str, str]]) -> Tuple[str, str]:
    for walked_prefix, stored_prefix, root_key in translation:
        if path_str == walked_prefix:
            return stored_prefix, root_key
        if path_str.startswith(walked_prefix + os.sep):
            return stored_prefix + path_str[len(walked_prefix):], root_key
    return path_str, "data_root"


def resolve_hardlink_ownership(
    scan_id: int,
    candidates: List[Tuple[int, int, str, str, int, int]],
    translation: List[Tuple[str, str, str]],
    *,
    full_scan: bool,
    connection: Optional[sqlite3.Connection] = None,
) -> Tuple[List[Tuple[str, int]], List[Tuple[str, int]], List[Tuple[str, Tuple[Any, ...]]]]:
    grouped: Dict[Tuple[int, int], List[Tuple[int, int, str, str, int, int]]] = {}
    for candidate in candidates:
        grouped.setdefault((candidate[0], candidate[1]), []).append(candidate)
    attributions: List[Tuple[str, int]] = []
    adjustments: List[Tuple[str, int]] = []
    changes: List[Tuple[str, Tuple[Any, ...]]] = []
    existing: Dict[int, sqlite3.Row] = {}
    db = connection
    owns_connection = db is None
    if db is None and not full_scan:
        db = open_db_connection()
    try:
        if not full_scan and grouped:
            assert db is not None
            inos = [key[1] for key in grouped]
            for offset in range(0, len(inos), 900):
                chunk = inos[offset:offset + 900]
                placeholders = ",".join("?" for _ in chunk)
                for row in db.execute(
                    f"SELECT ino, dev, owner_path, allocated_bytes FROM hardlink_inodes WHERE scan_id = ? AND ino IN ({placeholders})",
                    (scan_id, *chunk),
                ):
                    existing[int(row["ino"])] = row
        for (dev, ino), group in grouped.items():
            translated = [(translate_walk_path(item[2], translation)[0], item) for item in group]
            translated.sort(key=lambda item: item[0])
            row = existing.get(ino)
            if row is None and all(item[1][5] == 1 for item in translated):
                attributions.extend((item[1][3], item[1][4]) for item in translated)
                continue
            owner_path = translated[0][0]
            owner_item = translated[0][1]
            if row is not None:
                valid = False
                try:
                    owner_stat = os.lstat(row["owner_path"])
                    valid = owner_stat.st_dev == row["dev"] and owner_stat.st_ino == row["ino"]
                except OSError:
                    pass
                candidates_by_path = {path: item for path, item in translated}
                if row["owner_path"] in candidates_by_path:
                    owner_path = row["owner_path"]
                    owner_item = candidates_by_path[owner_path]
                elif valid:
                    continue
                else:
                    adjustments.append((os.path.dirname(row["owner_path"]), -int(row["allocated_bytes"])))
            attributions.append((owner_item[3], owner_item[4]))
            if all(item[1][5] == 1 for item in translated):
                changes.append(("delete", (scan_id, ino)))
            else:
                changes.append(("upsert", (scan_id, ino, dev, owner_path, owner_item[4])))
    finally:
        if owns_connection and db is not None:
            db.close()
    return attributions, adjustments, changes


def stat_file_sizes(path: Path) -> Dict[str, Optional[int]]:
    stat_result = safe_stat(path)
    if stat_result is None:
        return {"apparent_bytes": None, "allocated_bytes": None}
    return {
        "apparent_bytes": int(stat_result.st_size),
        "allocated_bytes": allocated_bytes_from_stat(stat_result) or int(stat_result.st_size),
    }


def bytes_or_zero(value: Optional[int]) -> int:
    return int(value or 0)


def format_number(value: Optional[int]) -> str:
    if value is None:
        return "Unknown"
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    amount = float(value)
    for unit in units:
        if amount < 1024.0 or unit == units[-1]:
            if unit == "B":
                return f"{int(amount)} {unit}"
            return f"{amount:.1f} {unit}"
        amount /= 1024.0
    return f"{int(value)} B"


def encode_action_token(payload: Dict[str, Any]) -> str:
    return base64.urlsafe_b64encode(json.dumps(payload, sort_keys=True).encode("utf-8")).decode("ascii")


def decode_action_token(token: str) -> Dict[str, Any]:
    return json.loads(base64.urlsafe_b64decode(token.encode("ascii")).decode("utf-8"))


def publish_event(event_type: str, payload: Dict[str, Any]) -> None:
    message = {"type": event_type, "payload": payload}
    stale_ids: List[str] = []
    with STATE.lock:
        subscribers = list(STATE.subscribers.items())
    for subscriber_id, subscriber_queue in subscribers:
        try:
            subscriber_queue.put_nowait(message)
        except Exception:
            stale_ids.append(subscriber_id)
    if stale_ids:
        with STATE.lock:
            for subscriber_id in stale_ids:
                STATE.subscribers.pop(subscriber_id, None)


def set_scan_status(**updates: Any) -> None:
    with STATE.lock:
        STATE.scan_status.update(updates)
        STATE.scan_status["updated_at"] = iso_now()
