SCAN_DB_FILENAME = "storage_monitor.db"


@dataclass(frozen=True)
class RuntimePaths:
    home: Path
    scan_db: Path
    latest_scan: Path
    history_dir: Path
    action_log: Path
    last_port: Path
    pid_file: Path


def build_runtime_paths() -> RuntimePaths:
    override = os.environ.get("STORAGE_MONITOR_HOME")
    home = Path(override).expanduser() if override else Path.home() / ".storage_monitor"
    return RuntimePaths(
        home=home,
        scan_db=home / SCAN_DB_FILENAME,
        latest_scan=home / "latest_scan.json",
        history_dir=home / "history",
        action_log=home / "action_log.jsonl",
        last_port=home / "last_port",
        pid_file=home / "pid",
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Storage Monitor: scan local storage, surface reclaim candidates, and run safe cleanup actions.",
    )
    parser.add_argument("--port", "-p", type=int, default=8473, help="Preferred localhost port (default: 8473).")
    parser.add_argument("--no-browser", action="store_true", help="Do not auto-open the browser UI.")
    return parser.parse_args()


def ensure_runtime_home(paths: RuntimePaths) -> None:
    paths.home.mkdir(parents=True, exist_ok=True)
    paths.history_dir.mkdir(parents=True, exist_ok=True)


def open_db_connection(paths: Optional[RuntimePaths] = None) -> sqlite3.Connection:
    target = paths or RUNTIME_PATHS
    connection = sqlite3.connect(str(target.scan_db), timeout=30)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA journal_mode=WAL")
    connection.execute("PRAGMA foreign_keys=ON")
    connection.execute("PRAGMA busy_timeout=5000")
    return connection


def initialize_scan_db(paths: RuntimePaths) -> None:
    with open_db_connection(paths) as connection:
        connection.executescript(
            """
            CREATE TABLE IF NOT EXISTS scan_runs (
                id INTEGER PRIMARY KEY,
                started_at TEXT NOT NULL,
                completed_at TEXT,
                status TEXT NOT NULL,
                active INTEGER NOT NULL DEFAULT 0,
                report_json TEXT
            );

            CREATE TABLE IF NOT EXISTS nodes (
                scan_id INTEGER NOT NULL,
                path TEXT NOT NULL,
                parent_path TEXT,
                name TEXT NOT NULL,
                root_key TEXT NOT NULL,
                depth INTEGER NOT NULL,
                allocated_bytes INTEGER NOT NULL,
                children_indexed INTEGER NOT NULL DEFAULT 0,
                updated_at TEXT NOT NULL,
                PRIMARY KEY (scan_id, path),
                FOREIGN KEY (scan_id) REFERENCES scan_runs(id)
            );

            CREATE INDEX IF NOT EXISTS idx_nodes_parent
            ON nodes (scan_id, parent_path, allocated_bytes DESC);

            CREATE TABLE IF NOT EXISTS large_files (
                scan_id INTEGER NOT NULL,
                path TEXT NOT NULL,
                parent_path TEXT,
                name TEXT NOT NULL,
                root_key TEXT NOT NULL,
                apparent_bytes INTEGER,
                allocated_bytes INTEGER,
                updated_at TEXT NOT NULL,
                PRIMARY KEY (scan_id, path),
                FOREIGN KEY (scan_id) REFERENCES scan_runs(id)
            );

            CREATE INDEX IF NOT EXISTS idx_large_files_root
            ON large_files (scan_id, root_key, allocated_bytes DESC);

            CREATE TABLE IF NOT EXISTS hardlink_inodes (
                scan_id INTEGER NOT NULL,
                ino INTEGER NOT NULL,
                dev INTEGER NOT NULL,
                owner_path TEXT NOT NULL,
                allocated_bytes INTEGER NOT NULL,
                PRIMARY KEY (scan_id, ino)
            );

            CREATE TABLE IF NOT EXISTS scan_dir_history (
                scan_id INTEGER NOT NULL,
                completed_at TEXT NOT NULL,
                path TEXT NOT NULL,
                root_key TEXT NOT NULL,
                depth INTEGER NOT NULL,
                allocated_bytes INTEGER NOT NULL,
                PRIMARY KEY (scan_id, path)
            );

            CREATE INDEX IF NOT EXISTS idx_dir_history_path
            ON scan_dir_history (path, scan_id);
            """
        )
        node_columns = {
            row["name"]
            for row in connection.execute("PRAGMA table_info(nodes)").fetchall()
        }
        if "children_indexed" not in node_columns:
            connection.execute(
                "ALTER TABLE nodes ADD COLUMN children_indexed INTEGER NOT NULL DEFAULT 0"
            )
        connection.commit()

