def mark_alias_path_cached(scan_id: int, source_path: Path, target_path: Path, root_key: str) -> None:
    target_breakdown = fetch_breakdown_from_db(scan_id, str(target_path))
    if target_breakdown is None or target_breakdown["total_bytes"] is None:
