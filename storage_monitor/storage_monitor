        html`<div class=${"surface"} style=${{ borderRadius: 8, overflow: 'hidden' }}>  <div style=${{
            display: 'flex', justifyContent: 'space-between', alignItems: 'center',
            padding: '8px 12px', borderBottom: '1px solid var(--border)',
            background: `${ROOT_COLORS[rootKey]}15`,
          }}> <div style=${{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 14, flexWrap: 'wrap' }}>  <span style=${{ cursor: drillPath.length > 0 ? 'pointer' : 'default', fontWeight: 600, textDecoration: drillPath.length > 0 ? 'underline' : 'none' }} onClick=${() => drillPath.length > 0 && navigateBack(-1)}> ${ROOT_LABELS[rootKey]} </span> ${drillPath.map((crumb, i) => (
                html`<span key=${i}> <span style=${{ opacity: 0.4, margin: '0 4px' }}>></span> <span style=${{ cursor: i < drillPath.length - 1 ? 'pointer' : 'default', textDecoration: i < drillPath.length - 1 ? 'underline' : 'none' }} onClick=${() => i < drillPath.length - 1 && navigateBack(i)}> ${crumb.label} </span> </span>`
              ))} </div> <div style=${{ display: 'flex', alignItems: 'center', gap: 8 }}> <span style=${{ fontSize: 12, color: 'var(--text-secondary)' }}> ${formatBytes(currentTotal)} · ${currentItems.length} items ${updatedAt && ` · ${formatRelativeTime(updatedAt)}`} </span> ${onReveal && drillPath.length > 0 && (
                html`<button onClick=${(e) => {
                    e.stopPropagation();
                    const revealTarget = drillData?.path || drillPath[drillPath.length - 1].path;
                    onReveal(revealTarget);
                  }} title=${"Reveal in Finder"} style=${{
                    padding: '2px 7px',
                    borderRadius: 4,
                    fontSize: 11,
                    border: '1px solid var(--border)',
                    cursor: 'pointer',
                    background: 'transparent',
                    color: 'var(--text-secondary)',
                    whiteSpace: 'nowrap',
                  }}> Reveal </button>`
              )} ${onRescan && drillPath.length > 0 && (
                html`<button onClick=${async (e) => {
                    e.stopPropagation();
                    const target = drillData?.path || drillPath[drillPath.length - 1].path;
                    setRescanning(true);
                    try {
                      const freshData = await onRescan(target);
                      if (freshData) {
                        setDrillData(freshData);
                        setCachedPaths(new Set());
                      }
                    } finally {
                      setRescanning(false);
                    }
                  }} disabled=${rescanning} title=${"Rescan this directory"} style=${{
                    padding: '2px 7px',
                    borderRadius: 4,
                    fontSize: 11,
                    border: '1px solid var(--border)',
                    cursor: rescanning ? 'wait' : 'pointer',
                    background: 'transparent',
                    color: 'var(--text-secondary)',
                    whiteSpace: 'nowrap',
                    opacity: rescanning ? 0.5 : 1,
                  }}> ${rescanning ? 'Scanning…' : 'Rescan'} </button>`
              )} </div> </div>  ${drillLoading ? (
            html`<div style=${{ padding: '20px 12px', textAlign: 'center' }}> <div style=${{ display: 'inline-flex', alignItems: 'center', gap: 8, color: 'var(--text-secondary)', fontSize: 13 }}> <span role=${"presentation"} style=${{ display: 'inline-block', width: 14, height: 14, border: '2px solid var(--border)', borderTopColor: 'var(--accent)', borderRadius: '50%', animation: 'spin 0.8s linear infinite' }} /> Scanning directory… </div> <div style=${{ marginTop: 12 }}> <div class=${"shimmer"} style=${{ height: 14, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 14, marginBottom: 8 }} /> <div class=${"shimmer"} style=${{ height: 14 }} /> </div> </div>`
          ) : (
            html`<div style=${{ maxHeight: 320, overflowY: 'auto', fontSize: 13 }}> ${displayItems.map((item) => (
                html`<div key=${item.path} class=${item.is_file ? '' : 'surface-hover'} role=${item.is_file ? undefined : 'button'} tabIndex=${item.is_file ? undefined : 0} style=${{ display: 'flex', alignItems: 'center', padding: '5px 12px', borderBottom: '1px solid var(--border)', cursor: item.is_file ? 'default' : 'pointer', opacity: item.is_file ? 0.75 : 1 }} onClick=${item.is_file ? undefined : () => drillInto(item)} onKeyDown=${item.is_file ? undefined : (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); drillInto(item); } }}> <span style=${{
                    width: 'clamp(180px, 38%, 240px)',
                    minWidth: 0,
                    display: 'flex',
                    alignItems: 'center',
                    gap: 6,
                  }}> ${item.is_file ? (
                      html`<svg width=${"13"} height=${"13"} viewBox=${"0 0 24 24"} fill=${"none"} stroke=${"var(--text-secondary)"} stroke-width=${"2"} stroke-linecap=${"round"} stroke-linejoin=${"round"} style=${{ flex: '0 0 auto', opacity: 0.5 }}> <path d=${"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"} /><polyline points=${"14 2 14 8 20 8"} /> </svg>`
                    ) : (
                      html`<svg width=${"13"} height=${"13"} viewBox=${"0 0 24 24"} fill=${"none"} stroke=${"var(--text-secondary)"} stroke-width=${"2"} stroke-linecap=${"round"} stroke-linejoin=${"round"} style=${{ flex: '0 0 auto', opacity: 0.5 }}> <path d=${"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"} /> </svg>`
                    )} ${item.is_cached === false && !cachedPaths.has(item.path) && (
                      html`<span title=${"Not yet scanned — click to load"} aria-label=${"Not yet scanned"} style=${{
                          display: 'inline-block',
                          width: 6,
                          height: 6,
                          borderRadius: '50%',
