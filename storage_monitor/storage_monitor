def refresh_large_files_for_paths(scan_id: int, paths: List[Path]) -> None:
    for path in paths:
        target = path if path.is_dir() else path.parent
        if target.exists():
            walk_subtree_and_store(scan_id, target)


def rebuild_and_publish_report(
    scan_id: int,
    metadata: Dict[str, Any],
    provider_slug: Optional[str] = None,
) -> Optional[Dict[str, Any]]:
    """Rebuild the report from DB, persist it, and broadcast via SSE."""
    with STATE.lock:
        base_report = dict(STATE.report or {})
    if not base_report:
        publish_event("metadata_ready", metadata)
        return None
    if provider_slug is not None:
        providers = dict(base_report.get("providers") or {"items": [], "updated_at": None})
        replacement = probe_provider(scan_id, provider_slug)
        items = [
            replacement if item.get("slug") == provider_slug else item
            for item in providers.get("items", [])
        ]
        if not any(item.get("slug") == provider_slug for item in items):
            items.append(replacement)
        base_report["providers"] = {"items": items, "updated_at": iso_now()}
    watchlist = scan_watchlist()["items"]
    snapshots = collect_snapshot_section()
    report = build_updated_report(scan_id, base_report, metadata, watchlist, snapshots)
    persist_report(report)
    persist_report_json(scan_id, report)
    with STATE.lock:
        STATE.report = report
    publish_event("metadata_ready", metadata)
    publish_event("report", report)
    return report


def refresh_after_action(action: Dict[str, Any], result: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    scan_id = fetch_active_scan_id()
    metadata = collect_metadata()
    if scan_id is None:
        publish_event("metadata_ready", metadata)
        return None

    if action.get("kind") == "trash_path":
        source_path = Path(action["path"]).expanduser()
        trash_path = Path(result["trash_path"]).expanduser()
        source_root_key = root_key_for_path(source_path)
        if source_root_key is not None:
            remove_cached_subtree(scan_id, source_root_key, str(source_path.resolve()))
            refresh_directory_chain(scan_id, source_path.parent)
        destination_root_key = root_key_for_path(trash_path)
        if destination_root_key is not None:
            refresh_directory_chain(scan_id, trash_path.parent)
        refresh_large_files_for_paths(scan_id, [trash_path])

    provider_slug = action.get("slug") if action.get("kind") == "provider_execute" else None
    return rebuild_and_publish_report(scan_id, metadata, provider_slug)


ALLOWED_BREAKDOWN_ROOTS: List[Path] = [
    DATA_VOLUME.resolve(),
    HOME_DIR.resolve(),
    (HOME_DIR / "Library").resolve(),
    APPLICATIONS_DIR.resolve(),
]
ROOT_PATHS: Dict[str, Path] = {
    "data_root": DATA_VOLUME.resolve(),
    "home_root": HOME_DIR.resolve(),
    "library_root": (HOME_DIR / "Library").resolve(),
    "applications_root": APPLICATIONS_DIR.resolve(),
}
ALIASABLE_ROOT_TARGETS: List[Path] = [
    APPLICATIONS_DIR.resolve(),
    HOME_DIR.resolve(),
    (HOME_DIR / "Library").resolve(),
]


def root_key_for_path(path: Path) -> Optional[str]:
    resolved = path.resolve()
    for root_key, root_path in ROOT_PATHS.items():
        try:
            resolved.relative_to(root_path)
            return root_key
        except ValueError:
            continue
        except Exception:
            continue
    return None


def canonicalize_breakdown_path(path: Path) -> Path:
    resolved = path.resolve()
    # Exact match: path IS an aliasable root (e.g. /System/Volumes/Data/Users → /Users)
    for target in ALIASABLE_ROOT_TARGETS:
        if samefile_or_false(resolved, target):
            return target
    # Child match: path is under a Data Volume firmlink child.
    # E.g. /System/Volumes/Data/Users/example/Library/Caches → /Users/example/Library/Caches
    # Walk up from the resolved path to find the deepest ancestor that matches
    # an aliasable root, then rewrite the prefix.
    data_root = DATA_VOLUME.resolve()
    try:
        resolved.relative_to(data_root)
    except ValueError:
        return resolved
    # Path is under Data Volume — check if any ancestor is a firmlinked root
    # Try longest targets first (Library before Home) for correct match depth
    sorted_targets = sorted(ALIASABLE_ROOT_TARGETS, key=lambda t: len(str(t)), reverse=True)
    for target in sorted_targets:
        # Find the corresponding Data Volume path for this target
        # e.g. /Users/example → /System/Volumes/Data/Users/example
        try:
            target_on_data = data_root / target.relative_to(Path("/"))
        except ValueError:
            continue
        if not target_on_data.exists():
            continue
        if not samefile_or_false(target_on_data, target):
            continue
        try:
            suffix = resolved.relative_to(target_on_data)
            return target / suffix
        except ValueError:
            continue
    return resolved


def alias_target_for_data_child(path: Path) -> Optional[Path]:
    resolved = path.resolve()
    for target in ALIASABLE_ROOT_TARGETS:
        if samefile_or_false(resolved, target):
            return target
    return None


EXCLUDED_BREAKDOWN_PATHS: List[Path] = [
    DATA_VOLUME.resolve() / "Volumes",  # mount points for external/network drives
]


def validate_breakdown_path(path_str: str) -> Path:
    """Resolve path_str and verify it is a directory under an allowed root."""
    try:
        resolved = Path(path_str).expanduser().resolve()
    except (ValueError, OSError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=f"Invalid path: {exc}") from exc
    for excluded in EXCLUDED_BREAKDOWN_PATHS:
        try:
            resolved.relative_to(excluded)
            raise HTTPException(
                status_code=400,
                detail=f"Path is excluded from scanning (external/network volume): {resolved}",
            )
        except ValueError:
            pass
    if not resolved.exists():
        raise HTTPException(status_code=404, detail=f"Path does not exist: {resolved}")
    if not resolved.is_dir():
        raise HTTPException(status_code=400, detail=f"Path is not a directory: {resolved}")
    for allowed_root in ALLOWED_BREAKDOWN_ROOTS:
        try:
            resolved.relative_to(allowed_root)
            return resolved
        except ValueError:
            continue
        except Exception:
            continue
    raise HTTPException(
        status_code=400,
        detail=f"Path is not under an allowed breakdown root: {resolved}",
    )


def choose_scan_id_for_path(path_str: str) -> Optional[int]:
    return fetch_active_scan_id()


def _apply_delta_chain(connection: sqlite3.Connection, scan_id: int, start_path: str, delta: int) -> None:
    current = start_path
    visited: Set[str] = set()
    while current and current not in visited:
        visited.add(current)
        connection.execute(
            "UPDATE nodes SET allocated_bytes = allocated_bytes + ?, updated_at = ? WHERE scan_id = ? AND path = ?",
            (delta, iso_now(), scan_id, current),
        )
        if current == str(HOME_DIR.resolve()):
            alias = str(DATA_VOLUME / "Users" / HOME_DIR.name)
            connection.execute("UPDATE nodes SET allocated_bytes = allocated_bytes + ? WHERE scan_id=? AND path=?", (delta, scan_id, alias))
            current = os.path.dirname(alias)
            continue
        if current == str(APPLICATIONS_DIR.resolve()):
            alias = str(DATA_VOLUME / "Applications")
            connection.execute("UPDATE nodes SET allocated_bytes = allocated_bytes + ? WHERE scan_id=? AND path=?", (delta, scan_id, alias))
            current = os.path.dirname(alias)
            continue
        row = connection.execute("SELECT parent_path FROM nodes WHERE scan_id=? AND path=?", (scan_id, current)).fetchone()
        if row is None or not row["parent_path"]:
            break
        current = row["parent_path"]


def walk_subtree_and_store(scan_id: int, path: Path) -> Dict[str, Any]:
    canonical = canonicalize_breakdown_path(path)
    translation = build_walk_translation()
    stored_root, _ = translate_walk_path(str(canonical), translation)
    prefixes = {stored_root}
    for walked_prefix, stored_prefix, _ in translation:
        if walked_prefix == str(canonical) or walked_prefix.startswith(str(canonical) + os.sep):
            prefixes.add(stored_prefix)
    with SUBTREE_REFRESH_LOCK:
        with open_db_connection() as read_connection:
            registered = {int(row[0]) for row in read_connection.execute("SELECT ino FROM hardlink_inodes WHERE scan_id=?", (scan_id,))}
        result = walk_tree(canonical, workers=SCAN_WORKER_COUNT, excluded_paths=EXCLUDED_BREAKDOWN_PATHS, registered_inodes=registered)
        with DB_WRITE_LOCK:
            with open_db_connection() as connection:
                active = connection.execute("SELECT id FROM scan_runs WHERE active=1 ORDER BY id DESC LIMIT 1").fetchone()
                if active is None or int(active["id"]) != scan_id:
                    new_id = int(active["id"]) if active else None
                    response = fetch_breakdown_from_db(new_id, stored_root) if new_id else None
                    if response is None:
                        raise HTTPException(status_code=409, detail="The active scan changed during refresh.")
                    return response
                old_row = connection.execute("SELECT allocated_bytes FROM nodes WHERE scan_id=? AND path=?", (scan_id, stored_root)).fetchone()
                old_total = int(old_row["allocated_bytes"]) if old_row else 0
                attributions, adjustments, changes = resolve_hardlink_ownership(scan_id, result.hardlink_candidates, translation, full_scan=False, connection=connection)
                for parent, allocated in attributions:
                    result.dir_local[parent] = result.dir_local.get(parent, 0) + allocated
                totals = rollup_subtree_totals(result.dir_local, str(canonical))
                new_total = int(totals.get(str(canonical), 0))
                for prefix in prefixes:
                    like = sql_like_prefix(prefix)
                    connection.execute("DELETE FROM nodes WHERE scan_id=? AND (path=? OR path LIKE ? ESCAPE '\\')", (scan_id, prefix, like))
                    connection.execute("DELETE FROM large_files WHERE scan_id=? AND (path=? OR path LIKE ? ESCAPE '\\')", (scan_id, prefix, like))
                updated_at = iso_now()
                node_payload = []
                for walked_path, allocated in totals.items():
                    stored_path, root_key = translate_walk_path(walked_path, translation)
                    node_payload.append((scan_id, stored_path, os.path.dirname(stored_path), os.path.basename(stored_path) or stored_path, root_key, path_depth(ROOT_PATHS[root_key], stored_path), allocated, 1, updated_at))
                connection.executemany("INSERT INTO nodes (scan_id,path,parent_path,name,root_key,depth,allocated_bytes,children_indexed,updated_at) VALUES (?,?,?,?,?,?,?,?,?)", node_payload)
                large_payload = []
                for item in result.large_files:
                    stored_path, root_key = translate_walk_path(item["path"], translation)
                    if any(stored_path == prefix or stored_path.startswith(prefix + os.sep) for prefix in LARGE_FILE_EXCLUDED_PREFIXES):
                        continue
                    large_payload.append((scan_id, stored_path, os.path.dirname(stored_path), item["name"], root_key, item["apparent_bytes"], item["allocated_bytes"], updated_at))
                connection.executemany("INSERT INTO large_files (scan_id,path,parent_path,name,root_key,apparent_bytes,allocated_bytes,updated_at) VALUES (?,?,?,?,?,?,?,?)", large_payload)
                for operation, payload in changes:
                    if operation == "delete":
                        connection.execute("DELETE FROM hardlink_inodes WHERE scan_id=? AND ino=?", payload)
                    else:
                        connection.execute("INSERT INTO hardlink_inodes (scan_id,ino,dev,owner_path,allocated_bytes) VALUES (?,?,?,?,?) ON CONFLICT(scan_id,ino) DO UPDATE SET dev=excluded.dev, owner_path=excluded.owner_path, allocated_bytes=excluded.allocated_bytes", payload)
                _apply_delta_chain(connection, scan_id, os.path.dirname(stored_root), new_total - old_total)
                for old_parent, delta in adjustments:
                    if not any(old_parent == prefix or old_parent.startswith(prefix + os.sep) for prefix in prefixes):
                        _apply_delta_chain(connection, scan_id, old_parent, delta)
                connection.commit()
    response = fetch_breakdown_from_db(scan_id, stored_root)
    if response is None:
        raise HTTPException(status_code=500, detail=f"Failed to persist breakdown for {path}")
    return response


def store_breakdown_for_path(scan_id: int, path: Path) -> Dict[str, Any]:
    canonical_path = canonicalize_breakdown_path(path)
    root_key = root_key_for_path(canonical_path)
    if root_key is None:
        raise HTTPException(status_code=400, detail=f"Path is not under a supported root: {path}")
    return walk_subtree_and_store(scan_id, canonical_path)


