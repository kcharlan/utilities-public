function JobActionMenuContent({ job, x, y, onClose, runAction, openDetail }) {
  const menuRef = useRef(null);
  const [position, setPosition] = useState(null);

  useLayoutEffect(() => {
    const frame = requestAnimationFrame(() => {
    const menu = menuRef.current;
    if (!menu) return;
    const rect = menu.getBoundingClientRect();
    let left = x;
    let top = y;
    if (rect.bottom > window.innerHeight) top = y - rect.height;
    if (rect.right > window.innerWidth) left = x - rect.width;
    left = Math.max(8, Math.min(left, window.innerWidth - rect.width - 8));
    top = Math.max(8, Math.min(top, window.innerHeight - rect.height - 8));
    setPosition({ left, top });
    });
    return () => cancelAnimationFrame(frame);
  }, [x, y]);

  useEffect(() => {
    const handleOutside = (event) => {
      if (menuRef.current && !menuRef.current.contains(event.target)) {
        onClose();
      }
    };
    const handleKeyDown = (event) => {
      if (event.key !== 'Escape' || document.querySelector('.confirm-dialog')) return;
      event.preventDefault();
      event.stopPropagation();
      onClose();
    };
    document.addEventListener('mousedown', handleOutside);
    document.addEventListener('keydown', handleKeyDown);
    document.addEventListener('scroll', onClose, true);
    window.addEventListener('resize', onClose);
    return () => {
      document.removeEventListener('mousedown', handleOutside);
      document.removeEventListener('keydown', handleKeyDown);
      document.removeEventListener('scroll', onClose, true);
      window.removeEventListener('resize', onClose);
    };
  }, [onClose]);

  const actionGroups = [
    ['start', 'stop', 'run-now', 'reload'],
    [job.enabled ? 'disable' : 'enable', job.loaded ? 'unload' : 'load'],
    ['edit', 'logs', 'info'],
    ['export'],
    ['delete'],
  ];

  const dispatch = (actionId) => {
    onClose();
    const action = JOB_ACTIONS[actionId];
    if (action.kind === 'nav') {
      openDetail(job, action.tab);
      return;
    }
    runAction(job, actionId);
  };

  return html`<div ref=${menuRef} class=${"job-action-menu"} role=${"menu"} aria-label=${'Actions for ' + job.label} style=${{
        left: position ? position.left : x,
        top: position ? position.top : y,
        visibility: position ? 'visible' : 'hidden',
      }}> ${actionGroups.map((group, groupIndex) => (
        html`<${preact.Fragment} key=${groupIndex}> ${groupIndex > 0 && html`<div class=${"job-action-menu-separator"} role=${"separator"} />`} ${group.map(actionId => {
            const action = JOB_ACTIONS[actionId];
            return (
              html`<button type=${"button"} role=${"menuitem"} class=${'job-action-menu-item' + (action.danger ? ' danger' : '')} key=${actionId} onClick=${() => dispatch(actionId)}><${Icon} name=${action.icon} size=${14} /><span>${action.label}</span></button>`
            );
          })} <//>`
      ))} </div>`;
}

