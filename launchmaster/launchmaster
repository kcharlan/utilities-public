{ ...s, confirm_apple_modify: !s.confirm_apple_modify }))} /> </div> </div> <div class=${"settings-section"}> <div class=${"settings-section-title"}>Keyboard Shortcuts</div> <div style=${{ display: 'grid', gridTemplateColumns: '60px 1fr', gap: '6px 12px', fontSize: 12, color: 'var(--text-secondary)' }}> <kbd class=${"kbd"}>s</kbd> <span>Start selected job</span> <kbd class=${"kbd"}>x</kbd> <span>Stop selected job</span> <kbd class=${"kbd"}>r</kbd> <span>Reload selected job</span> <kbd class=${"kbd"}>e</kbd> <span>Edit selected job</span> <kbd class=${"kbd"}>l</kbd> <span>View logs</span> <kbd class=${"kbd"}>n</kbd> <span>Create new job</span> <kbd class=${"kbd"}>Esc</kbd> <span>Close menu/dialog/panel, then deselect</span> <kbd class=${"kbd"}>/</kbd> <span>Focus search</span> <kbd class=${"kbd"}>?</kbd> <span>Open settings & shortcuts</span> </div> </div> </div> <div class=${"modal-footer"}> <button class=${"btn"} onClick=${onClose}>Cancel</button> <button class=${"btn btn-accent"} onClick=${handleSave} disabled=${saving}> ${saving ? 'Saving...' : 'Save & Close'} </button> </div> </div> </div>`
