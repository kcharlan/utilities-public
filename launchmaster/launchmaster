      if (!target) {
        addToast('warning', 'Select one job or open its details first');
        return;
      }
      runAction(target, actionId);
    };
    window.addEventListener('keydown', handler);
    return () => window.removeEventListener('keydown', handler);
  }, [
    actionMenu,
    addToast,
    cancelConfirm,
    detailJob,
    jobs,
    runAction,
    selected,
    showCreate,
    showSettings,
  ]);

  return (
    html`<div class=${"app-shell"}>  <input ref=${fileInputRef} type=${"file"} accept=${".plist"} style=${{ display: 'none' }} onInput=${handleFileSelected} />  <div class=${"topbar"}> <div class=${"topbar-left"}> <span class=${"topbar-brand"}>launchmaster</span> <span class=${"topbar-subtitle"}>launchd control center</span> </div> <div class=${"topbar-right"}> <div class=${"topbar-ws-status"}> <div class=${'ws-dot' + (connected ? '' : ' disconnected')} /> <span>${connected ? 'Live' : 'Disconnected'}</span> </div> <button class=${"btn btn-sm"} onClick=${handleImport}> <${Icon} name=${"upload"} size=${13} /> Import </button> <button class=${"btn btn-sm btn-accent"} onClick=${() => setShowCreate(true)}> <${Icon} name=${"plus"} size=${13} /> New Job </button> <button class=${"icon-btn"} onClick=${() => { refresh(); addToast('success', 'Status refreshed'); }}> <${Icon} name=${"refresh-cw"} size=${16} /> </button> <button class=${"icon-btn"} onClick=${() => setShowSettings(true)}> <${Icon} name=${"settings"} size=${16} /> </button> </div> </div>  <div class=${"main-content"}> <${StatusCards} jobs=${filteredJobs} activeFilter=${statusFilter} setActiveFilter=${setStatusFilter} /> <${FailedPanel} jobs=${filteredJobs} onOpenDetail=${(j) => { setDetailInitialTab('info'); setDetailJob(j); }} onOpenLogs=${(j) => { setDetailInitialTab('logs'); setDetailJob(j); }} onOpenEdit=${(j) => { setDetailInitialTab('edit'); setDetailJob(j); }} onReload=${(j) => runAction(j, 'reload')} openActionMenu=${openActionMenu} /> <${FilterBar} search=${search} setSearch=${setSearch} domainFilter=${domainFilter} setDomainFilter=${setDomainFilter} showApple=${showApple} setShowApple=${setShowApple} activeFilter=${statusFilter} setActiveFilter=${setStatusFilter} /> <${BulkBar} count=${selected.length} onClear=${() => setSelected([])} selectedLabels=${selected} jobs=${jobs} addToast=${addToast} presentConfirm=${presentConfirm} settings=${settings} /> <${JobTable} jobs=${filteredJobs} selected=${selected} setSelected=${setSelected} onRowClick=${handleRowClick} showApple=${showApple} runAction=${runAction} openActionMenu=${openActionMenu} /> </div>  ${actionMenu && actionMenuJob && (
        html`<${JobActionMenu} key=${actionMenu.label + ':' + actionMenu.x + ':' + actionMenu.y} job=${actionMenuJob} x=${actionMenu.x} y=${actionMenu.y} onClose=${closeActionMenu} runAction=${runAction} openDetail=${handleRowClick} />`
