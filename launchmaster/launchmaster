                    html`<span class=${'exit-code ' + (job.last_exit === 0 ? 'zero' : 'nonzero')}>${job.last_exit}</span>`
                  ) : '\u2014'} </span> ${job.blame && (
                  html` <span class=${"info-label"}>Blame</span> <span class=${"info-value"} style=${{ color: 'var(--status-failed)' }}>${job.blame}</span> `
                )} ${job.program && (
                  html` <span class=${"info-label"}>Program</span> <span class=${"info-value"}>${job.program}</span> `
                )} ${job.program_arguments && job.program_arguments.length > 0 && (
                  html` <span class=${"info-label"}>Arguments</span> <span class=${"info-value"}>${job.program_arguments.join(' ')}</span> `
                )} ${job.working_directory && (
                  html` <span class=${"info-label"}>Working Dir</span> <span class=${"info-value"}>${job.working_directory}</span> `
                )} <span class=${"info-label"}>Stdout</span> <span class=${"info-value"}>${job.stdout_path || '\u2014'}</span> <span class=${"info-label"}>Stderr</span> <span class=${"info-value"}>${job.stderr_path || '\u2014'}</span> </div> <div style=${{ display: 'flex', gap: 8, flexWrap: 'wrap', marginTop: 12 }}> <button class=${"btn"} onClick=${() => runAction(job, job.enabled ? 'disable' : 'enable')}> <${Icon} name=${"toggle-left"} size=${14} /> ${job.enabled ? 'Disable' : 'Enable'} </button> <button class=${"btn"} onClick=${() => runAction(job, job.loaded ? 'unload' : 'load')}> <${Icon} name=${job.loaded ? 'log-out' : 'log-in'} size=${14} /> ${job.loaded ? 'Unload' : 'Load'} </button> <button class=${"btn"} onClick=${() => runAction(job, 'export')}> <${Icon} name=${"download"} size=${14} /> Export Plist </button> <button class=${"btn btn-danger"} onClick=${async () => {
                  const result = await runAction(job, 'delete');
                  if (result.ok) onClose();
                }}><${Icon} name=${"trash-2"} size=${14} /> Delete Job</button> </div> </div>`
          )} ${activeTab === 'edit' && (
            html`<div class=${"animate-fade"}> <div class=${"plist-editor"}> <div class=${"plist-editor-header"}> <span>${job.plist_path}</span> <div style=${{ display: 'flex', gap: 8 }}> ${modified && html`<span style=${{ color: 'var(--accent)', fontSize: 11 }}>${'\u25CF'} Modified</span>`} <button class=${"btn btn-sm btn-accent"} onClick=${handleSavePlist} disabled=${!modified} style=${{ opacity: modified ? 1 : 0.5 }}> <${Icon} name=${"save"} size=${12} /> Save </button> <button class=${"btn btn-sm"} onClick=${handleSaveAndReload}> <${Icon} name=${"refresh-cw"} size=${12} /> Save & Reload </button> </div> </div> ${plistLoading ? (
                  html`<div style=${{ padding: 20, color: 'var(--text-tertiary)' }}>Loading plist...</div>`
                ) : (
                  html`<textarea value=${plistContent} onInput=${e => { setPlistContent(e.target.value); setModified(true); }} spellCheck=${false} />`
                )} </div> </div>`
          )} ${activeTab === 'logs' && (
            html`<div class=${"animate-fade"}> <div class=${"log-viewer"}> <div class=${"log-toolbar"}> <div class=${"log-toolbar-left"}> ${['stderr', 'stdout', 'unified'].map(t => (
                      html`<div key=${t} class=${'log-tab' + (logTab === t ? ' active' : '')} onClick=${() => setLogTab(t)}> ${t} </div>`
                    ))} </div> <div style=${{ display: 'flex', gap: 4 }}> <button class=${"btn btn-sm btn-ghost"} onClick=${() => {
                      // Refresh logs
                      setLogLoading(true);
                      api('/jobs/' + encoded + '/logs/' + logTab)
                        .then(data => { setLogContent(data.content || data.lines || ''); setLogLoading(false); })
                        .catch(err => { setLogContent('Error: ' + err.message); setLogLoading(false); });
                    }}> <${Icon} name=${"refresh-cw"} size=${12} /> Refresh </button> </div> </div> <div class=${"log-content"}> ${logLoading ? (
                    html`<div style=${{ color: 'var(--text-tertiary)' }}>Loading logs...</div>`
                  ) : (
                    typeof logContent === 'string' ? (
                      logContent.split('\\n').map((line, i) => (
                        html`<div key=${i} class=${"log-line"}> <span class=${line.toLowerCase().includes('error') || line.toLowerCase().includes('traceback') ? 'error' : line.toLowerCase().includes('warn') ? 'warn' : ''}> ${line} </span> </div>`
                      ))
                    ) : Array.isArray(logContent) ? (
                      logContent.map((line, i) => (
                        html`<div key=${i} class=${"log-line"}> ${line.time && html`<span class=${"timestamp"}>${line.time} </span>`} <span class=${line.level === 'error' ? 'error' : line.level === 'warn' ? 'warn' : ''}> ${line.text || line} </span> </div>`
                      ))
                    ) : null
                  )} </div> </div> </div>`
          )} </div> </div> `
  );
}

// ---- Create Job Modal ----
function CreateJobModal({ onClose, addToast }) {
  const [step, setStep] = useState('form'); // form | preview
  const [creating, setCreating] = useState(false);
  const [formData, setFormData] = useState({
    label: '',
    program: '',
    args: '',
    domain: 'user-agent',
    runAtLoad: true,
    keepAlive: false,
    scheduleType: 'none',
    startInterval: '',
    calendarHour: '',
    calendarMinute: '0',
    calendarWeekdays: [],
    calendarDay: '',
    watchPaths: '',
    stdoutPath: '',
    stderrPath: '',
    workingDir: '',
  });

  const update = (k, v) => setFormData(prev => ({ ...prev, [k]: v }));

  const buildPlistData = () => {
    const data = {
      Label: formData.label || 'com.example.my-tool',
      ProgramArguments: [formData.program || '/usr/local/bin/python3'].concat(
        formData.args ? formData.args.split('\\n').filter(Boolean) : []
      ),
    };
    if (formData.scheduleType === 'interval' && formData.startInterval) {
      data.StartInterval = parseInt(formData.startInterval, 10);
    }
    if (formData.scheduleType === 'calendar') {
      if (formData.calendarWeekdays.length > 1) {
        data.StartCalendarInterval = formData.calendarWeekdays.map(wd => {
          const entry = {};
          if (formData.calendarHour) entry.Hour = parseInt(formData.calendarHour, 10);
          if (formData.calendarMinute) entry.Minute = parseInt(formData.calendarMinute, 10);
          entry.Weekday = wd;
          if (formData.calendarDay) entry.Day = parseInt(formData.calendarDay, 10);
          return entry;
        });
      } else {
        const entry = {};
        if (formData.calendarHour) entry.Hour = parseInt(formData.calendarHour, 10);
        if (formData.calendarMinute) entry.Minute = parseInt(formData.calendarMinute, 10);
        if (formData.calendarWeekdays.length === 1) entry.Weekday = formData.calendarWeekdays[0];
        if (formData.calendarDay) entry.Day = parseInt(formData.calendarDay, 10);
        data.StartCalendarInterval = entry;
      }
    }
    if (formData.scheduleType === 'watch' && formData.watchPaths) {
      data.WatchPaths = formData.watchPaths.split('\\n').filter(Boolean);
    }
    if (formData.runAtLoad) data.RunAtLoad = true;
    if (formData.keepAlive) data.KeepAlive = true;
    if (formData.stdoutPath) data.StandardOutPath = formData.stdoutPath;
    if (formData.stderrPath) data.StandardErrorPath = formData.stderrPath;
    if (formData.workingDir) data.WorkingDirectory = formData.workingDir;
    return data;
  };

  const handleCreate = async () => {
    setCreating(true);
    try {
      await api('/jobs', {
        method: 'POST',
        body: JSON.stringify({
          plist_data: buildPlistData(),
          domain: formData.domain,
        }),
      });
      addToast('success', 'Created and loaded ' + (formData.label || 'new job'));
      onClose();
    } catch (err) {
      addToast('error', 'Create failed: ' + err.message);
    } finally {
      setCreating(false);
    }
  };

  // Generate preview XML for display
  const previewXml = useMemo(() => {
    const label = formData.label || 'com.example.my-tool';
    const prog = formData.program || '/usr/local/bin/python3';
    let xml = '<?xml version="1.0" encoding="UTF-8"?>\\n';
    xml += '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"\\n';
    xml += '  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\\n';
    xml += '<plist version="1.0">\\n<dict>\\n';
    xml += '    <key>Label</key>\\n    <string>' + label + '</string>\\n';
    xml += '    <key>ProgramArguments</key>\\n    <array>\\n';
    xml += '        <string>' + prog + '</string>\\n';
    if (formData.args) {
      formData.args.split('\\n').filter(Boolean).forEach(a => {
        xml += '        <string>' + a + '</string>\\n';
      });
    }
    xml += '    </array>\\n';
    if (formData.scheduleType === 'interval' && formData.startInterval) {
      xml += '    <key>StartInterval</key>\\n    <integer>' + formData.startInterval + '</integer>\\n';
    }
    if (formData.scheduleType === 'calendar') {
      if (formData.calendarWeekdays.length > 1) {
        xml += '    <key>StartCalendarInterval</key>\\n    <array>\\n';
        formData.calendarWeekdays.forEach(wd => {
          xml += '        <dict>\\n';
          if (formData.calendarHour) xml += '            <key>Hour</key>\\n            <integer>' + formData.calendarHour + '</integer>\\n';
          if (formData.calendarMinute) xml += '            <key>Minute</key>\\n            <integer>' + formData.calendarMinute + '</integer>\\n';
          xml += '            <key>Weekday</key>\\n            <integer>' + wd + '</integer>\\n';
          if (formData.calendarDay) xml += '            <key>Day</key>\\n            <integer>' + formData.calendarDay + '</integer>\\n';
          xml += '        </dict>\\n';
        });
        xml += '    </array>\\n';
      } else {
        xml += '    <key>StartCalendarInterval</key>\\n    <dict>\\n';
        if (formData.calendarHour) xml += '        <key>Hour</key>\\n        <integer>' + formData.calendarHour + '</integer>\\n';
        if (formData.calendarMinute) xml += '        <key>Minute</key>\\n        <integer>' + formData.calendarMinute + '</integer>\\n';
        if (formData.calendarWeekdays.length === 1) xml += '        <key>Weekday</key>\\n        <integer>' + formData.calendarWeekdays[0] + '</integer>\\n';
        if (formData.calendarDay) xml += '        <key>Day</key>\\n        <integer>' + formData.calendarDay + '</integer>\\n';
        xml += '    </dict>\\n';
      }
    }
    if (formData.scheduleType === 'watch' && formData.watchPaths) {
      xml += '    <key>WatchPaths</key>\\n    <array>\\n';
      formData.watchPaths.split('\\n').filter(Boolean).forEach(p => {
        xml += '        <string>' + p + '</string>\\n';
      });
      xml += '    </array>\\n';
    }
    if (formData.runAtLoad) xml += '    <key>RunAtLoad</key>\\n    <true/>\\n';
    if (formData.keepAlive) xml += '    <key>KeepAlive</key>\\n    <true/>\\n';
    if (formData.stdoutPath) xml += '    <key>StandardOutPath</key>\\n    <string>' + formData.stdoutPath + '</string>\\n';
    if (formData.stderrPath) xml += '    <key>StandardErrorPath</key>\\n    <string>' + formData.stderrPath + '</string>\\n';
    if (formData.workingDir) xml += '    <key>WorkingDirectory</key>\\n    <string>' + formData.workingDir + '</string>\\n';
    xml += '</dict>\\n</plist>';
    return xml;
  }, [formData]);

  return (
    html`<div class=${"modal-overlay"} onClick=${onClose}> <div class=${"modal"} onClick=${e => e.stopPropagation()}> <div class=${"modal-header"}> <div class=${"modal-title"}> <${Icon} name=${"plus-circle"} size=${18} /> Create New Job </div> <button class=${"icon-btn"} onClick=${onClose}> <${Icon} name=${"x"} size=${16} /> </button> </div> <div class=${"modal-body"}> ${step === 'form' ? (
            html`<div class=${"animate-fade"}> <div class=${"form-group"}> <label class=${"form-label"}>Label (reverse-DNS)</label> <input class=${"form-input"} ref=${focusOnMount} placeholder=${"com.example.my-tool"} value=${formData.label} onInput=${e => update('label', e.target.value)} /> <div class=${"form-hint"}>Unique identifier, e.g. com.example.tool-name</div> </div> <div class=${"form-group"}> <label class=${"form-label"}>Program / Command</label> <input class=${"form-input"} placeholder=${"/usr/local/bin/python3"} value=${formData.program} onInput=${e => update('program', e.target.value)} /> </div> <div class=${"form-group"}> <label class=${"form-label"}>Arguments (one per line)</label> <textarea class=${"form-input"} rows=${3} placeholder=${"/path/to/script.py\\n--flag\\nvalue"} value=${formData.args} onInput=${e => update('args', e.target.value)} style=${{ fontFamily: 'var(--font-mono)', resize: 'vertical' }} /> </div> <div class=${"form-group"}> <label class=${"form-label"}>Domain</label> <select class=${"form-input"} value=${formData.domain} onInput=${e => update('domain', e.target.value)}> <option value=${"user-agent"}>User Agent (~/Library/LaunchAgents)</option> <option value=${"global-agent"}>Global Agent (/Library/LaunchAgents)</option> <option value=${"system-daemon"}>System Daemon (/Library/LaunchDaemons)</option> </select> </div>  <div style=${{ background: 'var(--bg-base)', border: '1px solid var(--border-default)', borderRadius: 6, padding: 14, marginBottom: 14 }}> <div style=${{ fontFamily: 'var(--font-display)', fontWeight: 600, fontSize: 12, textTransform: 'uppercase', letterSpacing: 1, color: 'var(--text-secondary)', marginBottom: 10 }}> Schedule </div> <div class=${"form-group"}> <label class=${"form-label"}>Schedule Type</label> <select class=${"form-input"} value=${formData.scheduleType} onInput=${e => update('scheduleType', e.target.value)}> <option value=${"none"}>None (manual start only)</option> <option value=${"interval"}>Interval (every N seconds)</option> <option value=${"calendar"}>Calendar (cron-like schedule)</option> <option value=${"watch"}>Watch Paths (run when files change)</option> </select> <div class=${"form-hint"}> ${formData.scheduleType === 'none' && 'Job will only run when started manually or via RunAtLoad/KeepAlive.'} ${formData.scheduleType === 'interval' && 'Job repeats at a fixed interval.'} ${formData.scheduleType === 'calendar' && 'Job runs at specific times (like cron). Leave fields blank for "any".'} ${formData.scheduleType === 'watch' && 'Job runs whenever the specified paths are modified.'} </div> </div> ${formData.scheduleType === 'interval' && (
                  html`<div class=${"form-group animate-fade"}> <label class=${"form-label"}>Interval (seconds)</label> <div class=${"form-row"}> <div class=${"form-group"} style=${{ marginBottom: 0 }}> <input class=${"form-input"} type=${"number"} placeholder=${"e.g. 300"} value=${formData.startInterval} onInput=${e => update('startInterval', e.target.value)} /> </div> <div style=${{ display: 'flex', alignItems: 'center', color: 'var(--text-tertiary)', fontSize: 11 }}> ${formData.startInterval && ('= ' + (formData.startInterval >= 3600 ? Math.floor(formData.startInterval / 3600) + 'h ' + Math.floor((formData.startInterval % 3600) / 60) + 'm' : formData.startInterval >= 60 ? Math.floor(formData.startInterval / 60) + 'm ' + (formData.startInterval % 60) + 's' : formData.startInterval + 's'))} </div> </div> </div>`
                )} ${formData.scheduleType === 'calendar' && (
                  html`<div class=${"animate-fade"}> <div class=${"form-row"}> <div class=${"form-group"}> <label class=${"form-label"}>Hour (0-23)</label> <input class=${"form-input"} type=${"number"} min=${"0"} max=${"23"} placeholder=${"any"} value=${formData.calendarHour} onInput=${e => update('calendarHour', e.target.value)} /> </div> <div class=${"form-group"}> <label class=${"form-label"}>Minute (0-59)</label> <input class=${"form-input"} type=${"number"} min=${"0"} max=${"59"} placeholder=${"0"} value=${formData.calendarMinute} onInput=${e => update('calendarMinute', e.target.value)} /> </div> </div> <div class=${"form-group"}> <label class=${"form-label"}>Weekdays (click to select, leave empty for every day)</label> <div style=${{ display: 'flex', gap: 4 }}> ${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map((day, idx) => {
                          const isSelected = formData.calendarWeekdays.includes(idx);
                          return (
                            html`<div key=${idx} onClick=${() => {
                                const next = isSelected
                                  ? formData.calendarWeekdays.filter(d => d !== idx)
                                  : [...formData.calendarWeekdays, idx].sort();
                                update('calendarWeekdays', next);
                              }} style=${{
                                padding: '4px 10px',
                                borderRadius: 4,
                                fontSize: 11,
                                fontFamily: 'var(--font-mono)',
                                cursor: 'pointer',
                                userSelect: 'none',
                                transition: 'all 0.15s',
                                background: isSelected ? 'var(--accent)' : 'var(--bg-elevated)',
                                color: isSelected ? 'var(--text-inverse)' : 'var(--text-secondary)',
                                border: '1px solid ' + (isSelected ? 'var(--accent)' : 'var(--border-default)'),
                                fontWeight: isSelected ? 600 : 400,
                              }}> ${day} </div>`
                          );
                        })} </div> <div class=${"form-hint"} style=${{ marginTop: 4 }}> ${formData.calendarWeekdays.length === 0
                          ? 'Every day'
                          : formData.calendarWeekdays.map(d => ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d]).join(', ')} </div> </div> <div class=${"form-group"}> <label class=${"form-label"}>Day of Month</label> <div style=${{ display: 'flex', gap: 6, alignItems: 'center' }}> <input class=${"form-input"} style=${{ width: 80 }} type=${"number"} min=${"1"} max=${"31"} placeholder=${"any"} value=${formData.calendarDay} onInput=${e => {
                            let v = e.target.value;
                            if (v !== '') {
                              const n = parseInt(v, 10);
                              if (isNaN(n)) v = '';
                              else if (n > 31) v = '31';
                              else if (n < 1 && v !== '') v = '1';
                            }
                            update('calendarDay', v);
                          }} /> ${formData.calendarDay && (
                          html`<button class=${"btn btn-sm btn-ghost"} onClick=${() => update('calendarDay', '')} title=${"Clear to "+String.fromCodePoint(39)+"any day"+String.fromCodePoint(39)}> <${Icon} name=${"x"} size=${12} /> Any </button>`
                        )} ${!formData.calendarDay && (
                          html`<span style=${{ fontSize: 11, color: 'var(--text-tertiary)' }}>any day of month</span>`
                        )} </div> </div> <div class=${"form-hint"} style=${{ marginTop: -8, marginBottom: 8 }}> Preview: ${(() => {
                        const parts = [];
                        const wd = formData.calendarWeekdays;
                        if (wd.length > 0) parts.push(wd.map(d => ['Sundays','Mondays','Tuesdays','Wednesdays','Thursdays','Fridays','Saturdays'][d]).join(', '));
                        if (formData.calendarDay) parts.push('day ' + formData.calendarDay + ' of month');
                        if (wd.length === 0 && !formData.calendarDay) parts.push('Daily');
                        parts.push('at ' + (formData.calendarHour || '*') + ':' + (formData.calendarMinute || '0').padStart(2, '0'));
