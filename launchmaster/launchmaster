            html`<div key=${t} class=${'panel-tab' + (activeTab === t ? ' active' : '')} onClick=${() => setActiveTab(t)}> ${t === 'info' ? 'Info' : t === 'logs' ? 'Logs' : 'Edit Plist'} </div>`
