const html = htm.bind(preact.h);
const {focusOnMount, Portal, Icon: KitIcon} = frontendKit;





const {useState, useEffect, useLayoutEffect, useRef, useMemo, useCallback} = preactHooks;

// ---- API helper ----
async function api(path, options = {}) {
  const resp = await fetch('/api' + path, {
    headers: { 'Content-Type': 'application/json' },
    ...options,
  });
  if (!resp.ok) {
    const text = await resp.text();
    throw new Error(text || resp.statusText);
  }
  const data = await resp.json();
  if (data && data.success === false) {
    throw new Error(data.message || 'Operation failed');
  }
  return data;
}

// ---- WebSocket hook for live data ----
function useWebSocket() {
  const [jobs, setJobs] = useState([]);
  const [connected, setConnected] = useState(false);
  const wsRef = useRef(null);

  useEffect(() => {
    const connect = () => {
      const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const ws = new WebSocket(protocol + '//' + location.host + '/ws');
      wsRef.current = ws;
      ws.onopen = () => setConnected(true);
      ws.onclose = () => { setConnected(false); setTimeout(connect, 3000); };
      ws.onmessage = (e) => {
        const msg = JSON.parse(e.data);
        if (msg.type === 'jobs') setJobs(msg.data);
      };
    };
    connect();
    return () => wsRef.current && wsRef.current.close();
  }, []);

  const refresh = () => wsRef.current && wsRef.current.send(JSON.stringify({type: 'refresh'}));
  return { jobs, connected, refresh };
}

// ---- Icon components (using inline SVGs for the prototype) ----
function Icon({ name, size = 16, className = '' }) {
  const iconName = name.replace(/(^|-)([a-z0-9])/g, (_, dash, c) => c.toUpperCase());
  return html`<span class=${className} style=${{ display: 'inline-flex', alignItems: 'center' }}><${KitIcon} name=${iconName} size=${size} /><//>`;
}

// ---- Apple logo SVG (inline, no font dependency) ----
function AppleLogo({ size = 14, color = 'currentColor', className = '' }) {
  return (
    html`<svg width=${size} height=${size} viewBox=${"0 0 24 24"} fill=${color} class=${className} style=${{ display: 'inline-block', verticalAlign: 'middle' }}> <path d=${"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"} /> </svg>`
  );
}

// ---- Helper functions ----
function getJobStatus(job) {
  if (!job.loaded) return 'unloaded';
  if (!job.enabled) return 'disabled';
  if (job.pid != null && job.pid > 0) return 'running';
  if (job.last_exit !== 0 && job.last_exit !== null) return 'failed';
  return 'idle';
}

function statusLabel(s) {
  return { running: 'Running', idle: 'Idle', failed: 'Failed', disabled: 'Disabled', unloaded: 'Unloaded' }[s] || s;
}

function isAppleDomain(domain) {
  return domain === 'apple-agent' || domain === 'apple-daemon' || (domain && domain.startsWith('apple'));
}

function isAppleJob(job) {
  return job.is_apple === true || isAppleDomain(job.domain);
}

const JOB_ACTIONS = {
  'start':    { label: 'Start',    icon: 'play',         kind: 'api', mutating: true },
  'stop':     { label: 'Stop',     icon: 'square',       kind: 'api', mutating: true },
  'run-now':  { label: 'Run Now',  icon: 'zap',          kind: 'api', mutating: true },
  'reload':   { label: 'Reload',   icon: 'refresh-cw',   kind: 'api', mutating: true },
  'enable':   { label: 'Enable',   icon: 'toggle-left',  kind: 'api', mutating: true },
  'disable':  { label: 'Disable',  icon: 'toggle-right', kind: 'api', mutating: true },
  'load':     { label: 'Load',     icon: 'log-in',       kind: 'api', mutating: true },
  'unload':   { label: 'Unload',   icon: 'log-out',      kind: 'api', mutating: true },
  'edit':     { label: 'Edit',     icon: 'pencil',       kind: 'nav', tab: 'edit' },
  'logs':     { label: 'Logs',     icon: 'file-text',    kind: 'nav', tab: 'logs' },
  'info':     { label: 'Details',  icon: 'info',         kind: 'nav', tab: 'info' },
  'export':   { label: 'Export',   icon: 'download',     kind: 'export' },
  'delete':   { label: 'Delete',   icon: 'trash-2',      kind: 'api', mutating: true, danger: true },
};

async function apiJobAction(label, actionId) {
  const action = JOB_ACTIONS[actionId];
  if (!action || action.kind !== 'api') {
    throw new Error('Unsupported API action: ' + actionId);
  }
  const encoded = encodeURIComponent(label);
  if (actionId === 'delete') {
    return api('/jobs/' + encoded, { method: 'DELETE' });
  }
  return api('/jobs/' + encoded + '/' + actionId, { method: 'POST' });
}

function confirmationFor(job, actionId, settings) {
  const action = JOB_ACTIONS[actionId];
  if (!action || !action.mutating) return null;

  const deleting = actionId === 'delete';
  const destructiveGuard = deleting && settings.confirm_destructive;
  const appleGuard = isAppleJob(job) && settings.confirm_apple_modify;
  if (!destructiveGuard && !appleGuard) return null;

  if (deleting) {
    let message = 'Are you sure you want to delete "' + job.label + '"? This will unload and remove the plist file.';
    if (appleGuard) {
      message += ' This is an Apple system job.';
    }
    return { title: 'Delete Job', message, danger: true };
  }

  return {
    title: 'Modify Apple System Job',
    message: '"' + job.label + '" is an Apple system job. Are you sure you want to ' + action.label.toLowerCase() + ' it?',
    danger: false,
  };
}

function bulkConfirmationFor(labels, jobs, actionId, settings) {
  const action = JOB_ACTIONS[actionId];
  if (!action || !action.mutating) return null;

  const selected = jobs.filter(job => labels.includes(job.label));
  const appleCount = selected.filter(isAppleJob).length;
  const deleting = actionId === 'delete';
  const destructiveGuard = deleting && settings.confirm_destructive;
  const appleGuard = appleCount > 0 && settings.confirm_apple_modify;
  if (!destructiveGuard && !appleGuard) return null;

  const jobWord = labels.length === 1 ? 'job' : 'jobs';
  if (deleting) {
    let message = 'Are you sure you want to delete ' + labels.length + ' selected ' + jobWord + '? This will unload and remove the plist files.';
    if (appleGuard) {
      message += ' ' + appleCount + ' selected ' + (appleCount === 1 ? 'job is an Apple system job.' : 'jobs are Apple system jobs.');
    }
    return {
      title: 'Delete ' + labels.length + ' Jobs',
      message,
      danger: true,
    };
  }

  return {
    title: action.label + ' Apple System Jobs',
    message: appleCount + ' selected ' + (appleCount === 1 ? 'job is an Apple system job.' : 'jobs are Apple system jobs.') + ' Are you sure you want to continue?',
    danger: false,
  };
}

function actionSuccessMessage(job, actionId) {
  if (actionId === 'start') return 'Started ' + job.label;
  if (actionId === 'stop') return 'Stopped ' + job.label;
  if (actionId === 'run-now') return 'Running ' + job.label + ' (one-shot)...';
  if (actionId === 'reload') return 'Reloading ' + job.label + '...';
  if (actionId === 'enable') return 'Enabled ' + job.label;
  if (actionId === 'disable') return 'Disabled ' + job.label;
  if (actionId === 'load') return 'Loaded ' + job.label;
  if (actionId === 'unload') return 'Unloaded ' + job.label;
  if (actionId === 'delete') return 'Deleted ' + job.label;
  return JOB_ACTIONS[actionId].label + ' completed for ' + job.label;
}

function useJobActions({ addToast, presentConfirm, settings, openDetail }) {
  return useCallback(async (job, actionId) => {
    const action = JOB_ACTIONS[actionId];
    if (!action) {
      addToast('error', 'Unknown action: ' + actionId);
      return { ok: false };
    }

    const confirmation = confirmationFor(job, actionId, settings);
    if (confirmation) {
      const confirmed = await new Promise(resolve => {
        let settled = false;
        const settle = value => {
          if (settled) return;
          settled = true;
          resolve(value);
        };
        presentConfirm({
          ...confirmation,
          onConfirm: () => settle(true),
          onCancel: () => settle(false),
        });
      });
      if (!confirmed) return { ok: false, cancelled: true };
    }

    if (action.kind === 'nav') {
      openDetail(job, action.tab);
      return { ok: true };
    }

    if (action.kind === 'export') {
      const encoded = encodeURIComponent(job.label);
      const anchor = document.createElement('a');
      anchor.href = '/api/jobs/' + encoded + '/export';
      anchor.download = job.label + '.plist';
      document.body.appendChild(anchor);
      anchor.click();
      document.body.removeChild(anchor);
      addToast('success', 'Exported ' + job.label + '.plist');
      return { ok: true };
    }

    try {
      await apiJobAction(job.label, actionId);
      addToast('success', actionSuccessMessage(job, actionId));
      return { ok: true };
    } catch (err) {
      const prefix = actionId === 'delete' ? 'Failed to delete' : actionId + ' failed';
      addToast('error', prefix + ': ' + err.message);
      return { ok: false };
    }
  }, [addToast, openDetail, presentConfirm, settings]);
}

