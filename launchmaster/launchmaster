        html`<${CreateJobModal} onClose=${() => setShowCreate(false)} addToast=${addToast} />`
      )}  ${showSettings && (
        html`<${SettingsModal} onClose=${() => setShowSettings(false)} settings=${settings} setSettings=${setSettings} addToast=${addToast} />`
      )}  ${showConfirm && (
        html`<${ConfirmDialog} title=${showConfirm.title} message=${showConfirm.message} danger=${showConfirm.danger} onConfirm=${confirmCurrent} onCancel=${cancelConfirm} />`
      )}  <${ToastContainer} toasts=${toasts} removeToast=${removeToast} /> </div>`
  );
}

