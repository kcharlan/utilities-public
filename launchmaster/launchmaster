                )} </div> <div class=${"form-row"}> <div class=${"form-group"}> <label class=${"form-label"}>Stdout Path</label> <input class=${"form-input"} placeholder=${"/tmp/my-tool.log"} value=${formData.stdoutPath} onInput=${e => update('stdoutPath', e.target.value)} /> </div> <div class=${"form-group"}> <label class=${"form-label"}>Stderr Path</label> <input class=${"form-input"} placeholder=${"/tmp/my-tool.err"} value=${formData.stderrPath} onInput=${e => update('stderrPath', e.target.value)} /> </div> </div> <div class=${"form-group"}> <label class=${"form-label"}>Working Directory</label> <input class=${"form-input"} placeholder=${"(optional)"} value=${formData.workingDir} onInput=${e => update('workingDir', e.target.value)} /> </div> <div style=${{ marginTop: 8 }}> <div class=${"toggle-row"}> <span class=${"toggle-row-label"}>Run at Load</span> <div class=${'toggle-switch' + (formData.runAtLoad ? ' on' : '')} onClick=${() => update('runAtLoad', !formData.runAtLoad)} /> </div> <div class=${"toggle-row"}> <span class=${"toggle-row-label"}>Keep Alive</span> <div class=${'toggle-switch' + (formData.keepAlive ? ' on' : '')} onClick=${() => update('keepAlive', !formData.keepAlive)} /> </div> </div> </div>`
          ) : (
            html`<div class=${"animate-fade"}> <div style=${{ marginBottom: 12, fontSize: 12, color: 'var(--text-secondary)' }}> Preview the generated plist before creating: </div> <div class=${"plist-preview"}>${previewXml}</div> </div>`
          )} </div> <div class=${"modal-footer"}> ${step === 'preview' && (
            html`<button class=${"btn"} onClick=${() => setStep('form')} style=${{ marginRight: 'auto' }}> <${Icon} name=${"arrow-left"} size=${14} /> Back </button>`
          )} <button class=${"btn"} onClick=${onClose}>Cancel</button> ${step === 'form' ? (
            html`<button class=${"btn btn-accent"} onClick=${() => setStep('preview')}> Preview Plist <${Icon} name=${"arrow-right"} size=${14} /> </button>`
          ) : (
            html`<button class=${"btn btn-accent"} onClick=${handleCreate} disabled=${creating} style=${{ opacity: creating ? 0.6 : 1 }}> <${Icon} name=${"plus"} size=${14} /> ${creating ? 'Creating...' : 'Create & Load'} </button>`
          )} </div> </div> </div>`
  );
}

// ---- Settings Modal ----
function SettingsModal({ onClose, settings, setSettings, addToast }) {
  const [saving, setSaving] = useState(false);

  const handleSave = async () => {
    setSaving(true);
    try {
      await api('/settings', {
        method: 'PUT',
        body: JSON.stringify(settings),
      });
      addToast('success', 'Settings saved');
      onClose();
    } catch (err) {
      addToast('error', 'Failed to save settings: ' + err.message);
    } finally {
      setSaving(false);
    }
