// ---- Job Table ----
const PAGE_SIZE = 25;

function JobTable({ jobs, selected, setSelected, onRowClick, showApple, runAction, openActionMenu }) {
  const [sortCol, setSortCol] = useState('status');
  const [sortAsc, setSortAsc] = useState(true);
  const [currentPage, setCurrentPage] = useState(1);

  const handleSort = (col) => {
    if (sortCol === col) setSortAsc(!sortAsc);
    else { setSortCol(col); setSortAsc(true); }
  };

  const toggleSelect = (label, e) => {
    e.stopPropagation();
    setSelected(prev =>
      prev.includes(label) ? prev.filter(l => l !== label) : [...prev, label]
    );
  };

  const toggleAll = () => {
    if (selected.length === jobs.length) setSelected([]);
    else setSelected(jobs.map(j => j.label));
  };

  // Reset to page 1 when filters/jobs change
  useEffect(() => { setCurrentPage(1); }, [jobs.length]);

  const sorted = useMemo(() => {
    const order = { failed: 0, running: 1, idle: 2, disabled: 3, unloaded: 4 };
    return [...jobs].sort((a, b) => {
      let cmp = 0;
      if (sortCol === 'status') cmp = order[getJobStatus(a)] - order[getJobStatus(b)];
      else if (sortCol === 'label') cmp = a.label.localeCompare(b.label);
      else if (sortCol === 'domain') cmp = a.domain.localeCompare(b.domain);
      else if (sortCol === 'exit') cmp = (a.last_exit || 0) - (b.last_exit || 0);
      return sortAsc ? cmp : -cmp;
    });
  }, [jobs, sortCol, sortAsc]);

  const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
  const page = Math.min(currentPage, totalPages);
  const paginatedJobs = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

  const SortHeader = ({ col, children, style }) => (
    html`<th class=${sortCol === col ? 'sorted' : ''} onClick=${() => handleSort(col)} style=${style}> ${children} <span class=${"sort-arrow"}>${sortCol === col ? (sortAsc ? '\u25B2' : '\u25BC') : '\u25B2'}</span> </th>`
  );

  return (
    html`<div class=${"job-table-container"} style=${{ overflow: 'auto' }}> <table class=${"job-table"}> <thead> <tr> <th style=${{ width: 36 }}> <div class=${'checkbox' + (selected.length === jobs.length && jobs.length > 0 ? ' checked' : '')} onClick=${toggleAll} /> </th> <${SortHeader} col=${"status"} style=${{ width: 60 }}>Status<//> <${SortHeader} col=${"label"}>Label<//> <${SortHeader} col=${"domain"} style=${{ width: 120 }}>Domain<//> <th style=${{ width: 180 }}>Schedule</th> <th style=${{ width: 70 }}>PID</th> <${SortHeader} col=${"exit"} style=${{ width: 80 }}>Last Exit<//> <th class=${"actions-col"} style=${{ width: 110, textAlign: 'right' }}>Actions</th> </tr> </thead> <tbody> ${paginatedJobs.map((job, i) => {
            const status = getJobStatus(job);
            const apple = isAppleJob(job);
            return (
              html`<tr key=${job.label} class=${(selected.includes(job.label) ? 'selected ' : '') + 'status-' + status + (apple ? ' apple-row' : '')} onClick=${() => onRowClick(job)} onContextMenu=${e => {
                  e.preventDefault();
                  openActionMenu(job, e.clientX, e.clientY);
                }} style=${{ animationDelay: (i * 20) + 'ms' }}> <td> <div class=${'checkbox' + (selected.includes(job.label) ? ' checked' : '')} onClick=${e => toggleSelect(job.label, e)} /> </td> <td> <div class=${'status-dot ' + status} title=${statusLabel(status)} /> </td> <td> <div class=${"job-label-cell"}> ${apple && html`<span class=${"apple-row-icon"} title=${"Apple system job"}><${AppleLogo} size=${14} color=${"#d0a050"} /></span>`} <span class=${"job-label-text"}>${job.label}</span> </div> </td> <td> <span class=${'domain-badge ' + (apple ? 'apple' : job.domain)}> ${apple && html`<${AppleLogo} size=${10} color=${"#e8a030"} className=${"apple-badge-icon"} />`} ${job.domain.replace('-', ' ')} </span> </td> <td><span class=${"schedule-text"} title=${job.schedule}>${job.schedule_human}</span></td> <td><span class=${"pid-text"}>${job.pid || '\u2014'}</span></td> <td> ${job.last_exit !== null ? (
                    html`<span class=${'exit-code ' + (job.last_exit === 0 ? 'zero' : 'nonzero')}> ${job.last_exit} </span>`
                  ) : '\u2014'} </td> <td class=${"actions-cell"} style=${{ textAlign: 'right' }}> <div class=${"row-actions"}> <button class=${"row-action-btn"} title=${"Run Now (one-shot)"} onClick=${e => { e.stopPropagation(); runAction(job, 'run-now'); }}> <${Icon} name=${"zap"} size=${13} /> </button> <button class=${"row-action-btn"} title=${"Stop (x)"} onClick=${e => { e.stopPropagation(); runAction(job, 'stop'); }}> <${Icon} name=${"square"} size=${13} /> </button> <button class=${"row-action-btn"} title=${"More actions"} aria-label=${"More actions"} onClick=${e => {
                        e.stopPropagation();
                        const rect = e.currentTarget.getBoundingClientRect();
                        openActionMenu(job, rect.left, rect.bottom + 4);
                      }}> <${Icon} name=${"more-vertical"} size=${13} /> </button> </div> </td> </tr>`
            );
          })} </tbody> </table> <div style=${{
        display: 'flex', alignItems: 'center', justifyContent: 'space-between',
        padding: '6px 12px', borderTop: '1px solid var(--border-subtle)',
        background: 'var(--bg-elevated)', fontSize: 11, color: 'var(--text-tertiary)',
      }}> <span>${sorted.length} job${sorted.length !== 1 ? 's' : ''}${sorted.length !== jobs.length ? ' (filtered from ' + jobs.length + ')' : ''}</span> <${Pagination} currentPage=${page} totalPages=${totalPages} onPageChange=${setCurrentPage} /> <span>${PAGE_SIZE} per page</span> </div> </div>`
  );
}

// ---- Bulk Action Bar ----
function BulkBar({ count, onClear, selectedLabels, jobs, addToast, presentConfirm, settings }) {

  const bulkAction = async (action, label) => {
    let successes = 0;
    let failures = 0;
    for (const jobLabel of selectedLabels) {
      try {
        await apiJobAction(jobLabel, action);
        successes++;
      } catch (err) {
        failures++;
      }
    }
    if (failures === 0) {
      addToast('success', label + ' ' + successes + ' job' + (successes !== 1 ? 's' : ''));
    } else {
      addToast('warning', label + ': ' + successes + ' succeeded, ' + failures + ' failed');
    }
    onClear();
  };

  const requestBulkAction = (actionId, successLabel) => {
    const confirmation = bulkConfirmationFor(
      selectedLabels, jobs, actionId, settings
    );
    if (!confirmation) {
      bulkAction(actionId, successLabel);
      return;
    }
    presentConfirm({
      ...confirmation,
      onConfirm: () => bulkAction(actionId, successLabel),
      onCancel: () => {},
    });
  };

  if (count === 0) return null;
  return (
    html`<div class=${"bulk-bar"}> <span class=${"bulk-bar-count"}>${count} selected</span> <div class=${"bulk-bar-divider"} /> <button class=${"btn btn-sm"} onClick=${() => requestBulkAction('start', 'Started')}><${Icon} name=${"play"} size=${12} /> Start All</button> <button class=${"btn btn-sm"} onClick=${() => requestBulkAction('stop', 'Stopped')}><${Icon} name=${"square"} size=${12} /> Stop All</button> <button class=${"btn btn-sm"} onClick=${() => requestBulkAction('reload', 'Reloaded')}><${Icon} name=${"refresh-cw"} size=${12} /> Reload All</button> <button class=${"btn btn-sm"} onClick=${() => requestBulkAction('enable', 'Enabled')}><${Icon} name=${"toggle-left"} size=${12} /> Enable</button> <button class=${"btn btn-sm"} onClick=${() => requestBulkAction('disable', 'Disabled')}><${Icon} name=${"toggle-right"} size=${12} /> Disable</button> <button class=${"btn btn-sm btn-danger"} onClick=${() => requestBulkAction('delete', 'Deleted')}><${Icon} name=${"trash-2"} size=${12} /> Delete</button> <div style=${{ flex: 1 }} /> <button class=${"btn btn-sm btn-ghost"} onClick=${onClear}>Clear Selection</button> </div>`
  );
}

// ---- Detail Panel ----
function DetailPanel({ job, initialTab, onClose, addToast, runAction }) {
  const [activeTab, setActiveTab] = useState(initialTab || 'info');
  const [logTab, setLogTab] = useState('stderr');
  const [logContent, setLogContent] = useState('');
  const [logLoading, setLogLoading] = useState(false);
  const [plistContent, setPlistContent] = useState('');
  const [plistLoading, setPlistLoading] = useState(false);
  const [modified, setModified] = useState(false);

  // Reset tab when job or initialTab changes
  useEffect(() => {
    setActiveTab(initialTab || 'info');
  }, [job && job.label, initialTab]);

  // Fetch logs when logs tab is active or logTab changes
  useEffect(() => {
    if (!job || activeTab !== 'logs') return;
    let cancelled = false;
    setLogLoading(true);
    const encoded = encodeURIComponent(job.label);
    api('/jobs/' + encoded + '/logs/' + logTab)
      .then(data => {
        if (!cancelled) {
          setLogContent(data.content || data.lines || '');
          setLogLoading(false);
        }
      })
      .catch(err => {
        if (!cancelled) {
          setLogContent('Error loading logs: ' + err.message);
          setLogLoading(false);
        }
      });
    return () => { cancelled = true; };
  }, [job && job.label, activeTab, logTab]);

  // Fetch plist when edit tab is active
  useEffect(() => {
    if (!job || activeTab !== 'edit') return;
    let cancelled = false;
    setPlistLoading(true);
    setModified(false);
    const encoded = encodeURIComponent(job.label);
    api('/jobs/' + encoded + '/plist')
      .then(data => {
        if (!cancelled) {
          setPlistContent(data.content || '');
          setPlistLoading(false);
        }
      })
      .catch(err => {
        if (!cancelled) {
          setPlistContent('Error loading plist: ' + err.message);
          setPlistLoading(false);
        }
      });
    return () => { cancelled = true; };
  }, [job && job.label, activeTab]);

  if (!job) return null;
  const status = getJobStatus(job);
  const encoded = encodeURIComponent(job.label);

  const handleSavePlist = async () => {
    try {
      await api('/jobs/' + encoded + '/plist', {
        method: 'PUT',
        body: JSON.stringify({ content: plistContent }),
      });
      setModified(false);
      addToast('success', 'Plist saved. Reload to apply changes.');
    } catch (err) {
      addToast('error', 'Save failed: ' + err.message);
    }
  };

  const handleSaveAndReload = async () => {
    try {
      await api('/jobs/' + encoded + '/plist', {
        method: 'PUT',
        body: JSON.stringify({ content: plistContent }),
      });
      setModified(false);
      await apiJobAction(job.label, 'reload');
      addToast('success', 'Saved and reloading ' + job.label + '...');
    } catch (err) {
