#!/bin/sh
set -eu

SLOT_NUMBER="${1:?slot required}"
TASK_ID="${2:?task id required}"
SESSION_ROOT="${3:?session root required}"
REPO_ROOT="${COGNITIVE_SWITCHYARD_REPO_ROOT:-}"

if [ -z "$REPO_ROOT" ]; then
  echo "COGNITIVE_SWITCHYARD_REPO_ROOT must point at the repository root for git-worktree isolation." >&2
  exit 1
fi

WORKSPACE_PATH="$SESSION_ROOT/workers/$SLOT_NUMBER/worktree-$TASK_ID"
BRANCH_NAME="switchyard-$TASK_ID-$SLOT_NUMBER"
# A previous conflict may need manual resolution even if its worktree was
# removed separately. Never reset an existing branch or workspace on retry.
if [ -e "$WORKSPACE_PATH" ]; then
  echo "Workspace already exists: $WORKSPACE_PATH" >&2
  exit 1
fi
if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
  echo "Task branch already exists: $BRANCH_NAME" >&2
  exit 1
fi
git -C "$REPO_ROOT" worktree add -B "$BRANCH_NAME" "$WORKSPACE_PATH" >/dev/null
printf '%s\n' "$WORKSPACE_PATH"
