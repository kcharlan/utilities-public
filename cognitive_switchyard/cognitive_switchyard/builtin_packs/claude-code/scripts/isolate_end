#!/bin/sh
set -eu

SLOT_NUMBER="${1:?slot required}"
TASK_ID="${2:?task id required}"
WORKSPACE_PATH="${3:?workspace path required}"
FINAL_STATUS="${4:?final status required}"
REPO_ROOT="${COGNITIVE_SWITCHYARD_REPO_ROOT:-}"
BRANCH_NAME="switchyard-$TASK_ID-$SLOT_NUMBER"

# The hook receives no session root. Restrict cleanup to the expected worker
# layout and require Git to recognize the worktree before removing it.
case "$WORKSPACE_PATH" in
  */workers/"$SLOT_NUMBER"/worktree-"$TASK_ID") ;;
  *) echo "Refusing unexpected workspace path: $WORKSPACE_PATH" >&2; exit 1 ;;
esac
if [ -z "$REPO_ROOT" ]; then
  echo "COGNITIVE_SWITCHYARD_REPO_ROOT is required." >&2
  exit 1
fi

BRANCH_MERGED=false
if [ "$FINAL_STATUS" = "done" ] && git -C "$REPO_ROOT" rev-parse --verify "$BRANCH_NAME" >/dev/null 2>&1; then
  if git -C "$REPO_ROOT" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    echo "Refusing to disturb a merge already in progress." >&2
    exit 1
  fi
  if [ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]; then
    echo "Refusing to merge into a dirty working tree; branch preserved: $BRANCH_NAME" >&2
    exit 1
  fi
  MERGE_BASE="$(git -C "$REPO_ROOT" merge-base HEAD "$BRANCH_NAME")"
  BRANCH_HEAD="$(git -C "$REPO_ROOT" rev-parse "$BRANCH_NAME")"
  if [ "$MERGE_BASE" != "$BRANCH_HEAD" ]; then
    if git -C "$REPO_ROOT" merge --squash "$BRANCH_NAME" >/dev/null 2>&1; then
      COMMIT_MSG="${SWITCHYARD_COMMIT_MSG:-feat: merge task $TASK_ID from slot $SLOT_NUMBER}"
      git -C "$REPO_ROOT" commit -m "$COMMIT_MSG" >/dev/null
      git -C "$REPO_ROOT" rev-parse --short HEAD
    else
      if git -C "$REPO_ROOT" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        git -C "$REPO_ROOT" merge --abort
      else
        git -C "$REPO_ROOT" restore --source=HEAD --staged --worktree -- .
      fi
      echo "CONFLICT: merge of $BRANCH_NAME failed; branch preserved for manual resolution." >&2
      exit 1
    fi
  fi
  BRANCH_MERGED=true
fi

if [ -e "$WORKSPACE_PATH" ]; then
  git -C "$REPO_ROOT" worktree remove --force "$WORKSPACE_PATH"
fi
if [ "$BRANCH_MERGED" = true ] || [ "$FINAL_STATUS" != done ]; then
  if git -C "$REPO_ROOT" rev-parse --verify "$BRANCH_NAME" >/dev/null 2>&1; then
    git -C "$REPO_ROOT" branch -D "$BRANCH_NAME" >/dev/null
  fi
fi
echo "Cleaned up slot $SLOT_NUMBER for $TASK_ID ($FINAL_STATUS)."
