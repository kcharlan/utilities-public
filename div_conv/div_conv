"""Convert supported brokerage activity CSV exports to cooked CSV and QIF."""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import glob
import json
import os
import re
import stat
import sys
import tempfile
from dataclasses import dataclass
from decimal import Decimal, DecimalException, InvalidOperation, localcontext
from pathlib import Path
from typing import Callable, Iterable, Mapping, Sequence


SCHEMA_VERSION = 1
MAX_AMOUNT_SIGNIFICANT_DIGITS = 100
MAX_AMOUNT_INTEGER_DIGITS = 100
WITHDRAWAL_SECURITY_KEY = "@withdrawal"
FINANCIAL_NUMBER = r"(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?|\.\d+"
FINANCIAL_AMOUNT_PATTERN = re.compile(
    rf"^(?:\(\$?(?P<parenthesized>{FINANCIAL_NUMBER})\)|"
    rf"(?P<sign_before>[+-]?)(?P<currency>\$?)(?P<sign_after>[+-]?)"
    rf"(?P<number>{FINANCIAL_NUMBER}))$"
)
FIDELITY_HEADERS = [
    "Account",
    "Run Date",
    "Action",
    "Symbol",
    "Description",
    "Quantity",
    "Price ($)",
    "Commission ($)",
    "Fees ($)",
    "Accrued Interest ($)",
    "Amount ($)",
    "Settlement Date",
]
VANGUARD_HEADERS = [
    "Account Number",
    "Trade Date",
    "Settlement Date",
    "Transaction Type",
    "Transaction Description",
    "Investment Name",
    "Symbol",
    "Shares",
    "Share Price",
    "Principal Amount",
    "Commissions and Fees",
    "Net Amount",
]
COOKED_HEADERS = [
    "Brokerage",
    "Account",
    "Date",
    "Action",
    "Security",
    "Amount",
    "Source File",
    "Source Row",
]


class UserError(Exception):
    """An actionable input or configuration error."""


class ConfigurationCreated(UserError):
    """Raised after an incomplete first-run configuration is written."""


@dataclass(frozen=True)
class ExtractedRow:
    account: str
    date: str
    source_action: str
    security: str
    amount: str
    description: str


@dataclass(frozen=True)
class BrokerageAdapter:
    """Brokerage-owned raw CSV contract and row extraction behavior."""

    required_headers: tuple[str, ...]
    actions: Mapping[str, str]
    skipped_actions: tuple[str, ...]
    category_actions: tuple[str, ...]
    transfer_actions: tuple[str, ...]
    required_security_keys: tuple[str, ...]
    extractor: Callable[[dict[str, str]], ExtractedRow]


def extract_fidelity_row(row: dict[str, str]) -> ExtractedRow:
    return ExtractedRow(
        account=row["Account"],
        date=row["Run Date"],
        source_action=row["Action"],
        security=row["Symbol"] or row["Description"],
        amount=row["Amount ($)"],
        description=row["Description"],
    )


def extract_vanguard_row(row: dict[str, str]) -> ExtractedRow:
    return ExtractedRow(
        account=row["Account Number"],
        date=row["Trade Date"],
        source_action=row["Transaction Type"],
        security=row["Symbol"] or row["Investment Name"] or row["Transaction Description"],
        amount=row["Net Amount"],
        description=row["Transaction Description"],
    )


ADAPTERS = {
    "fidelity": BrokerageAdapter(
        required_headers=tuple(FIDELITY_HEADERS),
        actions={
            "DIVIDEND RECEIVED": "dividend",
        },
        skipped_actions=("REINVESTMENT",),
        category_actions=("dividend",),
        transfer_actions=(),
        required_security_keys=(),
        extractor=extract_fidelity_row,
    ),
    "vanguard": BrokerageAdapter(
        required_headers=tuple(VANGUARD_HEADERS),
        actions={"Dividend": "dividend", "Withdrawal": "withdrawal"},
        skipped_actions=("Reinvestment", "Sweep out"),
        category_actions=("dividend",),
        transfer_actions=("withdrawal",),
        required_security_keys=(WITHDRAWAL_SECURITY_KEY,),
        extractor=extract_vanguard_row,
    ),
}
REGISTERED_BROKERAGES = tuple(ADAPTERS)


