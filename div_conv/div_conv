@dataclass(frozen=True)
class ExtractedRow:
    account: str
    date: str
    source_action: str
    security: str
    amount: str
    description: str


@dataclass(frozen=True)
class BrokerageAdapter:
    """Brokerage-owned raw CSV contract and row extraction behavior."""

    required_headers: tuple[str, ...]
    alternate_required_headers: tuple[tuple[str, ...], ...]
    actions: Mapping[str, str]
    skipped_actions: tuple[str, ...]
    category_actions: tuple[str, ...]
    transfer_actions: tuple[str, ...]
    required_security_keys: tuple[str, ...]
    extractor: Callable[[dict[str, str]], ExtractedRow]
    surrounding_section_headers: tuple[tuple[str, ...], ...] = ()
    allows_trailing_notices: bool = False


def canonical_fidelity_action(value: str) -> str:
    """Collapse Fidelity's detail-bearing action labels to supported actions."""
    normalized = " ".join(value.split()).upper()
    for action in ("DIVIDEND RECEIVED", "REINVESTMENT"):
        if normalized == action or normalized.startswith(f"{action} "):
            return action
    return value


def extract_fidelity_row(row: dict[str, str]) -> ExtractedRow:
    return ExtractedRow(
        account=row["Account"],
        date=row["Run Date"],
        source_action=canonical_fidelity_action(row["Action"]),
        security=row["Symbol"] or row["Description"],
        amount=row["Amount ($)"],
        description=row["Description"],
    )


def extract_vanguard_row(row: dict[str, str]) -> ExtractedRow:
    return ExtractedRow(
        account=row["Account Number"],
        date=row["Trade Date"],
        source_action=row["Transaction Type"],
        security=row["Symbol"] or row["Investment Name"] or row["Transaction Description"],
        amount=row["Net Amount"],
        description=row["Transaction Description"],
    )


