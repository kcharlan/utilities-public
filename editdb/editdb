# --- Server Lifecycle ---

def open_browser(port):
    time.sleep(1.5)
    webbrowser.open(f"http://127.0.0.1:{port}")


def testing_mode_enabled():
    value = os.environ.get("UTILITIES_TESTING", "")
    return value.lower() not in {"", "0", "false", "no"}


def main():
    global db_manager
    args = parse_args()
    
    if not args.db_path:
        logger.error("❌ Error: No database path provided.")
        logger.info("Usage: ./editdb <path_to_db> [-p <port>]")
        sys.exit(1)
        
    db_manager = DBManager(args.db_path)
    
    logger.info(f"🚀 EditDB starting for: {args.db_path}")
    logger.info(f"📡 API available at http://127.0.0.1:{args.port}/api")
    
    if not testing_mode_enabled():
        threading.Thread(target=open_browser, args=(args.port,), daemon=True).start()
    
    # Security: Bind to 127.0.0.1 only (not 0.0.0.0) to prevent network access
    # No CORS headers needed since we only serve localhost requests
    uvicorn.run(app, host="127.0.0.1", port=args.port, log_level="info")

if __name__ == "__main__":
    main()
